<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Finger Pathway Atlas · Anatomical Edition</title>
<style>
:root{color-scheme:dark;--bg:#050b11;--panel:rgba(10,19,27,.94);--border:rgba(129,165,187,.19);--ink:#e6edf1;--muted:#8fa4b1;--sens:#61d9e8;--motor:#eaaa77}*{box-sizing:border-box}body{margin:0;overflow:hidden;background:var(--bg);color:var(--ink);font:13px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}button,select,input{font:inherit}button,select{background:#101e29;color:var(--ink);border:1px solid var(--border);border-radius:5px;cursor:pointer}button{padding:7px 10px}button:hover,select:hover{border-color:#7ba9bb;background:#172b39}button.active{border-color:var(--sens);color:var(--sens);background:#12303c}button:focus-visible,select:focus-visible{outline:2px solid var(--sens);outline-offset:3px}input[type=range]{width:100%;accent-color:#73b7ce}input[type=checkbox]{accent-color:#6dd3df}select{padding:6px;max-width:100%}header{height:70px;position:absolute;inset:0 0 auto;z-index:4;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 22px;background:linear-gradient(90deg,#0b141d,#070e15)}h1{font:25px/1.1 Georgia,serif;margin:0 0 4px;letter-spacing:-.4px}.brand{font-size:9px;letter-spacing:2px;color:var(--muted);text-transform:uppercase}.version{font-size:10px;letter-spacing:1px;border:1px solid var(--border);padding:5px 9px;border-radius:20px}.header-actions{display:flex;align-items:center;gap:8px}.side{position:absolute;top:70px;bottom:0;left:0;width:236px;border-right:1px solid var(--border);background:var(--panel);z-index:3;overflow-y:auto;scrollbar-width:thin;padding:18px 14px 22px}h2{font:18px/1.25 Georgia,serif;margin:0 0 10px}h3{font-size:10px;font-weight:600;letter-spacing:1.7px;text-transform:uppercase;color:var(--muted);margin:16px 0 8px}.navbutton{border:0;background:transparent;border-radius:3px;display:flex;gap:10px;align-items:center;text-align:left;width:100%;padding:7px 8px;margin:1px 0;font-size:12px;color:#b8c7d0}.navbutton.active{border:0;border-left:2px solid var(--sens);background:linear-gradient(90deg,#10303c,transparent)}.navbutton span{font-size:9px;letter-spacing:.7px;width:21px;color:#78909e}.divider{height:1px;background:var(--border);margin:16px 0}.small{font-size:11px;color:var(--muted)}.tiny{font-size:10px;color:var(--muted)}.legend{display:flex;gap:12px;font-size:10px;margin:11px 0}.dot{width:6px;height:6px;display:inline-block;margin-right:4px;border-radius:50%}.row{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:8px 0}.row label{font-size:11px;color:#adc0cb}.twocol{display:grid;grid-template-columns:1fr 1fr;gap:7px}.twocol button{font-size:11px;padding:6px}.controlgroup{padding:11px 0;border-top:1px solid var(--border)}#stage{position:absolute;left:236px;top:70px;right:0;bottom:0;background:radial-gradient(ellipse at 52% 48%,#12212d 0,#071019 50%,#03080e 95%)}canvas{display:block;width:100%;height:100%;touch-action:none}#labels{position:absolute;inset:0;pointer-events:none;overflow:hidden}.label{position:absolute;transform:translate(-50%,-50%);white-space:nowrap;max-width:240px;font-size:10px;letter-spacing:.15px;border:1px solid rgba(131,175,195,.25);background:rgba(5,14,22,.78);padding:3px 8px;border-radius:3px;color:#ccdae3;text-shadow:0 1px 3px #000}.label.hotspot{cursor:pointer;pointer-events:auto;padding:5px 9px;border-color:rgba(89,197,213,.5)}.label.hotspot:before{content:'+';color:var(--sens);margin-right:7px}.label.hotspot:hover{background:#184151}#sceneheading{position:absolute;top:20px;left:26px;pointer-events:none;max-width:60%}#sceneheading h2{font-size:29px;line-height:1.1;letter-spacing:-.6px;margin:4px 0 8px}#eyebrow{font-size:10px;letter-spacing:1.9px;color:var(--sens);text-transform:uppercase}#subtitle{font-size:11px;color:var(--muted);max-width:520px}#info{position:absolute;right:17px;top:18px;width:236px;padding:14px;background:rgba(8,17,25,.9);border:1px solid var(--border);border-radius:6px;backdrop-filter:blur(10px)}#info p{font-size:11px;color:#b5c6d0;line-height:1.65;margin:10px 0}#info h3{margin:0 0 8px;font-size:9px}.tag{display:inline-block;font-size:9px;letter-spacing:.6px;background:#1b303e;border:1px solid #284757;border-radius:3px;padding:2px 5px;color:#a8c9db;margin:1px 3px 3px 0}.tag.synthetic{background:#302923;border-color:#4a392b;color:#d5b99f}#selectedTitle{font:17px/1.2 Georgia,serif;margin:4px 0 8px}#details{font-size:10px;color:var(--muted);line-height:1.7}.provenance{font-size:10px!important;color:#8097a6!important;border-top:1px solid var(--border);padding-top:9px}#inspectorButtons{margin-top:10px}#bottom{position:absolute;left:24px;right:24px;bottom:17px;display:flex;justify-content:space-between;align-items:flex-end;gap:20px;pointer-events:none}.status{font-size:10px;color:#8ba4b2;padding:5px 0}.scale{border-left:1px solid #b5c5cf;border-right:1px solid #b5c5cf;border-bottom:1px solid #b5c5cf;height:7px;margin:5px 0 2px}#scalewrap{min-width:100px;text-align:center}.bottomright{max-width:310px;text-align:right}.bottomright div{font-size:10px;color:#8198a6}#toolbar{position:absolute;left:26px;bottom:100px;display:flex;gap:6px}#toolbar button{background:rgba(10,25,35,.9);font-size:10px;padding:6px 9px}#contextMini{position:absolute;right:18px;bottom:83px;width:160px;height:125px;border:1px solid var(--border);border-radius:5px;background:rgba(10,22,32,.3);display:none;pointer-events:none}.mini-caption{position:absolute;left:9px;top:6px;font-size:8px;letter-spacing:1px;color:#a4b9c7}#loader{position:absolute;inset:0;background:#071019;z-index:10;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px}#loader h2{font-size:34px;margin:0}#loadbar{width:220px;height:2px;background:#173442;overflow:hidden}#loadbar:after{content:'';display:block;height:100%;background:var(--sens);width:45%;animation:loading 1.8s infinite ease-in-out}@keyframes loading{0%{transform:translateX(-100%)}100%{transform:translateX(350%)}}#toast{position:absolute;z-index:20;bottom:30px;left:50%;transform:translateX(-50%);max-width:650px;padding:12px 20px;border:1px solid #416579;background:#142a36;border-radius:6px;font-size:12px;display:none}.modal{position:fixed;inset:0;background:rgba(0,6,10,.82);z-index:20;display:none;align-items:center;justify-content:center;padding:30px}.modal.open{display:flex}.modalarticle{width:760px;max-height:86vh;overflow:auto;padding:30px;background:#0d1c26;border:1px solid #3d596a;border-radius:10px}.modalarticle p,.modalarticle li{font-size:12px;color:#b9cbd6;line-height:1.8}.modalarticle h2{font-size:28px}.modalarticle a{color:#7ec5db}.modalarticle code{font-size:11px;color:#bfd8e6}.close{float:right}.cinema header,.cinema .side,.cinema #info,.cinema #toolbar{display:none}.cinema #stage{inset:0}.cinema #sceneheading{top:26px}.hide-info #info{display:none}#showSide{display:none}#stats{font-variant-numeric:tabular-nums;white-space:nowrap}#scaleText{white-space:nowrap}#eyebrow{text-transform:none}#bottom>div:first-child{min-width:300px}.source-select{width:100%;font-size:10px;margin-top:10px}#diagramNotice{font-size:9px;line-height:1.55;color:#829ba8;margin-top:10px}#fps{font-variant-numeric:tabular-nums}.qualityNote{font-size:9px;color:#708996}#error{color:#efac99;max-width:600px;white-space:pre-wrap;text-align:left}
@media(max-width:1050px){#info{width:205px}#sceneheading{max-width:55%}#sceneheading h2{font-size:23px}.side{width:207px}#stage{left:207px}#subtitle{max-width:300px}.version{display:none}}
@media(max-width:760px){header{height:62px;padding:0 13px}h1{font-size:20px}.brand{font-size:8px}.side{top:62px;transform:translateX(-100%);transition:transform .2s}.side.open{transform:none;width:230px}#stage{left:0;top:62px}#showSide{display:block}#info{display:none}#sceneheading{left:15px;max-width:90%}#sceneheading h2{font-size:24px}#subtitle{max-width:330px}#bottom{left:16px;right:16px}.bottomright{max-width:170px}.header-actions button{font-size:10px;padding:5px}.header-actions .desktop{display:none}#toolbar{left:14px}.modal{padding:12px}.modalarticle{padding:20px}#contextMini{display:none!important}}
#previewGrid{position:absolute;left:26px;top:165px;width:370px;display:grid;grid-template-columns:1fr 1fr;gap:11px}#previewGrid button{padding:0;overflow:hidden;text-align:left;background:rgba(8,18,28,.87);border-radius:6px}#previewGrid img{width:100%;height:126px;object-fit:cover;display:block}#previewGrid .caption{padding:8px 10px;font-size:10px;color:#c1d2dc}#previewGrid .caption span{display:block;color:#6e98aa;font-size:8px;letter-spacing:1px;text-transform:uppercase;margin-top:3px}.cinema #previewGrid{display:none!important}@media(max-width:1340px){#previewGrid{display:none!important}}

/* Version 3: one anatomical plate, linked local specimens. */
:root{--panel:rgba(8,17,23,.96);--border:rgba(139,175,193,.19);--ink:#e3e8e7;--muted:#8ca1ac;--sens:#81ced8;--motor:#d8ab7d}
header{height:70px;background:#091218;padding:0 23px}h1{font-size:27px}.brand{letter-spacing:1.8px;font-size:8px}.version{font-size:9px;border-radius:3px;padding:5px 8px;color:#a7bec8}.header-actions{gap:6px}.header-actions button{font-size:10px;border-radius:3px;background:#0e1d26;padding:7px 9px}
.side{width:211px;padding:18px 13px;background:linear-gradient(180deg,#0a151d,#071016);scrollbar-color:#2c424b transparent}.side h3{font-size:9px;letter-spacing:1.55px;margin-top:17px}.navbutton{padding:6px 7px;font-size:11px;line-height:1.42}.navbutton span{font-size:8px;flex:0 0 19px}.navbutton.active{color:#a2dbe2}.controlgroup{padding:4px 0}.controlgroup summary{font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#a7bdc8;cursor:pointer;padding:12px 0;list-style-position:outside;margin-left:13px}.controlgroup details[open]{padding-bottom:12px}.side .tiny{font-size:9px;color:#6c8491;line-height:1.7;padding-top:12px}.divider{margin:15px 0 8px}.row label{font-size:10px}.legend{font-size:9px;gap:8px}
#stage{left:211px}#viewport{transition:opacity .22s ease,filter .22s ease}body[data-loading=true] #viewport{opacity:.40;filter:blur(1px)}
#breadcrumb{position:absolute;left:27px;top:16px;font-size:9px;letter-spacing:.6px;color:#708b9b;z-index:2;max-width:70%}#breadcrumb button{padding:0;background:none;border:0;font-size:9px;color:#92aebb;letter-spacing:.3px}#breadcrumb button:hover{color:#b8e0e7}#breadcrumb span>span{color:#6c9ba8}
#sceneheading{top:56px;left:27px;max-width:650px}#sceneheading h2{font-size:35px;font-weight:400;letter-spacing:-1px;margin:5px 0 9px}#eyebrow{font-size:9px;letter-spacing:1.8px;color:#88bdc8}#subtitle{max-width:515px;font-size:10px;line-height:1.65;color:#778f9c}.label{background:rgba(5,15,22,.86);border-color:#294650;border-radius:2px;font-size:9px;padding:4px 8px}.label.hotspot{font-size:9px}
#journeyBar{position:absolute;top:149px;left:27px;display:flex;align-items:center;gap:7px;z-index:2}#journeyBar button{border-radius:3px;font-size:10px;padding:7px 12px;background:#0b202a;color:#a7dae1;border-color:#284c58}#journeyBar #motorJourney{color:#d8b592;border-color:#514234;background:#201c19}#journeyBar span{font-size:9px;color:#6c8491;margin-left:4px}
#plateHeading{position:absolute;right:22px;top:140px;width:366px;pointer-events:none}#plateHeading>span{font-size:9px;letter-spacing:2px;color:#7ca5b3}#plateHeading p{font:16px Georgia;margin:4px 0 9px;color:#bdcdd3}
#previewGrid{left:auto!important;right:22px!important;top:190px!important;width:366px!important;gap:10px!important;z-index:2}body.atlas-board #previewGrid{display:grid!important}#previewGrid button{border:1px solid #263c48;border-radius:4px;background:#09141c;transition:border-color .18s,transform .18s}#previewGrid button:hover{transform:translateY(-2px);border-color:#6b9ca7;background:#10212b}#previewGrid img{height:clamp(104px,13.8vh,157px);object-fit:contain;background:#020506}#previewGrid .caption{position:relative;padding:9px 10px 10px 31px;font-size:10px;line-height:1.4;min-height:55px}#previewGrid .caption b{position:absolute;left:9px;top:10px;font-size:9px;font-weight:500;color:#6ea0af}#previewGrid .caption strong{font-weight:500;color:#c6dce2;font-size:10px}#previewGrid .caption span{font-size:8px;text-transform:none;letter-spacing:0;color:#768f9d;line-height:1.4;margin:3px 0 0}#previewGrid .caption em{float:right;color:#80aebb;font-style:normal}
#atlasLeaders{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:hidden;z-index:1}#atlasLeaders path{fill:none;stroke-width:.9;stroke-linecap:round;stroke-dasharray:3 4;opacity:.42}.sensory-leader{stroke:#5d929e}.motor-leader{stroke:#b6916c}#anatomicalPins{position:absolute;inset:0;pointer-events:none;z-index:2}.anatomical-pin{position:absolute;width:24px;height:24px;padding:0;transform:translate(-50%,-50%);border:1px solid #608d9a;border-radius:50%;background:#08171edc;font-size:9px;color:#c1e2e6;pointer-events:auto;box-shadow:0 0 12px #417b8726}.anatomical-pin:hover,.anatomical-pin.hover{border-color:#aed9df;box-shadow:0 0 17px #79c6d150;background:#164050}.anatomical-pin[data-specimen=nmj]{border-color:#ab8869;color:#ead1ad}
#linkNotice{position:absolute;right:22px;bottom:112px;font-size:8px;letter-spacing:1px;color:#728c99;max-width:370px;text-align:right}#linkNotice span{color:#527687;margin:0 4px}body:not(.atlas-board) #linkNotice{display:none}
#opening{position:absolute;bottom:100px;left:50%;transform:translateX(-50%);padding:10px 16px;border:1px solid #315361;border-radius:4px;font-size:11px;background:#0b1c26ee;color:#bdcfd8;pointer-events:none;opacity:0;transition:opacity .15s;z-index:5}#opening.show{opacity:1}
#journeyPanel{position:absolute;right:22px;top:95px;width:309px;padding:18px;background:linear-gradient(160deg,rgba(14,31,40,.98),rgba(7,16,23,.96));border:1px solid #304b58;border-radius:5px;z-index:3;backdrop-filter:blur(12px)}#journeyPanel[hidden]{display:none!important}.journeyTop{display:flex;justify-content:space-between;align-items:center}#journeyTag{font-size:8px;letter-spacing:1.4px;color:#83bbc9}#closeJourney{font-size:18px;border:0;background:none;padding:0 1px;color:#708e9d}#journeyTitle{font:23px/1.18 Georgia;color:#d7e1e4;text-transform:none;letter-spacing:-.4px;margin:11px 0}#journeyText{font-size:11px;line-height:1.85;color:#acbec8;margin:0 0 17px}#journeySteps{display:flex;gap:5px;justify-content:space-between}#journeySteps button{padding:0;width:24px;height:24px;font-size:9px;border-radius:50%;background:#0b1b24;color:#6e8e9e}#journeySteps .active{background:#184353;color:#d4e9ed;border-color:#74acb8}.journeyTransport{display:flex;align-items:center;justify-content:space-between;margin-top:15px}.journeyTransport button{font-size:10px;padding:6px 12px}.journeyTransport span{font-size:9px;color:#7b97a5}#journeyPanel small{display:block;font-size:8px;line-height:1.6;color:#607d8b;margin-top:13px}
#info{top:61px;border-radius:4px;background:rgba(7,19,28,.96);max-height:calc(100% - 215px);overflow:auto}#selectedTitle{font-size:20px}#info p{font-size:10px}#infoHeading{letter-spacing:1.5px}#contextMini{pointer-events:auto;border-color:#304c59;background:rgba(6,14,20,.30)}#contextMini .mini-caption{font-size:7px;letter-spacing:.5px;left:6px;right:6px;display:flex;align-items:center;justify-content:space-between}#returnLocation{padding:1px 3px;font-size:7px;border-color:#3b5661;background:#0a1a25;color:#9cc3d2}#locatorDot{position:absolute;display:none;width:8px;height:8px;background:#9ccfd8;border:1px solid #e5f5f4;border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 0 8px #84c8d8;pointer-events:none}
#toolbar{bottom:92px;left:27px}#toolbar button{border-radius:3px;font-size:9px}#bottom{left:27px;bottom:17px}.bottomright div{font-size:9px;line-height:1.6}#stats{font-size:9px;color:#718a99}#scaleText{font-size:9px}.cinema #breadcrumb,.cinema #journeyBar,.cinema #journeyPanel,.cinema #plateHeading,.cinema #linkNotice,.cinema #atlasLeaders,.cinema #anatomicalPins{display:none!important}.cinema #sceneheading{left:30px;top:28px}.cinema #stage{left:0;top:0}
@media(max-height:880px) and (min-width:1120px){#previewGrid{top:173px!important}#plateHeading{top:122px}#previewGrid img{height:105px}#previewGrid .caption{min-height:51px;padding-top:7px}#linkNotice{bottom:99px}#sceneheading h2{font-size:31px}#journeyBar{top:142px}}
@media(max-width:1120px){#journeyBar span{display:none}#sceneheading{max-width:60%}#sceneheading h2{font-size:30px}.side{width:200px}#stage{left:200px}.header-actions .version{display:none}}
@media(max-width:880px){#journeyPanel{width:calc(100% - 28px);right:14px;top:auto;bottom:77px;padding:13px;max-height:232px;overflow:auto}#journeyTitle{font-size:20px;margin:6px 0}#journeyText{font-size:10px;line-height:1.55;margin-bottom:9px}#journeyPanel small{margin-top:5px;font-size:7px}.journeyTransport{margin-top:8px}#journeySteps{justify-content:flex-start;gap:8px}#journeySteps button{height:19px;width:19px}body.guided #toolbar{display:none}}
@media(max-width:760px){header{height:62px;padding:0 12px}h1{font-size:20px}.header-actions button{font-size:9px;padding:5px 6px}.header-actions .desktop{display:none}#stage{left:0;top:62px}.side{top:62px;z-index:7;width:224px}#breadcrumb{left:15px;top:14px;max-width:95%;font-size:8px}#breadcrumb button{font-size:8px}#sceneheading{top:48px;left:15px;max-width:96%}#sceneheading h2{font-size:28px}#subtitle{font-size:9px;max-width:320px}#eyebrow{font-size:8px}#journeyBar{left:15px;top:137px;gap:6px}#journeyBar button{font-size:9px;padding:6px 10px}#toolbar{left:15px;bottom:96px;gap:4px}#toolbar button{font-size:8px;padding:5px 6px}#bottom{left:15px;right:15px}#bottom>div:first-child{min-width:150px}#stats{max-width:190px;white-space:normal;font-size:8px}.bottomright{max-width:155px}.bottomright div{font-size:8px}#opening{font-size:10px;max-width:90%;width:max-content;bottom:65px}#info{display:none}#linkNotice{display:none!important}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

@media(min-width:1250px){body.atlas-board #toolbar{left:auto;right:22px;bottom:71px}}

</style></head><body class="hide-info">
<header><div><div class="brand">Build the Simulation / Anatomical edition</div><h1>Finger Pathway Atlas</h1></div><div class="header-actions"><span class="version">V3 · CONNECTED ATLAS</span><button id="showSide" aria-label="Open navigation">Views</button><button id="modelCard">Evidence & sources</button><button id="cinema" class="desktop">Presentation</button><button id="capture" class="desktop">Snapshot</button><button id="export">Export 3D</button></div></header>
<aside class="side" id="side"><div class="brand">One right index finger</div><div class="legend"><span><i class="dot" style="background:var(--sens)"></i>Sensory</span><span><i class="dot" style="background:var(--motor)"></i>Motor</span><span><i class="dot" style="background:#ba90de"></i>Other</span></div><nav id="navigation"></nav><div class="divider"></div><div class="controlgroup"><h3>Display layers</h3><div class="row"><label for="pose">Coordinates</label><select id="pose"><option value="rest" selected>Atlas rest</option></select></div><div class="row"><label><input id="skinToggle" type="checkbox" checked> Holographic skin</label><label><input id="labelToggle" type="checkbox" checked> Labels</label></div><label class="small" for="skinOpacity">Skin / envelope opacity</label><input id="skinOpacity" type="range" min="0" max="100" value="24"><div class="row"><label><input id="supportToggle" type="checkbox" checked> Support membranes</label></div><div class="row"><label><input id="contextToggle" type="checkbox" checked> Context fibers / section guides</label></div><div class="row"><label><input id="fineToggle" type="checkbox"> Modeled spines / boutons</label></div><div class="row"><label><input id="brainToggle" type="checkbox" checked> Cortical surfaces</label></div><div class="row"><label><input id="bonesToggle" type="checkbox"> Bone landmarks</label></div><div class="row"><label><input id="muscleToggle" type="checkbox"> Muscle targets</label></div></div><div class="controlgroup"><h3>Pathway / population</h3><div class="row"><label for="filter">Show</label><select id="filter"><option value="all">All pathways</option><option value="sensory">Sensory</option><option value="motor">Motor</option></select></div><div class="row"><label for="colorMode">Color</label><select id="colorMode"><option value="auto">By view</option><option value="pathway">Pathway</option><option value="cell">Individual cell</option></select></div><div class="row"><label for="sampling">Tactile sample</label><select id="sampling"><option value="20">1 : 20</option><option value="30" selected>1 : 30</option><option value="40">1 : 40</option></select></div><div class="qualityNote" id="sampleNote">52 afferents · assumed territory</div></div><div class="controlgroup"><h3>Rendering</h3><div class="row"><label><input id="caliberToggle" type="checkbox" checked> Keep thin neurites visible</label></div><div class="qualityNote">Screen-only aid; exported radii stay native.</div><div class="row"><label for="quality">Detail</label><select id="quality"><option value="low">Efficient</option><option value="high" selected>Detailed</option><option value="ultra">Dense cortex</option></select></div><div class="row"><label><input id="glowToggle" type="checkbox" checked> Soft glow</label><label><input id="aoToggle" type="checkbox"> Occlusion</label></div><div class="row"><label><input id="clipToggle" type="checkbox"> Depth section</label><label><input id="rotateToggle" type="checkbox"> Orbit</label></div><input id="clip" type="range" min="0" max="100" value="70" aria-label="Section depth"><div class="qualityNote">Drag to orbit · scroll to zoom<br>Right-drag or Shift-drag to pan · double-click to focus</div></div><div class="tiny">BodyParts3D anatomy + Allen human cell traces. Neural routes and tissue samples are constructed models, not a measured end-to-end connectome.</div></aside>
<main id="stage"><svg id="atlasLeaders" aria-hidden="true"></svg><div id="anatomicalPins"></div>
<div id="breadcrumb"><button data-go="overview">Whole pathway</button><span id="crumbContext"></span></div>
<div id="opening" role="status">Opening linked specimen…</div>
<div id="journeyBar"><button id="touchJourney">Follow touch</button><button id="motorJourney">Follow motor</button><span>Explore the route, one scale at a time</span></div>
<section id="journeyPanel" aria-label="Guided anatomical route" hidden><div class="journeyTop"><span id="journeyTag"></span><button id="closeJourney" title="End guided route">×</button></div><h3 id="journeyTitle"></h3><p id="journeyText"></p><div id="journeySteps"></div><div class="journeyTransport"><button id="prevStep">← Back</button><span id="journeyCount"></span><button id="nextStep">Next →</button></div><small>Guided anatomy · no physiological timing or measured connectivity implied</small></section>
<div id="plateHeading"><span>MICROSCOPIC WINDOWS</span><p>Six specimens. One anatomical story.</p></div><div id="sceneheading"><div id="eyebrow"></div><h2 id="sceneTitle"></h2><div id="subtitle"></div></div><div id="labels"></div><section id="info"><h3 id="infoHeading">Specimen information</h3><div id="evidenceTags"></div><div id="selectedTitle"></div><p id="description"></p><div id="details"></div><div id="inspectorButtons" class="twocol"><button id="focus">Focus</button><button id="isolate">Isolate cell</button></div><select id="cellSelect" class="source-select" aria-label="Select neuron or anatomical structure"></select><p id="provenance" class="provenance"></p></section><div id="previewGrid"></div><div id="linkNotice">SOURCE ANATOMY <span>+</span> HUMAN TRACES <span>+</span> MODELED PATHWAYS</div><div id="toolbar"><button id="reset">Reset view</button><button id="home">Whole pathway</button><button id="clearSelection">Clear selection</button><button id="infoToggle">Inspector</button></div><div id="contextMini"><span class="mini-caption">ANATOMICAL LOCATION · <button id="returnLocation">Return ↗</button></span><span id="locatorDot"></span></div><div id="bottom"><div><div id="stats" class="status"></div><div id="scalewrap"><div id="scale" class="scale"></div><span id="scaleText" class="tiny"></span></div></div><div class="bottomright"><div id="scaleNotice"></div><div id="fps"></div></div></div><div id="loader"><div class="brand">Source geometry / offline specimen</div><h2>Assembling the atlas</h2><div id="loadbar"></div><div id="loadStatus" class="small">Reading anatomical surfaces and human neuron traces…</div><div id="error"></div></div></main><div id="toast"></div>
<div id="cardModal" class="modal" role="dialog" aria-modal="true" aria-label="Evidence and source information"><article class="modalarticle"><button class="close" data-close>Close</button><div class="brand">Evidence record · Version 3.0</div><h2>Anatomy first. Uncertainty visible.</h2><div id="cardContent"></div></article></div>
<div id="exportModal" class="modal" role="dialog" aria-modal="true" aria-label="Export 3D model"><article class="modalarticle"><button class="close" data-close>Close</button><h2>Export the actual 3D geometry</h2><p>GLB preserves meshes, source names and basic physically based materials. Hologram shaders are converted to translucent materials. Visual glow, screen-only thickness assistance, clipping planes and interface labels are not baked into the GLB. Exports retain the full surfaces of the selected visible objects.</p><div class="twocol"><button id="exportScene">Current scene · GLB</button><button id="exportSelected">Selected object · GLB</button><button id="exportSWC">Original human cell · SWC</button><button id="exportManifest">Evidence manifest · JSON</button></div><p class="small">GLB units are meters: millimeters × 0.001; micrometers × 0.000001. Imported anatomy retains its source license; Allen data retains its data-use terms. Exporting does not turn generated membrane surfaces into measured or solver-ready tissue.</p></article></div>
