     for(let j=0;j<14;j++){const a=st+j*2;if(side){outer.tri(a,a+1,a+2);outer.tri(a+1,a+3,a+2);}else{outer.tri(a,a+2,a+1);outer.tri(a+1,a+2,a+3);}}
    }}start+=25;
