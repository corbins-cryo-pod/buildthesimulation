  }
  s.membrane(b,C.motor,{id:201,name:'Connected presynaptic motor-terminal arbor',kind:'motor',source:'Synthetic human-inspired nonlattice arbor; not a traced NMJ',evidence:'One incoming motor axon, connected terminal tree, irregular distal swellings. Separate postsynaptic domains.',terminalGraph:parents});
  s.membrane(post,0xb9c59c,{id:'postsynaptic-patches',name:'Postsynaptic receptor domains',kind:'context',source:'Qualitative nummular patches; dimensions and placement are model assumptions'},'support',1);
  s.membrane(folds,0x728d85,{id:'junctional-folds',name:'Illustrative junctional-fold crests',kind:'context',source:'Visualization details; not resolved human ultrastructure'},'support',.85);
  s.membrane(glia,0x8fa7b2,{id:'terminal-schwann',name:'Partial terminal Schwann membrane',kind:'context',source:'Synthetic conformal coverage'},'support',.22);
  const stripes=new Membrane();for(let z=-87;z<89;z+=2.5){const ps=[];for(let k=0;k<=32;k++){const x=-38+k/32*76;ps.push([x,height(x,z)-.12,z]);}stripes.sweep(ps,.10,Math.floor(z+200),5);}s.membrane(stripes,0xaf8582,{id:'striations',name:'Subsarcolemmal striation cues',kind:'context',source:'Illustrative local muscle context'},'muscle',.37);
  s.label('Presynaptic motor arbor',[-50,70,-30]);s.label('Separate receptor domains',[30,31,15]);s.label('Curved local sarcolemma',[0,18,78]);
 }
 function proprio(s){const tissue=new Membrane(),sens=new Membrane();for(let i=0;i<5;i++){const x=-330+(i-2)*11,ps=[];for(let k=0;k<=55;k++)ps.push([x+1.8*Math.sin(k*.08+i),-450+k*16.4,Math.sin(i)*11]);tissue.sweep(ps,5.5+(i%3),60+i,12);const spiral=[];for(let j=0;j<=340;j++){let a=j/340*TAU*12,y=-150+j/340*300;spiral.push([x+Math.cos(a)*9,y,Math.sin(i)*11+Math.sin(a)*9]);}sens.sweep(spiral,1.1,i+900,7);sens.curve([[-540,-630,0],[-510,-210,0],spiral[0]],2.7,i+771,60,.25,8);}
  const cap=new Membrane();cap.shell([-330,0,0],[67,530,47],261,50,52,.76);s.membrane(cap,0x889eac,{id:'spindle-envelope',name:'Spindle-like capsule',kind:'context'},'skin',.16);s.membrane(tissue,0x8b7779,{id:'intrafusal-context',name:'Intrafusal-fiber context',kind:'context'},'muscle',.35);
  const collagen=new Membrane();for(let i=0;i<30;i++){const p=[245+(i%6)*12,-410,Math.floor(i/6)*13-26];const ps=[];for(let k=0;k<=50;k++)ps.push([p[0]+2.7*Math.sin(k*.3+i),p[1]+k*16,p[2]+1.4*Math.cos(k*.31+i)]);collagen.sweep(ps,1.0+i%3*.15,i+66,7);}
  sens.tree([285,-280,0],[0,1,0],132,2.1,4,43918,false);sens.curve([[548,-620,0],[430,-400,0],[285,-280,0]],3.1,672,65,.30,9);
  s.membrane(collagen,0xafac93,{id:'collagen-context',name:'Tendon-organ collagen context',kind:'context',source:'Synthetic geometry'},'support',.55);
  s.membrane(sens,C.sensory,{id:1301,name:'Proprioceptive comparison endings',kind:'sensory',source:'Synthetic examples outside the glabrous tactile population count'});
  s.label('Spindle-like sensory ending',[-330,602,0]);s.label('Tendon-organ-like arbor',[299,551,0]);
 }
 function build(id,model,quality='high',sourceIndex=0){if(['overview','hand','arm','cervical','brain'].includes(id))return macro(model);const s=new Specimen(id,'µm');if(id==='tip')endings(s,model);if(id==='nerve')nerve(s,model);if(id==='drg')drg(s,model);if(['spinal','medulla','thalamus'].includes(id))circuit(s,id,model);if(id==='cortex')cortex(s,quality);if(id==='cell'){const rec=human[sourceIndex%human.length];addHuman(s,sourceIndex,rec.info.id,[0,0,0],'other',1,0);s.label('Specimen '+rec.info.id,[0,rec.info.bounds[1][1]+65,0]);}if(id==='nmj')nmj(s);if(id==='proprio')proprio(s);return s;}
 return {build,anatomy,human,sourceGeometry,somaPriors,REGIONS,cohort,Specimen};
}
window.ATLAS_GENERATORS={factories,REGIONS,cohort};
})();
</script><script>(async()=>{'use strict';
const {T,V,PALETTE:C,cellColor,posePoint}=window.ATLAS_GEOMETRY;
const {$:unused}= {};
const $=id=>document.getElementById(id);
const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
const errorLog=[];window.addEventListener('error',e=>errorLog.push(e.message));window.addEventListener('unhandledrejection',e=>errorLog.push(String(e.reason)));
function toast(text){$('toast').textContent=text;$('toast').style.display='block';clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('toast').style.display='none',4300);}
function esc(text){return String(text??'').replace(/[&<>"']/g,s=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));}
try{
 const bytes=Uint8Array.from(atob($('packed').textContent.trim()),c=>c.charCodeAt(0));
 const data=JSON.parse(await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).text());$('packed').remove();
 $('loadStatus').textContent='Building curved fibers and positioning the source anatomy…';await new Promise(r=>setTimeout(r,30));
 const maker=window.ATLAS_GENERATORS.factories(data),REGIONS=maker.REGIONS;
 let model=maker.cohort(30),quality='high',current,region=REGIONS[0],macro=null,selected=null,isolated=false,sourceIndex=0;
 const persistentGeometries=new Set();let needsRender=true,lastDraw=0,tween=null,sceneSerial=0,ready=false,drawMs=0;
 const stage=$('stage'),canvas=document.createElement('canvas');canvas.id='viewport';canvas.setAttribute('aria-label','Interactive three-dimensional anatomical viewer');stage.prepend(canvas);
 const renderer=new T.WebGLRenderer({canvas,antialias:true,alpha:false,preserveDrawingBuffer:true,powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));renderer.setClearColor(0x060e16,1);renderer.outputColorSpace=T.SRGBColorSpace;renderer.toneMapping=T.ACESFilmicToneMapping;renderer.toneMappingExposure=1.10;renderer.localClippingEnabled=true;
 const scene=new T.Scene();scene.background=new T.Color(0x060e16);
 const camera=new T.PerspectiveCamera(35,1,.03,12000);const controls=new T.OrbitControls(camera,canvas);controls.enableDamping=true;controls.dampingFactor=.11;controls.screenSpacePanning=true;controls.minDistance=.5;controls.maxDistance=10000;controls.enablePan=true;controls.autoRotateSpeed=.4;
 controls.addEventListener('change',()=>{needsRender=true;});
 function lights(sc){const hemi=new T.HemisphereLight(0xcbdde9,0x142236,1.1);sc.add(hemi);let key=new T.DirectionalLight(0xe6f3ff,2.15);key.position.set(-450,600,900);sc.add(key);let fill=new T.DirectionalLight(0x96ccdc,1.1);fill.position.set(500,90,-500);sc.add(fill);let rim=new T.DirectionalLight(0xffd3ae,.8);rim.position.set(-150,-100,-650);sc.add(rim);}
 lights(scene);
 const composer=new T.EffectComposer(renderer,new T.WebGLRenderTarget(800,600,{samples:4,type:T.HalfFloatType}));const renderPass=new T.RenderPass(scene,camera);composer.addPass(renderPass);
 const ssao=new T.SSAOPass(scene,camera,800,600);ssao.kernelRadius=9;ssao.minDistance=.001;ssao.maxDistance=.04;ssao.enabled=false;composer.addPass(ssao);
 const bloom=new T.UnrealBloomPass(new T.Vector2(800,600),.27,.48,.72);composer.addPass(bloom);composer.addPass(new T.OutputPass());
 const miniScene=new T.Scene();miniScene.background=new T.Color(0x08141e);lights(miniScene);const miniCamera=new T.PerspectiveCamera(35,160/125,1,8000);
 const clipPlane=new T.Plane(V(0,0,-1),1e9);
 const paddingUniforms=new WeakMap();
 function readableMaterial(mesh){if(mesh.userData.layer!=='neural'||paddingUniforms.has(mesh))return;const u={value:0};paddingUniforms.set(mesh,u);mesh.material.onBeforeCompile=shader=>{shader.uniforms.uAtlasPadding=u;shader.vertexShader='uniform float uAtlasPadding;\n'+shader.vertexShader.replace('#include <begin_vertex>','#include <begin_vertex>\n transformed += normalize(normal) * uAtlasPadding;');};mesh.material.customProgramCacheKey=()=> 'atlas-readable-v3';mesh.material.needsUpdate=true;}
 const raycaster=new T.Raycaster(),pointer=new T.Vector2();let pointerDown=null,labelNodes=[];
 function ghostMaterial(mesh){if(mesh.userData.layer!=='skin'||mesh.userData.ghost)return;mesh.userData.ghost=true;const m=mesh.material;m.side=['tip-skin','dermal-hologram'].includes(mesh.userData.id)?T.DoubleSide:T.FrontSide;m.transparent=true;m.depthWrite=false;m.onBeforeCompile=shader=>{shader.fragmentShader=shader.fragmentShader.replace('#include <opaque_fragment>',`float ghostRim = pow(1.0 - abs(dot(normalize(normal), normalize(vViewPosition))), 1.65);\n diffuseColor.a *= 0.24 + 0.76 * ghostRim;\n outgoingLight *= 0.75 + 0.7 * ghostRim;\n #include <opaque_fragment>`);};m.customProgramCacheKey=()=> 'atlas-ghost-v3';m.needsUpdate=true;}
 function retainShared(){for(const a of maker.anatomy.values())if(a.geometry)persistentGeometries.add(a.geometry);for(const a of maker.human){if(a.geometry)persistentGeometries.add(a.geometry);if(a.fine)persistentGeometries.add(a.fine);}for(const a of maker.somaPriors)persistentGeometries.add(a.geometry);}
 function disposeSpecimen(s){if(!s||s===macro)return;for(const o of s.entries){if(!persistentGeometries.has(o.geometry))o.geometry.dispose();o.material.dispose();}s.group.clear();}
 function resize(){const w=Math.max(1,stage.clientWidth),h=Math.max(1,stage.clientHeight);renderer.setSize(w,h,false);composer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();window.atlasUI?.layout();needsRender=true;}
 new ResizeObserver(resize).observe(stage);window.addEventListener('resize',resize);
 function sceneCenter(r){if(r.id==='overview'&&!window.ATLAS_POSE_EXTENDED)return V(-45,-100,0);return r.native?V(posePoint(r.native)):V(r.center);}
 function cameraFrame(r,animate=true){animate=animate&&!reducedMotion;let center=sceneCenter(r),offset=V(r.camera);if(r.id==='overview'&&!window.ATLAS_POSE_EXTENDED)offset=V(240,72,1760);if(r.id==='cell'){const b=new T.Box3().setFromObject(current.group);center=b.getCenter(V());const size=b.getSize(V());offset=V(size.x*.12,size.y*.07,Math.max(size.x,size.y)*1.9);}
  // Maintain intended framing on portrait screens without distorting physical geometry.
  if(camera.aspect<1.25)offset.multiplyScalar(1.25/Math.max(camera.aspect,.45));
  if(animate)tween={start:performance.now(),duration:780,from:camera.position.clone(),to:center.clone().add(offset),targetFrom:controls.target.clone(),targetTo:center};
  else{controls.target.copy(center);camera.position.copy(center).add(offset);controls.update();}
  camera.near=Math.max(.003,r.unit==='mm'?.15:.1);camera.far=20000;camera.updateProjectionMatrix();needsRender=true;
 }
 function labelBuild(){const l=$('labels');l.replaceChildren();labelNodes=[];for(const item of current.labels){const el=document.createElement(item.target?'button':'div');el.className='label'+(item.target?' hotspot':'');el.textContent=item.text;if(item.target){el.title='Inspect '+item.text;el.onclick=()=>setRegion(item.target);}l.appendChild(el);labelNodes.push({el,p:V(item.p),item});}}
 function labelsUpdate(){const w=stage.clientWidth,h=stage.clientHeight,vis=$('labelToggle').checked;for(const {el,p,item} of labelNodes){if(!vis||isolated){el.style.display='none';continue;}const q=p.clone().project(camera);const x=(q.x*.5+.5)*w,y=(-q.y*.5+.5)*h;
   const inInfo=w>760&&x>w-267&&y<390&&!document.body.classList.contains('hide-info');const inTitle=y<130&&x<620;
   el.style.display=q.z<1&&q.z>-1&&x>15&&x<w-20&&y>18&&y<h-52&&!inInfo&&!inTitle?'block':'none';el.style.left=x+'px';el.style.top=y+'px';}}
 function selectedObjects(){return current.entries.filter(m=>String(m.userData.id)===String(selected));}
 function optionsUpdate(){const sel=$('cellSelect');sel.replaceChildren();if(region.id==='cell'){
   maker.human.forEach((m,i)=>{const opt=document.createElement('option');opt.value='source:'+i;opt.textContent=`${m.info.id} · ${m.info.metadata.structure__acronym} · ${m.info.metadata.tag__dendrite_type}`;sel.appendChild(opt);});sel.value='source:'+sourceIndex;return;}
  const blank=document.createElement('option');blank.value='';blank.textContent='Inspect a cell or source structure…';sel.appendChild(blank);const used=new Set();
  current.entries.forEach(m=>{const d=m.userData;if(used.has(String(d.id)))return;used.add(String(d.id));const op=document.createElement('option');op.value=String(d.id);op.textContent=(typeof d.id==='number'?`#${d.id} · `:'')+d.name;sel.appendChild(op);});sel.value=selected!=null?String(selected):'';
 }
 function inspector(){let selectedEntry=selectedObjects()[0];const d=selectedEntry?.userData;
  $('infoHeading').textContent=d?'Selected object':'Specimen information';$('evidenceTags').innerHTML=d?`<span class="tag${d.atlas||d.sourceId?'':' synthetic'}">${d.modeledFineDetail?'MODELED MICRODETAIL':d.atlas?'ATLAS SURFACE':d.sourceId?'HUMAN SOURCE TRACE':'MODELED STRUCTURE'}</span>`:`<span class="tag">${esc(region.evidence)}</span>`;
  $('selectedTitle').textContent=d?d.name:region.name;$('description').textContent=d?(d.evidence||d.source||SOURCE_FALLBACK):region.description;
  const items=[];if(d){if(d.id!=null)items.push(['Object ID',d.id]);if(d.sourceId)items.push(['Source ID',d.sourceId]);if(d.sourceRegion)items.push(['Source region',d.sourceRegion]);if(d.sourceLayer)items.push(['Source layer',d.sourceLayer]);if(d.sourceSpecies)items.push(['Species',d.sourceSpecies]);if(d.rawNodes)items.push(['Original trace nodes',d.rawNodes.toLocaleString()]);if(d.branches)items.push(['Display branches',d.branches]);if(d.bifurcations)items.push(['Source bifurcations',d.bifurcations]);if(d.fiberDiameter)items.push(['Outer fiber diameter',d.fiberDiameter.toFixed(2)+' µm']);if(d.axonDiameter)items.push(['Inner axon diameter',d.axonDiameter.toFixed(2)+' µm']);if(d.placement)items.push(['Placement',d.placement]);}
  else{items.push(['Coordinates',region.unit==='mm'?'Shared atlas-rest millimeters':'Linked specimen · micrometers']);if(region.id==='cortex')items.push(['Source-based instances',current.cellInstanceCount]);if(region.id==='nerve')items.push(['Extra context fragments',current.contextFragments]);items.push(['Tactile sample',`${model.n} primary afferents (1:${model.denominator})`]);}
  $('details').innerHTML=items.map(([a,b])=>`<div><span style="color:#738d9d">${esc(a)}</span> &nbsp; ${esc(b)}</div>`).join('');
  $('provenance').textContent=d?.sourceId&&!d.atlas?'Source region and ID are retained. This is a generated membrane around a measured bright-field tree, not an EM reconstruction.':d?.atlas?'BodyParts3D v3.0 source surface; cropped/decimated for display in atlas-rest coordinates. Not this person’s MRI or a biomechanics result.':region.notice;
  $('isolate').textContent=isolated?'Show all':'Isolate object';$('focus').disabled=!d;$('isolate').disabled=!d;
 }
 const SOURCE_FALLBACK='Synthetic educational geometry; anatomical source/assumption labels are available in the model card.';
 function clippingUpdate(){const active=$('clipToggle').checked;const forward=V();camera.getWorldDirection(forward);const dist=camera.position.distanceTo(controls.target),range=region.span||1000;const at=controls.target.clone().addScaledVector(forward,($('clip').value/100-.5)*range);clipPlane.setFromNormalAndCoplanarPoint(forward.clone().negate(),at);renderer.clippingPlanes=active?[clipPlane]:[];needsRender=true;}
 function applyState(){const colorMode=$('colorMode').value==='auto'?(['cortex','drg','spinal','medulla','thalamus','cell'].includes(region.id)?'cell':'pathway'):$('colorMode').value,filter=$('filter').value,skin=$('skinToggle').checked,support=$('supportToggle').checked,bones=$('bonesToggle').checked,muscle=$('muscleToggle').checked;
  for(const mesh of current.entries){const d=mesh.userData,associated=d.layer==='neural'||(d.layer==='support'&&typeof d.id==='number');let show=true;
   if(d.layer==='contextNerve')show=$('contextToggle').checked;if(d.layer==='cortex')show=$('brainToggle').checked;if(d.layer==='skin')show=skin;if(d.layer==='support')show=support;if(d.layer==='bone')show=bones;if(d.layer==='muscle')show=muscle;
   if(associated&&filter!=='all'&&d.kind!==filter)show=false;if(d.modeledFineDetail)show=show&&$('fineToggle').checked;
   if(isolated&&String(d.id)!==String(selected))show=false;mesh.visible=show;
   if(d.layer==='neural'&&colorMode==='cell'&&typeof d.id==='number')mesh.material.color.copy(cellColor(d.id));else mesh.material.color.set(d.baseColor);
   mesh.material.emissive.copy(mesh.material.color);mesh.material.emissiveIntensity=d.layer==='neural'?.07:.014;
   if(String(d.id)===String(selected)&&selected!=null){mesh.material.emissiveIntensity=.42;mesh.material.roughness=.36;}else mesh.material.roughness=.52;
   mesh.material.opacity=d.baseOpacity*(d.layer==='skin'?Number($('skinOpacity').value)/24:1);mesh.material.opacity=Math.min(.88,mesh.material.opacity);
   if(d.baseOpacity>=.99&&d.layer!=='skin')mesh.material.opacity=1;
   if(associated&&selected!=null&&!isolated&&String(d.id)!==String(selected)){
    mesh.material.opacity*=.16;mesh.material.transparent=true;mesh.material.depthWrite=false;mesh.material.emissiveIntensity=.005;
   }else if(associated){mesh.material.transparent=mesh.material.opacity<.99;mesh.material.depthWrite=mesh.material.opacity>=.99;}
   ghostMaterial(mesh);readableMaterial(mesh);
  }
  bloom.enabled=$('glowToggle').checked;ssao.enabled=$('aoToggle').checked;controls.autoRotate=$('rotateToggle').checked;
  $('sampleNote').textContent=`${model.n} afferents · area assumptions retained`;clippingUpdate();inspector();updateStats();needsRender=true;
 }
 function updateStats(){let tr=0,v=0;const ids=new Set();for(const m of current.entries)if(m.visible){tr+=(m.geometry.index?m.geometry.index.count:m.geometry.attributes.position.count)/3;v+=m.geometry.attributes.position.count;if(typeof m.userData.id==='number'&&m.userData.layer==='neural')ids.add(m.userData.id);}
  $('stats').textContent=`${tr.toLocaleString()} visible triangles · ${ids.size} identified neural objects`;$('scaleNotice').textContent=region.notice;return{triangles:tr,vertices:v,neuralObjects:ids.size};
 }
 async function setRegion(id,opts={}){
  const next=REGIONS.find(r=>r.id===id);if(!next)throw new Error('Unknown region '+id);const serial=++sceneSerial;ready=false;document.body.dataset.loading='true';window.atlasUI?.beforeRegion(id,opts);$('loadStatus').textContent='Preparing '+next.name.toLowerCase()+'…';if(!macro)$('loader').style.display='flex';else $('opening').classList.add('show');await new Promise(r=>setTimeout(r,25));
  if(serial!==sceneSerial)return {cancelled:true};const previous=current;region=next;const isMacro=region.group==='Anatomical scale';document.body.dataset.region=id;document.body.dataset.scale=isMacro?'macro':'micro';
  if(isMacro){if(!macro){macro=maker.build('overview',model,quality);retainShared();}current=macro;}
  else{current=maker.build(id,model,quality,sourceIndex);retainShared();}
  if(serial!==sceneSerial)return {cancelled:true};scene.children.filter(x=>x.userData.specimen).forEach(o=>scene.remove(o));
  if(previous&&previous!==current&&previous!==macro){scene.remove(previous.group);disposeSpecimen(previous);}
  if(macro?.group.parent===miniScene)miniScene.remove(macro.group);
  current.group.userData.specimen=true;scene.add(current.group);
  if(isolated)isolated=false;if(region.id==='cell')selected=maker.human[sourceIndex].info.id;
  $('muscleToggle').checked=['nmj','proprio'].includes(id);
  document.querySelectorAll('.navbutton').forEach(b=>b.classList.toggle('active',b.dataset.region===id));
  $('sceneTitle').textContent=region.title;$('eyebrow').textContent=(isMacro?'Anatomical scaffold':'Cellular inspection').toUpperCase()+' / '+region.unit;$('subtitle').textContent=region.id==='overview'?'Source-based anatomy. Reconstructed human cell trees. Explicitly modeled pathways.':region.evidence;
  $('previewGrid').style.display=id==='overview'?'grid':'none';$('bonesToggle').disabled=!isMacro;optionsUpdate();labelBuild();applyState();resize();cameraFrame(region,opts.animate!==false&&lastDraw>0);
  $('loader').style.display='none';$('opening').classList.remove('show');document.body.dataset.loading='false';$('side').classList.remove('open');ready=true;needsRender=true;
  if(!isMacro&&macro){miniScene.add(macro.group);macro.group.visible=true;configureMini();}
  window.atlasUI?.afterRegion(opts);
  return {region:id,...updateStats()};
 }
 function configureMini(){const ctx=REGIONS.find(r=>r.id===region.context)||REGIONS[0],center=sceneCenter(ctx),off=ctx.id==='overview'?V(0,150,1500):V(ctx.camera).multiplyScalar(1.5);miniCamera.position.copy(center).add(off);miniCamera.lookAt(center);miniCamera.updateProjectionMatrix();}
 function select(id){selected=id;isolated=false;optionsUpdate();applyState();window.atlasUI?.selectionChanged(id);}
 function focusSelection(){const objects=selectedObjects();if(!objects.length)return;const box=new T.Box3();for(const o of objects){box.union(new T.Box3().setFromObject(o));}const center=box.getCenter(V()),size=box.getSize(V()),d=Math.max(size.x,size.y,size.z)*1.75;let dir=camera.position.clone().sub(controls.target).normalize();tween={start:performance.now(),duration:reducedMotion?1:680,from:camera.position.clone(),to:center.clone().addScaledVector(dir,Math.max(d,region.unit==='mm'?20:35)),targetFrom:controls.target.clone(),targetTo:center};needsRender=true;}
 function pick(event,focus=false){const rect=canvas.getBoundingClientRect();pointer.set((event.clientX-rect.left)/rect.width*2-1,-(event.clientY-rect.top)/rect.height*2+1);raycaster.setFromCamera(pointer,camera);const objects=current.entries.filter(o=>o.visible&&o.userData.layer==='neural');let hits=raycaster.intersectObjects(objects,false);if(!hits.length)hits=raycaster.intersectObjects(current.entries.filter(o=>o.visible&&o.userData.layer!=='skin'),false);if(hits.length){select(hits[0].object.userData.id);if(focus)focusSelection();}}
 canvas.addEventListener('pointerdown',e=>{pointerDown={x:e.clientX,y:e.clientY,time:performance.now()};if(e.shiftKey)controls.mouseButtons.LEFT=T.MOUSE.PAN;else controls.mouseButtons.LEFT=T.MOUSE.ROTATE;});
 canvas.addEventListener('pointerup',e=>{if(pointerDown&&Math.hypot(e.clientX-pointerDown.x,e.clientY-pointerDown.y)<5&&performance.now()-pointerDown.time<450)pick(e);pointerDown=null;});canvas.addEventListener('dblclick',e=>pick(e,true));
 $('cellSelect').onchange=async()=>{const val=$('cellSelect').value;if(val.startsWith('source:')){sourceIndex=+val.split(':')[1];await setRegion('cell',{animate:false});}else select(val||null);};
 $('focus').onclick=focusSelection;$('isolate').onclick=()=>{if(selected==null)return;isolated=!isolated;applyState();};$('clearSelection').onclick=()=>{selected=null;isolated=false;optionsUpdate();applyState();window.atlasUI?.selectionChanged(null);};$('home').onclick=()=>setRegion('overview');$('reset').onclick=()=>{isolated=false;cameraFrame(region);applyState();};$('infoToggle').onclick=()=>{document.body.classList.toggle('hide-info');window.atlasUI?.layout();needsRender=true;};$('showSide').onclick=()=>$('side').classList.toggle('open');
 for(const id of ['contextToggle','skinToggle','brainToggle','supportToggle','fineToggle','bonesToggle','muscleToggle','labelToggle','filter','colorMode','glowToggle','caliberToggle','aoToggle','clipToggle','rotateToggle'])$(id).onchange=applyState;
 $('skinOpacity').oninput=applyState;$('clip').oninput=clippingUpdate;
 $('pose').onchange=async()=>{window.ATLAS_POSE_EXTENDED=false;if(macro){macro.group.parent?.remove(macro.group);macro=null;}await setRegion(region.id,{animate:false});};
 $('sampling').onchange=async()=>{model=maker.cohort(+$('sampling').value);const old=macro;if(old){old.group.parent?.remove(old.group);macro=null;for(const m of old.entries){if(!persistentGeometries.has(m.geometry))m.geometry.dispose();m.material.dispose();}old.group.clear();}await setRegion(region.id,{animate:false});};
 $('quality').onchange=async()=>{quality=$('quality').value;renderer.setPixelRatio(quality==='low'?1:Math.min(devicePixelRatio,1.5));await setRegion(region.id,{animate:false});};
 $('cinema').onclick=()=>{document.body.classList.toggle('cinema');resize();window.atlasUI?.layout();toast('Press Escape to leave presentation mode.');};
 window.addEventListener('keydown',e=>{if(e.key==='Escape'){document.body.classList.remove('cinema');window.atlasUI?.layout();document.querySelectorAll('.modal').forEach(m=>m.classList.remove('open'));resize();}});
 $('capture').onclick=()=>{draw();const a=document.createElement('a');a.href=renderer.domElement.toDataURL('image/png');a.download=`Finger_Atlas_v3_${region.id}.png`;a.click();toast('3D viewport snapshot saved; interface labels are not included.');};
 let lastGroup='';REGIONS.forEach((r,i)=>{if(r.group!==lastGroup){const h=document.createElement('h3');h.textContent=r.group;$('navigation').appendChild(h);lastGroup=r.group;}const b=document.createElement('button');b.className='navbutton';b.dataset.region=r.id;b.innerHTML=`<span>${String(i+1).padStart(2,'0')}</span>${esc(r.name)}`;b.onclick=()=>setRegion(r.id);$('navigation').appendChild(b);});
 function scaleUpdate(){const distance=camera.position.distanceTo(controls.target),unitsPerPx=2*distance*Math.tan(camera.fov*Math.PI/360)/stage.clientHeight,target=110*unitsPerPx,power=10**Math.floor(Math.log10(target));let val=[1,2,5,10].map(x=>x*power).filter(x=>x<=target).at(-1)||power;const px=val/unitsPerPx;$('scale').style.width=px+'px';$('scalewrap').style.width=px+'px';$('scaleText').textContent=(val<.01?val.toExponential(1):Number(val.toPrecision(3)))+' '+region.unit;}
 function draw(){if(!current)return;const start=performance.now();const unitsPerPixel=2*camera.position.distanceTo(controls.target)*Math.tan(camera.fov*Math.PI/360)/stage.clientHeight;for(const m of current.entries){const u=paddingUniforms.get(m);if(u)u.value=$('caliberToggle').checked?Math.min(region.unit==='mm'?.12:.42,unitsPerPixel*.27)/Math.max(.1,m.scale.x):0;}renderer.setViewport(0,0,stage.clientWidth,stage.clientHeight);renderer.setScissorTest(false);composer.render();
  const miniVisible=region.group==='Cellular scale'&&macro&&stage.clientWidth>1000&&!document.body.classList.contains('cinema');$('contextMini').style.display=miniVisible?'block':'none';if(miniVisible){const w=158,h=123,x=stage.clientWidth-178,y=84;renderer.setScissorTest(true);renderer.setScissor(x,y,w,h);renderer.setViewport(x,y,w,h);renderer.clearDepth();const oldClip=renderer.clippingPlanes;renderer.clippingPlanes=[];renderer.render(miniScene,miniCamera);renderer.clippingPlanes=oldClip;renderer.setScissorTest(false);renderer.setViewport(0,0,stage.clientWidth,stage.clientHeight);}
  labelsUpdate();scaleUpdate();window.atlasUI?.afterDraw();drawMs=performance.now()-start;lastDraw=performance.now();$('fps').textContent=$('caliberToggle').checked?'Screen-only neurite visibility aid · scale at focal plane':'Native membrane radii · scale at focal plane';needsRender=false;
 }
 function loop(){requestAnimationFrame(loop);if(!ready)return;if(tween){let t=Math.min(1,(performance.now()-tween.start)/tween.duration);t=t*t*(3-2*t);camera.position.lerpVectors(tween.from,tween.to,t);controls.target.lerpVectors(tween.targetFrom,tween.targetTo,t);needsRender=true;if(t>=1)tween=null;}if(controls.update())needsRender=true;if(controls.autoRotate)needsRender=true;if(needsRender){if($('clipToggle').checked)clippingUpdate();draw();}}
 const licenseLinks={atlas:'https://lifesciencedb.jp/bp3d/info_en/license/index.html',mirror:'https://github.com/Kevin-Mattheus-Moerman/BodyParts3D',allen:'https://brain-map.org/support/documentation/cell-types-database-api',terms:'https://alleninstitute.org/legal/terms-of-use'};
 function modelCard(){return `<h3>What is genuinely sourced</h3><p><strong>${data.meshes.length} anatomical meshes</strong> come from BodyParts3D v3.0 via the Kevin-Mattheus-Moerman STL conversion. This includes the actual skin, arm/hand bones, cortical gyri, pons, medulla, cerebellum and thalami. The skin was cropped and converted to a source-derived outer envelope, with mild smoothing. Other meshes were decimated. All use the source atlas-rest pose; there is no anatomical limb deformation.</p><p><strong>${data.morphologies.length} human neuron reconstructions</strong> come from the Allen Cell Types Database. Their branching trees and sampled radii are measured bright-field traces. The visible membrane is reconstructed mathematically around those traces; it is not measured membrane ultrastructure. The original SWC files, source IDs, species, regions and hashes remain available.</p><h3>What is deliberately modeled</h3><p>The long-range neural routes, rootlets, spinal-cord and ganglion envelopes, noncortical cells, synaptic topology, receptors, myelin packing, motor endings and proprioceptor examples are synthetic. Their class-specific anatomy is represented, but their geometry and population distribution are not experimentally validated. The cortex comparison tiles reuse temporal/frontal source cells in a constructed arrangement; these are not measured finger S1/M1 cells.</p><h3>Reduction is not a full nervous-system census</h3><p>Assuming 3 cm² of fingertip and 9 cm² of remaining glabrous index skin gives <code>3 × 241 + 9 × 92.8 = 1558.2</code> tactile afferent units. This produces 78 / 52 / 39 rendered afferents at 1:20 / 1:30 / 1:40. The areas and subtype mix are assumptions. The reduction does not apply to central neurons, other sensory modalities, glia or context fragments.</p><p>The fiber prior uses coarse visual bin weights from the large-fiber portion of Johansson & Vallbo's median-nerve histogram, not a digitized raw dataset or a measured index-only fascicle. Outer fiber diameter and inner axon diameter are distinguished; a g-ratio of 0.66 is assumed. Fascicle packing and internodal patterns remain procedural.</p><h3>Coordinates and interpretation</h3><p>Macro anatomy uses millimeters. Cellular windows use micrometers and are linked inspection specimens, not one seamless measured connectome. Macro fiber radii are exaggerated so they can be seen. Skin and support surfaces are separate layers. The scale bar applies to the camera target plane. An optional screen-only normal offset keeps subpixel neurites visible without modifying exported radii. Optional reduced spines/boutons are modeled decorations anchored to the source tree, not measured SWC features. There is no electrical, recording, stimulation, mechanical or conduction-time solver here. The model is not for medical or surgical planning.</p><h3>Sources and reuse</h3><p><a href="${licenseLinks.atlas}" target="_blank" rel="noopener">BodyParts3D, © The Database Center for Life Science</a> — the v3 mirror's CC BY-SA 2.1 Japan notice is preserved with the derived mesh data. <a href="${licenseLinks.mirror}" target="_blank" rel="noopener">STL conversion source</a>. <a href="${licenseLinks.allen}" target="_blank" rel="noopener">Allen Cell Types Database</a> — use requires compliance with the <a href="${licenseLinks.terms}" target="_blank" rel="noopener">Allen Institute terms and citation policy</a>; this package is intended for noncommercial research/education, not a claim of unrestricted redistribution or commercial rights. Three.js is MIT licensed.</p><p><a href="https://pubmed.ncbi.nlm.nih.gov/439026/" target="_blank" rel="noopener">Johansson & Vallbo 1979</a>; <a href="https://www.cns.nyu.edu/~david/courses/sm12/Readings/Johansson1983.pdf" target="_blank" rel="noopener">1983 review</a>; <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC1167184/" target="_blank" rel="noopener">human Meissner reconstruction</a>; <a href="https://pubmed.ncbi.nlm.nih.gov/29186674/" target="_blank" rel="noopener">human NMJ anatomy</a>; <a href="https://nba.uth.tmc.edu/neuroscience/m/s2/chapter04.html" target="_blank" rel="noopener">somatosensory pathway reference</a>.</p><h3>Verification scope</h3><p>Software tests check geometry, file integrity, source metadata, controls and exports. They do not establish biological validation. Branch surfaces may overlap at some distal junctions; the exported meshes are visualization assets, not watertight finite-element models.</p>`;}
 $('cardContent').innerHTML=modelCard();const previews=JSON.parse($('previews').textContent||'{}');for(const [id,uri] of Object.entries(previews)){const r=REGIONS.find(r=>r.id===id);if(!r)continue;const b=document.createElement('button');b.dataset.specimen=id;b.innerHTML=`<img alt="Actual 3D viewport preview: ${esc(r.name)}" src="${uri}"><div class="caption">${esc(r.name)}<span>Open 3D specimen</span></div>`;b.onclick=()=>setRegion(id);$('previewGrid').appendChild(b);}$('modelCard').onclick=()=>$('cardModal').classList.add('open');$('export').onclick=()=>$('exportModal').classList.add('open');document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>b.closest('.modal').classList.remove('open'));document.querySelectorAll('.modal').forEach(m=>m.onclick=e=>{if(e.target===m)m.classList.remove('open');});
 function download(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),12000);}
 async function exportGLB(onlySelected=false){if(onlySelected&&!selectedObjects().length){toast('Select an object first.');return null;}toast('Assembling the GLB meshes…');await new Promise(r=>setTimeout(r,50));const group=new T.Group();group.name=`Finger_Pathway_Atlas_v3_${region.id}`;group.userData={version:'3.0.0',unit:'meter',sourceUnit:region.unit,evidence:data.evidence,notes:region.notice};const originals=onlySelected?selectedObjects().filter(m=>m.visible):current.entries.filter(m=>m.visible);
  for(const src of originals){const mesh=src.clone();mesh.material=src.material.clone();mesh.material.onBeforeCompile=()=>{};mesh.material.opacity=src.userData.baseOpacity;mesh.material.transparent=mesh.material.opacity<.99;mesh.material.depthWrite=!mesh.material.transparent;mesh.material.emissiveIntensity=.10;mesh.visible=true;group.add(mesh);}
  group.scale.setScalar(region.unit==='mm'?.001:.000001);group.updateMatrixWorld(true);const exporter=new T.GLTFExporter();const result=await exporter.parseAsync(group,{binary:true,onlyVisible:true,trs:false,includeCustomExtensions:false});for(const m of group.children)m.material.dispose();download(new Blob([result],{type:'model/gltf-binary'}),`Finger_Atlas_v3_${region.id}${onlySelected?'_selected':''}.glb`);toast('Actual 3D geometry exported.');return {bytes:result.byteLength,objects:originals.length,units:'meter'};
 }
 function manifest(){return{version:'3.0.0',generatedAt:new Date().toISOString(),region:region.id,sceneUnits:region.unit,calibration:model.calibration,sourceMeshes:data.meshes.map(({id,name,source,sourceCommit,sha256,nv,nf,license,derived})=>({id,name,source,sourceCommit,sha256,nv,nf,license,derived})),humanMorphologies:data.morphologies.map(({id,metadata,source,sha256,nodes,bifurcations,provenance})=>({id,metadata,source,sha256,nodes,bifurcations,provenance})),displayObjects:current.entries.filter(m=>m.visible).map(m=>({name:m.name,...m.userData,translation:m.position.toArray(),scale:m.scale.toArray(),rotation:m.rotation.toArray().slice(0,3)})),evidence:data.evidence,routes:macro?.paths||[],limitations:['No measured end-to-end connectome','S1/M1 comparison placement is synthetic; donor source regions retained','No electrophysiology or biomechanics','Some neurite branch membranes overlap; not FEM-ready','Macro calibers exaggerated','Micro-scenes are local comparative windows']};}
 $('exportScene').onclick=()=>exportGLB(false).catch(e=>{errorLog.push(String(e));toast('Export failed: '+e.message);});$('exportSelected').onclick=()=>exportGLB(true).catch(e=>toast(e.message));$('exportManifest').onclick=()=>download(new Blob([JSON.stringify(manifest(),null,2)],{type:'application/json'}),'Finger_Atlas_v3_manifest.json');$('exportSWC').onclick=()=>{const d=selectedObjects()[0]?.userData;const rec=data.morphologies.find(m=>m.id===d?.sourceId)||(region.id==='cell'?data.morphologies[sourceIndex]:null);if(!rec){toast('Choose a source-based cortical cell or open the single-cell library.');return;}download(new Blob([rec.swc],{type:'text/plain'}),`Allen_human_${rec.id}_original.swc`);};
 async function thumbnail(){const box=new T.Box3();for(const m of current.entries)if(m.visible&&m.userData.layer!=='skin')box.union(new T.Box3().setFromObject(m));const center=box.getCenter(V()),size=box.getSize(V());const cam=new T.PerspectiveCamera(34,320/230,.05,20000),direction=camera.position.clone().sub(controls.target).normalize();const right=V().crossVectors(V(0,1,0),direction).normalize(),up=V().crossVectors(direction,right).normalize();let maxX=0,maxY=0,maxD=0;for(let x of [-.5,.5])for(let y of [-.5,.5])for(let z of [-.5,.5]){const d=V(size.x*x,size.y*y,size.z*z);maxX=Math.max(maxX,Math.abs(d.dot(right)));maxY=Math.max(maxY,Math.abs(d.dot(up)));maxD=Math.max(maxD,Math.abs(d.dot(direction)));}const dist=(Math.max(maxY/Math.tan(17*Math.PI/180),maxX/(320/230)/Math.tan(17*Math.PI/180))+maxD)*1.09;cam.position.copy(center).addScaledVector(direction,dist);cam.lookAt(center);const target=new T.WebGLRenderTarget(320,230,{samples:4});target.texture.colorSpace=T.SRGBColorSpace;const oldPadding=[];for(const m of current.entries){const u=paddingUniforms.get(m);if(u){oldPadding.push([u,u.value]);u.value=Math.min(region.unit==='mm'?.45:3.0,dist*2*Math.tan(17*Math.PI/180)/230*.45)/(m.scale.x||1);}}const old=renderer.getRenderTarget(),oldclip=renderer.clippingPlanes;renderer.setRenderTarget(target);renderer.setScissorTest(false);renderer.setViewport(0,0,320,230);renderer.clippingPlanes=[];renderer.render(scene,cam);const pixels=new Uint8Array(320*230*4);renderer.readRenderTargetPixels(target,0,0,320,230,pixels);renderer.setRenderTarget(old);renderer.clippingPlanes=oldclip;target.dispose();oldPadding.forEach(([u,value])=>u.value=value);const canvas=document.createElement('canvas');canvas.width=320;canvas.height=230;const ctx=canvas.getContext('2d'),image=ctx.createImageData(320,230);for(let y=0;y<230;y++)image.data.set(pixels.subarray((229-y)*320*4,(230-y)*320*4),y*320*4);ctx.putImageData(image,0,0);needsRender=true;return canvas.toDataURL('image/png');}
 window.atlas={applyState,invalidate:()=>{needsRender=true;},cameraFrame,controls,miniCamera,miniScene,scene,resize,thumbnail,version:'3.0.0',setRegion,select,focusSelection,exportGLB,manifest,draw,errors:errorLog,get ready(){return ready;},get current(){return current;},get camera(){return camera;},get renderer(){return renderer;},get macro(){return macro;},get maker(){return maker;},get model(){return model;},get region(){return region;},get data(){return data;},getState(){return{region:region.id,ready,unit:region.unit,selected,isolated,quality,sourceMeshes:data.meshes.length,humanSources:data.morphologies.length,tactileCount:model.n,drawMs,...updateStats()};},async sourceCell(i){sourceIndex=i%maker.human.length;return setRegion('cell',{animate:false});},validateGeometry(){let bad=[];for(const m of current.entries){const pos=m.geometry.attributes.position.array;for(let i=0;i<pos.length;i++)if(!Number.isFinite(pos[i])){bad.push(m.name);break;}const inds=m.geometry.index?.array;if(inds)for(let i=0;i<inds.length;i++)if(inds[i]>=pos.length/3){bad.push(m.name+' index');break;}}return{valid:bad.length===0,bad,objects:current.entries.length};}};
 resize();await setRegion('overview',{animate:false});requestAnimationFrame(loop);$('loadStatus').textContent='Ready';
}catch(e){console.error(e);$('error').textContent='The 3D viewer could not start.\n'+e.message+'\nUse a current desktop browser with WebGL 2 enabled.';$('loadStatus').textContent='Initialization failed';}
})();
</script><script>/* Atlas-wide presentation, anatomical navigation and guided routes.
 * This module links explicitly local specimens. It does not register their
 * microscopic coordinates to the body or calculate physiological propagation.
 */
(()=>{'use strict';
 const $=id=>document.getElementById(id),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const wait=setInterval(()=>{if(window.atlas?.ready){clearInterval(wait);install(window.atlas);}},60);
 function install(A){
  const {T,V}=window.ATLAS_GEOMETRY,stage=$('stage');
  const specimens=[['tip','01','Sensory endings','Modeled end organs'],['nerve','02','Peripheral nerve','Myelin · axoplasm · fascicles'],['drg','03','Sensory ganglion','Pseudounipolar cells'],['spinal','04','Cervical section','Dorsal / ventral circuitry'],['cortex','05','Human cortical tissue','10 source reconstructions'],['nmj','06','Motor endplate','At a forearm muscle']];
  let guide=null,guideStep=0,guideBusy=false,savedFilter='all',lines=[],board=false;
  const primary=()=>A.model.cells.find(c=>c.subtype==='meissner')?.id||1;
  const routes={
   sensory:[
    ['overview','From the fingertip to the other hemisphere','Follow the selected right-index tactile route. The body is a shared anatomical scaffold; the cellular windows are separate inspection specimens.',null],
    ['tip','Touch begins at a specialized ending','This Meissner-associated ending belongs to one primary sensory neuron. Support membranes are not additional sensory neurons. Its modeled identity is retained in the next windows.',primary],
    ['nerve','The same afferent, inside a nerve','The selected axon is surrounded by its myelin and neighboring fiber excerpts. The four fascicles sit inside one windowed epineurial sleeve.',primary],
    ['drg','A soma beside a continuous axon','The peripheral and central branches belong to the same pseudounipolar neuron. There is no obligatory synaptic relay in the dorsal root ganglion.',primary],
    ['spinal','Dorsal entry and an ascending continuation','The selected afferent enters dorsally and continues into the dorsal-column route, with a modeled local collateral. The section boundary and micro-circuit placement are illustrative.',primary],
    ['medulla','A new neuron at the cuneate relay','The primary tactile afferent reaches the right cuneate region. A different relay neuron then crosses toward the left medial lemniscus. This is not the motor crossing.',301],
    ['thalamus','Another relay toward cortex','The modeled left-VPL neuron projects toward somatosensory cortex. Its identity is distinct from both the primary afferent and the cuneate relay.',341],
    ['cortex','Human morphology at cortical scale','The unscaled trees here come from ten human temporal/frontal source specimens. Their layer-group layout illustrates cortical tissue; it is not a measured S1 fingertip connectome.',null]
   ],
   motor:[
    ['brain','Motor output starts in the opposite hemisphere','The selected upper-motor route descends from the modeled left-M1 hand-area location. The imported gyri are anatomical surfaces; these long-range fiber trajectories are modeled.',901],
    ['cortex','Inspect the cellular architecture','These are source-based human arbors, grouped by their recorded layer. They are morphology references—not a claim that these donor cells were measured controlling this finger.',null],
    ['medulla','The separate pyramidal crossing','The descending corticospinal route crosses caudal to the sensory crossing. Its upper-motor identity remains separate from the lower motor neuron.',901],
    ['spinal','A different cell supplies the muscle','The selected lower motor neuron lies in the modeled right ventral motor pool. Local spinal circuitry mediates much of motor output; this gallery does not assert a measured synapse.',201],
    ['arm','Out through a peripheral motor route','The selected lower-motor axon follows a median-nerve example toward a forearm flexor target. Radial and ulnar examples remain available outside this guided selection.',201],
    ['nmj','The motor axon ends on muscle','The same modeled lower-motor identity supplies this connected terminal arbor and its separate postsynaptic receptor domains. The muscle target is in the forearm, not inside the fingertip.',201]
   ]
  };
  for(const [id,num,title,sub] of specimens){
   const b=$('previewGrid').querySelector(`[data-specimen="${id}"]`);if(!b)continue;
   b.querySelector('.caption').innerHTML=`<b>${num}</b><strong>${esc(title)}</strong><span>${esc(sub)} <em>↗</em></span>`;
   b.title='Open the linked 3D '+title.toLowerCase();$('previewGrid').appendChild(b);
   const pin=document.createElement('button');pin.className='anatomical-pin';pin.dataset.specimen=id;pin.textContent=num;pin.title=title;pin.setAttribute('aria-label','Inspect '+title);pin.onclick=()=>A.setRegion(id);$('anatomicalPins').appendChild(pin);
   b.addEventListener('pointerenter',()=>{pin.classList.add('hover');});b.addEventListener('pointerleave',()=>pin.classList.remove('hover'));
  }
  // Keep controls reachable without an entire screen of sliders preceding the model.
  document.querySelectorAll('.side .controlgroup').forEach(group=>{
   const h=group.querySelector('h3');if(!h)return;const d=document.createElement('details'),sum=document.createElement('summary');sum.textContent=h.textContent;h.remove();d.appendChild(sum);while(group.firstChild)d.appendChild(group.firstChild);group.appendChild(d);
  });
  function layout(){
   if(!A.camera)return;const w=stage.clientWidth,h=stage.clientHeight,cinema=document.body.classList.contains('cinema');
   const info=!document.body.classList.contains('hide-info');board=A.region.id==='overview'&&w>=1030&&!cinema&&!guide&&!info;
   document.body.classList.toggle('atlas-board',board);document.body.classList.toggle('guided',!!guide);
   $('previewGrid').style.display=board?'grid':'none';$('plateHeading').style.display=board?'block':'none';
   $('journeyBar').style.display=guide||cinema?'none':'flex';$('journeyPanel').hidden=!guide||cinema;
   const reserve=cinema?0:board?414:guide&&w>880?335:info&&w>760?260:0;
   A.camera.clearViewOffset();
   if(reserve)A.camera.setViewOffset(w,h,reserve*.50,0,w,h);
   else if(guide&&w<=880)A.camera.setViewOffset(w,h,0,100,w,h);
   A.camera.updateProjectionMatrix();A.invalidate();
  }
  function labelCollision(){
   if(board){$('labels').style.display='none';return;} $('labels').style.display='block';
   const avoid=[$('sceneheading'),$('journeyBar'),!$('journeyPanel').hidden?$('journeyPanel'):null,!document.body.classList.contains('hide-info')?$('info'):null].filter(Boolean).map(e=>e.getBoundingClientRect());
   const overlaps=(a,b)=>a.left<b.right+8&&a.right>b.left-8&&a.top<b.bottom+6&&a.bottom>b.top-6;
   for(const el of $('labels').children){if(el.style.display==='none')continue;const box=el.getBoundingClientRect();if(avoid.some(r=>overlaps(box,r)))el.style.display='none';else avoid.push(box);}
  }
  function makeLeaders(){
   const svg=$('atlasLeaders'),pins=$('anatomicalPins');svg.replaceChildren();lines=[];pins.style.display=board?'block':'none';if(!board)return;
   const w=stage.clientWidth,h=stage.clientHeight,rect=stage.getBoundingClientRect();svg.setAttribute('viewBox',`0 0 ${w} ${h}`);
   let lastY=-100;
   // Anatomical anchors are millimeter locations in the shared source coordinate frame.
   for(const [id] of specimens){
    const p=A.macro?.routeAnchors?.[id],card=$('previewGrid').querySelector(`[data-specimen="${id}"]`),pin=pins.querySelector(`[data-specimen="${id}"]`);if(!p||!card||!pin)continue;
    const q=V(p).project(A.camera),x=(q.x*.5+.5)*w,y=(-q.y*.5+.5)*h;
    if(q.z>=1||x<10||x>w-15||y<70||y>h-55){pin.style.display='none';continue;}pin.style.display='block';
    const shift=id==='spinal'?[-22,29]:id==='drg'?[17,-10]:[0,0],px=x+shift[0],py=y+shift[1];pin.style.left=px+'px';pin.style.top=py+'px';
    const box=card.getBoundingClientRect(),endX=box.left-rect.left,endY=box.top-rect.top+box.height*.50,controlX=Math.min(endX-24,px+Math.max(55,(endX-px)*.53));
    const d=`M ${x} ${y} L ${px} ${py} C ${controlX} ${py}, ${controlX} ${endY}, ${endX} ${endY}`;
    const el=document.createElementNS('http://www.w3.org/2000/svg','path');el.setAttribute('d',d);el.setAttribute('class',id==='nmj'?'motor-leader':'sensory-leader');svg.appendChild(el);
    lines.push({x,y,px,py,endX,endY,controlX,id});
   }
  }
  function updateLocator(){
   const marker=$('locatorDot'),p=A.macro?.routeAnchors?.[A.region.id];
   if(!p||$('contextMini').style.display==='none'){marker.style.display='none';return;}
   const q=V(p).project(A.miniCamera),x=(q.x*.5+.5)*158,y=(-q.y*.5+.5)*123;
   marker.style.display=q.z<1&&x>4&&x<154&&y>20&&y<119?'block':'none';marker.style.left=x+'px';marker.style.top=y+'px';
  }
  function afterRegion(opts={}){
   const r=A.region;const context=A.maker.REGIONS.find(x=>x.id===r.context)||A.maker.REGIONS[0];
   $('crumbContext').innerHTML=r.id==='overview'?' / RIGHT INDEX FINGER':` / <button data-go="${context.id}">${esc(context.name)}</button> / <span>${esc(r.name)}</span>`;
   $('opening').textContent='Opening '+r.name.toLowerCase()+'…';
   if(guide)document.body.classList.add('hide-info');
   else if(!A.current.entries.some(m=>String(m.userData.id)===String(A.getState().selected)))document.body.classList.add('hide-info');
   layout();
   try{history.replaceState(null,'','#view='+r.id);}catch(e){/* Managed or embedded documents may not allow URL mutation. */}
   $('sceneheading').classList.remove('arrived');requestAnimationFrame(()=>$('sceneheading').classList.add('arrived'));
  }
  function selectionChanged(id){
   if(!guide){document.body.classList.toggle('hide-info',id==null);layout();}
  }
  const UI={layout,selectionChanged,afterRegion,beforeRegion(id,opts){if(guide&&!opts?.fromGuide)closeGuide();$('opening').textContent='Opening '+(A.maker.REGIONS.find(r=>r.id===id)?.name||'specimen')+'…';},afterDraw(){labelCollision();makeLeaders();updateLocator();},get guide(){return guide;},get guideStep(){return guideStep;},get board(){return board;}};
  window.atlasUI=UI;
  $('breadcrumb').onclick=e=>{const b=e.target.closest('[data-go]');if(b)A.setRegion(b.dataset.go);};
  $('returnLocation').onclick=()=>A.setRegion(A.region.context||'overview');
  async function goStep(i){
   if(!guide||guideBusy)return;const list=routes[guide];i=Math.max(0,Math.min(list.length-1,i));guideStep=i;const [id,title,text,selection]=list[i];
   guideBusy=true;$('nextStep').disabled=true;$('prevStep').disabled=true;
   try{
    $('journeyTag').textContent=guide==='sensory'?'SENSORY ROUTE · RIGHT INDEX':'MOTOR ROUTE · LEFT CORTEX';
    $('journeyTitle').textContent=title;$('journeyText').textContent=text;$('journeyCount').textContent=`${i+1} / ${list.length}`;
    $('journeySteps').replaceChildren();list.forEach((entry,k)=>{const b=document.createElement('button');b.className=k===i?'active':'';b.title=entry[1];b.setAttribute('aria-label',entry[1]);b.setAttribute('aria-current',k===i?'step':'false');b.textContent=String(k+1);b.onclick=()=>goStep(k);$('journeySteps').appendChild(b);});
    // Never treat the cortical tracing library as the measured continuation of a
    // named macroscopic projection. It is a separately identified source gallery.
    $('filter').value=id==='cortex'?'all':guide==='sensory'?'sensory':'motor';
    await A.setRegion(id,{animate:false,fromGuide:true});A.select(typeof selection==='function'?selection():selection);layout();
   }finally{guideBusy=false;$('prevStep').disabled=i===0;$('nextStep').disabled=false;$('nextStep').textContent=i===list.length-1?'Finish':'Next →';}
  }
  async function startGuide(kind){if(guideBusy)return;savedFilter=$('filter').value;guide=kind;guideStep=0;document.body.classList.add('hide-info');await goStep(0);}
  function closeGuide(){guide=null;guideStep=0;$('filter').value=savedFilter;A.select(null);A.applyState();layout();}
  $('touchJourney').onclick=()=>startGuide('sensory');$('motorJourney').onclick=()=>startGuide('motor');$('prevStep').onclick=()=>goStep(guideStep-1);$('nextStep').onclick=()=>guideStep>=routes[guide].length-1?closeGuide():goStep(guideStep+1);$('closeJourney').onclick=closeGuide;
  UI.startGuide=startGuide;UI.goStep=goStep;UI.closeGuide=closeGuide;
  window.addEventListener('keydown',e=>{if(e.target.matches('input,select,textarea')||e.altKey||e.ctrlKey||e.metaKey)return;if(guide&&e.key==='ArrowRight'){e.preventDefault();$('nextStep').click();}if(guide&&e.key==='ArrowLeft'){e.preventDefault();$('prevStep').click();}});
  // Save the current anatomical plate with its real rendered specimen thumbnails.
  // Canvas meshes, not the generated concept poster, are the only image sources.
  async function savePlate(){
   A.draw();const scale=2,w=stage.clientWidth,h=stage.clientHeight,canvas=document.createElement('canvas');canvas.width=Math.round(w*scale);canvas.height=Math.round((h+75)*scale);const ctx=canvas.getContext('2d');ctx.scale(scale,scale);ctx.fillStyle='#050a0f';ctx.fillRect(0,0,w,h+75);ctx.drawImage(A.renderer.domElement,0,50,w,h);
   ctx.fillStyle='#dce7e9';ctx.font='24px Georgia';ctx.fillText('Finger Pathway Atlas',22,31);ctx.font='10px sans-serif';ctx.fillStyle='#8aa2ad';ctx.fillText('VERSION 3  /  '+A.region.name.toUpperCase(),270,30);
   if(board){
    for(const l of lines){ctx.beginPath();ctx.moveTo(l.x,l.y+50);ctx.lineTo(l.px,l.py+50);ctx.bezierCurveTo(l.controlX,l.py+50,l.controlX,l.endY+50,l.endX,l.endY+50);ctx.strokeStyle=l.id==='nmj'?'#826953':'#3e6775';ctx.lineWidth=.8;ctx.stroke();}
    const base=stage.getBoundingClientRect();for(const [id,num,title,sub] of specimens){const b=$('previewGrid').querySelector(`[data-specimen="${id}"]`),img=b?.querySelector('img');if(!b||!img?.complete)continue;const r=b.getBoundingClientRect(),x=r.left-base.left,y=r.top-base.top+50,iw=r.width,ih=img.getBoundingClientRect().height;ctx.fillStyle='#08141c';ctx.fillRect(x,y,iw,r.height);ctx.drawImage(img,x,y,iw,ih);ctx.strokeStyle='#2b404b';ctx.strokeRect(x,y,iw,r.height);ctx.fillStyle='#b7d3db';ctx.font='10px sans-serif';ctx.fillText(num+'  '+title,x+9,y+ih+15);ctx.fillStyle='#7c929e';ctx.font='8px sans-serif';ctx.fillText(sub,x+9,y+ih+31);}
    for(const l of lines){ctx.beginPath();ctx.arc(l.px,l.py+50,10,0,Math.PI*2);ctx.fillStyle='#07151d';ctx.fill();ctx.strokeStyle=l.id==='nmj'?'#be9870':'#659ca9';ctx.stroke();ctx.fillStyle='#dce7e9';ctx.font='9px sans-serif';ctx.textAlign='center';ctx.fillText(specimens.find(s=>s[0]===l.id)[1],l.px,l.py+53);ctx.textAlign='left';}
   }
   ctx.fillStyle='#92a7b0';ctx.font='10px sans-serif';ctx.fillText('Source anatomy + human tracing sources + modeled pathways. Linked local specimens; not a measured end-to-end connectome.',22,h+64);
   return new Promise(resolve=>canvas.toBlob(blob=>{const link=document.createElement('a'),url=URL.createObjectURL(blob);link.href=url;link.download='Finger_Pathway_Atlas_v3_'+A.region.id+'_plate.png';link.click();setTimeout(()=>URL.revokeObjectURL(url),10000);resolve({bytes:blob.size,width:canvas.width,height:canvas.height});},'image/png'));
  }
  const save=document.createElement('button');save.id='savePlate';save.className='desktop';save.textContent='Save plate';save.onclick=()=>savePlate().catch(console.error);$('capture').before(save);UI.savePlate=savePlate;
  const requested=new URLSearchParams(location.hash.slice(1)).get('view');afterRegion();if(requested&&A.maker.REGIONS.some(r=>r.id===requested)&&requested!=='overview')A.setRegion(requested,{animate:false});
 }
})();
</script></body></html>
