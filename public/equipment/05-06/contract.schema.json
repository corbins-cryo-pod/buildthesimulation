{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://buildthesimulation.com/equipment/05-06/contract.schema.json",
 "title":"05-06 CDE ResMap teaching-fixture exchange contract",
 "description":"Lengths in meters, currents in amperes, voltages in volts, angles in radians counterclockwise from +x, wafer-centered. Active film is uniform; relative coordinate guard and paired lengths are checked by the solver. Output revision equals parentRevision + 1.",
 "oneOf":[{"$ref":"#/$defs/film"},{"$ref":"#/$defs/inputMap"},{"$ref":"#/$defs/result"}],
 "$defs":{
  "id":{"type":"string","pattern":"^[a-zA-Z0-9_.-]{1,64}$"},
  "diameter":{"type":"number","minimum":0.0508,"maximum":0.2032},
  "film":{"type":"object","required":["schema","sampleId","revision","shape","diameterM","resistivityOhmM","filmThicknessM"],"properties":{
   "schema":{"const":"bts.sheet-film.v1"},"sampleId":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":0},"shape":{"const":"uniform-disk"},"diameterM":{"$ref":"#/$defs/diameter"},"resistivityOhmM":{"type":"number","minimum":1e-12,"maximum":10000},"filmThicknessM":{"type":"number","minimum":1e-9,"maximum":0.0001}
  }},
  "coords":{"type":"object","required":["xM","yM"],"properties":{"xM":{"type":"number","minimum":-0.102,"maximum":0.102},"yM":{"type":"number","minimum":-0.102,"maximum":0.102}}},
  "inputRow":{"allOf":[{"$ref":"#/$defs/coords"},{"type":"object","required":["siteId","angleRad","currentA","voltageV"],"properties":{"siteId":{"$ref":"#/$defs/id"},"angleRad":{"type":"number","minimum":-6.283185307179586,"maximum":6.283185307179586},"currentA":{"anyOf":[{"type":"number","minimum":0.000001,"maximum":0.01},{"type":"number","minimum":-0.01,"maximum":-0.000001}]},"voltageV":{"type":"number","minimum":-1,"maximum":1},"reversedVoltageV":{"anyOf":[{"type":"null"},{"type":"number","minimum":-1,"maximum":1}]}}}]},
  "inputMap":{"type":"object","required":["schema","sampleId","revision","diameterM","sites"],"properties":{"schema":{"const":"bts.sheet-voltage-map.v1"},"sampleId":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":0},"diameterM":{"$ref":"#/$defs/diameter"},"sites":{"type":"array","minItems":1,"maxItems":49,"items":{"$ref":"#/$defs/inputRow"}}}},
  "result":{"type":"object","required":["schema","deviceId","sampleId","parentRevision","revision","diameterM","calibrationId","coordinates","units","rows","provenance"],"properties":{"schema":{"const":"bts.sheet-map.v1"},"deviceId":{"const":"05-06"},"sampleId":{"$ref":"#/$defs/id"},"parentRevision":{"type":"integer","minimum":0},"revision":{"type":"integer","minimum":1},"diameterM":{"$ref":"#/$defs/diameter"},"calibrationId":{"const":"BTS-CDE178-JANDEL-1MM-r1"},"coordinates":{"type":"object"},"units":{"type":"object"},"provenance":{"type":"object"},"rows":{"type":"array","minItems":1,"maxItems":49,"items":{"type":"object","required":["siteId","site","tips","angleRad","currentA","voltageV","reversedVoltageV","oddV","edgeMultiplier","fOhmsPerOhm","sheetOhmSq","apparentInfiniteOhmSq","contactIds"],"properties":{"siteId":{"$ref":"#/$defs/id"},"site":{"$ref":"#/$defs/coords"},"tips":{"type":"array","minItems":4,"maxItems":4},"contactIds":{"const":["P1","P2","P3","P4"]},"angleRad":{"type":"number"},"currentA":{"type":"number"},"voltageV":{"type":"number"},"reversedVoltageV":{"type":["number","null"]},"oddV":{"type":"number"},"edgeMultiplier":{"type":"number","exclusiveMinimum":0},"fOhmsPerOhm":{"type":"number","exclusiveMinimum":0},"sheetOhmSq":{"type":"number"},"apparentInfiniteOhmSq":{"type":"number"}}}}}}
 }
}
