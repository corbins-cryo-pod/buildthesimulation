{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildthesimulation.com/equipment/04-03/output-schema.json",
  "title": "Simulated Bosch trench revision",
  "type": "object",
  "required": [
    "schema",
    "deviceId",
    "sampleId",
    "revision",
    "parentRevision",
    "provenance",
    "units",
    "frame",
    "inputs",
    "depthUm",
    "remainingMaskUm",
    "nominalBottomWidthUm",
    "scallopCount",
    "wall",
    "cycleData"
  ],
  "properties": {
    "schema": {
      "const": "bts.drie.trench.v1"
    },
    "deviceId": {
      "const": "04-03"
    },
    "sampleId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parentRevision": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "type": "string"
    },
    "units": {
      "type": "object",
      "properties": {
        "length": {
          "const": "um"
        },
        "wafer": {
          "const": "mm"
        },
        "angle": {
          "const": "deg"
        }
      },
      "required": [
        "length",
        "wafer",
        "angle"
      ]
    },
    "frame": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "depthUm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "remainingMaskUm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nominalBottomWidthUm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "scallopCount": {
      "type": "integer",
      "minimum": 0
    },
    "wall": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "required": [
          "zUm",
          "leftXUm",
          "rightXUm"
        ],
        "properties": {
          "zUm": {
            "type": "number",
            "minimum": 0
          },
          "leftXUm": {
            "type": "number"
          },
          "rightXUm": {
            "type": "number"
          }
        }
      }
    },
    "cycleData": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cycle",
          "depthUm",
          "stepUm",
          "remainingMaskUm"
        ],
        "properties": {
          "cycle": {
            "type": "integer",
            "minimum": 1
          },
          "depthUm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stepUm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "remainingMaskUm": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}