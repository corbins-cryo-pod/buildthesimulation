{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://buildthesimulation.com/equipment/05-04/contract.schema.json",
 "title":"Legacy alpha-SE reflections and thickness-fit contract",
 "description":"Wavelength and film thickness in nm; degrees for incidence, Psi and Delta. Delta=null means phase not defined; Delta differences use the shortest circular residual. Fixed optical constants and semi-infinite substrate.",
 "oneOf":[{"$ref":"#/$defs/spectrum"},{"$ref":"#/$defs/fit"}],
 "$defs":{
  "layer":{"type":"object","required":["name"],"properties":{"name":{"type":"string","maxLength":100},"n":{"type":"number","minimum":1,"maximum":8},"k":{"type":"number","minimum":0,"maximum":4},"table":{"type":"array","minItems":2,"maxItems":800,"items":{"type":"array","minItems":3,"maxItems":3,"prefixItems":[{"type":"number"},{"type":"number","minimum":1,"maximum":8},{"type":"number","minimum":0,"maximum":4}]}}},"oneOf":[{"required":["n","k"]},{"required":["table"]}]},
  "finite":{"allOf":[{"$ref":"#/$defs/layer"},{"type":"object","required":["thicknessNm"],"properties":{"thicknessNm":{"type":"number","minimum":0,"maximum":2000}}}]},
  "row":{"type":"object","required":["wavelengthNm","angleDeg","psiDeg","deltaDeg"],"properties":{"wavelengthNm":{"type":"number","minimum":380,"maximum":900},"angleDeg":{"enum":[65,70,75]},"psiDeg":{"type":"number","minimum":0,"maximum":90},"deltaDeg":{"type":["number","null"],"minimum":0,"maximum":360}}},
  "identity":{"type":"object","required":["schema","sampleId","revision","provenance"],"properties":{"sampleId":{"type":"string","pattern":"^[a-zA-Z0-9_.-]{1,80}$"},"revision":{"type":"integer","minimum":0},"provenance":{"type":["object","null"]}}},
  "spectrum":{"allOf":[{"$ref":"#/$defs/identity"},{"type":"object","required":["stack","substrate","rows"],"properties":{"schema":{"const":"bts.ellipsometry-spectrum.v1"},"stack":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/finite"}},"substrate":{"$ref":"#/$defs/layer"},"rows":{"type":"array","minItems":1,"maxItems":540,"items":{"$ref":"#/$defs/row"}}}}]},
  "fit":{"allOf":[{"$ref":"#/$defs/identity"},{"type":"object","required":["deviceId","parentRevision","thicknessNm","rmsDeg","assumedStack","substrate","rowCount","residuals","diagnostics","profile"],"properties":{"schema":{"const":"bts.ellipsometry-fit.v1"},"deviceId":{"const":"05-04"},"parentRevision":{"type":"integer","minimum":0},"thicknessNm":{"type":"number","minimum":0,"maximum":2000},"rmsDeg":{"type":"number","minimum":0},"rowCount":{"type":"integer","minimum":1,"maximum":540},"assumedStack":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/finite"}},"substrate":{"$ref":"#/$defs/layer"},"residuals":{"type":"array","minItems":1,"maxItems":540,"items":{"allOf":[{"$ref":"#/$defs/row"},{"type":"object","required":["predPsiDeg","predDeltaDeg","psiResidualDeg","deltaResidualDeg"]}]}},"profile":{"type":"array"},"diagnostics":{"type":"object","required":["status","candidateCount","candidates"],"properties":{"status":{"enum":["flat","multiple-orders","edge-limited","unique-in-search"]},"candidateCount":{"type":"integer","minimum":0}}}}}]}
 }
}
