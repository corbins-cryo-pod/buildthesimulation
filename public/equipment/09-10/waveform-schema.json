{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "SR560 simulated signed output volts. Sample i at t0S+i*dtS; export contains parent source metadata, modeled condition and model revision.",
  "type": "object",
  "required": [
    "schema",
    "sampleId",
    "revision",
    "dtS",
    "t0S",
    "channels"
  ],
  "properties": {
    "schema": {
      "const": "bts.analog-waveform.v1"
    },
    "sampleId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "dtS": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "t0S": {
      "type": "number"
    },
    "kind": {
      "const": "simulated"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "unit",
          "samples"
        ],
        "properties": {
          "id": {
            "const": "OUTPUT"
          },
          "unit": {
            "const": "V"
          },
          "samples": {
            "type": "array",
            "minItems": 16,
            "maxItems": 65536,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
