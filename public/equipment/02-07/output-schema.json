{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTS spin coater resist-layer revision",
  "type": "object",
  "required": [
    "schema",
    "sampleId",
    "parentRevision",
    "revision",
    "contactIds",
    "resistId",
    "calibrationId",
    "provenance",
    "wafer",
    "recipe",
    "history",
    "metrics",
    "grid"
  ],
  "properties": {
    "schema": {
      "const": "bts.spin-coater.resist-layer.v1"
    },
    "sampleId": {
      "type": "string"
    },
    "parentRevision": {
      "type": "integer"
    },
    "revision": {
      "type": "integer"
    },
    "contactIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resistId": {
      "type": "string"
    },
    "calibrationId": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "modelVersion",
        "source",
        "fit",
        "heldOut",
        "mapMetrics"
      ],
      "properties": {
        "kind": {
          "const": "simulated"
        },
        "modelVersion": {
          "const": "2.0"
        },
        "source": {
          "type": "string"
        },
        "fit": {
          "type": "object"
        },
        "heldOut": {
          "type": "object"
        },
        "mapMetrics": {
          "type": "string"
        }
      }
    },
    "wafer": {
      "type": "object"
    },
    "recipe": {
      "type": "object"
    },
    "history": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "required": [
        "central_um",
        "min_um",
        "max_um",
        "mean_um",
        "range_um"
      ],
      "properties": {
        "central_um": {
          "type": "number",
          "minimum": 0
        },
        "min_um": {
          "type": "number",
          "minimum": 0
        },
        "max_um": {
          "type": "number",
          "minimum": 0
        },
        "mean_um": {
          "type": "number",
          "minimum": 0
        },
        "range_um": {
          "type": "number",
          "minimum": 0
        },
        "edgeExcluded3mm_oppositePointDifference_um": {
          "type": "number",
          "minimum": 0
        },
        "edgeExcluded3mm_radius_mm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "nx",
        "nz",
        "pitch_mm",
        "origin_mm",
        "frame",
        "units",
        "values"
      ],
      "properties": {
        "nx": {
          "type": "integer"
        },
        "nz": {
          "type": "integer"
        },
        "pitch_mm": {
          "type": "number"
        },
        "origin_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "frame": {
          "type": "string"
        },
        "units": {
          "const": "µm"
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}