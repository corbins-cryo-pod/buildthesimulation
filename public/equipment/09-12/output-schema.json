{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://buildthesimulation.com/equipment/09-12/output-schema.json",
 "title":"BTS ideal three-electrode fixture: passive cell boundary contract and spectrum",
 "type":"object",
 "required":["schema","deviceId","modelRevision","sampleId","contactId","parentRevision","revision","provenance","terminals","leadMap","geometry","cellConstantPerM","cellCircuit","excitation","convention","columns","samples","handoff"],
 "properties":{
  "schema":{"const":"bts.cell.three-electrode.v1"},
  "deviceId":{"const":"09-12"},
  "modelRevision":{"const":"BTS-CELL-3E/Mk-I"},
  "sampleId":{"type":"string","minLength":1,"maxLength":80},
  "contactId":{"type":"string","minLength":1,"maxLength":80},
  "parentRevision":{"type":"integer","minimum":0},
  "revision":{"type":"integer","minimum":1},
  "provenance":{"type":"object","required":["origin","equation","hardwareCalibration"],"properties":{"origin":{"const":"simulated"},"hardwareCalibration":{"const":false}}},
  "terminals":{"type":"object","required":["working","reference","counter"]},
  "leadMap":{"const":{"WE":"WE","RE":"RE","CE":"CE"}},
  "geometry":{"type":"object","required":["gapM","areaM2","conductivitySm","declaredTemperatureC"],"properties":{"gapM":{"type":"number","minimum":0.002,"maximum":0.03},"areaM2":{"type":"number","minimum":0.000004,"maximum":0.0004},"conductivitySm":{"type":"number","minimum":0.05,"maximum":5},"declaredTemperatureC":{"type":"number","minimum":5,"maximum":50}}},
  "cellConstantPerM":{"type":"number","exclusiveMinimum":0},
  "cellCircuit":{"type":"object","required":["kind","solutionOhm","interfaceOhm","interfaceFarad","referredTo","referenceInputIdeal"],"properties":{"kind":{"enum":["series-r","series-r-plus-parallel-rc"]},"solutionOhm":{"type":"number","exclusiveMinimum":0},"interfaceOhm":{"type":["number","null"]},"interfaceFarad":{"type":["number","null"]},"referredTo":{"const":"WE-minus-RE"},"referenceInputIdeal":{"const":true}}},
  "excitation":{"type":"object","required":["voltageRmsV","startHz","stopHz","samples","grid"]},
  "convention":{"type":"object","required":["phasor","temperature","current","referencePlane"]},
  "columns":{"const":["frequency_Hz","Z_real_ohm","Z_imag_ohm","Z_magnitude_ohm","Z_phase_deg","I_real_Arms","I_imag_Arms","I_magnitude_Arms"]},
  "samples":{"type":"array","minItems":2,"maxItems":181,"items":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"number"}}},
  "handoff":{"type":"object","required":["intendedConsumer","kind","requiresAdapter","notVendorDataFile"]}
 }
}
