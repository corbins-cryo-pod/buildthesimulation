{
  "declaredBeforeImplementation": true,
  "method": "Analytic homogeneous conducting slab, Dirichlet planes normal to +X, insulated lateral sides. Arithmetic tolerances, not measurement uncertainty.",
  "cases": [
    {
      "id": "register",
      "setup": "40×20×10 mm slab, sigma 2 S/m, phi left 5 V and right 0 V",
      "expected": {
        "currentA": 0.05,
        "centerV": 2.5,
        "electricXVm": 125,
        "currentDensityAm2": 250
      },
      "tolerances": {
        "currentA": 1e-7,
        "centerV": 1e-7,
        "electricXVm": 0.000001,
        "currentDensityAm2": 0.000001
      }
    },
    {
      "id": "refinement",
      "setup": "8, 16, 32 subdivisions in X, same slab",
      "expected": {
        "maxCurrentErrorA": 0,
        "maxPotentialErrorV": 0
      },
      "tolerances": {
        "maxCurrentErrorA": 1e-7,
        "maxPotentialErrorV": 1e-7
      }
    },
    {
      "id": "reverse",
      "setup": "Swap the electrode potentials",
      "expected": {
        "currentA": -0.05
      },
      "tolerances": {
        "currentA": 1e-7
      }
    },
    {
      "id": "equal",
      "setup": "Both electrodes held at 5 V",
      "expected": {
        "currentA": 0,
        "centerV": 5
      },
      "tolerances": {
        "currentA": 1e-7,
        "centerV": 1e-7
      }
    },
    {
      "id": "invalid-domain",
      "setup": "Zero slab length",
      "expected": "Use positive slab dimensions 5–120 mm."
    }
  ]
}
