---
import '../styles/company-brief.css';
import { getDevicePhoto } from '../lib/device-photos.js';

const { entry, brief, headings, apps, devices, lastVerified } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
const photo = getDevicePhoto(brief.photoDeviceId);
const cleanTitle = (title) => title.replace(/^\d+\s*[-—]\s*/, '');
---

<article class="company-brief" data-company-brief>
  <div class="brief-edition">
    <a href={`/companies/?org=${entry.slug}`}>BCI Atlas <span aria-hidden="true">/</span> Company brief</a>
    <span>{entry.data.region} edition <span aria-hidden="true">·</span> No. {brief.folio}</span>
  </div>

  <header class="brief-cover">
    <div class="brief-cover-grid">
      <div class="brief-title-block">
        <p class="brief-overline">{brief.label}</p>
        <h1 class="brief-name" aria-label={brief.name}>{brief.headline.map(line => <span>{line}</span>)}</h1>
        <p class="brief-deck">{brief.deck}</p>
      </div>
      <div class="brief-imprint">
        <svg class="brief-emblem" width="176" height="100" viewBox="0 0 176 100" fill="none" aria-hidden="true">
          <path d="M12 88H164M24 80H152M36 72H140M48 64H128M60 56H116M72 48H104M88 4V40M48 14L70 44M18 38L62 52M128 14L106 44M158 38L114 52" stroke="currentColor" stroke-width="1" />
          <path d="M78 42L88 32L98 42L88 52Z" stroke="currentColor" />
        </svg>
        <span class="brief-imprint-label">Organization dossier</span>
        <span class="brief-folio" aria-hidden="true">{brief.folio}</span>
        {lastVerified && <p class="brief-reviewed">Public-source review<br /><time datetime={entry.data.lastVerified.toISOString().slice(0, 10)}>{lastVerified}</time></p>}
        <a class="brief-official" href={entry.data.website} target="_blank" rel="noopener noreferrer">Official website <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <dl class="brief-facts" aria-label="Company at a glance">
      <div><dt>Location</dt><dd>{entry.data.location}</dd></div>
      <div><dt>Organization</dt><dd>{brief.structure}</dd></div>
      <div><dt>Platform</dt><dd>{brief.platform}</dd></div>
      <div><dt>Focus</dt><dd>{brief.focus}</dd></div>
    </dl>
  </header>

  <div class="brief-reading-grid">
    <aside class="brief-rail">
      <nav class="brief-contents" aria-label="In this brief">
        <p class="brief-small-label">In this brief</p>
        <ol>
          {sections.map((section, index) => <li><a href={`#${section.slug}`} data-brief-section>
            <span class="brief-nav-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{section.text}</span>
          </a></li>)}
          <li><a href="#source-index" data-brief-section><span class="brief-nav-number" aria-hidden="true">{String(sections.length + 1).padStart(2, '0')}</span><span>Source index</span></a></li>
        </ol>
        <a class="brief-rail-atlas" href={`/companies/?org=${entry.slug}`}>Locate in the atlas <span aria-hidden="true">↗</span></a>
      </nav>
    </aside>

    <div class="brief-prose">
      <slot />
    </div>

    <aside class="brief-marginalia" aria-label="Interface and related reading">
      {photo && <figure class="brief-interface">
        <div class="brief-small-label">The physical interface</div>
        <a class="brief-photo" href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Enlarge the image of ${brief.deviceName}`}>
          <img src={photo.thumbnail} width={photo.thumbnailWidth} height={photo.thumbnailHeight} alt={photo.alt} loading="lazy" decoding="async" />
          <span aria-hidden="true">Enlarge image ↗</span>
        </a>
        <figcaption>
          <h2>{brief.photoTitle}</h2>
          <p>{photo.versionNote}</p>
          <details class="brief-photo-credit">
            <summary>Image credit &amp; source</summary>
            <p>{photo.credit}. <a href={photo.sourceUrl} target="_blank" rel="noopener noreferrer">Original publication</a> · <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">{photo.license}</a>.</p>
            <p>{photo.changes}</p>
          </details>
        </figcaption>
        <a class="brief-catalog-link" href={`/devices/${brief.deviceSlug}/`}>{brief.deviceName} <span>Device brief ↗</span></a>
      </figure>}

      <div class="brief-field-note">
        <span class="brief-small-label">An engineering lens</span>
        <p>{brief.note}</p>
        <svg viewBox="0 0 84 16" width="84" height="16" fill="none" aria-hidden="true"><path d="M0 8H30M54 8H84M34 8L42 0L50 8L42 16Z" stroke="currentColor" /></svg>
      </div>

      {(apps.length > 0 || devices.length > 0) && <section class="brief-related">
        <h2>In the collection</h2>
        {devices.length > 0 && <><p class="brief-small-label">Linked hardware</p><ul>{devices.map(device => <li><a href={`/devices/${device.slug}/`}>{cleanTitle(device.data.title)}</a></li>)}</ul></>}
        {apps.length > 0 && <><p class="brief-small-label">Applications &amp; studies</p><ul>{apps.map(app => <li><a href={`/applications/${app.slug}/`}>{cleanTitle(app.data.title)}</a></li>)}</ul></>}
      </section>}
    </aside>
  </div>

  <section class="brief-sources" id="source-index" aria-labelledby="source-heading">
    <div class="brief-source-heading">
      <span class="brief-section-number" aria-hidden="true">{String(sections.length + 1).padStart(2, '0')}</span>
      <div><p class="brief-small-label">The reading room</p><h2 id="source-heading">Source index</h2></div>
      <p>Short citations in the text lead here. Each reference keeps its original destination and context.</p>
    </div>
    <ol class="brief-source-list">
      {brief.sources.map(source => <li id={`source-${source.id}`}>
        <span class="brief-source-number" aria-hidden="true">{source.id}</span>
        <div class="brief-source-copy">
          <p class="brief-source-meta">{source.publisher} <span aria-hidden="true">/</span> <span>{source.type}</span></p>
          <a class="brief-source-title" href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<span aria-hidden="true"> ↗</span></a>
          {source.note && <p class="brief-source-note">{source.note}</p>}
          <div class="brief-source-actions">
            {source.alternate && <a href={source.alternate.url} target="_blank" rel="noopener noreferrer">{source.alternate.label}</a>}
            <a href={`#${source.section}`} aria-label={`Return to the section citing source ${source.id}`}>Back to section</a>
          </div>
        </div>
      </li>)}
    </ol>
  </section>

  <footer class="brief-colophon">
    <a href={`/companies/${brief.counterpart.slug}/`} class="brief-next">
      <span class="brief-small-label">Another perspective</span>
      <span class="brief-next-name">{brief.counterpart.name} <span aria-hidden="true">↗</span></span>
      <span class="brief-next-label">{brief.counterpart.label}</span>
    </a>
    <a class="brief-back-top" href="#top-of-brief">Back to the beginning <span aria-hidden="true">↑</span></a>
  </footer>
</article>

<script>
  // Section links work without JavaScript; observation adds a reading-position cue.
  const dossier = document.querySelector<HTMLElement>('[data-company-brief]');
  if (dossier && 'IntersectionObserver' in window) {
    const links = Array.from(dossier.querySelectorAll<HTMLAnchorElement>('[data-brief-section]'));
    const sections = links.map(link => document.getElementById(link.hash.slice(1))).filter((section): section is HTMLElement => Boolean(section));
    const activate = (id: string) => links.forEach(link => {
      if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) activate(entry.target.id);
    }, { rootMargin: '-8% 0px -65% 0px', threshold: 0 });
    sections.forEach(section => observer.observe(section));
    links.forEach(link => link.addEventListener('click', () => activate(link.hash.slice(1))));
    activate(window.location.hash.slice(1) || sections[0]?.id || '');
  }
</script>
