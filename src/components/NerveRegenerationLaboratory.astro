---
import { DEFAULT_CONFIG, MODEL_VERSION, PRESETS } from '../lib/nerve-regeneration/model.mjs';
const sliders = [
 {key:'elongationMmDay',label:'Unimpeded elongation',unit:'mm/day',min:0,max:5,step:.1,note:'Potential arc-length advance before local environmental resistance.'},
 {key:'growthLagDays',label:'Growth initiation lag',unit:'days',min:0,max:30,step:1,note:'A separate heterogeneous clock after the pathway becomes available.'},
 {key:'alignment',label:'Track alignment',unit:'fraction',min:0,max:1,step:.05,note:'Guidance and synthetic fascicle geometry; not surgical skill.'},
 {key:'schwannSupport',label:'Repair-state support',unit:'fraction',min:0,max:1,step:.05,note:'Amplitude of normalized Schwann repair-state availability.'},
 {key:'vascularSupport',label:'Vascular support',unit:'fraction',min:0,max:1,step:.05,note:'Permissiveness index, not blood flow or oxygen concentration.'},
 {key:'scar',label:'Scar burden',unit:'fraction',min:0,max:1,step:.05,note:'Adjustable obstruction hypothesis; no collagen mechanics.'},
 {key:'supportHalfLifeDays',label:'Distal support half-life',unit:'days',min:15,max:365,step:5,note:'Assumed persistence of the denervated repair environment.'},
 {key:'intrinsicHalfLifeDays',label:'Neuronal competence half-life',unit:'days',min:30,max:730,step:10,note:'Initiation competence after chronic axotomy; not neuronal death.'},
 {key:'targetHalfLifeDays',label:'Target receptivity half-life',unit:'days',min:30,max:730,step:10,note:'Independent diagnostic. Does not gate or rescue growing axons.'},
 {key:'remyelinationLagDays',label:'Local myelination lag',unit:'days',min:0,max:30,step:1,note:'Delay measured from the arrival of each axon at each location.'},
 {key:'remyelinationDays',label:'Myelin maturation time constant',unit:'days',min:5,max:120,step:5,note:'Exponential maturation hypothesis; not measured sheath thickness.'},
 {key:'motorFraction',label:'Motor identity fraction',unit:'fraction',min:0,max:1,step:.05,note:'Descriptive fiber identities; target-specific recognition is absent.'},
];
const sweepKeys=[['elongationMmDay','Unimpeded elongation / mm per day'],['gapMm','Gap length / mm'],['distalMm','Distal distance / mm'],['delayDays','Repair delay / days'],['alignment','Track alignment / 0–1'],['schwannSupport','Schwann support / 0–1'],['supportHalfLifeDays','Distal support half-life / days'],['scar','Scar burden / 0–1']];
---
<div class="nr-lab" data-nerve-regeneration>
 <header class="nr-heading"><div><span class="nr-eyebrow">Anatomy &amp; pathways / Computational laboratory</span><h1>Peripheral nerve regeneration</h1><p>Follow individual axons through degeneration, repair, distal advance and remyelination. Change the assumptions. Inspect the consequences.</p></div><nav><a href="/simulations/">All simulations</a><a href="/simulations/nerve-regeneration/methods/">Model &amp; evidence →</a></nav></header>
 <div class="nr-model-note"><span class="nr-badge">Exploratory mechanistic model</span><p>Literature-informed mechanisms with explicit, adjustable assumptions. Synthetic anatomy. Outcomes describe this model; human recovery and treatment efficacy are not calibrated.</p></div>
 <section class="nr-presets" aria-label="Example experiments"><span class="nr-section-label">Start with an example</span><div>{PRESETS.map(p=><button type="button" data-nr-preset={p.id} aria-pressed="false">{p.label}</button>)}</div></section>
 <div class="nr-workspace">
  <aside class="nr-controls" aria-label="Experimental conditions">
   <div class="nr-control-heading"><span class="nr-section-label">01 / Experimental conditions</span><p data-nr="preset-description"></p></div>
   <details class="nr-control-group" open><summary>Injury &amp; repair geometry</summary>
    <label>Biological context<select data-nr-param="species"><option value="human-exploratory">Human-scale / exploratory</option><option value="rat">Rat-scale / exploratory</option></select></label><p class="nr-help">Context labels preserve species provenance. Every parameter remains explicit; this is not a species-calibrated predictor.</p>
    <label>Injury<select data-nr-param="injury"><option value="transection">Transection / disrupted path</option><option value="crush">Crush / preserved tracks</option></select></label>
    <label>Repair architecture<select data-nr-param="repair"><option value="conduit">Hollow guidance conduit</option><option value="graft">Structured supportive bridge</option><option value="direct">Direct apposition</option><option value="none">No repair</option></select></label>
    <div class="nr-paired"><label>Gap <small>mm</small><input type="number" data-nr-param="gapMm" min="0" max="50" step=".5" value={DEFAULT_CONFIG.gapMm}/></label><label>Distal path <small>mm</small><input type="number" data-nr-param="distalMm" min="5" max="500" step="1" value={DEFAULT_CONFIG.distalMm}/></label></div><p class="nr-help">Distal path is measured from the distal stump to the target, in addition to the gap.</p>
    <div class="nr-paired"><label>Repair delay <small>days</small><input type="number" data-nr-param="delayDays" min="0" max="365" step="1" value={DEFAULT_CONFIG.delayDays}/></label><label>Nerve radius <small>mm</small><input type="number" data-nr-param="radiusMm" min=".3" max="3" step=".1" value={DEFAULT_CONFIG.radiusMm}/></label></div>
    <label>Time horizon<select data-nr-param="durationDays">{[90,180,365,730].map(n=><option value={n} selected={n===DEFAULT_CONFIG.durationDays}>{n} days after injury</option>)}</select></label><p class="nr-help" data-nr="normalization-note"></p>
   </details>
   <details class="nr-control-group"><summary>Growth &amp; tissue assumptions</summary>{sliders.map(s=><label class="nr-slider-label"><span>{s.label}<output data-nr-value={s.key}></output></span><input type="range" data-nr-param={s.key} data-unit={s.unit} min={s.min} max={s.max} step={s.step} value={DEFAULT_CONFIG[s.key]}/><small>{s.note}</small></label>)}</details>
   <details class="nr-control-group"><summary>Sampling &amp; reproducibility</summary><label>Representative parent axons<select data-nr-param="axonCount">{[64,128,256,512].map(n=><option value={n}>{n} parent axons</option>)}</select></label><label>Random seed<input type="number" data-nr-param="seed" min="0" max="4294967295" step="1" value={DEFAULT_CONFIG.seed}/></label><label>Maximum integration step<select data-nr-param="dtDays"><option value="0.25">0.25 day</option><option value="0.1">0.1 day</option><option value="0.05">0.05 day / refinement</option></select></label><p class="nr-help">The same seed reproduces the same cohort. Numerical parents are not a measured count of all axons in a real nerve. Large cohorts retain every trajectory in analysis.</p></details>
   <div class="nr-run-area"><button type="button" class="nr-primary" data-nr="run">Run experiment →</button><button type="button" data-nr="cancel" hidden>Cancel computation</button><p data-nr="dirty" class="nr-dirty" hidden>Settings changed · previous run still displayed.</p><p data-nr="status" role="status" aria-live="polite">Preparing experiment…</p></div>
  </aside>
  <main class="nr-main">
   <section class="nr-scene" aria-label="Anatomical regeneration viewer"><header class="nr-scene-header"><div><span class="nr-section-label">02 / Injury window</span><strong data-nr="scene-title">Axons across the repair site</strong></div><span data-nr="day-heading">DAY 0</span></header><div class="nr-viewport" data-nr="viewport"><div class="nr-scene-loading">Preparing anatomical view…</div></div>
    <div class="nr-scene-annotation"><span>Proximal stump</span><span data-nr="gap-label">8 mm gap</span><span>Distal stump → target</span></div>
    <div class="nr-scene-toolbar"><div class="nr-segment" aria-label="Camera view"><button type="button" data-nr-camera="oblique">Oblique</button><button type="button" data-nr-camera="top">Longitudinal</button><button type="button" data-nr-camera="cross-section">Cross-section</button></div><label>Color <select data-nr="color-mode"><option value="state">Axon state</option><option value="anatomy">Fiber identity</option><option value="support">Local support</option></select></label><button type="button" data-nr="scale-toggle" aria-pressed="false">True proportions</button></div>
    <details class="nr-display-options"><summary>Anatomy layers &amp; display scale</summary><div><label><input type="checkbox" data-nr-layer="showSheath" checked/> Cutaway sheath</label><label><input type="checkbox" data-nr-layer="showSchwann" checked/> Repair Schwann cells</label><label><input type="checkbox" data-nr-layer="showVessels" checked/> Vascular guides</label><label><input type="checkbox" data-nr-layer="showDebris" checked/> Distal debris</label><label><input type="checkbox" data-nr-layer="showScar"/> Scar</label></div><p data-nr="scale-note">Procedural anatomy · transverse scale ×3 · fiber diameter ×3</p></details><div class="nr-legend" data-nr="legend"></div>
   </section>
   <div class="nr-timeline"><div class="nr-play-row"><button type="button" data-nr="play" aria-label="Play regeneration timeline">Play</button><button type="button" data-nr="restart" aria-label="Return to injury">↤</button><label class="nr-time-slider"><span class="nr-sr-only">Days since injury</span><input type="range" data-nr="timeline" min="0" max={DEFAULT_CONFIG.durationDays} step=".1" value="0"/></label><output data-nr="time-label">Day 0 / 180</output><label class="nr-speed"><span class="nr-sr-only">Playback speed</span><select data-nr="playback-speed"><option value="3">3 days/s</option><option value="10" selected>10 days/s</option><option value="30">30 days/s</option></select></label></div><nav class="nr-event-nav" aria-label="Jump to event">{[['injury','Injury'],['repair','Repair'],['entry','First distal entry'],['arrival','First target arrival'],['end','End']].map(([id,label])=><button type="button" data-nr-event={id} disabled>{label}</button>)}</nav><p data-nr="time-caption" class="nr-time-caption">Time is measured from injury. Playback speed changes only the display.</p></div>
   <div class="nr-metrics">{[['distalEntry','Crossed into distal stump','Unique parent axons'],['arrived','Reached target distance','Anatomical arrival'],['correctlyRouted','Fascicle-matched arrival','Original synthetic fascicle'],['p90FrontMm','Leading growth front','90th percentile / mm']].map(([key,label,note])=><div><span>{label}</span><strong data-nr-metric={key}>—</strong><small>{note}</small></div>)}</div>
   <section class="nr-inspector" aria-label="Axon inspector"><div><span class="nr-section-label">Individual parent axon</span><label>Select trajectory <select data-nr="axon-select"><option>Select after computation</option></select></label></div><p data-nr="axon-detail">Click a fiber in the anatomical view or select an axon to inspect its state and arrival events.</p></section>
   <section class="nr-plot-panel nr-route-panel"><header><div><span class="nr-section-label">03 / Full regeneration path</span><h2>From the injury to the target</h2></div><span data-nr="path-length"></span></header><canvas data-nr="route-chart" role="img" aria-label="Axon growth positions along the complete path in millimeters"></canvas><p class="nr-plot-note">The anatomical view resolves the injury window. This plot includes the full distal distance; each mark is one parent axon. Marks can overlap.</p></section>
   <div class="nr-plots">
    <section class="nr-plot-panel"><header><div><span class="nr-section-label">04 / Structural outcomes</span><h2>Crossing is only one milestone</h2></div></header><canvas data-nr="outcome-chart" role="img" aria-label="Distal crossing, target arrival and fascicle-matched arrival over time"></canvas><div class="nr-plot-key"><span style="--key:#2a8d83">Distal entry</span><span style="--key:#a47b34">Target arrival</span><span style="--key:#aa5c4a">Fascicle match</span></div><p class="nr-plot-note">All fractions use the original parent cohort. A fascicle match does not establish appropriate organ reinnervation or useful function. Dashed lines show a pinned reference.</p></section>
    <section class="nr-plot-panel"><header><div><span class="nr-section-label">05 / Tissue environment</span><h2>Support changes along the path</h2></div></header><canvas data-nr="environment-chart" role="img" aria-label="Normalized debris, repair support, vascular support and scar by position"></canvas><div class="nr-plot-key"><span style="--key:#858078">Debris</span><span style="--key:#2a8d83">Repair support</span><span style="--key:#aa5c4a">Vascular support</span><span style="--key:#a47b34">Scar</span></div><p class="nr-plot-note">Dimensionless states, 0–1. Spatial profiles are simulated support fields, not measured cell densities or molecular concentrations.</p></section>
    <section class="nr-plot-panel"><header><div><span class="nr-section-label">06 / Maturation</span><h2>Rebuilding the myelin sheath</h2></div></header><canvas data-nr="maturation-chart" role="img" aria-label="Mean entry-site myelin maturity, conduction surrogate and target receptivity over time"></canvas><div class="nr-plot-key"><span style="--key:#2a8d83">Entry-site myelin</span><span style="--key:#a47b34">Conduction surrogate</span><span style="--key:#aa5c4a">Target receptivity</span></div><p class="nr-plot-note">Myelin is averaged at distal entry among entered parents. Conduction is a dimensionless surrogate, not velocity, CMAP or strength. Target receptivity is an independent diagnostic; it does not gate growth.</p></section>
    <section class="nr-plot-panel"><header><div><span class="nr-section-label">07 / Stochastic variability</span><h2>Repeat the same experiment</h2></div><button type="button" data-nr="ensemble">Run 16 seeds</button></header><canvas data-nr="ensemble-chart" role="img" aria-label="Seed-to-seed variation in target arrival"></canvas><p class="nr-plot-note" data-nr="ensemble-note">The central 80% band shows stochastic cohort variation at fixed assumptions, not biological confidence.</p></section>
   </div>
   <section class="nr-plot-panel nr-sensitivity-panel"><header><div><span class="nr-section-label">08 / Parameter sensitivity</span><h2>Change one assumption at a time</h2></div></header><div class="nr-sensitivity-controls"><label>Parameter<select data-nr="sensitivity-parameter">{sweepKeys.map(([value,label])=><option value={value}>{label}</option>)}</select></label><button type="button" data-nr="sensitivity">Compute five values</button></div><canvas data-nr="sensitivity-chart" role="img" aria-label="Endpoint arrival and fascicle matching across parameter values"></canvas><div class="nr-plot-key"><span style="--key:#2a8d83">Distal entry</span><span style="--key:#a47b34">Target arrival</span><span style="--key:#aa5c4a">Fascicle match</span></div><p class="nr-plot-note" data-nr="sensitivity-note">Five values, the same seed and observation horizon. A controlled sensitivity experiment within the model.</p><details class="nr-sensitivity-table"><summary>Numerical sweep values</summary><div data-nr="sensitivity-table">Run a sweep to inspect numerical values.</div></details></section>
   <section class="nr-compare-panel"><div><span class="nr-section-label">09 / Compare hypotheses</span><h2>Keep a reference experiment</h2><p>Pin a completed run, change an assumption, then recompute. Endpoints and dashed curves retain the reference.</p></div><div class="nr-compare-actions"><button type="button" data-nr="pin">Pin current as reference</button><button type="button" data-nr="clear-reference" disabled>Clear reference</button></div><div class="nr-comparison" data-nr="comparison"></div></section>
   <details class="nr-data-table"><summary>Exact numerical values at the displayed day</summary><div class="nr-table-scroll"><table><thead><tr><th>Readout</th><th>Value</th><th>Interpretation</th></tr></thead><tbody data-nr="results-table"></tbody></table></div></details>
   <section class="nr-export-panel"><div><span class="nr-section-label">Reproducible experiment</span><p data-nr="manifest-label">Model {MODEL_VERSION} · synthetic anatomy · local computation</p></div><div><button type="button" data-nr="export-json">Export experiment JSON</button><button type="button" data-nr="export-csv">Export time series CSV</button><button type="button" data-nr="import">Import parameters</button><input data-nr="import-file" type="file" accept="application/json,.json" hidden/></div></section>
  </main>
 </div>
 <section class="nr-reading"><div><span class="nr-section-label">How to read this model</span><h2>A coupled biological sequence</h2><p>An axon can cross the repair yet enter a different synthetic fascicle; reach the target coordinate while target receptivity has declined; or arrive before its sheath has matured. The laboratory keeps those events visible separately.</p><p>Use crush to inspect preserved guidance, conduit examples to explore an initially unsupported gap, and delayed repair to examine separate biological clocks. Each preset is an experiment in assumptions, not a clinical comparison of procedures.</p></div><div><span class="nr-section-label">Evidence &amp; limits</span><h2>Inspect the model behind the picture</h2><p>The methods explain primary studies, species, equations, units and numerical checks. Molecular networks, collateral sprouting, detailed motor units, immune subtypes, target-specific synapses and patient anatomy are not resolved.</p><p><a href="/simulations/nerve-regeneration/methods/">Read the complete model &amp; primary-source evidence →</a></p><ul data-nr="warnings" class="nr-warnings"></ul></div></section>
</div>
<script>
 import { initializeRegenerationLab } from '../lib/nerve-regeneration/client.mjs';
 initializeRegenerationLab();
</script>
