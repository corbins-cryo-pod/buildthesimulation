---
import Layout from '../layouts/Layout.astro';
interface Props { version?: 3 | 4 }
const { version = 4 } = Astro.props;
const isV3 = version === 3;
const viewerPath = isV3 ? '/simulations/finger-pathway-atlas/v3-viewer/' : '/simulations/finger-pathway-atlas/viewer/';
---

<Layout pageTitle={`Finger Pathway Atlas V${version}`} compactHeader wide subtitle="" description="Explore a right index finger's sensory and motor pathways in 3D, from sensory endings through peripheral nerves, spinal cord, brainstem and cortex. Compare 50 source-attributed reference plates.">
  <section class="atlas-heading" aria-labelledby="atlas-title">
    <div><p class="edition">{isV3 ? 'Original anatomical edition · V3' : 'Anatomical edition · V4'}</p><h1 id="atlas-title">Finger Pathway Atlas</h1></div>
    <nav aria-label="Atlas pages">
      <a href="/simulations/finger-pathway-atlas/v3/" aria-current={isV3 ? 'page' : undefined}>V3 · Original</a>
      <a href="/simulations/finger-pathway-atlas/v4/" aria-current={!isV3 ? 'page' : undefined}>V4 · Development</a>
      <a href="/simulations/finger-pathway-atlas/references/">Reference images · 50 plates</a>
      <button id="atlas-fullscreen" type="button">Full screen</button>
      <a href={viewerPath}>Open V{version} viewer</a>
    </nav>
  </section>
  <div class="viewer-shell" id="atlas-shell">
    <iframe id="atlas-frame" data-version={version} src={viewerPath} title={`Finger Pathway Atlas V${version}: interactive 3D anatomy`} allow="fullscreen" allowfullscreen></iframe>
  </div>
  <section class="atlas-guide" aria-label="Quick start and scope">
    {isV3 ? <>
      <div><h2>Complete original V3</h2><p>The original V3 viewer, anatomical models, cellular specimens, pathway journeys and display controls are available here in full. Select a location or specimen from the viewer’s navigation to inspect the original models.</p></div>
      <div><h2>Compare while troubleshooting</h2><p>Keep this V3 page open alongside <a href="/simulations/finger-pathway-atlas/v4/" target="_blank" rel="noopener">V4 in another tab</a>. Both versions use the same <a href="/simulations/finger-pathway-atlas/references/">50 comparison plates and original scientific figures</a>.</p></div>
      <p class="scope">This is the complete original V3 experience, including its original specimen views and controls. Its models are illustrative and are not an experimentally mapped human connectome.</p>
    </> : <>
    <div><h2>One connected model</h2><p>Follow <strong>touch, free-ending, proprioceptive, or motor</strong> pathways through 306 individually identified cells and 78 representative routes. Each relay is a distinct neuron. Choose a region, then select <strong>Inspect cell</strong> or <strong>Inspect ending</strong> to see that same cell at close range.</p></div>
    <div><h2>Detail where you look</h2><p>V3’s detailed cellular models remain integrated; the cortex now shows only the left precentral (M1) and postcentral (S1) gyri. Choose <strong>M1 + S1 coronal cortex</strong> for paired coronal sections, six layers, H01 reference neurites and connected layer-VI axons. Original source meshes load near the camera; distant pathways keep their identities and connections as solid cylindrical fibers. Drag to orbit, scroll to zoom, and right-drag to pan. <a href="/simulations/finger-pathway-atlas/references/">Compare with the published histology and microscopy references.</a></p></div>
    <p class="scope">V4 preserves V3’s detailed procedural cell models and measured human cortical traces with modeled placements and connections. It is a representative anatomical model, not a complete biological census or experimentally mapped human connectome. There is no electrical or biomechanics solver. The 50 comparison plates retain V3 model panels as the development baseline; source species, tissue and scale limits remain labeled.</p>
    </>}
    <p class="download"><button id="atlas-offline" type="button">Download original V3 offline atlas (22 MB)</button> · WebGL 2 is required for the 3D viewer.</p>
    <p id="offline-status" role="status"></p>
    <p id="fullscreen-status" role="status"></p>
  </section>
</Layout>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('#atlas-frame');
  const requested = new URLSearchParams(location.search).get('view');
  const sharedViews = ['overview','hand','arm','tip','nerve','drg','spinal','medulla','thalamus','cortex','nmj','proprio'];
  const views = frame?.dataset.version === '3' ? [...sharedViews,'cervical','brain','cell'] : [...sharedViews,'pons','midbrain'];
  if (frame && requested && views.includes(requested)) frame.src += `#view=${requested}`;
  document.querySelector('#atlas-fullscreen')?.addEventListener('click', async () => {
    const shell = document.querySelector<HTMLElement>('#atlas-shell');
    const status = document.querySelector('#fullscreen-status');
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else if (shell?.requestFullscreen) await shell.requestFullscreen();
      else throw new Error('unavailable');
    } catch { if (status) status.textContent = 'Use Open viewer for a full-window view in this browser.'; }
  });
  const offline = document.querySelector<HTMLButtonElement>('#atlas-offline')!;
  offline.addEventListener('click', async () => {
    const status = document.querySelector('#offline-status')!;
    offline.disabled = true; status.textContent = 'Preparing the offline atlas…';
    try {
      const parts = await Promise.all([1,2,3].map(async part => {
        const response = await fetch(`/assets/finger-pathway-atlas/v3/Finger_Pathway_Atlas_v3.html.part-${part}.bin`);
        if (!response.ok) throw new Error('Download failed');
        return response.arrayBuffer();
      }));
      const url = URL.createObjectURL(new Blob(parts, {type:'text/html;charset=utf-8'}));
      const link = document.createElement('a');
      link.href = url; link.download = 'Finger_Pathway_Atlas_v3.html';
      document.body.appendChild(link); link.click(); link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
      status.textContent = 'Offline atlas downloaded. Open the HTML file in your browser.';
    } catch { status.textContent = 'The download could not finish. Try again.'; }
    finally { offline.disabled = false; }
  });
</script>

<style>
  .atlas-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:20px 0 14px}
  .edition{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin:0 0 7px}
  h1{font-size:clamp(30px,4vw,46px);font-weight:400;margin:0}
  .atlas-heading nav a[aria-current="page"]{font-weight:700;text-decoration:underline;text-underline-offset:5px}
  .atlas-heading nav{display:flex;align-items:center;flex-wrap:wrap;gap:14px;font-size:13px}
  button{font:inherit;color:var(--text);border:1px solid var(--border);background:var(--panel);border-radius:8px;padding:8px 12px;cursor:pointer}
  .viewer-shell{height:clamp(680px,82vh,1050px);background:#050b11;border:1px solid var(--borderStrong);border-radius:10px;overflow:hidden}
  iframe{display:block;width:100%;height:100%;border:0}
  .viewer-shell:fullscreen{height:100vh;width:100vw;border:0;border-radius:0}
  .atlas-guide{display:grid;grid-template-columns:1fr 1fr;gap:8px 30px;margin:22px 0}
  h2{font-size:24px;font-weight:400;margin:0 0 8px}p{font-size:14px;line-height:1.65;margin:0 0 10px}
  .scope,.download,#fullscreen-status,#offline-status{grid-column:1/-1;color:var(--muted);font-size:12px}.scope{border-top:1px solid var(--border);padding-top:16px;margin-top:8px}
  @media(max-width:760px){.atlas-heading{align-items:start;flex-direction:column}.atlas-guide{grid-template-columns:1fr}.viewer-shell{height:78svh;min-height:570px}.atlas-heading nav{gap:12px;font-size:12px}}
</style>
