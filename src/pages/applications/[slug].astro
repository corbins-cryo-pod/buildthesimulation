---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("applications");
  return posts.filter((p) => !p.data.draft).map((p) => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const strip = (t) => t.replace(/^\d+\s*[-—]\s*/, "");
const atlasTitle = (t) => strip(t).replace(/\s*\((company|lab) brief\)$/i, "");

const allDevices = await getCollection("designs");
const allOrgs = await getCollection("companies");
const devices = entry.data.devices.map((s) => allDevices.find((d) => d.slug === s)).filter(Boolean);
const orgs = entry.data.orgs.map((s) => allOrgs.find((o) => o.slug === s)).filter(Boolean);

const subtitle = entry.data.description ?? "BCI application entry.";
const titleNoPrefix = strip(entry.data.title);
---

<Layout pageTitle="Applications" subtitle={subtitle} description={entry.data.description}>
  <article class="post">
    <header class="postHead">
      <div class="kicker">Application — {entry.data.modality}</div>
      <h2 class="title">{titleNoPrefix}</h2>

      {entry.data.website ? (
        <p class="siteLink">
          <a class="siteBtn" href={entry.data.website} target="_blank" rel="noopener noreferrer">Source →</a>
        </p>
      ) : null}

      {entry.data.tags?.length ? <div class="meta">{entry.data.tags.join(" · ")}</div> : null}
    </header>

    <section class="links" aria-label="Device and organizations">
      <div class="linkBox">
        <h3>Device</h3>
        {devices.length ? (
          <ul>
            {devices.map((d) => <li><a href={`/devices/${d.slug}/`}>{strip(d.data.title)}</a></li>)}
          </ul>
        ) : (
          <p>No device entry covers this hardware yet. The spec card below lists what the source says.</p>
        )}
      </div>
      <div class="linkBox">
        <h3>Lab or organization</h3>
        {orgs.length ? (
          <ul>
            {orgs.map((o) => <li><a href={`/companies/${o.slug}/`}>{atlasTitle(o.data.title)}</a></li>)}
          </ul>
        ) : (
          <p>No atlas brief linked yet.</p>
        )}
      </div>
    </section>

    <section class="content">
      <Content />
    </section>
  </article>
</Layout>

<style>
  .post {
    padding: 26px 26px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--panel);
    max-width: 860px;
  }

  :global(main.wrap) {
    display: flex;
    flex-direction: column;
  }

  :global(main.wrap) .post {
    align-self: center;
    width: 100%;
  }

  .kicker {
    opacity: 0.7;
    font-size: var(--text-kicker);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .title {
    margin: 6px 0 0;
    font-size: var(--title-post);
    letter-spacing: -0.005em;
    line-height: 1.15;
  }

  .siteLink {
    margin: 12px 0 0;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .siteBtn {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panelStrong);
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .siteBtn:hover {
    border-color: var(--borderStrong);
    background: var(--panelHover);
    transform: translateY(-1px);
  }

  .meta {
    margin-top: 8px;
    opacity: 0.72;
    font-size: var(--text-meta);
  }

  .content :global(h1) {
    display: none;
  }

  .content :global(p) {
    line-height: 1.55;
    margin: 0.95em 0;
  }

  .content :global(p:first-of-type) {
    font-size: 1.08em;
    line-height: 1.55;
  }

  .content :global(h2) {
    margin: 1.2em 0 0.2em;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: var(--title-section);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .content :global(h3) {
    margin: 1em 0 0.2em;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.12;
  }

  .links {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .linkBox {
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--panelStrong);
  }

  .linkBox h3 {
    margin: 0 0 6px;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.12;
  }

  .linkBox ul { margin: 0; padding-left: 1.1em; }
  .linkBox li { margin: 0.25em 0; }
  .linkBox p { margin: 0; opacity: 0.78; line-height: 1.5; }
  .linkBox a { color: inherit; }

  @media (max-width: 680px) {
    .links { grid-template-columns: 1fr; }
  }
</style>
