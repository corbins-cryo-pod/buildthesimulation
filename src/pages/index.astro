---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CatalogContents from '../components/CatalogContents.astro';
import { buildCatalogContents } from '../lib/catalog-contents.js';

const [companies, devices, applications] = await Promise.all([
  getCollection('companies'), getCollection('designs'), getCollection('applications'),
]);
const groups = buildCatalogContents(companies, devices, applications);
---
<Layout compactHeader={false} description="An alphabetical index of neural-interface companies and labs, their linked devices, and documented applications. Explore simulation laboratories through the main navigation.">
  <CatalogContents groups={groups} />
</Layout>
