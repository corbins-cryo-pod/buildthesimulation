---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CatalogContents from '../components/CatalogContents.astro';
import { buildCatalogContents } from '../lib/catalog-contents.js';
import { simulationLinks } from '../data/simulations.js';

const [companies, devices, applications] = await Promise.all([
  getCollection('companies'), getCollection('designs'), getCollection('applications'),
]);
const groups = buildCatalogContents(companies, devices, applications);
---
<Layout compactHeader={false} description="An alphabetical index of neural-interface companies and labs, their linked devices, and documented applications. Explore simulation laboratories through the main navigation.">
  <section class="home-intro" aria-label="Search neural interface information">
    <button class="hero-search" type="button" data-discovery-trigger aria-haspopup="dialog" aria-label="Search the entire site">
      <span class="search-lens" aria-hidden="true">⌕</span>
      <span>Search devices, companies, technologies, studies…</span>
    </button>
    <div class="try-search" aria-label="Example searches">
      <span>Try</span>
      <button type="button" data-discovery-trigger data-discovery-query="Neuralink">Neuralink</button>
      <button type="button" data-discovery-trigger data-discovery-query="ECoG">ECoG</button>
      <button type="button" data-discovery-trigger data-discovery-query="speech">Speech decoding</button>
      <button type="button" data-discovery-trigger data-discovery-query="stentrode">Stentrode</button>
    </div>
  </section>
  <section class="home-simulations" aria-labelledby="home-simulations-title">
    <header>
      <h2 id="home-simulations-title">Simulations</h2>
      <a href="/simulations/">View all →</a>
    </header>
    <ul>
      {simulationLinks.map(simulation => <li><a href={simulation.href}>{simulation.title}</a></li>)}
    </ul>
  </section>
  <CatalogContents groups={groups} />
</Layout>

<style>
  .home-intro { padding-top: 12px; }
  .hero-search { display: flex; align-items: center; gap: 14px; width: min(100%, 850px); text-align: left; padding: 18px 19px; color: var(--text); border: 1px solid var(--borderStrong); border-radius: 0; background: var(--panelStrong); cursor: pointer; transition: background .14s, border-color .14s; }
  .hero-search:hover { background: var(--panelHover); border-color: var(--text); }
  .hero-search:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .hero-search > span:nth-child(2) { flex: 1; min-width: 0; font: normal 18px/1.3 var(--font-body); color: var(--muted); }
  .search-lens { font-size: 30px; line-height: .7; color: var(--muted); }
  .hero-search kbd { padding: 5px 7px; border: 1px solid var(--border); border-radius:0; font: normal 13px var(--font-body); color: var(--muted); white-space: nowrap; }
  .try-search { display: flex; flex-wrap: wrap; align-items: baseline; gap: 11px; margin-top: 14px; font-size: 15px; color: var(--muted); }
  .try-search button { background: transparent; padding: 0; color: var(--text); text-decoration: underline; text-decoration-color: var(--borderStrong); text-underline-offset: 4px; border: 0; cursor: pointer; font-size: 15px; }
  .try-search button:hover { text-decoration-color: currentColor; }
  .hero-search { width: 100%; }
  @media (max-width: 720px) {
    .hero-search { padding: 14px; }
    .hero-search > span:nth-child(2) { font-size: 16px; }
  }
  .home-simulations { margin-top:22px; border:1px solid var(--text); }
  .home-simulations header { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:12px; padding:10px 12px; border-bottom:1px solid var(--text); }
  .home-simulations h2 { grid-column:2; margin:0; font-family:'Twentieth Century',Arial,sans-serif!important; font-size:14px!important; font-weight:700; font-style:normal; line-height:1.1!important; letter-spacing:.1em!important; text-transform:uppercase; text-align:center; }
  .home-simulations header>a { justify-self:end; color:inherit; font-size:13px; line-height:1.1!important; white-space:nowrap; }
  .home-simulations ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:5px 28px; list-style:none; margin:0; padding:11px 12px 12px; }
  .home-simulations li { margin:0; padding:0; min-width:0; line-height:1.08!important; text-align:left; }
  .home-simulations li a { display:block; color:inherit; text-decoration:none; font-family:'Twentieth Century',Arial,sans-serif!important; font-size:15px; font-weight:700; font-style:normal; line-height:1.08!important; letter-spacing:.05em!important; overflow-wrap:break-word; }
  .home-simulations li a:hover { text-decoration:underline; text-underline-offset:3px; }
  @media(max-width:600px) { .home-simulations ul { grid-template-columns:1fr; gap:6px; } }
</style>
