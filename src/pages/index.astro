---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { deviceModels } from "../lib/devices/catalog.js";

const [companies, devices, applications] = await Promise.all([
  getCollection("companies"), getCollection("designs"), getCollection("applications"),
]);
const count = entries => entries.filter(entry => !entry.data.draft).length;
const routes = [
  {name: "Devices", href: "/devices/", kicker: "Hardware", desc: "Specifications, photographs and 3D references.", number: "01"},
  {name: "Companies & labs", href: "/companies/", kicker: "Directory", desc: "Who's developing what, where, and at what stage.", number: "02"},
  {name: "Applications", href: "/applications/", kicker: "Evidence", desc: "Studies, clinical programs and demonstrated uses.", number: "03"},
  {name: "Simulations & tools", href: "/simulations/", kicker: "Explore", desc: "Run experiments or design neural interfaces.", number: "04"},
];
const topics = [
  {label: "Intracortical", href: "/devices/?iface=intracortical"},
  {label: "ECoG", href: "/devices/?iface=ecog"},
  {label: "Peripheral nerve", href: "/devices/?axis=peripheral-nerve"},
  {label: "Human studies", href: "/companies/?stage=3"},
  {label: "Clinical products", href: "/companies/?stage=4"},
  {label: "Speech BCI", href: "/applications/?q=speech"},
  {label: "3D models", href: "/devices/models/"},
];
---
<Layout compactHeader={false} description="Find neural interface devices, companies, studies, technical specifications and interactive neuroengineering tools.">
  <section class="home-intro" aria-label="Search neural interface information">
    <button class="hero-search" type="button" data-discovery-trigger aria-haspopup="dialog" aria-label="Search the entire site">
      <span class="search-lens" aria-hidden="true">⌕</span>
      <span>Search devices, companies, technologies, studies…</span>
    </button>
    <div class="try-search" aria-label="Example searches">
      <span>Try</span>
      <button type="button" data-discovery-trigger data-discovery-query="Neuralink">Neuralink</button>
      <button type="button" data-discovery-trigger data-discovery-query="ECoG">ECoG</button>
      <button type="button" data-discovery-trigger data-discovery-query="speech">Speech decoding</button>
      <button type="button" data-discovery-trigger data-discovery-query="stentrode">Stentrode</button>
    </div>
  </section>

  <section class="home-paths" aria-labelledby="home-paths-title">
    <div class="section-head">
      <h2 id="home-paths-title">Start Here</h2>
    </div>
    <div class="route-grid">
      {routes.map(route => (
        <a class="route" href={route.href}>
          <div class="route-top"><span>{route.kicker}</span><span aria-hidden="true">→</span></div>
          <h3>{route.name}</h3>
          <p>{route.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="home-topics" aria-labelledby="home-topics-title">
    <h2 id="home-topics-title">Explore by topic</h2>
    <div class="topic-links">
      {topics.map(topic => <a href={topic.href}>{topic.label} <span aria-hidden="true">→</span></a>)}
    </div>
  </section>
  <div class="home-footerline" aria-label="Catalog size">
    <span>{count(devices)} devices</span><span aria-hidden="true">·</span>
    <span>{count(companies)} organizations</span><span aria-hidden="true">·</span>
    <span>{count(applications)} applications</span><span aria-hidden="true">·</span>
    <span>{Object.keys(deviceModels).length} 3D references</span>
  </div>
</Layout>
<style>
  .home-intro { padding: 12px 0 19px; }
  .eyebrow { margin: 0 0 14px; color: var(--muted); font-size: 15px; letter-spacing: .07em; text-transform: uppercase; }
  .home-intro h1 { font-size: clamp(54px, 7.5vw, 98px); letter-spacing: -.012em; line-height: .98; max-width: 900px; }
  .intro { max-width: 720px; font-size: clamp(19px, 2.1vw, 23px); line-height: 1.35; color: var(--muted); margin: 19px 0 28px; }
  .hero-search { display: flex; align-items: center; gap: 14px; width: min(100%, 850px); text-align: left; padding: 18px 19px; color: var(--text); border: 1px solid var(--borderStrong); border-radius: 0; background: var(--panelStrong); cursor: pointer; transition: background .14s, border-color .14s; }
  .hero-search:hover { background: var(--panelHover); border-color: var(--text); }
  .hero-search:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .hero-search > span:nth-child(2) { flex: 1; min-width: 0; font: normal 18px/1.3 var(--font-body); color: var(--muted); }
  .search-lens { font-size: 30px; line-height: .7; color: var(--muted); }
  .hero-search kbd { padding: 5px 7px; border: 1px solid var(--border); border-radius:0; font: normal 13px var(--font-body); color: var(--muted); white-space: nowrap; }
  .try-search { display: flex; flex-wrap: wrap; align-items: baseline; gap: 11px; margin-top: 14px; font-size: 15px; color: var(--muted); }
  .try-search button { background: transparent; padding: 0; color: var(--text); text-decoration: underline; text-decoration-color: var(--borderStrong); text-underline-offset: 4px; border: 0; cursor: pointer; font-size: 15px; }
  .try-search button:hover { text-decoration-color: currentColor; }
  .home-paths { margin: 28px 0 0; }
  .section-head { display: flex; gap: 14px; align-items: baseline; justify-content: space-between; margin-bottom: 13px; }
  .section-head h2, .home-topics h2 { font: normal 29px/1.1 var(--font-heading); margin: 0; }
  .section-head h2 { font-size: clamp(38px, 4.5vw, 52px); }
  .section-head p { margin: 0; color: var(--muted); font-size: 16px; }
  .route-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .route { display: block; min-width: 0; padding: 20px 21px; border: 1px solid var(--border); border-radius: 0; text-decoration: none; background: var(--panel); transition: background .14s, border-color .14s, transform .14s; }
  .route:hover { background: var(--panelStrong); border-color: var(--borderStrong); transform: translateY(-2px); }
  .route-top { display: flex; justify-content: space-between; font-size: 14px; color: var(--muted); }
  .route-top span:last-child { font-size: 19px; line-height: 1; }
  .route h3 { font-size: clamp(29px, 3.7vw, 38px); line-height: 1.05; margin: 19px 0 7px; }
  .route p { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.34; }
  .home-topics { margin: 30px 0 12px; }
  .topic-links { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px; }
  .topic-links a { border: 1px solid var(--border); border-radius: 0; background: var(--panel); color: var(--text); text-decoration: none; padding: 9px 12px; font-size: 16px; line-height: 1.2; }
  .topic-links a:hover { background: var(--panelStrong); border-color: var(--borderStrong); }
  .topic-links a span { color: var(--muted); font-size: 12px; margin-left: 4px; }
  .home-footerline { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 22px; font-size: 14px; color: var(--muted); }
  @media (max-width: 720px) {
    .home-intro { padding-top: 8px; }
    .home-intro h1 { font-size: clamp(49px, 11vw, 75px); }
    .route-grid { grid-template-columns: 1fr; }
    .route { padding: 15px 17px; }
    .route h3 { margin: 12px 0 5px; }
    .section-head { display: block; }
    .section-head p { margin-top: 5px; }
    .hero-search { padding: 14px; }
    .hero-search > span:nth-child(2) { font-size: 16px; }
    .hero-search kbd { display: none; }
  }
</style>
