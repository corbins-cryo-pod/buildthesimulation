---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const companies = (await getCollection("companies"))
  .filter((p) => !p.data.draft);

const devices = (await getCollection("designs")).filter((p) => !p.data.draft);
---

<Layout withHero={true}>
  <section class="card">
    <div class="row"><h2>Start here</h2></div>
    <div class="pathGrid">
      <div class="path">
        <a class="pathMain" href="/simulations/">
          <h3>Simulations</h3>
          <p>Place electrodes, change thresholds and watch the recorded signals respond in a cortical slab or a nerve cross-section.</p>
        </a>
        <div class="subLinks">
          <a href="/simulations/cortex-slab/">Cortical recording lab</a>
          <a href="/sim/">Peripheral nerve cross-section</a>
        </div>
      </div>
      <div class="path">
        <a class="pathMain" href="/devices/">
          <h3>Explore devices</h3>
          <p>Search for an existing brain computer interface.</p>
        </a>
        <div class="subLinks">
          <a href="/devices/models/">3D models</a>
        </div>
      </div>
      <a class="path pathMain" href="/devices/designer/">
        <h3>Designer</h3>
        <p>Build grids, circles and custom arrays. Shape the contacts, compare lead arrangements and export your geometry.</p>
      </a>
      <a class="path pathMain" href="/companies/">
        <h3>BCI Atlas</h3>
        <p>Browse the companies and labs building neural interfaces.</p>
      </a>
    </div>
  </section>

  <section class="card">
    <div class="row"><h2>Platform snapshot</h2></div>
    <div class="stats">
      <div class="stat"><div class="num">{companies.length}</div><div class="label">Companies / labs</div></div>
      <div class="stat">
        <div class="num">{devices.length}</div>
        <div class="label">Devices</div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .card { margin-top: 14px; padding: 22px; border-radius: 16px; border: 1px solid var(--border); background: var(--panel); }
  .row { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  h2 { margin: 0 0 10px; font-size: var(--title-section); }
  .pathGrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .path { display: block; padding: 14px; text-decoration: none; color: inherit; border: 1px solid var(--border); border-radius: 14px; background: var(--panelStrong); }
  .path:hover { border-color: var(--borderStrong); background: var(--panelHover); transform: translateY(-1px); }
  .path h3 { margin: 0 0 6px; font-size: var(--title-card); }
  .pathMain { display: block; text-decoration: none; color: inherit; }
  .subLinks { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .subLinks a { border: 1px solid var(--border); border-radius: 10px; padding: 6px 10px; text-decoration: none; color: inherit; font-size: 16px; font-style: italic; background: var(--panel); }
  .subLinks a:hover { border-color: var(--borderStrong); background: var(--panelHover); }
  .path p { font-style: italic; margin: 0; opacity: 0.8; line-height: 1.45; }
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .stat { padding: 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--panelStrong); }
  .num { font-size: 32px; font-family: var(--font-heading); font-weight: 400; line-height: 1; }
  .label { margin-top: 6px; font-size: var(--text-meta); font-style: italic; opacity: 0.72; }
  @media (max-width: 680px) { .pathGrid, .stats { grid-template-columns: 1fr; } .card { padding: 18px; } }
</style>
