---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { compareDeviceEntries } from "../../lib/device-order.js";
import DevicesDirectory from "../../components/DevicesDirectory";
import { resolveFacets } from "../../lib/device-facets.js";
import { getDevicePhoto } from "../../lib/device-photos.js";

function stripPrefix(title) {
  return title.replace(/^\d+\s*[-—]\s*/, "");
}

const entries = (await getCollection("designs"))
  .filter((p) => !p.data.draft)
  .sort(compareDeviceEntries);

const normalized = entries.map((p) => ({
  title: stripPrefix(p.data.title),
  slug: p.slug,
  description: p.data.description ?? "",
  order: p.data.order,
  device_id: p.data.device_id ?? "",
  interface_class: p.data.interface_class,
  status: p.data.status,
  modality: p.data.modality,
  website: p.data.website ?? "",
  last_updated: p.data.last_updated?.toISOString().slice(0,10) ?? "",
  tags: p.data.tags ?? [],
  facets: resolveFacets(p.data),
  photo: getDevicePhoto(p.data.device_id),
}));
---

<Layout
  pageTitle="Devices"
  subtitle="See the hardware. Explore neural interfaces and inspect their 3D models."
  description="Explore implanted neural interfaces through source-credited hardware photographs, searchable specification sheets, and 3D reference models."
>
  <section class="catalog-heading">
    <h3><a href="/devices/models/">3D Model Finder</a></h3>
  </section>
  <DevicesDirectory client:load entries={normalized} />
</Layout>

<style>
  .catalog-heading { margin: 26px 0 18px; }
  .catalog-heading h3 { font-size: var(--title-card); font-style: italic; margin: 0; }
  .catalog-heading a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 4px; }
</style>
