---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import DevicesDirectory from "../../components/DevicesDirectory";

function stripPrefix(title) {
  return title.replace(/^\d+\s*[-—]\s*/, "");
}

const entries = (await getCollection("designs"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const ar = a.data.successRank ?? Number.POSITIVE_INFINITY;
    const br = b.data.successRank ?? Number.POSITIVE_INFINITY;
    if (ar !== br) return ar - br;
    return stripPrefix(a.data.title).localeCompare(stripPrefix(b.data.title));
  });

const normalized = entries.map((p) => ({
  title: stripPrefix(p.data.title),
  slug: p.slug,
  description: p.data.description ?? "",
  order: p.data.order,
  device_id: p.data.device_id ?? "",
  interface_class: p.data.interface_class,
  status: p.data.status,
  modality: p.data.modality,
  website: p.data.website ?? "",
  last_updated: p.data.last_updated?.toISOString().slice(0,10) ?? "",
  tags: p.data.tags ?? [],
}));
---

<Layout
  pageTitle="Devices"
  subtitle="Explore neural interfaces, inspect 3D models and design your own electrodes."
  description="BCI Devices: a searchable directory with curated facets (axis, interface type, directionality, form factor)."
>
  <DevicesDirectory client:load entries={normalized} />
</Layout>

<style>
  .tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .tool { display: flex; flex-direction: column; padding: 22px; border: 1px solid var(--border); border-radius: 16px; background: var(--panel); text-decoration: none; color: inherit; }
  .tool:hover { border-color: var(--borderStrong); background: var(--panelHover); }
  .eyebrow { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; opacity: .72; }
  .tool h2 { font-size: var(--title-card); margin: 10px 0 6px; }
  .tool p { margin: 0 0 18px; line-height: 1.5; opacity: .82; }
  .tool-link { margin-top: auto; font-size: 18px; font-style: italic; }
  .catalog-title { font-size: var(--title-section); margin: 26px 0 8px; }
  .muted { opacity: .72; margin: 0; line-height: 1.5; }
  @media (max-width: 680px) { .tools { grid-template-columns: 1fr; } .tool { padding: 18px; } }
</style>
