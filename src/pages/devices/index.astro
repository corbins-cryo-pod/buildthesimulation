---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { compareDeviceEntries } from "../../lib/device-order.js";
import DevicesDirectory from "../../components/DevicesDirectory";
import { deviceModels } from "../../lib/devices/catalog.js";

function stripPrefix(title) {
  return title.replace(/^\d+\s*[-—]\s*/, "");
}

const entries = (await getCollection("designs"))
  .filter((p) => !p.data.draft)
  .sort(compareDeviceEntries);

const normalized = entries.map((p) => ({
  title: stripPrefix(p.data.title),
  slug: p.slug,
  description: p.data.description ?? "",
  order: p.data.order,
  device_id: p.data.device_id ?? "",
  interface_class: p.data.interface_class,
  status: p.data.status,
  modality: p.data.modality,
  website: p.data.website ?? "",
  last_updated: p.data.last_updated?.toISOString().slice(0,10) ?? "",
  tags: p.data.tags ?? [],
}));
---

<Layout
  pageTitle="Devices"
  subtitle="Explore neural interfaces, inspect 3D models and design your own electrodes."
  description="BCI Devices: a searchable directory with curated facets (axis, interface type, directionality, form factor)."
>
  <section class="tools" aria-label="Device tools">
    <a class="tool" href="/devices/models/">
      <span class="eyebrow">{Object.keys(deviceModels).length} reference models</span>
      <h2>3D model finder</h2>
      <p>Explore implant geometry, inspect electrode details and download models with published dimensions and source notes.</p>
      <span class="tool-link">Find a device model →</span>
    </a>
  </section>
  <p class="muted">Studies and clinical programs that use these devices are listed under <a href="/applications/">Applications</a>.</p>
  <h2 class="catalog-title">Device catalog</h2>
  <p class="muted">Browse {entries.length} catalog records, grouped by documented device family, by interface type, anatomy and use case. Family cards highlight a documented reference configuration, not a claim of current availability or clinical superiority. Parallel branches and older versions remain accessible inside each family card. Export results CSV downloads the current filtered list, including stable IDs, source links and review dates. Evidence stage is not regulatory approval.</p>
  <p class="catalog-order">Featured order: Utah arrays, Neuralink and Neuropixels first, followed by selected implants and research interfaces.</p>
  <DevicesDirectory client:load entries={normalized} />
</Layout>

<style>
  .tools { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .tool { display: flex; flex-direction: column; padding: 22px; border: 1px solid var(--border); border-radius: 16px; background: var(--panel); text-decoration: none; color: inherit; }
  .tool:hover { border-color: var(--borderStrong); background: var(--panelHover); }
  .eyebrow { font-size: var(--text-kicker); font-style: italic; opacity: .72; }
  .tool h2 { font-size: var(--title-card); margin: 10px 0 6px; }
  .tool p { margin: 0 0 18px; line-height: 1.5; opacity: .82; }
  .tool-link { margin-top: auto; font-size: 18px; font-style: italic; }
  .catalog-title { font-size: var(--title-section); margin: 26px 0 8px; }
  .catalog-order { margin: 12px 0 0; font-size: var(--text-meta); font-style: italic; opacity: .72; }
  .muted { opacity: .72; margin: 0; line-height: 1.5; }
  @media (max-width: 680px) { .tools { grid-template-columns: 1fr; } .tool { padding: 18px; } }
</style>
