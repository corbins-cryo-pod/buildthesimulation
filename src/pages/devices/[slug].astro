---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import RealRecordingExplorer from "../../components/RealRecordingExplorer";
import NeuropixelsExplorer from "../../components/NeuropixelsExplorer";
import DeviceModelViewer from "../../components/DeviceModelViewer";
import { getDeviceModel } from "../../lib/devices/catalog.js";

export async function getStaticPaths() {
  const posts = await getCollection("designs");
  return posts.filter((p) => !p.data.draft).map((p) => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const apps = (await getCollection("applications"))
  .filter((a) => !a.data.draft && a.data.devices.includes(entry.slug))
  .sort((a, b) => a.data.order - b.data.order);
const stripNum = (s) => s.replace(/^\d+\s*[-—]\s*/, "");
const { Content } = await render(entry);

const subtitle = entry.data.description ?? "BCI device entry.";
const titleNoPrefix = entry.data.title.replace(/^\d+\s*—\s*/, "");
---

<Layout pageTitle="Devices" subtitle={subtitle} description={entry.data.description}>
  <article class="post">
    <header class="postHead">
      <div class="kicker">Device — {entry.data.modality}</div>
      <h2 class="title">{titleNoPrefix}</h2>

      {entry.data.website ? (
        <p class="siteLink">
          <a class="siteBtn" href={entry.data.website} target="_blank" rel="noopener noreferrer">Official site →</a>
        </p>
      ) : null}

      {entry.data.tags?.length ? <div class="meta">{entry.data.tags.join(" · ")}</div> : null}
    </header>

    {getDeviceModel(entry.data.device_id) && <DeviceModelViewer deviceId={entry.data.device_id} client:visible />}

    {entry.data.device_id === "BTSD-0001" && <RealRecordingExplorer client:visible />}
    {entry.data.device_id === "BTSD-0004" && <NeuropixelsExplorer client:visible />}

    {apps.length ? (
      <section class="appList" aria-label="Applications of this device">
        <h3>Applications</h3>
        <ul>
          {apps.map((a) => <li><a href={`/applications/${a.slug}/`}>{stripNum(a.data.title)}</a></li>)}
        </ul>
      </section>
    ) : null}

    <section class="content">
      <Content />
    </section>
  </article>
</Layout>

<style>
  .post {
    padding: 26px 26px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--panel);
    max-width: 860px;
  }

  :global(main.wrap) {
    display: flex;
    flex-direction: column;
  }

  :global(main.wrap) .post {
    align-self: center;
    width: 100%;
  }

  .kicker {
    opacity: 0.7;
    font-size: var(--text-kicker);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .title {
    margin: 6px 0 0;
    font-size: var(--title-post);
    letter-spacing: -0.005em;
    line-height: 1.15;
  }

  .siteLink {
    margin: 12px 0 0;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .siteBtn {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panelStrong);
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .siteBtn:hover {
    border-color: var(--borderStrong);
    background: var(--panelHover);
    transform: translateY(-1px);
  }

  .meta {
    margin-top: 8px;
    opacity: 0.72;
    font-size: var(--text-meta);
  }

  .content :global(h1) {
    display: none;
  }

  .content :global(p) {
    line-height: 1.55;
    margin: 0.95em 0;
  }

  .content :global(p:first-of-type) {
    font-size: 1.08em;
    line-height: 1.55;
  }

  .content :global(h2) {
    margin: 1.2em 0 0.2em;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: var(--title-section);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .content :global(h3) {
    margin: 1em 0 0.2em;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.12;
  }

  .appList {
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--panelStrong);
  }

  .appList h3 {
    margin: 0 0 6px;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.12;
  }

  .appList ul { margin: 0; padding-left: 1.1em; }
  .appList li { margin: 0.25em 0; }
  .appList a { color: inherit; }
</style>
