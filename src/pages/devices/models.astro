---
import Layout from '../../layouts/Layout.astro';
import { deviceModels } from '../../lib/devices/catalog.js';
---
<Layout pageTitle="3D model finder" subtitle="From physical electrodes to simulation geometry." description="Inspect and download dimensioned implanted neural-interface geometries: shanks, contact sheets, cuffs, wires, and segmented leads, with source measurements and reconstruction limits.">
  <section class="intro">
    <p>Rotate, inspect and download {Object.keys(deviceModels).length} reference configurations from the implant catalog. Each model includes published dimensions, reference images and explicit reconstruction notes.</p>
    <p>Full structures, contact-window crops and package envelopes are labeled separately. Documented measurements, reconstruction choices and omitted details are listed on each device page.</p>
    <p>Preview the implanted geometry, then open a model to rotate it, inspect its contacts and compare its sources. Materials follow reference images; the viewer can highlight electrodes or reveal a cuff’s interior. Detail views preserve dimensions and show a scale bar.</p>
  </section>
  <div class="finder">
    <label>Search 3D models<input id="model-search" type="search" placeholder="Device name, interface type or dimensions…" /></label>
    <output id="model-count" aria-live="polite">{Object.keys(deviceModels).length} models</output>
  </div>
  <div class="models">
    {Object.values(deviceModels).map(model => <a class="model-card" href={`/devices/${model.slug}/#model-3d`}>
      <div class="model-preview"><img src={`/models/devices/${model.id}.webp`} alt={`Rendered geometry of ${model.name}; view and scale marked on the image`} width="720" height="460" loading="lazy" decoding="async" /></div>
      <div class="model-card-copy">
      <span class="eyebrow">{model.kind === 'planar-probe' ? 'PENETRATING PROBE' : model.kind === 'cylindrical-lead' ? 'IMPLANTED LEAD CONTACT WINDOW' : ['nerve-cuff', 'flat-cuff'].includes(model.kind) ? 'PERIPHERAL NERVE CUFF' : model.kind === 'exposed-wire' ? 'INTRAFASCICULAR WIRE' : model.kind === 'carbon-row' ? 'INTRACORTICAL FIBER ROW' : model.kind === 'chip-envelope' ? 'WIRELESS CHIP PACKAGE ENVELOPE' : model.kind === 'surface-grid' ? (model.id.startsWith('neuropixels-') ? 'INTRACORTICAL RECORDING WINDOW' : model.deviceId === 'BTSD-0006' ? 'INTRAFASCICULAR CONTACT WINDOW' : 'SURFACE CONTACT PATCH') : model.kind === 'stentrode' ? 'ENDOVASCULAR STENT ARRAY' : model.kind === 'connexus' ? 'CORTICAL MICROWIRE MODULE' : model.kind === 'neuralink' ? 'FLEXIBLE THREAD IMPLANT' : model.kind === 'utah' ? 'PENETRATING ARRAY' : 'CMOS RECORDING SHANK'}</span>
      <h2>{model.name}</h2>
      <p>{model.modeledScope ?? model.specs[0][1]}</p>
      <p class="model-measurement">{model.specs[1]?.[0]}: {model.specs[1]?.[1]}</p>
      <span>Open interactive 3D model →</span>
      </div>
    </a>)}
  </div>
  <p id="model-empty" hidden>No matching models. Try another device name or dimension.</p>
  <p><a href="/devices/">← All devices</a></p>
  <script>
    const input = document.querySelector<HTMLInputElement>('#model-search');
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.model-card'));
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let count = 0;
      for (const card of cards) {
        card.hidden = !(card.textContent ?? '').toLowerCase().includes(query);
        if (!card.hidden) count++;
      }
      const output = document.getElementById('model-count');
      if (output) output.textContent = `${count} model${count === 1 ? '' : 's'}`;
      const empty = document.getElementById('model-empty');
      if (empty) empty.hidden = count !== 0;
    });
  </script>
</Layout>
<style>
  .finder { display: flex; align-items: end; flex-wrap: wrap; gap: 14px; margin-top: 22px; }
  .finder label { flex: 1; min-width: min(280px, 100%); font-size: 18px; font-style: italic; }
  .finder input { display: block; width: 100%; margin-top: 8px; border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; color: inherit; background: var(--panelStrong); font-size: 18px; font-style: normal; }
  .finder output { font-size: 16px; padding-bottom: 12px; opacity: .72; }
  .model-card[hidden] { display: none; }
  .intro{max-width:800px;line-height:1.8}.intro p{opacity:.8}
  .models{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:16px;margin:28px 0}
  .model-card{overflow:hidden;border:1px solid var(--border);border-radius:16px;background:var(--panel);text-decoration:none;color:inherit;transition:border-color .16s,background .16s}
  .model-preview{aspect-ratio:720/460;background:var(--scene-bg);border-bottom:1px solid var(--border);overflow:hidden}.model-preview img{display:block;width:100%;height:100%;object-fit:contain;transition:transform .25s}.model-card:hover .model-preview img{transform:scale(1.025)}
  .model-card-copy{padding:22px}.model-card-copy>span:last-child{font-size:17px;font-style:italic}.model-measurement{font-size:14px}.model-card:focus-visible{outline:2px solid currentColor;outline-offset:4px}
  .model-card:hover{background:var(--panelHover);border-color:var(--borderStrong)}
  .model-card h2{font-size:var(--title-card);line-height:1.15;margin:14px 0}.model-card p{line-height:1.7;opacity:.75}
  .eyebrow{font-size:12px;letter-spacing:.15em;opacity:.7}
</style>
