---
import Layout from '../../layouts/Layout.astro';
import { deviceModels } from '../../lib/devices/catalog.js';
---
<Layout pageTitle="3D model finder" subtitle="From physical electrodes to simulation geometry." description="Explore source-documented 3D reference models of Paradromics Connexus, Neuralink N1, Synchron Stentrode, Utah, Utah Slanted, Neuropixels and NeuroGrid.">
  <section class="intro">
    <p>Rotate, inspect and download {Object.keys(deviceModels).length} reference configurations from the implant catalog. Each model includes published dimensions, reference images and explicit reconstruction notes.</p>
    <p>Gold highlights electrode sites. Detail views zoom the camera while preserving scale. Housing and lead envelopes are included where described; their assumptions travel with the geometry exports. These are geometric references for simulation development, without electrical or tissue-response predictions.</p>
  </section>
  <div class="finder">
    <label>Search 3D models<input id="model-search" type="search" placeholder="Device name, interface type or dimensions…" /></label>
    <output id="model-count" aria-live="polite">{Object.keys(deviceModels).length} models</output>
  </div>
  <div class="models">
    {Object.values(deviceModels).map(model => <a class="model-card" href={`/devices/${model.slug}/#model-3d`}>
      <span class="eyebrow">{model.kind === 'surface-grid' ? 'CORTICAL SURFACE RECORDING PATCH' : model.kind === 'stentrode' ? 'ENDOVASCULAR STENT ARRAY' : model.kind === 'connexus' ? 'CORTICAL MICROWIRE MODULE' : model.kind === 'neuralink' ? 'FLEXIBLE THREAD IMPLANT' : model.kind === 'utah' ? 'PENETRATING ARRAY' : 'CMOS RECORDING SHANK'}</span>
      <h2>{model.name}</h2>
      <p>{model.specs[0][1]} · {model.kind === 'surface-grid' ? '10 × 10 µm contacts' : model.kind === 'stentrode' ? '40 × 8 mm scaffold' : model.kind === 'connexus' ? '300 µm pitch' : model.kind === 'neuralink' ? '200 µm along-thread pitch' : model.kind === 'utah' ? '400 µm pitch' : '12 × 12 µm contacts'}</p>
      <span>Open interactive 3D model →</span>
    </a>)}
  </div>
  <p id="model-empty" hidden>No matching models. Try another device name or dimension.</p>
  <p><a href="/devices/">← All devices</a></p>
  <script>
    const input = document.querySelector<HTMLInputElement>('#model-search');
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.model-card'));
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let count = 0;
      for (const card of cards) {
        card.hidden = !(card.textContent ?? '').toLowerCase().includes(query);
        if (!card.hidden) count++;
      }
      const output = document.getElementById('model-count');
      if (output) output.textContent = `${count} model${count === 1 ? '' : 's'}`;
      const empty = document.getElementById('model-empty');
      if (empty) empty.hidden = count !== 0;
    });
  </script>
</Layout>
<style>
  .finder { display: flex; align-items: end; flex-wrap: wrap; gap: 14px; margin-top: 22px; }
  .finder label { flex: 1; min-width: min(280px, 100%); font-size: 18px; font-style: italic; }
  .finder input { display: block; width: 100%; margin-top: 8px; border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; color: inherit; background: var(--panelStrong); font-size: 18px; font-style: normal; }
  .finder output { font-size: 16px; padding-bottom: 12px; opacity: .72; }
  .model-card[hidden] { display: none; }
  .intro{max-width:800px;line-height:1.8}.intro p{opacity:.8}
  .models{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:16px;margin:28px 0}
  .model-card{padding:24px;border:1px solid var(--border);border-radius:16px;background:var(--panel);text-decoration:none;color:inherit}
  .model-card:hover{background:var(--panelHover);border-color:var(--borderStrong)}
  .model-card h2{font-size:var(--title-card);line-height:1.15;margin:14px 0}.model-card p{line-height:1.7;opacity:.75}.model-card>span:last-child{font-size:18px;font-style:italic}
  .eyebrow{font-size:12px;letter-spacing:.15em;opacity:.7}
</style>
