---
import Layout from '../../../layouts/Layout.astro';
import NeuralInterfaceDesigner from '../../../components/NeuralInterfaceDesigner.jsx';
---
<Layout pageTitle="Neural interface designer" subtitle="" description="Micrometer-scale electrode layout designer with circle, square and ring contacts, array generators, automatic lead routing, multilayer concept stacks and physical-scale exports.">
  <p class="intro">Read the guide for this tool <a href="/devices/designer/guide/">here →</a></p>
  <NeuralInterfaceDesigner client:load />
  <noscript><p class="intro">The designer needs JavaScript. The <a href="/devices/designer/guide/">guide</a> works without it.</p></noscript>
</Layout>
<style>
  .intro { margin: 14px 0 0; opacity: 0.82; line-height: 1.6; max-width: 85ch; font-size: 17px; }
  .intro a { color: inherit; text-underline-offset: 3px; }
</style>
