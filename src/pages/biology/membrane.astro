---
import Layout from '../../layouts/Layout.astro';
import MembraneExplorer from '../../components/MembraneExplorer.jsx';
import {readFileSync} from 'node:fs';
import {CHANNELS} from '../../lib/cortex/active-channels.js';
const fit=JSON.parse(readFileSync('public/models/cortex/allen571654895/optim_param_571654895.json','utf8'));
const sections=['soma','axon','apic','dend'];
---
<Layout pageTitle="Membrane Biophysics" subtitle="" description="Interactive gating curves from the Cortex Laboratory channel mechanisms, with fitted conductance densities.">
 <nav class="local"><a href="/biology/">Biology</a><a href="/biology/current-clamp/">Current Clamp</a><a href="/cells/">Cell Model Atlas</a><a href="/cortex/?cell=allen-human-571654895%2F1">Cortex Laboratory</a></nav>
 <MembraneExplorer client:load />
 <section class="panel"><h2>Fitted conductance density · S/cm²</h2><div class="scroll"><table><caption>Allen / Mosher · specimen 571654895 · 34 °C</caption><thead><tr><th>Mechanism</th>{sections.map(s=><th>{s}</th>)}</tr></thead><tbody>{CHANNELS.map(m=><tr><th>{m}</th>{sections.map(s=><td>{fit.genome.find(p=>p.section===s&&p.mechanism===m&&p.name.startsWith('gbar'))?.value ?? ''}</td>)}</tr>)}</tbody></table></div></section>
 <section class="panel"><h2>Scope & provenance</h2><table><tbody>
 <tr><th>Kinetics</th><td>Same 34 °C functions as Cortex Laboratory · mixed-species mechanism sources</td></tr>
 <tr><th>NaV</th><td>12-state stationary distribution · open state O · no single τ · stationary solve, not upstream seqinitial</td></tr>
 <tr><th>Voltage step</th><td>Ideal prescribed voltage · independent gates · fixed intracellular calcium · no membrane integration</td></tr>
 <tr><th>Model status</th><td>Published fitted model · no independent biological validation here</td></tr>
 <tr><th>Source</th><td><a href="https://github.com/AllenInstitute/Human_all_active_models_EAP">Allen Institute model repository</a> · <a href="/models/cortex/allen571654895/optim_param_571654895.json">Fitted parameters</a> · <a href="/models/cortex/allen571654895/LICENSE.txt">Allen license</a></td></tr>
 <tr><th>Equations & verification</th><td><a href="/cortex/methods/">Methods</a> · <a href="/cortex/validation/">Numerical verification</a></td></tr>
 </tbody></table></section>
</Layout>
<style>
.local{display:flex;gap:18px;flex-wrap:wrap;margin:18px 0}.panel{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:20px;margin:18px 0}h2{font-weight:400;font-size:1.4rem;margin-top:0}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--border);font-variant-numeric:tabular-nums}th{font-weight:500}caption{text-align:left;margin-bottom:12px;opacity:.7}
</style>
