---
import Layout from '../../layouts/Layout.astro';
const entries = [
 ['/biology/membrane/', 'Membrane Biophysics', '9 mechanisms · steady state · kinetics · voltage step'],
 ['/biology/current-clamp/', 'Current Clamp', 'soma compartment · current steps · IV · f-I'],
 ['/biology/cable/', 'Cable Explorer', 'passive spread · length constant · steady state · transients'],
 ['/cells/', 'Cell Model Atlas', 'Electrical models · measured morphology · specimen sources'],
 ['/cortex/methods/', 'Cellular Dynamics', 'Cable equation · membrane currents · calcium dynamics'],
 ['/cortex/interface/methods/', 'Neural Interfaces', 'Finite contacts · stimulation · recording'],
 ['/cortex/validation/', 'Numerical Verification', 'Reference fixtures · convergence · limitations'],
];
---
<Layout pageTitle="Biology" subtitle="Membrane biophysics, source-traceable cell models and neural simulation mechanisms." description="Membrane biophysics, source-traceable cell models and neural simulation mechanisms.">
 <section class="grid" aria-label="Biology components">{entries.map(([href,title,scope])=><a class="tile" href={href}><h2>{title}</h2><p>{scope}</p></a>)}</section>
</Layout>
<style>
.grid{margin-top:14px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.tile{display:block;padding:18px;border-radius:16px;border:1px solid var(--border);background:var(--panel);color:inherit;text-decoration:none}
.tile:hover{border-color:var(--borderStrong);transform:translateY(-1px);background:var(--panelHover)}
h2{margin:0 0 8px;font-family:var(--font-heading);font-size:var(--title-card);font-weight:400}
p{margin:0;opacity:.82;line-height:1.5}
@media(max-width:680px){.grid{grid-template-columns:1fr}}
</style>
