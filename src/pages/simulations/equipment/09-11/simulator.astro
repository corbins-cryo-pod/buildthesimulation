---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
import verification from '../../../../../public/equipment/09-11/verification.json';
const asset='/equipment/09-11/',srs='https://www.thinksrs.com',manual=srs+'/downloads/pdfs/manuals/SR860m.pdf',photo=srs+'/images/instr/sr860/';
const specs=[
 ['Envelope, W × H × D','431.80 × 133.35 × 431.80 mm','17 × 5.25 × 17 in, manual p. ix. Used for cabinet body. Foot, control and connector projections inferred.'],
 ['Signal input A','10 MΩ + 25 pF; peak ranges 10 mV to 1 V','Manual p. vii. DC-coupled voltage mode; peak limit checked. Input impedance loading and real ADC are not modeled.'],
 ['Reference oscillator','1 mHz–500 kHz instrument; 5 Hz–10 kHz virtual','Manual p. vii. Fundamental of ideal internal reference; phase origin at t=0. No PLL, noise floor, offset or harmonic calibration.'],
 ['Time constants & slope','1 µs–30 ks, 6/12/18/24 dB per octave instrument','Manual pp. vii, 44–45. Here 1, 3, 10, 30 or 100 ms and 1–4 classic RC poles. Advanced/synchronous filters excluded.'],
 ['Demodulator normalization','X, Y, R in RMS volts; θ in degrees','Manual pp. 39–40. X = A cos(φsignal−φref); Y = A sin(φsignal−φref) at steady state.'],
 ['Display','4 channels; full-color touchscreen, 640 × 480 pixels','Product overview; original virtual display shows simulated X/Y/R/θ, not reproduced firmware.'],
 ['I/O and accessories','8 front BNCs; rear auxiliary, data and sync connectors','Official front and rear photos. Benchtop unit, no rack ears or preamp. Only A accepts a virtual voltage cable.']
];
const sheet=[
 ['angle','Bench enclosure','SR860 three-quarter photo: broad case, vented side strip, black feet, recessed front panel. Pictured bail is raised on some units; the bench model rests level, with no extended bail.','SR860_Lt_Wide.jpg'],
 ['front','Operator face','SR860 straight-on photo: screen left of center, controls in banks, A and B on the lower left and sine outputs stacked at right. Knobs and BNC bosses are independent meshes.','SR860_FP.jpg'],
 ['rear','Signal routing','SR860 rear photo: aux BNC groupings above remote interfaces; power at left in rear view, timebase and HDMI at right. Connector internals are simplified.','SR860_RP.jpg']
];
---
<Layout pageTitle="Lock-in amplifier laboratory" subtitle="" description="Run a dual-phase voltage measurement on a physically scaled SR860 lock-in amplifier." wide={true}>
<article class="equipment lockin" id="sr860">
<nav class="eq-nav"><a href="/simulations/equipment/09-11/">← Equipment 09-11</a><a href="/simulations/equipment/">Equipment register</a><a href="#evidence">Sources & verification</a></nav>
<header class="eq-mast"><span class="eq-meta">09-11 / Electrical instrumentation</span><h2>SR860 · phase-sensitive detection</h2><p>Recover a weak periodic signal by comparing it with a reference. This benchtop reconstruction of the Stanford Research Systems SR860 uses voltage input A, dual-phase detection, an internal reference and classic RC output filters. No tissue or biological specimen is assumed.</p></header>
<div class="work">
<section class="panel"><div class="sectionid">01 / Instrument</div><h3>Operator view</h3><div class="tools">{[['orbit','Three-quarter'],['front','Front'],['input','Input A'],['rear','Rear']].map(([v,n])=><button type="button" data-view={v}>{n}</button>)}<button id="reset-view">Reset view</button></div>
<div class="viewer"><canvas id="inst" aria-label="Interactive SR860 exterior, rotary controls and voltage input plug"></canvas></div><p class="fine" id="load-status" role="status">Loading metric model…</p>
<div class="tools"><button id="cable" aria-pressed="true">Disconnect A</button><button id="phase90">Reference +90°</button></div>
<p class="fine">Drag to orbit, wheel or pinch to zoom. Input A, reference phase, time-constant keys and slope key are clickable in 3D. Other controls and rear connections are for inspection only. Control travel is illustrative.</p></section>
<section class="panel"><div class="sectionid">02 / Experiment</div><h3>Coherent voltage acquisition</h3>
<form id="settings" onsubmit="return false;"><label>Source<select name="source"><option value="tone">Virtual sine source</option><option value="import">Imported voltage samples</option></select></label>
<label>Signal identifier<input name="signalId" value="LOCKED-INPUT-A" maxlength="100"/></label>
<label>Input RMS amplitude (µV)<input name="ampUv" type="number" value="100" min="0" max="1000000" step="any"/></label>
<label>Signal frequency (Hz)<input name="signalHz" type="number" value="1000" min="5" max="10000" step="any"/></label>
<label>Signal phase (°)<input name="signalPhase" type="number" value="30" min="-360" max="360" step="any"/></label>
<label>Reference frequency (Hz)<input name="refHz" type="number" value="1000" min="5" max="10000" step="any"/></label>
<label>Reference phase (°)<input name="refPhase" type="number" value="0" min="-360" max="360" step="any"/></label>
<label>Time constant (ms)<select name="tauMs">{[1,3,10,30,100].map(n=><option value={n} selected={n===10}>{n}</option>)}</select></label>
<label>Filter slope (dB/octave)<select name="poles">{[1,2,3,4].map(n=><option value={n} selected={n===2}>{6*n}</option>)}</select></label>
<label>Peak range (mV)<select name="rangeMv">{[10,30,100,300,1000].map(n=><option value={n}>{n}</option>)}</select></label>
<label>Record length (ms)<input name="durationMs" value="200" type="number" min="10" max="1000" step="any"/></label>
<label>Interferer RMS (µV)<input name="interfererUv" value="0" type="number" min="0" max="1000000" step="any"/></label>
<label>Interferer frequency (Hz)<input name="interfererHz" value="1050" type="number" min="5" max="10000" step="any"/></label>
</form>
<div class="tools"><button id="run" class="primary">Acquire</button><button id="example">Run clean example</button><button id="beat">Load detuned tone</button></div>
<p role="status" aria-live="polite" id="status">Ready: measure the 100 µV RMS input at +30°.</p>
<label class="file">Open voltage CSV or waveform.v1 JSON <input id="upload" type="file" accept=".csv,.json,text/csv,application/json"/></label><button id="load-file-example">Load example waveform</button> <button id="load-scope">Measure an oscilloscope capture</button><p id="input-file" class="fine"></p></section>
</div>
<section class="panel readout"><div class="sectionid">03 / Simulated output</div><h3>Complex voltage</h3><div id="meters">{['X · in phase','Y · quadrature','R · magnitude','θ · angle'].map((k,i)=><div><small>{k}</small><strong data-meter={i}>—</strong></div>)}</div>
<div class="trace"><canvas id="plot" width="1100" height="260" aria-label="Time traces in microvolts showing in-phase and quadrature voltages"></canvas></div><p id="stats" class="fine">X and Y versus elapsed time. Readings are simulation outputs, not measured calibration data.</p>
<div class="tools"><button id="json" disabled>Download measurement JSON</button><button id="csv" disabled>Download trace CSV</button><a href={asset+'output-schema.json'}>Schema</a><a href={asset+'example-result.json'}>Example result</a></div></section>
<section id="evidence"><h3>Reference views & dimensions</h3><p>Original renderings of the downloadable geometry, compared with the linked SR860 photographs. Case dimensions are specified by SRS. Front and rear connector coordinates, foot heights and projections are proportional estimates, not metrology. No enclosure internals or manufacturer image pixels are included.</p>
<div class="sheet">{sheet.map(([file,label,caption,url])=><figure><img src={asset+file+'.png'} loading="lazy" alt={'Original modeled SR860: '+label}/><figcaption><b>{label}.</b> {caption} <a href={photo+url}>SRS source photograph</a></figcaption></figure>)}</div>
<div class="tablewrap"><table><thead><tr><th>Constraint</th><th>Value</th><th>Basis and use</th></tr></thead><tbody>{specs.map(([k,v,s])=><tr><th>{k}</th><td>{v}</td><td>{s} <a href={k==='Display'?srs+'/products/sr860.html':manual}>Source</a></td></tr>)}</tbody></table></div>
<p><a href={manual}>SRS operation manual, rev. 2.11</a> · <a href={srs+'/products/sr860.html'}>Product page / reference photographs</a> · <a href={asset+'build-model.py'} download>Editable parametric model (Python + Pillow)</a> · <a href={asset+'sr860.glb'} download>Download GLB</a> · <a href={asset+'vr-station.json'}>VR station contract</a> · <a href={asset+'station.mjs'}>State adapter</a></p></section>
<section><h3>Signal & measurement contract</h3><p>Source is a voltage waveform, not a physical sample holder. In tone mode set amplitude in RMS µV. For imports use <a href={asset+'example-signal.csv'}>two-column voltage CSV</a> with header <code>time_s,voltage_V</code> and optional initial <code># sampleId=…</code>, <code># contactId=…</code>, <code># revision=…</code>, <code># source=…</code>, <code># kind=…</code> lines. Alternatively import <code>bts.waveform.voltage.v1</code> JSON with signalId, contactId, parentRevision, t0S, sampleRateHz and a volts array. SI units; t=0 is the reference phase origin. Uniform finite samples, 32–160,000; at least 16 samples per reference cycle and time constant. No automatic resampling. Imported signals must be band limited; the instrument does not reconstruct frequencies above Nyquist.</p>
<p>A disconnected cable, peak overload, invalid fields, irregular time base, unsuitable sampling or excessive request produces no result. An imported waveform retains its signal/contact IDs and parent revision; the measurement is a child revision. X, Y and R are in RMS volts; phase is signal phase minus reference phase. Phase below 1 fV is undefined (null). The JSON includes settings, time base, units, trace, source metadata and settling criterion. The CSV is a derived demodulated trace, <em>not</em> a uniform raw source file. For a cross-station run, choose “Measure an oscilloscope capture.” This loads the simulated 09-04 CH1 export (1 kHz, 2 mV peak) and reports ≈1.414 mV RMS on input A. The 09-04 trace starts at its record origin. Its source revision becomes the parent of the lock-in measurement. <a href="/simulations/equipment/09-04/">Source equipment record</a> · <a href={asset+'scope-capture.csv'} download>Archived capture used for verification</a>.</p>
<details><summary>Algorithm, settling and limitations</summary><p>The input u(t) is multiplied by √2 sin(2πft+φ) and √2 cos(2πft+φ), producing X and Y after filtering. For each classic RC pole independently set k=1−exp(−Δt/τ) and update y←y+k(u−y). Poles are cascaded at the finite sample rate from zero initial state (a discrete approximation, not vendor DSP). R=hypot(X,Y); θ=atan2(Y,X). Both difference-frequency beats and finite sum-frequency leakage remain. Synthetic records use at least 64 samples per reference cycle, source period and time constant, with a 64 kS/s floor. Results store up to about 700 display points plus the last sample; integration uses all samples.</p><p>Reported 1% startup time is for a constant post-mix step, obtained from exp(−x)Σ xᵏ/k! = 0.01 for k=0…n−1. It does not establish steady DC for detuned or varying signals. ENBW for 1–4 classic RC poles is [1,½,⅜,5/16]/(4τ). This model omits input noise, sensitivity calibration, hardware transfer response, analog loading, external PLL and FIR modes. It is not empirical calibration of a particular serial number.</p></details></section>
<section id="verification"><h3>Predetermined verification cases</h3><p>Independent analytic and failure-mode checks. The 0.05 µV tolerance (0.05% of the 100 µV input) permits numerical sampling and finite warm-up; it is not a hardware accuracy specification. No independent bench recordings are available.</p>
<div class="tablewrap"><table><thead><tr><th>Test</th><th>Expected</th><th>Observed</th><th>Units / tol.</th><th>Result</th></tr></thead><tbody>{verification.cases.map(c=><tr><th title={c.fixture}>{c.id}<br/><small>{c.kind??'Numerical'}</small></th><td>{String(c.expected)}</td><td>{Array.isArray(c.actual)?c.actual.map(v=>Number(v.toPrecision(6))).join(', '):typeof c.actual==='number'?Number(c.actual.toPrecision(8)):c.actual}</td><td>{c.units??'status'}{c.absoluteTolerance?' ± '+c.absoluteTolerance:''}</td><td>{c.pass?'Pass':'Fail'}</td></tr>)}</tbody></table></div>
<p><a href={asset+'verification-plan.json'}>Fixtures & tolerances</a> · <a href={asset+'verification.json'}>Actual numeric results</a> · <a href={asset+'solver.mjs'}>Solver source</a> · <a href={asset+'verify.mjs'}>Reproduce checks</a></p></section></article>
</Layout>
<script>import '../../../../lib/equipment/09-11/client.mjs';</script>
<style>
.lockin{--rule:color-mix(in srgb,currentColor 28%,transparent);max-width:1320px;margin:auto}.lockin .work{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:1rem}.panel{min-width:0;padding:1rem;border:1px solid var(--rule);margin:.8rem 0}.lockin h3{font-size:1.45rem;margin:.3rem 0 .7rem}.sectionid,.fine,.lockin label,.tools{font: .85rem/1.45 system-ui,sans-serif}.sectionid{letter-spacing:.12em;text-transform:uppercase;opacity:.73}.tools{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:.4rem 0}.viewer{aspect-ratio:1.75;background:#293039}.viewer canvas,.trace canvas{display:block;width:100%;height:100%}.viewer canvas{touch-action:none}.lockin button,.lockin select,.lockin input{font:inherit;color:inherit;background:var(--bg,Canvas);border:1px solid var(--rule);border-radius:3px;padding:.4rem}.lockin button{cursor:pointer;min-height:38px}.lockin button:disabled{opacity:.45}.lockin button.primary{background:#285745;color:#fff}.lockin form{display:grid;grid-template-columns:1fr 1fr;gap:.45rem .65rem}.lockin label{display:grid;gap:.13rem}.lockin input,.lockin select{min-width:0;width:100%}.trace{border:1px solid var(--rule);background:#182428;height:190px}.readout #meters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.4rem;margin:1rem 0}.readout small,.readout strong{display:block}.readout strong{font:600 clamp(1rem,2vw,1.7rem)/1.5 monospace}.sheet{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.sheet figure{margin:0}.sheet img{width:100%;height:auto}.sheet figcaption{font-size:.9rem}.tablewrap{overflow:auto}.tablewrap table{width:100%;border-collapse:collapse}.tablewrap td,.tablewrap th{text-align:left;padding:.45rem;border-bottom:1px solid var(--rule)} .lockin section:not(.panel){margin:2rem 0}.lockin code{overflow-wrap:anywhere}.lockin [role=status]{min-height:1.4em}.lockin .error{color:#bb503f}
@media(max-width:820px){.lockin .work{grid-template-columns:1fr}.sheet{grid-template-columns:1fr}.readout #meters{grid-template-columns:1fr 1fr}}@media(max-width:400px){.lockin form{grid-template-columns:1fr 1fr}.panel{padding:.6rem}}
</style>
