---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
import checks from '../../../../../public/equipment/11-06/verification.json';
import m from '../../../../../public/equipment/11-06/interactions.json';
import {grid,mounts,initial} from '../../../../lib/equipment/11-06/solver.mjs';
const a='/equipment/11-06/';
const pdf='https://www.thorlabs.com/CatalogPages/Obsolete/2025/SDPM7590.pdf';
const photo='https://www.thorlabs.co.jp/ja/item/sdam7590';
const r=initial().result;
const display=x=>typeof x==='string'?x:Object.entries(x??{}).map(([k,v])=>k+': '+(v===null?'—':typeof v==='object'?JSON.stringify(v):String(v))).join('; ');
---
<Layout pageTitle="Thorlabs ScienceDesk dry mount layout" subtitle="" description="Snap passive mounting fixtures to a 25 mm Thorlabs ScienceDesk breadboard grid and inspect footprint fit and collision." wide={true}>
<article id="desk" class="equipment"><nav class="eq-nav"><a href="/simulations/equipment/11-06/">← Equipment 11-06</a><a href="/simulations/equipment/">Equipment register</a><a href="#desk-checks">Verification</a></nav>
<header><p class="eq-meta">11-06 / SDPM7590 + B7590A / Dry fit</p><h2>THORLABS SCIENCEDESK</h2><p>Check whether two mounts fit on the 25 mm hole grid. The default mounts are four pitches apart: 100 mm center to center, with 25 mm between their edges.</p></header>
<div class="e-grid"><section class="e-card"><h3>01 · Inspect and place</h3><div id="desk-views" class="e-row">{['Bench','Top','Rear','Anchors'].map(k=><button type="button" data-view={k.toLowerCase()}>{k}</button>)}<button id="desk-xr" type="button" disabled>VR unavailable</button></div><canvas id="desk-model" aria-label="Orbitable Thorlabs ScienceDesk with two movable dry mounts and 25 mm hole lattice"></canvas><p id="desk-asset" role="status">Loading metric GLB…</p><p class="e-hint">Select the brass or teal mount, then click the breadboard to snap it to the nearest hole. Use Top for the clearest pick. The plan and the fields provide the same placement without WebGL.</p></section>
<section class="e-card"><h3>02 · Read the fit</h3><form id="desk-fields" class="e-row"><label>Mount<select id="desk-active"><option value="A">A · brass</option><option value="B" selected>B · teal</option></select></label><label>Column<input id="desk-field-col" type="number" min="0" max={grid.columns-1} step="1" required value="16"/></label><label>Row<input id="desk-field-row" type="number" min="0" max={grid.rows-1} step="1" required value="14"/></label><button type="submit">Place</button></form>
<div id="desk-presets" class="e-row"><button type="button" data-preset="reset">Four pitches</button><button type="button" data-preset="collision">Same hole</button><button type="button" data-preset="edge">Outer hole</button><button type="button" class="e-run" id="desk-json">Export layout JSON</button></div>
<p id="desk-status" role="status">Clear</p><dl class="e-read"><div><dt>Center distance</dt><dd id="desk-distance">100 mm</dd></div><div><dt>Closest edge gap</dt><dd id="desk-gap">25 mm</dd></div><div><dt>Overlap volume</dt><dd id="desk-overlap">0 mm³</dd></div><div><dt>Overhang</dt><dd id="desk-overhang">None</dd></div></dl>
<svg id="desk-plan" viewBox="-480 -405 960 817" role="img" aria-label="Top plan of the breadboard and dry mount footprints. Choose a hole on the image or use the fields above.">
<defs><pattern id="desk-holes" patternUnits="userSpaceOnUse" width="25" height="25" x="-450" y="-375"><circle cx="12.5" cy="12.5" r="3" fill="#536469"/></pattern></defs>
<rect x="-450" y="-375" width="900" height="750" rx="5" fill="#d6ddd8" stroke="#6e7a7c" stroke-width="5"/><rect x="-450" y="-375" width="900" height="750" fill="url(#desk-holes)"/>
{Object.entries(mounts).map(([id,s])=><g data-mount={id}><rect id={'desk-mount-'+id} class:list={['fixture',id,id==='B'&&'active']} x={r.mounts[id].center.x-s.width/2} y={r.mounts[id].center.z-s.depth/2} width={s.width} height={s.depth} rx="4"/><text id={'desk-label-'+id} x={r.mounts[id].center.x} y={r.mounts[id].center.z+7} text-anchor="middle" font-size="22" fill="#fff">{id}</text></g>)}
<text x="0" y="403" text-anchor="middle" fill="#3e505c" font-size="24">OPERATOR SIDE / +Z</text></svg>
</section></div>
<section id="desk-references"><h3>Documentary geometry</h3><div class="e-grid"><figure><img src={a+'original-front.svg'} width="760" height="450" alt="Original front three-quarter render of a dark ScienceDesk frame, round legs and casters"/><figcaption>Original overview. Thorlabs documents the geometry in its <a href={pdf+'#page=1'}>SDPM7590 archive</a>. Thorlabs’ <a href={photo}>SDAM7590 sibling frame photograph</a> establishes the shared round legs and caster/foot silhouette; the active-air hardware in that photo is not modeled.</figcaption></figure><figure><img src={a+'original-work.svg'} width="760" height="450" alt="Original rear three-quarter render, open leg bay and caster layout"/><figcaption>Original rear view from the same model. Back rail, foot details and widths of individual structural pieces are inferred; no matching passive rear photo or certified CAD is asserted. The 3D asset, unlike these silhouette views, includes rendered mounting hole recesses.</figcaption></figure></div>
<div class="e-over"><table><thead><tr><th>Item</th><th>Design evidence</th><th>Use</th></tr></thead><tbody>
<tr><td>SDPM7590 rail W × D</td><td><a href={pdf+'#page=2'}>Thorlabs detailed figure / Specs</a>, 1,111.5 × 961.5 mm (table rounds to 1,112 × 962)</td><td>Outer rail envelope</td></tr>
<tr><td>B7590A breadboard W × D × H</td><td><a href={pdf}>Thorlabs, Table 351A</a>, 900 × 750 × 60 mm</td><td>Steel board envelope</td></tr>
<tr><td>Metric mounting pattern</td><td>25.0 mm pitch; first row 12.5 mm from each edge; M6 × 1.0 nominal</td><td>36 × 30 hole centers; threads not represented</td></tr>
<tr><td>Tabletop elevation</td><td>782 mm, lower documented assembled working height</td><td>Fixed scene clearance. No height adjustment or isolation calculation.</td></tr>
<tr><td>Mount A / B rectangles</td><td>80 × 60 × 35 mm / 70 × 50 × 30 mm (authored)</td><td>Rigid bounding volumes, not Thorlabs products</td></tr>
</tbody></table></div><p>Coordinates are in mm, with positive X to the operator’s right and positive Z toward the front. Column and row numbers start at zero. Placement uses the nearest lattice center; the clearance check uses axis-aligned rectangular footprints with vertical thickness. Positive overlap is a collision; exact contact has zero overlapping volume. This is not certification of either mount, fit hardware, load, vibration, or optics. No beam graph or biological operation is implemented.</p></section>
<section id="desk-checks"><h3>Verification and files</h3><div class="e-over"><table><thead><tr><th>Case</th><th>Expected</th><th>Actual</th><th>Status</th></tr></thead><tbody>{checks.map(x=><tr><td>{x.id}</td><td>{display(x.expected)}</td><td>{display(x.actual)}</td><td>{x.pass?'Pass':'Fail'}</td></tr>)}</tbody></table></div>
<p><a href={a+'reference-plan.json'}>Predeclared cases</a> · <a href={a+'verification.json'}>Verification data</a> · <a href={a+'example-layout.json'}>Example layout JSON</a> · <a href={a+'sciencedesk-sdpm7590.glb'} download>Metric GLB</a> · <a href={a+'geometry-source.mjs'}>Editable geometry</a> + <a href={a+'make-model.mjs'}>generator</a> + <a href={a+'mesh-writer.mjs'}>mesh writer</a> · <a href={a+'interactions.json'}>Named targets</a>. {m.triangles.toLocaleString()} triangles, {m.draws} draw primitives. Optional WebXR; physical headset untested.</p></section></article></Layout>
<script>import '../../../../lib/equipment/11-06/client.mjs';</script>
<style>
#desk header{max-width:73ch;padding:1.3rem 0}#desk h2{font-size:clamp(2rem,6vw,4rem);margin:.2rem 0}#desk section{margin:1rem 0}.e-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.e-card{border:1px solid var(--border);padding:.8rem;min-width:0}.e-card h3{margin:.3rem 0}.e-row{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0}.e-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.e-fields label{display:grid;gap:.2rem}.e-fields input,#desk button{min-width:0;min-height:2.45rem;border:1px solid var(--border);border-radius:3px;background:var(--panel);color:var(--text);font:inherit;padding:.3rem .5rem;box-sizing:border-box}#desk button:disabled{opacity:.52}.e-run{background:#3d596e!important;color:white!important}#desk-model{width:100%;height:clamp(280px,34vw,440px);display:block;background:#ebe8e0;touch-action:none}#desk select{min-height:2.45rem;background:var(--panel);color:var(--text);font:inherit;border:1px solid var(--border)}#desk form{align-items:end}#desk form label{display:grid;gap:.22rem}#desk input{max-width:6rem}#desk-status{font-weight:bold;margin:.66rem 0 .45rem}#desk .e-read{margin:.35rem 0 .8rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem}#desk .e-read div{border-top:1px solid var(--border);padding-top:.35rem}#desk .e-read dt{font-size:.84rem}#desk .e-read dd{margin-left:0;font-size:1rem;overflow-wrap:anywhere}#desk-plan{display:block;width:min(100%,500px);height:auto;max-height:21rem;background:#f0ede4;cursor:crosshair}#desk-plan .fixture{stroke:#243c48;stroke-width:3}#desk-plan .A{fill:#a37023}#desk-plan .B{fill:#3d9296}#desk-plan .active{stroke:#173f84;stroke-width:6}#desk-plan g[data-mount]{cursor:pointer} @media(max-width:500px){#desk input{max-width:5rem}}</style>


