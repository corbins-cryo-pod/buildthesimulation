<style is:global>#hlt160 .h-cols{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:1rem}#hlt160 section{padding:1rem;border:1px solid var(--border);margin:1rem 0;min-width:0}#hlt160 :is(input,select,button){font:inherit;color:inherit;background:var(--panel);border:1px solid var(--border);padding:.45rem;max-width:100%;box-sizing:border-box}#hlt160 label{display:grid;gap:.2rem;min-width:0;margin:.5rem 0}#hlt160 label :is(input,select){width:100%;min-width:0}#hlt160 button{margin:.35rem .25rem .2rem 0;cursor:pointer}#hlt160 button:disabled{opacity:.5}#hlt160 button:focus-visible{outline:3px solid #b28d5e}#hlt-model{display:block;width:100%;height:330px;touch-action:none}#hlt-plot{display:block;width:100%;height:auto;background:#172629}#hlt160 figure{margin:.5rem 0}#hlt160 figure img{width:100%}#hlt160 .h-scroll{overflow:auto}#hlt160 table{font-size:.9rem;border-collapse:collapse;width:100%;text-align:left}#hlt160 td,#hlt160 th{border-bottom:1px solid var(--border);padding:.35rem}@media(max-width:780px){#hlt160 .h-cols{grid-template-columns:minmax(0,1fr)}#hlt-model{height:280px}}</style>
