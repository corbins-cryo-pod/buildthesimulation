---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
const asset='/equipment/02-08/';
const brochure='https://abmasia.com.hk/hk/images/brochure/CEE200CBX%20Brochure.pdf';
const ku='https://nanofab.ku.edu/spin-coater-baking-tools';
const ucsb='https://www.cnsi.ucsb.edu/facilities/equipment/cee-200cbx-coat-bake-system';
const asu='https://cores.research.asu.edu/semiconductor-device-processing/nanofab/equipment-and-rates/cee-spin-coater-1-and-2/';
const seller='https://www.ebay.com/itm/226382217181';
const specs=[
 ['Overall enclosure (closed)','711 × 483 × 305 mm; 74.8 kg','Cee brochure p. 1; overall scale (rounded mm), mass not simulated',brochure],
 ['Color touchscreen','7 in diagonal','Cee brochure p. 1; geometry',brochure],
 ['Spin module','0–6000 rpm standard; options to 12,000/16,000 rpm','Cee brochure p. 1; selected standard speed, calibrated software range 2000–6000 rpm',brochure],
 ['Acceleration','up to 30,000 rpm/s unloaded; 23,000 rpm/s with 200 mm wafer','Cee brochure p. 1; virtual example fixed 1000 rpm/s, 30 s dwell',brochure],
 ['Substrate','up to 200 mm round or 7 in square','Cee brochure p. 2; round 75/100/125/150/200 mm only in simulation',brochure],
 ['Bake plate','254 mm; contact, vacuum, proximity','KU; 10-inch plate and 57.2 mm chuck illustrated; only contact bake modeled',ku],
 ['Plate temperature','ambient–300 °C standard; 400 °C option; 0.1 °C resolution','Cee brochure p. 2; virtual plate 30–300 °C, no controller PID modeled',brochure],
 ['Surface temperature uniformity','0.3% stated','Cee brochure p. 2; not wafer-temperature accuracy',brochure],
 ['Process time resolution','0.1 s; 0–9999.9 s/step','Cee brochure p. 1; software bake range 1–300 s, sampled each second plus end',brochure],
 ['Vacuum and exhaust','20–25 in Hg vacuum; 19.05 mm drain; 25.4 mm exhaust','Cee brochure p. 2; visual utilities; vacuum pressure not solved',brochure],
 ['Resist and dispense','Manual pipette dispense, cleanroom installation','ASU; UCSB lists AZ 1512, 1518, P4620 and SU-8. Synthetic user calibration only.',asu],
 ['Internal geometry','Hinge opening 75°; lid, housing and port placements estimated','Original reconstruction; no factory CAD, no orthogonal rear photograph',brochure]
];
const views=[
 ['front','Front three-quarter','Brochure p. 1 and seller photo: stainless body, left bake lid, right white bowl and sloped touchscreen. Original reconstruction, not a photograph.',brochure],
 ['spin','Spin bowl / chuck','Seller close-up: translucent cover, white ring, central white chuck with red pads, rear supports and touch panel. Exact serial not established.',seller],
 ['bake','Hotplate','Brochure p. 2 open-lid photograph and optional lift-pin close-up establish circular plate under rectangular lid. This model selects contact bake without optional lift pins.',brochure+'#page=2'],
 ['rear','Rear / utilities','Brochure p. 2 establishes drain, exhaust, vacuum, Ethernet and power; location and shape of rear fittings are schematic. No rear photograph acquired.',brochure+'#page=2']
];
const fields=[['sampleId','Parent sample ID','text',null,null,null],['revision','Parent revision','number',0,999999,1],['rpm','Spin speed (rpm)','number',2000,6000,1],['referenceUm','Reference film at 4000 rpm (µm)','number',.1,20,.01],['exponent','Thickness exponent','number',.2,.8,.01],['edgeFraction','Edge-bead amplitude (fraction)','number',0,.5,.01],['tauS','Assumed wafer thermal time constant (s)','number',1,60,.1],['tempA','Bake A plate (°C)','number',30,300,.1],['timeA','Bake A dwell (s)','number',1,300,.1],['tempB','Bake B plate (°C)','number',30,300,.1],['timeB','Bake B dwell (s)','number',1,300,.1]];
---
<Layout pageTitle="Coat / bake laboratory" subtitle="" description="Cee 200CBX virtual spin coating and contact bake station" wide={true}>
<article class="equipment cee" id="cee-lab">
<nav class="eq-nav"><a href="/simulations/equipment/02-08/">← Equipment 02-08</a><a href="/simulations/equipment/">Equipment register</a><a href="#cee-evidence">Evidence &amp; verification</a></nav>
<header class="eq-mast"><span class="eq-meta">02-08 / LITHOGRAPHY / VIRTUAL INSTRUMENT</span><h2>Cee 200CBX</h2><p>Legacy Brewer Science / Cost Effective Equipment precision coat-bake system. Selected standard 6,000 rpm, 300 °C benchtop configuration: manual dispense, PTFE bowl, vacuum chuck, contact hotplate. Exact installed serial unknown. Compare two identical coating recipes followed by different bake schedules.</p></header>
<div class="cee-bench">
<section class="cee-panel"><h3>Instrument</h3><div class="cee-tools">{[['reset','Reset'],['front','Front'],['spin','Spin bowl'],['bake','Hotplate'],['rear','Rear']].map(([k,label])=><button data-cee-view={k}>{label}</button>)}</div>
<div class="cee-view"><canvas id="cee-canvas" aria-label="3D coat-bake instrument"></canvas></div><p class="cee-small" id="cee-model-status" role="status">Loading 3D asset…</p>
<div class="cee-tools"><button id="cee-spin-lid">Open spin lid</button><button id="cee-bake-lid">Open bake lid</button><button id="cee-load">Unload pair</button><button id="cee-vacuum">Release vacuum</button></div>
<p id="cee-machine" aria-live="polite">Ready — two virtual wafers loaded, lids closed, vacuum engaged.</p><p class="cee-small">Drag to orbit; scroll or pinch to zoom. The first wafer is displayed in the spinner. For each recipe the animation transfers it to the hotplate, then starts the second identical wafer. Animation time and spindle rotation are illustrative and compressed; no live hardware control.</p></section>
<section class="cee-panel"><h3>Paired experiment</h3><form id="cee-fields" onsubmit="return false"><label>Round wafer diameter (mm)<select name="diameterMm">{[75,100,125,150,200].map(v=><option value={v}>{v}</option>)}</select></label>{fields.map(([name,label,type,min,max,step])=><label>{label}<input name={name} type={type} min={min??undefined} max={max??undefined} step={step??undefined} maxlength={name==='sampleId'?80:undefined} required/></label>)}</form>
<div class="cee-tools"><button id="cee-run" class="cee-primary">Run paired experiment</button><button id="cee-example">Run default example</button></div><progress id="cee-progress" max="1" value="0" aria-label="Experiment progress"></progress><p id="cee-status" role="status" aria-live="polite">Ready. Same spin recipe, separate contact bake histories.</p>
<p class="cee-small">Thickness calibration is hypothetical, not a manufacturer-measured pre-bake AZ resist curve. A preheated constant plate and user-defined wafer time constant are assumed.</p></section></div>
<section class="cee-panel"><h3>Process output</h3><div class="cee-plots"><figure><canvas id="cee-map" width="440" height="340" aria-label="Pre-bake thickness map"></canvas><figcaption>Shared pre-bake coating map (µm); outside the round wafer is masked. Both runs preserve the identical map.</figcaption></figure><figure><canvas id="cee-trace" width="540" height="340" aria-label="Wafer temperature over time for bake A and B"></canvas><figcaption>Calculated wafer temperature and plate setpoints (°C) versus contact bake time (s).</figcaption></figure></div><div id="cee-result" aria-live="polite">No current result.</div>
<div class="cee-tools"><button id="cee-json" disabled>Export paired revisions (JSON)</button><button id="cee-csv" disabled>Export bake traces (CSV)</button><button id="cee-mapcsv" disabled>Export pre-bake map (CSV)</button><a href={asset+'example-result.json'} download>Example result</a><a href={asset+'output-schema.json'} download>Output schema</a></div></section>
<section id="cee-evidence" class="cee-panel"><h3>Illustrated reference sheet</h3><p>Original model renders are generated from the editable 3D source below; reference photos are linked rather than redistributed without documented permission. The manufacturer brochure, ASU facility photograph and seller photographs were reviewed for silhouette and working areas. Rear geometry and undocumented internal dimensions remain estimates. Matching camera presets and an independent render inspection support qualitative comparison. The badge and rear panel were revised to prevent coplanar surfaces. No photogrammetric fit or orthogonal dimensional validation has been completed.</p><div class="cee-refs">{views.map(([id,title,caption,url])=><figure><img id={'cee-ref-'+id} alt={'Original rendering: '+title} width="480" height="300"/><figcaption><b>{title}.</b> {caption} <a href={url}>Original source</a> · <button data-cee-view={id}>Inspect</button></figcaption></figure>)}</div>
<h3>Specifications and scope</h3><div class="cee-scroll"><table><thead><tr><th>Specification</th><th>Value / units</th><th>Source and purpose</th></tr></thead><tbody>{specs.map(([name,value,note,url])=><tr><td>{name}</td><td>{value}</td><td><a href={url}>{note}</a></td></tr>)}</tbody></table></div><p>Additional source: <a href={ucsb}>UCSB 200CBX instrument listing</a>. The optional 12,000 rpm configuration is not modeled. No automatic dispense, proximity or vacuum bake, active solvent chemistry, plate PID, lift-pin motion or simultaneous two-module processing is simulated. Chuck fit is an allowed diameter list, not a validated chuck seal model.</p>
<h3>Model &amp; data contract</h3><p>For the fixed spin sequence (1000 rpm/s acceleration, 30 s hold, 1000 rpm/s deceleration), central pre-bake reference thickness is h = h₄₀₀₀ × (RPM / 4000)^(−n). An optional assumed edge bead adds h × E × exp(−(1−r/R)/0.045) at wafer radius r. The 41 × 41 grid samples cell centers in wafer-local millimeters, x right and y away from the operator. Values outside the circular wafer are null. Neither calibration nor edge function is an independently validated wet film model. Both paired specimens use the same coating map, reference and spin history.</p><p>Each wafer starts at 23 °C, contacts its already preheated plate, and obeys dT/dt = (Tplate−T)/τ; T(t) = Tplate + (23−Tplate) exp(−t/τ). The assumed lumped τ does not establish a measured wafer temperature, spatial gradients or actual heat transfer coefficient. The result preserves parent sample ID, revision, branch A/B IDs, calibration ID, coordinates, spin history, distinct bake schedules and traces; post-bake thickness is null because shrinkage is not modeled. No downstream import was demonstrated; the schema and example provide a handoff. Out-of-range inputs, open lids, missing wafers or absent vacuum block a run; inputs changed after calculation invalidate that result.</p>
<h3>Executed verification</h3><div class="cee-scroll"><table><thead><tr><th>Case</th><th>Expected</th><th>Actual</th><th>Tolerance / outcome</th></tr></thead><tbody>
<tr><td>Register acceptance: same coat</td><td>Identical 41 × 41 maps</td><td>Identical</td><td>Exact / PASS</td></tr>
<tr><td>Register acceptance: separate bake histories</td><td>51 / 91 time samples</td><td>51 / 91; 99.851355 / 109.998868 °C</td><td>Exact counts / PASS</td></tr>
<tr><td>Independent one-time-constant heating at 100 °C</td><td>71.6732830298 °C</td><td>71.6732830298 °C</td><td>10⁻⁹ °C / PASS</td></tr>
<tr><td>Flat film at reference speed</td><td>1.6 µm</td><td>1.6 µm</td><td>10⁻¹² µm / PASS</td></tr>
<tr><td>Halve RPM at exponent 0.5</td><td>1.414213562373095 × thickness</td><td>1.4142135623730951</td><td>10⁻¹² / PASS</td></tr>
<tr><td>Boundary and invalid inputs</td><td>6000 valid; 6001, 250 mm, 301 °C invalid</td><td>As expected</td><td>Exact / PASS</td></tr>
<tr><td>Geometry source / GLB</td><td>711 × 483 × 305 mm closed assembly; 254 mm plate; unique node names; valid GLB header</td><td>As designed</td><td>Exact source values / PASS</td></tr>
<tr><td>Physical comparison</td><td>Independent pre-bake film map and wafer thermocouple trace</td><td>Unavailable</td><td>NOT VALIDATED</td></tr>
</tbody></table></div><p>15 assertions executed against exact JavaScript solver and model generator before integration. Repository Node and browser checks are separate evidence; consult the GitHub Actions results. <a href={asset+'verification.json'} download>Machine-readable verification</a>.</p>
<div class="cee-tools"><a href={asset+'model-source.json'} download>Editable geometry (JSON)</a><a href={asset+'build-model.mjs'} download>Model generator</a><a href={asset+'cee-200cbx.glb'} download>Download GLB</a><a href={asset+'cee-200cbx.gltf'} download>Download glTF</a><a href={asset+'solver.mjs'} download>Solver</a><a href="https://github.com/corbins-cryo-pod/buildthesimulation/blob/main/tests/equipment-02-08-cee.mjs">Node tests</a><a href="https://github.com/corbins-cryo-pod/buildthesimulation/actions">CI</a></div></section></article></Layout>
<script>
import '../../../../lib/equipment/02-08/client.mjs';
</script>
<style is:global>
.cee{font-size:16px}.cee h3{font-size:1.45rem;margin:.2rem 0 .7rem}.cee-panel{border:1px solid var(--border);padding:1rem;margin:1rem 0;min-width:0}.cee-bench{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:1rem}.cee-bench .cee-panel{margin:0}.cee-view{height:clamp(290px,40vw,510px);background:#29343b}.cee-view canvas{width:100%;height:100%;display:block;touch-action:none}.cee-tools{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:.6rem 0}.cee button,.cee input,.cee select{font:inherit;color:inherit;background:transparent;border:1px solid var(--border);padding:.4rem .6rem;border-radius:0}.cee button{cursor:pointer}.cee button:disabled{opacity:.45;cursor:default}.cee .cee-primary{background:#aa946e;color:#171717;font-weight:bold}.cee form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.cee label{display:flex;flex-direction:column;font-size:.84rem;gap:.2rem;min-width:0}.cee input,.cee select{width:100%;box-sizing:border-box;min-width:0}.cee select option{color:#111;background:#f5f1e6}.cee progress{width:100%}.cee-small{font-size:.82rem;line-height:1.4}.cee-plots,.cee-refs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.cee figure{margin:0;min-width:0}.cee figure canvas,.cee figure img{max-width:100%;width:100%;height:auto;display:block;background:#29343b}.cee figcaption{font-size:.85rem;line-height:1.4;margin:.4rem 0}.cee-scroll{overflow-x:auto}.cee table{width:100%;border-collapse:collapse;font-size:.86rem}.cee th,.cee td{text-align:left;padding:.45rem;border:1px solid var(--border)}.cee #cee-result{font-variant-numeric:tabular-nums;padding:.7rem 0;line-height:1.6}.cee #cee-status[data-fail=true]{color:#c3473b}@media(max-width:850px){.cee-bench,.cee-plots,.cee-refs{grid-template-columns:1fr}.cee-panel{padding:.75rem}}@media(max-width:360px){.cee form{grid-template-columns:1fr}}
</style>