<style>
#labram{max-width:1260px;margin:auto}
#labram header{margin:1.37rem 0 1rem} #labram header p{max-width:78ch}
.bench{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:1rem}
.panel{min-width:0;border:1px solid color-mix(in srgb,currentColor 32%,transparent);border-radius:.3rem;padding:clamp(.8rem,2vw,1.35rem);margin:.55rem 0}
.panel h3{margin:0 0 .8rem}
.tools{display:flex;flex-wrap:wrap;gap:.4rem}
.tools button,.fields input,.fields select{color:inherit;background:transparent;border:1px solid currentColor;padding:.42rem .55rem;border-radius:.2rem;font:inherit;min-width:0;min-height:38px;box-sizing:border-box}
.tools button{cursor:pointer}.tools button:disabled{opacity:.5;cursor:default}
.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;margin:.8rem 0}
.fields label{display:flex;flex-direction:column;font-size:.9rem;gap:.18rem}
.fields option{background:#f5f1e6;color:#151b1a}
#raman-viewer{height:350px;margin:.72rem 0;background:#293941}
#raman-viewer :global(canvas){display:block;max-width:100%;touch-action:none}
#raman-spectrum{width:min(100%,700px);height:auto;display:block}
#raman-result{font-weight:bold}
#raman-status[data-error=true]{border-left:4px solid #7d4e30;padding-left:.6rem}
.refs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}
.refs figure{margin:0}.refs img{width:100%;height:auto}.refs figcaption{margin:.35rem 0 1rem}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;margin:.45rem 0}
th,td{text-align:left;padding:.44rem;border-bottom:1px solid color-mix(in srgb,currentColor 28%,transparent)}
@media(max-width:900px){.bench{grid-template-columns:1fr}#raman-viewer{height:310px}}
@media(max-width:560px){.refs{grid-template-columns:1fr}#raman-viewer{height:260px}.tools button,.fields input,.fields select{min-height:44px}}
.maps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;max-width:770px}
.maps>div{min-width:0}.matrix{display:grid;gap:2px;overflow:auto}.matrix button{border:0;min-height:35px;font:inherit;cursor:pointer;padding:0}
.matrix button[aria-pressed=true]{outline:2px solid currentColor;outline-offset:-2px}.matrix button:focus-visible{outline:2px dashed currentColor;z-index:1}
@media(max-width:590px){.maps{grid-template-columns:1fr}.matrix button{min-height:39px}}
</style>
