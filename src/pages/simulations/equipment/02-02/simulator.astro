---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
const asset='/equipment/02-02/';
const manual='https://www.ipsiras.ru/Lab/CKPO/Nanofot/doc/SussMJB-3.pdf';
const sop='https://cns1.rc.fas.harvard.edu/facilities/docs/SOP057_r2_3_MJB3%20Contact%20Aligner.pdf';
const nd='https://nanofabrication.nd.edu/facilities/equipment/mjb-3-mask-aligner/';
const side='https://caeonline.com/buy/mask-aligners/karl-suss-microtec-mjb-3/293773786';
const stage='https://caeonline.com/buy/mask-aligners/karl-suss-microtec-mjb-3/9284673';
const specs=[
['Chuck diameter / mask plate / clear aperture','25.4 / 76.2 / 50.8 mm','CNS SOP 057 r2.3, pp.1–2: selected 1-inch standard chuck and 3-inch maskholder with 2-inch round opening',sop],
['X, Y adjustment span','6.0 mm each; centered ±3 mm in virtual instrument','SUSS reference manual rev A (Feb 1984), §2.1.2, p.2-4; centering is a simulation convention',manual],
['Theta span','30° total; centered ±15°','SUSS manual §2.1.2, p.2-4',manual],
['X/Y micrometer pitch','1.0 mm coarse; 0.05 mm fine per revolution','SUSS manual §2.1.2, p.2-4; not a resolution claim',manual],
['Thickness adjustment','150 µm/revolution','CNS SOP p.3; Z stroke not measured; 100–1000 µm software sample range',sop],
['Illumination','405 nm CI-2 nominal 25 mW/cm²; 365 nm CI-1 nominal 12 mW/cm²','CNS SOP p.2; values may drift. Selected CI-2; user supplies intensity',sop],
['Alignment optics','Single-field, manual front-side X/Y/θ alignment','CNS SOP pp.1, 4–5; depicted binocular and three objectives informed by family imagery',sop],
['Exposure modes','Hard / soft / vacuum contact','CNS SOP p.4; this model implements ideal hard contact with a standard chuck only',sop],
['Rear utility connections','N₂, air, vacuum and power','SUSS manual §§6.5–6.7, pp.6-5–6-7; ports schematic',manual],
['Enclosure / transport','520 × 460 mm base, approximately 527 mm housing top; 120 mm slide motion; 180° contact lever rotation','Original estimates from family photographs. Lever action documented in SUSS manual §2.3.2; enclosure, port placement and slide travel unmeasured',manual]
];
const refs=[
['front','Front three-quarter','Notre Dame MJB3 installation: orange rear lamphouse, cream stage casting, binocular head and manual knobs. Family reference; exact Harvard serial/variant unavailable.',nd],
['side','Left side','Used 2006 MJB3, CAE listing 293773786: manipulator arm, focus knob, lamphouse and coarse controls. Not the selected installed serial.',side],
['load','Working area','Manufacturer Fig. 2-2, p.2-5: mask frame, clamp knobs, micrometers and transport slide. Fig. 2-4, p.2-7: standard chuck transport.',manual+'#page=27'],
['rear','Rear and utilities','Manual §6.5–6.7 and Figs. 6-3/6-4: rear utilities. Placement and enclosure shape reconstructed, not an observed orthogonal photograph.',manual],
['optics','Objective close-up','CAE listing 9284673: revolver, objective barrels, front stage and mask-clamp knobs. Family reference; original illustration is not calibrated photogrammetry.',stage]
];
---
<Layout pageTitle="Manual mask aligner" subtitle="" description="Karl SUSS MJB3 virtual contact photolithography bench." wide={true}>
<article class="equipment mjb" id="mjb-lab">
<nav class="eq-nav"><a href="/simulations/equipment/02-02/">← Equipment 02-02</a><a href="/simulations/equipment/">Equipment register</a><a href="#mjb-evidence">Evidence &amp; verification</a></nav>
<header class="eq-mast"><span class="eq-meta">02-02 / CONTACT LITHOGRAPHY / VIRTUAL INSTRUMENT</span><h2>Karl SUSS MJB3</h2><p>Harvard CNS OL-3 configuration as documented in SOP 057 rev 2.3 (2010): 1-inch standard chuck, 3-inch maskholder, single-field top-side optics, nominal 405 nm channel. Exact hardware suffix and serial number were not documented. Exterior reconstruction is family-informed, not factory CAD.</p></header>
<div class="mjb-bench">
<section class="mjb-panel"><h3>Instrument</h3><div class="mjb-tools">
<button data-view="reset">Reset view</button><button data-view="front">Front</button><button data-view="side">Side</button><button data-view="rear">Rear</button><button data-view="load">Stage</button><button data-view="optics">Optics</button>
</div><div class="mjb-view"><canvas id="mjb-canvas" aria-label="Orbitable three-dimensional MJB3 instrument"></canvas></div>
<p id="mjb-model-status" role="status" class="mjb-small">Loading scaled GLB model…</p><p class="mjb-small">Drag to orbit; scroll or pinch to zoom. Stage movement uses physical millimeters. The 120 mm loading slide, separation distance and optical carriage animation are illustrative.</p>
<div class="mjb-tools"><button id="mjb-slide">Withdraw slide</button><button id="mjb-load" disabled>Unload specimen</button><button id="mjb-clamp">Release mask</button><button id="mjb-contact">Bring into contact</button><button id="mjb-cut" aria-pressed="false">Inspect chuck (hide optics)</button></div>
<p id="mjb-machine" class="mjb-state" aria-live="polite">Demo coupon loaded, mask clamped, separated.</p>
</section>
<section class="mjb-panel"><h3>Experiment setup</h3><form id="mjb-fields" onsubmit="return false">
<label>Sample ID<input name="sampleId" maxlength="100" required/></label><label>Parent revision<input name="revision" type="number" min="0" max="999999" step="1" required/></label>
<label>Coupon width (mm)<input name="widthMm" type="number" min="1" max="25.4" step=".1" required/></label><label>Coupon height (mm)<input name="heightMm" type="number" min="1" max="25.4" step=".1" required/></label>
<label>Coupon thickness (µm)<input name="thicknessUm" type="number" min="100" max="1000" step="1" required/></label>
<label>Stage X (mm)<input name="xMm" type="number" step=".001" required/></label><label>Stage Y (mm)<input name="yMm" type="number" step=".001" required/></label><label>Stage θ (°)<input name="thetaDeg" type="number" step=".01" required/></label>
<label>Measured / assumed intensity (mW/cm²)<input name="intensity" type="number" min=".01" max="100" step=".01" required/></label><label>Exposure (s)<input name="seconds" type="number" min=".01" max="120" step=".01" required/></label>
<label>Nominal raster pitch (mm)<select name="pitchMm"><option value=".05">0.05</option><option value=".1">0.10</option><option value=".2">0.20</option><option value=".5">0.50</option></select></label>
</form><details><summary>Mask geometry (editable JSON)</summary><textarea id="mjb-mask" rows="12" spellcheck="false" aria-label="Mask clear rectangles and alignment fiducials"></textarea><label>Import mask JSON <input id="mjb-import" type="file" accept=".json,application/json"/></label><p class="mjb-small">ID, revision, clear rectangles (id, x, y, w, h in mm) and two fiducials (id, x, y). Coordinates are already viewed from the coupon, no artwork mirroring is applied.</p></details>
<div class="mjb-tools"><button id="mjb-apply">Apply stage pose</button><button id="mjb-align">Align both marks</button><button id="mjb-run" class="mjb-primary">Expose coupon</button><button id="mjb-example">Run aligned example</button></div><progress id="mjb-progress" value="0" max="1" aria-label="Illustrative exposure progress"></progress>
<p id="mjb-status" role="status" aria-live="polite">Ready: apply a stage pose, inspect the marks, then contact and expose.</p>
</section>
</div>
<section class="mjb-panel"><h3>Alignment microscope &amp; latent image</h3><div class="mjb-plots"><figure><canvas id="mjb-overlay" width="500" height="340" aria-label="Two sequential schematic microscope fields"></canvas><figcaption>Two sequential single-field inspections. Gold = mask target; cyan = coupon mark. Display magnification is schematic, not optical resolution.</figcaption></figure><figure><canvas id="mjb-dose" width="500" height="340" aria-label="Calculated latent exposure map"></canvas><figcaption>Coupon coordinates; gold pixels receive exposure. No development or printed feature width is inferred.</figcaption></figure></div><div id="mjb-result" aria-live="polite">No current exposure result.</div><div class="mjb-tools"><button id="mjb-json" disabled>Export sample revision (JSON)</button><button id="mjb-csv" disabled>Export dose map (CSV)</button><a href={asset+'example-result.json'} download>Example result</a><a href={asset+'output-schema.json'} download>Handoff schema</a></div></section>
<section id="mjb-evidence" class="mjb-panel"><h3>Illustrated reference sheet</h3><p>All views below are original renders from the editable virtual instrument. Original photos and illustrated manual are linked, rather than republished without verified reuse permission. The viewed Notre Dame and CAE photos establish a red/cream family silhouette, binocular optics, three-gauge manometer, stage and controls. Their machine-specific options do not establish the Harvard serial. Matching presets support qualitative comparison only; no orthographic metrology has been performed.</p>
<div class="mjb-refs">{refs.map(([id,title,description,url])=><figure><img id={'mjb-ref-'+id} alt={'Original model rendering: '+title} width="480" height="300"/><figcaption><b>{title}.</b> {description} <a href={url} target="_blank" rel="noopener">Original source</a> · <button data-view={id}>Inspect view</button></figcaption></figure>)}</div>
<h3>Specification and assumptions</h3><div class="mjb-scroll"><table><thead><tr><th>Specification</th><th>Value / limits</th><th>Evidence and purpose</th></tr></thead><tbody>{specs.map(([label,value,note,url])=><tr><td>{label}</td><td>{value}</td><td><a href={url} target="_blank" rel="noopener">{note}</a></td></tr>)}</tbody></table></div>
<p>Chuck-fit rule: a centered rectangular coupon must fit within a 25.4 mm diameter circle and cover four assumed vacuum holes at (±3, ±3) mm, radius 0.5 mm, plus center. Hole geometry is not from the manual; passing this rule does not prove real vacuum compatibility. The mask is a 76.2 mm square, 50.8 mm aperture; mask thickness, actual chuck retention and Z clearance remain unknown.</p>
<h3>Numerical method and input/output contract</h3><p>Let coupon-local coordinates be p = (x,y), with x right and y away from operator. The actual substrate pose is q = R(θ)p + t in mask coordinates. The exposure map evaluates D(p) = I × time × T(q), where T is 1 inside the round holder aperture and the union of clear rectangles, 0 elsewhere. Each raster cell is sampled at its center. The inverse transform is exported as a homogeneous 3 × 3 matrix. Alignment marks use two corresponding nominal positions; residual is R(θ)p + t − p.</p>
<p>This is ideal hard-contact, binary optical transmission, uniform monochromatic-equivalent dose, no diffraction, gap, mask sag, focus aberration, resist chemistry or development. Nominal dose is in mJ/cm², with mm grid coordinates. Default 0.1 mm pixels are far too coarse for micron-resolution claims. The model rejects out-of-span requests, unsupported samples, mask errors, invalid dose settings and absent load/clamp/contact interlocks. On rejection no new revision is produced and the last valid physical pose is retained. Revisions are calculated, not measured. Export JSON retains sample ID, revision, mask features and fiducial IDs, transform, dose map and provenance; CSV contains per-cell coordinates and dose. No compatible downstream import has been demonstrated; example and schema are available for the developer station.</p>
<h3>Executed verification</h3><div class="mjb-scroll"><table><thead><tr><th>Case</th><th>Expected</th><th>Actual</th><th>Tolerance / result</th></tr></thead><tbody>
<tr><td>2 × 2 mm independent square at 0.1 mm pitch</td><td>400 cells; 4 mm²</td><td>400; 4 mm²</td><td>Exact cells; 10⁻⁹ mm² / PASS</td></tr>
<tr><td>25 mW/cm² × 4 s</td><td>100 mJ/cm²</td><td>100 mJ/cm²</td><td>10⁻⁹ / PASS</td></tr>
<tr><td>Stage +1 mm X</td><td>10-cell left shift, area conserved</td><td>Columns 60–79 vs 70–89; 4 mm²</td><td>Exact columns / PASS</td></tr>
<tr><td>Register fit and range</td><td>16 × 16 mm fits; +3 mm valid; +3.001 mm rejected, no revision</td><td>Fit and edge accepted; travel flag; null output</td><td>Exact / PASS</td></tr>
<tr><td>Time doubled</td><td>200 mJ/cm²; unchanged area</td><td>200; 4 mm²</td><td>10⁻⁹ / PASS</td></tr>
<tr><td>Geometry source</td><td>25.4 mm chuck; 76.2 mm mask</td><td>25.4; 76.2 mm by construction</td><td>Exact source dimensions / PASS; not physical measurement</td></tr>
<tr><td>Experimental comparison</td><td>Measured irradiance and developed features</td><td>No independent resist data</td><td>NOT VALIDATED</td></tr>
</tbody></table></div><p>Eight authored test bodies executed against the exact JavaScript solver in a JS isolate, with an assertion shim. Full Node, production build and browser checks are separate GitHub Actions checks. <a href={asset+'verification.json'} download>Machine-readable results</a>.</p>
<div class="mjb-tools"><a href={asset+'model-source.json'} download>Editable model source (JSON)</a><a href={asset+'build-model.mjs'} download>glTF generator</a><a href={asset+'mjb3.glb'} download>Download GLB</a><a href={asset+'mjb3.gltf'} download>Download glTF</a><a href={asset+'solver.mjs'} download>Numerical solver</a><a href="https://github.com/corbins-cryo-pod/buildthesimulation/blob/main/tests/equipment-02-02-mjb3.mjs">Repository tests</a><a href="https://github.com/corbins-cryo-pod/buildthesimulation/actions">CI evidence</a></div>
</section>
</article></Layout>
<script>
import '../../../../lib/equipment/02-02/client.mjs';
</script>
<style is:global>
.mjb{font-size:17px}.mjb h3{font-size:1.5rem;margin:.2rem 0 .65rem}.mjb-panel{border:1px solid var(--border);padding:1rem;min-width:0;margin:1rem 0}.mjb-bench{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:1rem}.mjb-bench .mjb-panel{margin:0}.mjb-view{width:100%;height:clamp(290px,44vw,530px);background:#27323a;position:relative}.mjb-view canvas{width:100%;height:100%;display:block;touch-action:none}.mjb-tools{display:flex;flex-wrap:wrap;gap:.45rem;align-items:center;margin:.6rem 0}.mjb button,.mjb input,.mjb select,.mjb textarea{font:inherit;color:var(--text);background:var(--panel);border:1px solid var(--border);border-radius:2px;padding:.45rem .55rem;min-width:0;max-width:100%;box-sizing:border-box}.mjb button{cursor:pointer;font-size:15px}.mjb button:disabled{opacity:.48;cursor:not-allowed}.mjb button.mjb-primary{background:var(--accent);color:#181711;font-weight:bold}.mjb button[aria-pressed=true]{border:2px solid var(--accent)}.mjb form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.mjb form label{display:flex;flex-direction:column;gap:.2rem}.mjb textarea{width:100%;font-family:monospace;font-size:13px;display:block}.mjb details{margin:.75rem 0}.mjb progress{width:100%}.mjb-small{font-size:.86rem}.mjb-state{border-block:1px solid var(--border);padding:.55rem 0}.mjb #mjb-status[data-fail=true]{font-weight:bold;color:var(--text);border-left:4px solid #b55436;padding-left:.6rem}.mjb-plots,.mjb-refs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.mjb figure{margin:0;min-width:0}.mjb figure img,.mjb figure canvas{width:100%;height:auto;display:block;background:#27323a}.mjb figcaption{font-size:.85rem;margin-top:.4rem}.mjb-scroll{overflow:auto}.mjb table{width:100%;border-collapse:collapse;font-size:.92rem}.mjb th,.mjb td{padding:.55rem;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}.mjb #mjb-result{margin:.8rem 0;overflow-wrap:anywhere}.mjb #mjb-result dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.25rem 1rem}.mjb #mjb-result dd{margin:0;text-align:left;font-variant-numeric:tabular-nums}.mjb a{overflow-wrap:anywhere}
@media(max-width:800px){.mjb-bench{grid-template-columns:minmax(0,1fr)}.mjb-view{height:360px}}@media(max-width:480px){.mjb-panel{padding:.65rem}.mjb-plots,.mjb-refs{grid-template-columns:minmax(0,1fr)}.mjb-view{height:300px}.mjb button{min-height:38px}.mjb form{gap:.4rem}.mjb form label{font-size:.8rem}}
</style>
