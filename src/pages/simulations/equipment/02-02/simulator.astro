import '../../../../lib/equipment/02-02/client.mjs';
</script>
<style is:global>
.mjb{font-size:17px}.mjb h3{font-size:1.5rem;margin:.2rem 0 .65rem}.mjb-panel{border:1px solid var(--border);padding:1rem;min-width:0;margin:1rem 0}.mjb-bench{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:1rem}.mjb-bench .mjb-panel{margin:0}.mjb-view{width:100%;height:clamp(290px,44vw,530px);background:#27323a;position:relative}.mjb-view canvas{width:100%;height:100%;display:block;touch-action:none}.mjb-tools{display:flex;flex-wrap:wrap;gap:.45rem;align-items:center;margin:.6rem 0}.mjb button,.mjb input,.mjb select,.mjb textarea{font:inherit;color:var(--text);background:var(--panel);border:1px solid var(--border);border-radius:2px;padding:.45rem .55rem;min-width:0;max-width:100%;box-sizing:border-box}.mjb button{cursor:pointer;font-size:15px}.mjb button:disabled{opacity:.48;cursor:not-allowed}.mjb button.mjb-primary{background:var(--accent);color:#181711;font-weight:bold}.mjb button[aria-pressed=true]{border:2px solid var(--accent)}.mjb form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.mjb form label{display:flex;flex-direction:column;gap:.2rem;min-width:0}.mjb form :is(input,select){width:100%}.mjb-panel,.mjb-view,.mjb-tools{max-width:100%;box-sizing:border-box}.mjb details input[type=file]{width:100%;max-width:100%}.mjb textarea{width:100%;font-family:monospace;font-size:13px;display:block}.mjb details{margin:.75rem 0}.mjb progress{width:100%}.mjb-small{font-size:.86rem}.mjb-state{border-block:1px solid var(--border);padding:.55rem 0}.mjb #mjb-status[data-fail=true]{font-weight:bold;color:var(--text);border-left:4px solid #b55436;padding-left:.6rem}.mjb-plots,.mjb-refs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.mjb figure{margin:0;min-width:0}.mjb figure img,.mjb figure canvas{width:100%;height:auto;display:block;background:#27323a}.mjb figcaption{font-size:.85rem;margin-top:.4rem}.mjb-scroll{overflow:auto}.mjb table{width:100%;border-collapse:collapse;font-size:.92rem}.mjb th,.mjb td{padding:.55rem;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}.mjb #mjb-result{margin:.8rem 0;overflow-wrap:anywhere}.mjb #mjb-result dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.25rem 1rem}.mjb #mjb-result dd{margin:0;text-align:left;font-variant-numeric:tabular-nums}.mjb a{overflow-wrap:anywhere}
@media(max-width:800px){.mjb-bench{grid-template-columns:minmax(0,1fr)}.mjb-view{height:360px}}@media(max-width:480px){.mjb-panel{padding:.65rem}.mjb-plots,.mjb-refs{grid-template-columns:minmax(0,1fr)}.mjb-view{height:300px}.mjb button{min-height:38px}.mjb form{gap:.4rem}.mjb form label{font-size:.8rem}}
</style>
