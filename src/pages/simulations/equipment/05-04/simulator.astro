.alpha{max-width:80rem}.alpha .grid,.alpha .figs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.alpha section{min-width:0;border-top:1px solid var(--border);padding:.85rem 0;margin:.9rem 0}.alpha h2{margin:.22em 0}.alpha p{line-height:1.45}.alpha label{display:flex;flex-direction:column;gap:.25em;min-width:0}.alpha .config{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55em}.alpha .bar{display:flex;flex-wrap:wrap;gap:.45rem;margin:.6rem 0}.alpha button,.alpha select,.alpha input{font:inherit;border:1px solid var(--border);background:var(--panel);color:var(--text);min-height:2.35em;border-radius:.15em;padding:.4rem .5rem;min-width:0;max-width:100%}.alpha button{cursor:pointer}.alpha [disabled]{opacity:.53;cursor:default}.primary{background:#214752!important;color:white!important}.alpha #as-model{height:clamp(280px,32vw,440px);background:#d6dbdb;touch-action:none}.alpha #as-model :global(canvas){display:block;width:100%;height:100%}.alpha canvas{display:block;width:100%;height:auto;margin-bottom:.45em}.alpha output{display:block;white-space:pre-line;font-family:monospace}.alpha figure{margin:0}.alpha img{display:block;width:100%;height:auto}.small,.alpha figcaption{font-size:.88rem}.alpha table{border-collapse:collapse;font-size:.9rem}.alpha th,.alpha td{padding:.45em;text-align:left;border-bottom:1px solid var(--border)}.scroll{overflow-x:auto}.alpha [hidden]{display:none!important}.alpha .error{color:#a64b31}.alpha code{overflow-wrap:anywhere}@media(max-width:790px){.alpha .grid,.alpha .figs{grid-template-columns:1fr}}@media(max-width:390px){.alpha .config{grid-template-columns:1fr}}
</style>
