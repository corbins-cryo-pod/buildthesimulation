---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
import reports from '../../../../../public/equipment/05-02/verification.json';
import geom from '../../../../../public/equipment/05-02/geometry-check.json';
import metrics from '../../../../../public/equipment/05-02/interactions.json';
const a='/equipment/05-02/',ds='https://www.m3.tuc.gr/EQUIPMENT/CONTOUR%20GT-K/Datasheet.pdf';
const brochure='https://www.m3.tuc.gr/EQUIPMENT/CONTOUR%20GT-K/ContourGT_3D_Optical_Microscopes-Brochure-B514-RevC0.pdf',uic='https://rrc.uic.edu/wp-content/uploads/sites/112/2020/02/Bruker-Nano_Contour_GT-K_Optical_Profilometer.pdf',sop='https://purdue.atlassian.net/wiki/spaces/BNCWiki/pages/6228736/Bruker%2BOptical%2BProfilometer';
const refs=[
['front','Front housing',ds+'#page=1','Bruker datasheet front photograph sets the upright shroud, enamel housing and nosepiece proportions.'],
['side','Side and workstation',uic+'#page=1','UIC instrument photograph identifies the pendant, specimen clearance and a separate workstation. Exact side dimensions and computer are inferred.'],
['work','Measurement bay',sop,'Purdue facility instructions establish stage loading direction and accessible turret. Original detailed reconstruction, not an orthogonal photograph.'],
['rear','Rear service area',brochure,'Bruker family brochure B514 Rev C0 documents installed options. No rear photograph or connector offsets verified; rear ports here are schematic.']
];
const numeric=[['sx','Tilt slope X (µm/µm)',-.06,.06,.001],['sy','Tilt slope Y (µm/µm)',-.06,.06,-.0005],['stepUm','Step (µm)',0,25,5],['roughUm','Texture amplitude (µm)',0,2,0],['focusUm','Axial center (µm)',-40,40,0],['halfSpanUm','Scan half-span (µm)',1,40,15]];
const display=k=>typeof k==='string'?k:Object.entries(k).map(([key,v])=>key+': '+(v===null?'null':Math.abs(v)<1e-11&&v!==0?'≈0':Number(v.toPrecision(8)))).join('; ');
---
<Layout pageTitle="Bruker ContourGT-K" subtitle="" description="Measure an inert step, tilt or roughness using an ideal optical coherence scan." wide={true}>
<article id="gtk" class="equipment">
<nav class="eq-nav"><a href="/simulations/equipment/05-02/">← Equipment 05-02</a><a href="/simulations/equipment/">Equipment register</a><a href="#gtk-refs">References</a><a href="#gtk-verify">Verification</a></nav>
<header class="gtk-head"><p class="eq-meta">05-02 / Optical surface metrology / Virtual VSI bench</p><h2>Bruker ContourGT-K</h2><p>Measure a 5 µm step without touching it. The modeled bench combines documented options: 150 mm motorized XY stage, turret populated with 5× and 20× interferometric objectives, the standard monochrome camera and nominal 1× relay. This is a GT-K configuration, not a particular serial or a GT-K0.</p></header>
<div class="gtk-bench"><section class="gtk-card"><h3>01 · Inspect and load</h3><div class="gtk-bar" id="gtk-views">{['Bench','Front','Side','Rear','Work'].map(v=><button type="button" data-view={v.toLowerCase()}>{v}</button>)}<button id="gtk-xr" disabled>VR unavailable</button></div>
<canvas id="gtk-model" aria-label="Orbitable ContourGT-K with operable stage and objective turret"></canvas><p id="gtk-asset" role="status">Loading metric GLB…</p><p>Drag to orbit, scroll or pinch to zoom. Select the stage to move it out, the coupon to remove it, the turret to switch magnification, or the monitor to run the scan. On a removed coupon, use Load coupon to replace it.</p></section>
<section class="gtk-card"><h3>02 · Configure and measure</h3>
<form id="gtk-config"><div class="gtk-bar"><button type="button" id="gtk-stage">Move to load</button><button type="button" id="gtk-load">Remove coupon</button><button type="button" id="gtk-change">Switch objective</button></div>
<div class="gtk-fields"><label>Specimen ID<input name="sampleId" maxlength="96" required value="step-standard-01"/></label>
<label>Reference shape<select name="type"><option value="step">Step</option><option value="flat">Tilted flat</option><option value="texture">Periodic roughness</option></select></label>
<label>Objective<select name="objective"><option value="5">5×</option><option value="20">20×</option></select></label>
{numeric.map(([name,label,min,max,value])=><label>{label}<input name={name} type="number" min={min} max={max} value={value} step="any"/></label>)}
<label>Fringe visibility<select name="contrast"><option value="0.8">Reflecting · 0.8</option><option value="0.25">Lower · 0.25</option><option value="0.05">Below threshold · 0.05</option></select></label>
<label>Dropout<select name="mask"><option value="true">Mask 9 × 7 pixels</option><option value="false">None</option></select></label>
<label>Envelope noise<select name="noise"><option value="false">Off</option><option value="true">Seeded perturbation</option></select></label></div>
<div class="gtk-bar"><button class="gtk-run" id="gtk-run" type="submit">Acquire height map</button><button type="button" id="gtk-reset">Step demo</button><button type="button" id="gtk-flat">Tilt demo</button><button type="button" id="gtk-rough">Roughness demo</button></div></form>
<p id="gtk-status" role="status">Loaded and centered at 5×. Ready to scan.</p></section></div>
<section class="gtk-card"><h3>03 · Inspect topography</h3><p id="gtk-result" role="status">No height map acquired.</p><div class="gtk-bench">
<div><canvas id="gtk-map" width="512" height="384" aria-label="Height map with masked pixels"></canvas><p id="gtk-scale">Valid-pixel scale.</p></div><div><label>Profile row <input type="range" id="gtk-row" min="0" max="47" value="14"/></label><svg id="gtk-profile" viewBox="0 0 500 215" role="img" aria-label="Cross-section of selected raster row"></svg><p>Click a map row or use the slider. Invalid pixels are charcoal and break the cross-section.</p></div></div>
<div class="gtk-bar"><button id="gtk-json" disabled>Height map JSON</button><button id="gtk-csv" disabled>Height map CSV</button></div></section>
<section id="gtk-refs"><h3>Illustrated reference sheet</h3><p>The photographs remain at their original links. The companion images below are original simulation renders, not factory CAD.</p><div class="gtk-refs">
{refs.map(([v,t,src,d])=><figure><img src={a+v+'.webp'} width="600" height="430" loading="lazy" alt={'Original rendering: '+t}/><figcaption><b>{t}.</b> {d} <a href={src}>Reference source</a>.</figcaption></figure>)}</div>
<div class="gtk-table"><table><thead><tr><th>Specification</th><th>Value / conditions</th><th>Use / source</th></tr></thead><tbody>
<tr><td>Envelope W × D × H</td><td>492 × 534 × 754 mm; workstation and pendant excluded</td><td>Geometry. <a href={ds+'#page=2'}>Bruker specifications, p. 2</a>.</td></tr>
<tr><td>Stage and optical travel</td><td>150 mm motorized XY option; 100 mm Z focus option; up to 10 mm optical scan, 47 µm/s with standard camera</td><td><a href={ds+'#page=2'}>Bruker p. 2</a>. The model’s 80 mm loading move is inferred; the scan is limited to a smaller window.</td></tr>
<tr><td>Options</td><td>5× and 20×, 1× relay, 640 × 480 monochrome</td><td><a href={ds+'#page=2'}>Bruker p. 2</a> and <a href={brochure}>family brochure B514 rev C0</a>.</td></tr>
<tr><td>Virtual raster</td><td>64 × 48; 5× field 1280 × 960 µm, 20× field 320 × 240 µm; 0.1 µm axial sampling and ±1–40 µm half-span</td><td>Original software settings, not a measured pixel scale or resolution claim.</td></tr>
<tr><td>Envelope and cutoff</td><td>σ = 1 and 0.8 µm; visibility below 0.12 is rejected; optional 0.001 peak-to-peak seeded amplitude noise</td><td>Simulation assumptions, not measured optics or sensor calibration.</td></tr>
</tbody></table></div></section>
<section><h3>What the instrument calculates</h3><p>The conceptual interferogram is I(z) = I₀ + γ exp[−(z−h)²/(2σ²)] cos(4π(z−h)/λ). A broadband fringe envelope peaks near object height h. The solver samples ideal demodulated amplitudes and fits a three-point parabola to their logarithms near the peak. It does not simulate raw camera frames or use Vision64’s algorithm. <a href="https://opg.optica.org/ao/abstract.cfm?uri=ao-55-24-6763">Primary study on coherence-envelope extraction</a>.</p>
<p>The presets are a reflecting plane, a two-terrace step and an eight-cycle cosine reference. A prescribed 9 × 7 dropout, low visibility or a peak outside the axial window gives a null height and an explicit reason. Plane regression omits invalid pixels; the step fit uses one shared slope and two offsets, excluding two seam columns. Sa and Sq are the mean absolute and RMS leveled residual heights. These unfiltered statistics are not certified roughness measurements.</p>
<p>No diffraction transfer function, transparent-layer interference, camera saturation, vibration or uncertainty budget is simulated. The output contains row-major pixel-center coordinates (X right, Y away, Z toward the objective), units in µm, sample ID, parent and measurement revisions, height/mask/reason arrays, and provenance. The coupon itself does not change. <a href={a+'output-schema.json'}>Schema</a> · <a href={a+'example-heightmap.json'}>Example height map</a>.</p></section>
<section id="gtk-verify"><h3>Verification notebook</h3><p>Independent analytic cases were set before coding. Measured instrument datasets were not used.</p>
<div class="gtk-table"><table><thead><tr><th>Case</th><th>Expected</th><th>Actual</th><th>Tolerance</th><th>Outcome</th></tr></thead><tbody>
{reports.map(r=><tr><td>{r.id}</td><td>{display(r.expected)}</td><td>{display(r.actual)}</td><td>{display(r.tolerances??'Exact state')}</td><td>{r.pass?'Pass':'Fail'}</td></tr>)}
{geom.checks.map(r=><tr><td>GLB · {r.axis}</td><td>{r.referenceMm} mm</td><td>{r.actualMm} mm</td><td>±{r.toleranceMm} mm</td><td>{r.pass?'Pass':'Fail'}</td></tr>)}</tbody></table></div></section>
<section><h3>3D and integration files</h3><p><a href={a+'contour-gt-k.glb'} download>Metric GLB</a> · <a href={a+'model.py'}>Editable Blender generator</a> + <a href={a+'pack.py'}>packer</a> · <a href={a+'interactions.json'}>XR interaction contract</a> · <a href={a+'solver.mjs'}>Headless solver</a> · <a href={a+'reference-plan.json'}>Predeclared fixtures</a> · <a href={a+'verification.json'}>Numerical results</a> · <a href={a+'geometry-check.json'}>Geometry checks</a>.</p>
<p>{metrics.triangles.toLocaleString('en-US')} triangles, {metrics.drawCalls} material primitives, {Math.round(metrics.bytes/1024)} KiB. Meter scale and stable stage, coupon and turret targets. Supported WebXR sessions can use controller rays to operate the bench and scan monitor. Physical headset behavior is unverified.</p></section>
</article></Layout>
<script>import '../../../../lib/equipment/05-02/client.mjs';</script>
<style>
.gtk-head{padding:1.35rem 0;max-width:74ch}#gtk h2{font-size:clamp(1.9rem,6vw,4rem);line-height:1.05;margin:.2rem 0}#gtk section{margin:1rem 0}#gtk section>p{max-width:96ch}.gtk-bench,.gtk-refs{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem}.gtk-card{border:1px solid var(--border);padding:.85rem;min-width:0}.gtk-card h3{margin:.3rem 0}.gtk-bar{display:flex;gap:.35rem;flex-wrap:wrap;margin:.5rem 0}.gtk-bar button,.gtk-fields :is(select,input){min-height:2.45rem;border:1px solid var(--border);background:var(--panel);color:var(--text);border-radius:3px;font:inherit;padding:.3rem .47rem}.gtk-fields :is(select,input){width:100%;min-width:0;box-sizing:border-box}.gtk-fields option{background:var(--menuBg,Canvas);color:var(--text,CanvasText)}.gtk-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}.gtk-fields label{display:grid;gap:.22rem}.gtk-run{background:#345672!important;color:white!important}#gtk-model{display:block;width:100%;height:clamp(260px,34vw,430px);touch-action:none;background:#e9e8e2}#gtk-map{display:block;width:100%;height:auto;image-rendering:pixelated;background:#172733;max-width:540px}#gtk-profile{width:100%;max-height:14rem}.gtk-table{overflow:auto}#gtk table{border-collapse:collapse;width:100%;font-size:.85rem}#gtk th,#gtk td{text-align:left;padding:.5rem;border-bottom:1px solid var(--border);vertical-align:top}.gtk-refs figure{margin:.3rem 0}.gtk-refs img{width:100%;height:auto;display:block;background:#e9e8e2}.gtk-refs figcaption{font-size:.88rem}#gtk button{cursor:pointer}#gtk button:disabled{cursor:default;opacity:.55}@media(max-width:820px){.gtk-bench{grid-template-columns:1fr}.gtk-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:540px){.gtk-refs{grid-template-columns:1fr}}
</style>
