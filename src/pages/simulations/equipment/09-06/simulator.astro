import '../../../../lib/equipment/09-06/client.mjs';
</script>
<style>
#gen336 {max-width: 1280px; margin:auto; color:inherit;}
#gen336 header {margin:1.4rem 0 1rem;}
#gen336 header h2 {margin:.25rem 0 0;}
#gen336 header p {max-width:85ch;}
.work {display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:1rem;}
.panel {border:1px solid color-mix(in srgb,currentColor 32%,transparent);padding:clamp(.8rem,2vw,1.4rem);margin:.6rem 0;border-radius:.33rem;min-width:0;}
.panel h3 {margin:0 0 .85rem;}
.tools {display:flex;gap:.4rem;flex-wrap:wrap;}
.tools button {border:1px solid currentColor;background:transparent;color:inherit;min-height:38px;padding:.45rem .7rem;border-radius:.24rem;cursor:pointer;font:inherit;}
.tools button[aria-pressed=true] {background:#d6bd73;color:#151b1a;}
.tools button:disabled {opacity:.46;cursor:not-allowed;}
#gen-viewer {height:350px;margin:.75rem 0 0;background:#263439;}
#gen-viewer :global(canvas) {display:block;max-width:100%;touch-action:none;}
.fields {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin:.8rem 0;}
.fields label {display:flex;flex-direction:column;gap:.18rem;font-size:.9rem;}
.fields input,.fields select {min-width:0;width:100%;min-height:38px;box-sizing:border-box;font:inherit;color:inherit;background:transparent;border:1px solid currentColor;border-radius:.2rem;padding:.26rem;}
.fields option {color:#151b1a;background:#faf5e8;}
#gen-actual,#gen-result {font-weight:700;margin:.7rem 0;}
#gen-status[data-error=true] {color:inherit;border-left:4px solid #d16246;padding-left:.6rem;font-weight:600;}
#gen-trace {display:block;width:min(100%,760px);height:auto;max-width:100%;border-radius:.2rem;}
.views {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem;}
.views figure {margin:0;}
.views img {display:block;width:100%;height:auto;}
.views figcaption {margin:.35rem 0 1rem;font-size:.92rem;}
.specs div {border-top:1px solid color-mix(in srgb,currentColor 22%,transparent);padding:.55rem 0;}
