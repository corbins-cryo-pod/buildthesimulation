.specs dt {font-weight:bold;}
.scroll {overflow-x:auto;}
table {border-collapse:collapse;width:100%;}
th,td {text-align:left;border-bottom:1px solid color-mix(in srgb,currentColor 28%,transparent);padding:.44rem;}
@media(max-width:900px) {.work {grid-template-columns:1fr;} #gen-viewer {height:310px;}}
@media(max-width:550px) {.views {grid-template-columns:1fr;} #gen-viewer {height:265px;} .tools button,.fields input,.fields select{min-height:44px;}}
</style>
