eight:3em}#spin-model-status,#spin-probe,#spin-legend{font-size:.8rem} #spin-import{max-width:100%;box-sizing:border-box;min-width:0}.spin section,.spin-grid>section,.spin-results>figure,.spin-refs>figure{min-width:0;max-width:100%}.spin-table{max-width:100%}.spin p,.spin a,.spin-fields label,.spin figcaption{overflow-wrap:anywhere}.spin-fields label{min-width:0}@media(max-width:850px){.spin-grid,.spin-results,.spin-refs{grid-template-columns:minmax(0,1fr)}#spin-view{height:360px}.spin-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
