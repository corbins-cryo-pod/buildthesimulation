const fields=[
['sampleId','Sample ID','text','SI-WAFER-150-001'],['parentRevision','Parent revision','number',0,0,1e9,1],['diameter_mm','Wafer diameter (mm)','number',150,50,150,1],
['offsetX_mm','Center offset X (mm)','number',0,-10,10,.1],['offsetZ_mm','Center offset Z (mm)','number',0,-10,10,.1],['dispense_mL','Dispense (mL)','number',2,.1,5,.1],
['spreadRPM','Spread speed (rpm)','number',500,100,500,10],['spread_s','Spread time (s)','number',20,1,60,1],['rpm','Coat speed (rpm)','number',4000,500,4000,100],
['hold_s','Coat hold (s)','number',35,35,60,1],['accel_rpm_s','Ramp (rpm/s)','number',1000,100,3000,100],['edgeAmplitude','Illustrative edge bead fraction','number',.35,0,1,.05],['edgeWidth_mm','Illustrative edge width (mm)','number',2,.5,5,.5]];
const specs=[
['Configuration','WS-650Mz-23NPPB; NPP, standard Mz motor, 650 controller','23-series manufacturer photo, institutional model label; B-generation photographed, no serial-specific measurements',brochure+'#page=1'],
['Case / lid diameter proxy','254 mm (10.0 in)','Nominal drawing circle; use as envelope anchor, not measured cavity diameter',drawing],
['Controller','134.6 × 203.2 mm face envelope','5.3 × 8.0 in drawing dimensions; depth and tilt inferred',drawing],
['Overall closed body height','294.5 mm in model','Inferred from drawing lower view 11.6 in and installed photographs; not certified envelope',drawing],
['Clear lid center aperture','19 mm','Manufacturer nominal; ring and pivot dimensions estimated',brochure+'#page=1'],
['Drain port','38 mm','Nominal; hose and cup placement estimated',brochure+'#page=1'],
['Wafer limit','150 mm round / 125 mm square','Machine capability; simulator supports round 50–150 mm only',brochure+'#page=1'],
['Vacuum chuck','44.45 mm diameter (1.75 in)','50–150 mm wafers; O-ring radius 21 mm assumed',sop],
