---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
import verification from '../../../../../public/equipment/02-06/verification.json';
const base='/equipment/02-06/';
const nist='https://www.nist.gov/laboratories/tools-instruments/nanofab-tool-asml-pas5500275d-stepper';
const newsletter='https://www.nist.gov/system/files/documents/cnst/CNST_News_Winter2011.pdf#page=7';
const asml='https://edge.sitecorecloud.io/asmlnetherlaaea-asmlcom-prd-5369/media/project/asmlcom/asmlcom/asml/files/products/refurbished-products/pas-5500-275d.pdf';
const paper='https://nvlpubs.nist.gov/nistpubs/ams/NIST.AMS.100-63.pdf';
const specs=[
 ['Wavelength','365 nm','Fixed i-line; no diffraction simulation',asml+'#page=2'],
 ['Reduction','5:1 (scale 0.2)','Fixed; governs every projected feature',nist],
 ['Reticle','152.4 × 152.4 mm; 3.05, 3.81, 6.35 mm thick','Nominal model; selectable thickness',nist],
 ['Field','22 × 22 or 27.4 × 14.7 mm','Exposure window limits; 20 × 20 default',nist],
 ['Wafer','75 / 100 / 150 / 200 mm diameter; ≤ 1 mm thickness','100 mm default; modeled as full circular wafer without flat/notch',nist],
 ['Resolution','≤ 280 nm','Rated capability; warns below rating, no printability claim',asml+'#page=2'],
 ['Overlay','≤ 40 nm','Single-machine, 99.7% with two-point global alignment; injected rigid error is not a statistical reproduction',asml+'#page=2'],
 ['NA','0.48–0.60','Variable on actual instrument; not used in this geometric model',asml+'#page=2'],
 ['Pellicled image field','31.1 mm diameter; max X 22.0 mm, max Y 27.4 mm','Use the conservative NIST rectangle choices; virtual XY is a design frame and may rotate relative to machine axes',asml+'#page=2'],
 ['Annular usable depth of focus','≥ 0.8 µm','At 0.28 µm and 10% CD control; not simulated',asml+'#page=2'],
 ['Distortion','≤ 40 nm','Rated, not included as a spatial distortion field',asml+'#page=2'],
 ['Manufacturer throughput','≥ 120 wph (150 mm, 40 shots); ≥ 100 wph (200 mm, 70 shots)','200 mJ/cm² ATP settings; NIST installation rating differs',asml+'#page=2'],
 ['Illumination','3.5 kW Hg arc lamp, filtered at 365 nm','Lamp power is not wafer dose',newsletter],
 ['Stage','Linear motors; interferometric position control; electrostatic chuck','Schematic positioning and accelerated sequence',newsletter],
 ['Wafer handling','Fully automated; 84 wafers/h rated','Manual teaching steps simulate automated sequence, not timing',nist],
 ['Outer cabinet','Approx. 2.05 × 1.6 × 2.135 m','Inferred scale estimate from photo; no measured cabinet CAD',nist],
 ['Console, ports and travel','Approximate schematic geometry','Travel is nominal commanded field translation, not measured stage limits',newsletter],
 ['Demonstration reticle field','110 × 110 mm on reticle maps to 22 × 22 mm wafer','Independent published application of this exact instrument',paper+'#page=8']
];
---
<Layout pageTitle="Optical projection lithography" subtitle="" description="Operate the ASML PAS 5500/275D i-line stepper and calculate reticle reduction, wafer field stepping, edge coverage, and overlay.">
<article class="equipment pas" id="pas">
<nav class="eq-nav"><a href="/simulations/equipment/02-06/">← Equipment 02-06</a><a href="/simulations/equipment/">Equipment register</a><a href="#pas-evidence">References &amp; verification</a></nav>
<header class="eq-mast"><span class="eq-meta">02-06 / OPTICAL PROJECTION / MODEL 1.0</span><h2>ASML PAS 5500/275D</h2><p>NIST NanoFab configuration · 365 nm i-line · 5:1 reduction · automated reticle and wafer handler. Educational geometric exposure model; not machine control or manufacturer CAD.</p></header>
<div class="pas-grid">
<section class="pas-panel"><div class="pas-head"><span>01 / Instrument</span><strong id="pas-state">EMPTY</strong></div>
<div id="pas-view" aria-label="Interactive 3D projection stepper"></div><p id="pas-model" role="status" class="pas-small">Loading metric GLB…</p>
<div class="pas-buttons">{['whole','front','right','rear','reticle','stage','handler'].map(v=><button data-pas-view={v} type="button">{v==='whole'?'Reset view':v}</button>)}<button id="pas-cut" type="button" aria-pressed="false">Cutaway</button><button id="pas-save-view" type="button" disabled>Save view PNG</button></div>
<p class="pas-small">Drag to orbit; pinch or scroll to zoom. Select stage or reticle for close-up. Cutaway reveals schematic internals. Violet is an optical-axis marker, not visible UV. Physical field translations are in meters; loading paths and timings are illustrative.</p>
<p class="pas-small"><a href={base+'pas5500.glb'} download>Download GLB</a> · <a href={base+'pas5500.gltf'} download>glTF</a> · <a href={base+'model-source.json'} download>Editable model</a> · <a href={base+'model-generator.mjs'} download>Geometry generator</a></p>
</section>
<section class="pas-panel"><div class="pas-head"><span>02 / Step-and-repeat job</span><span>365 nm · 5:1</span></div>
<div class="pas-buttons"><button id="pas-auto" type="button" disabled>Run ready example</button><button id="pas-reset" type="button">Reset</button><button id="pas-load-reticle" type="button" disabled>Load reticle</button><button id="pas-load-wafer" type="button" disabled>Load wafer</button><button id="pas-align" type="button" disabled>Align</button><button id="pas-step" type="button" disabled>Step / expose next field</button><button id="pas-unload" type="button" disabled>Unload</button></div>
<p id="pas-status" role="status" aria-live="polite">Loading job…</p><progress id="pas-progress" value="0" max="1" aria-label="Field completion"></progress>
<div class="pas-fields">
<label>Wafer diameter (mm)<select id="pas-waferDiameter_mm"><option>75</option><option selected>100</option><option>150</option><option>200</option></select></label>
<label>Wafer thickness (mm)<input id="pas-waferThickness_mm" type="number" value=".525" min=".01" max="1" step=".001"/></label>
<label>Reticle thickness (mm)<select id="pas-reticleThickness_mm"><option>3.05</option><option>3.81</option><option selected>6.35</option></select></label>
<label>Rows<input id="pas-rows" type="number" value="2" min="1" max="25" step="1"/></label>
<label>Columns<input id="pas-columns" type="number" value="3" min="1" max="25" step="1"/></label>
<label>Field width (mm)<input id="pas-fieldWidth_mm" type="number" value="20" min=".01" max="27.4" step=".1"/></label>
<label>Field height (mm)<input id="pas-fieldHeight_mm" type="number" value="20" min=".01" max="27.4" step=".1"/></label>
<label>X pitch (mm)<input id="pas-pitchX_mm" type="number" value="20" min=".01" max="200" step=".1"/></label>
<label>Y pitch (mm)<input id="pas-pitchY_mm" type="number" value="20" min=".01" max="200" step=".1"/></label>
<label>X grid offset (mm)<input id="pas-offsetX_mm" type="number" value="0" min="-100" max="100" step=".1"/></label>
<label>Y grid offset (mm)<input id="pas-offsetY_mm" type="number" value="0" min="-100" max="100" step=".1"/></label>
<label>X overlay (nm)<input id="pas-overlayX_nm" type="number" value="0" min="-100000" max="100000" step="1"/></label>
<label>Y overlay (nm)<input id="pas-overlayY_nm" type="number" value="0" min="-100000" max="100000" step="1"/></label>
<label>Wafer rotation (µrad)<input id="pas-rotation_urad" type="number" value="0" min="-1000" max="1000" step="1"/></label>
<label>Edge exclusion (mm)<input id="pas-edgeExclusion_mm" type="number" value="0" min="0" max="10" step=".1"/></label>
<label>Partial fields<select id="pas-partialPolicy"><option value="skip">Skip</option><option value="expose">Expose clipped</option></select></label>
<label>Command dose (mJ/cm²)<input id="pas-dose_mJ_cm2" type="number" value="100" min="1" max="1000" step="1"/></label>
</div>
<details><summary>Editable reticle and specimen IDs</summary><p class="pas-small">Rectangle artwork: x/y is lower-left in reticle-centered mm, w/h in mm, unique shape IDs. The projected wafer orientation defines the reticle artwork convention; no undocumented optical inversion is inferred.</p><label>Sample ID<input id="pas-sampleId" value="PAS-WAFER-001"/></label><label>Parent revision<input id="pas-parentRevision" type="number" value="0" min="0" step="1"/></label><label>Reticle ID<input id="pas-reticleId" value="RETICLE-L-01"/></label><label>Artwork JSON<textarea id="pas-shapes" rows="9" spellcheck="false"></textarea></label><label>Import complete job<input id="pas-import" type="file" accept=".json,application/json"/></label><a href={base+'example-job.json'} download>Example job JSON</a></details>
</section>
</div>
<section class="pas-panel"><div class="pas-head"><span>03 / Wafer exposure map</span><span>SIMULATED · NOT MEASURED</span></div>
<div class="pas-maps"><figure><figcaption>Reticle artwork / 5:1 reduction</figcaption><canvas id="pas-reticle-map" width="400" height="400" aria-label="Reticle artwork"></canvas></figure><figure><figcaption>Wafer field map / actual projected geometry</figcaption><canvas id="pas-wafer-map" width="500" height="500" aria-label="Calculated wafer exposure map"></canvas></figure></div>
<p class="pas-small">Outline colors: green = full field; amber = partial; red = outside. Pale outlines = planned; purple = completed projected artwork. Dashed circle = usable exposure boundary. Field outlines show the entire planned rectangle; exposure artwork is clipped to the usable wafer disk.</p>
<p id="pas-result" role="status" aria-live="polite">No committed exposure.</p><p id="pas-probe" class="pas-small">Select a field to inspect the overlay and projected dimensions.</p><label>Inspect field<select id="pas-field" aria-label="Inspect field"></select></label>
<div class="pas-buttons"><button id="pas-export" type="button" disabled>Export exposure revision JSON</button><button id="pas-csv" type="button" disabled>Export field overlay CSV</button><a href={base+'example-exposure.json'} download>Example handoff</a><a href={base+'output-schema.json'} download>Output schema</a><a href={base+'solver.mjs'} download>Solver source</a></div>
</section>
<section id="pas-evidence" class="pas-panel"><h3>Illustrated reference sheet</h3><p>The <a href={asml}>ASML 2019 datasheet (pp. 1–3)</a>, NIST installation photograph and 2011 labeled equipment drawing establish optics, rated performance and major module arrangement. These original annotated schematics are not vendor CAD. Exact side, rear, handler, and internal travel dimensions were not available; linked sources rather than copied photos preserve source rights.</p>
<div class="pas-refs">
<figure><svg viewBox="0 0 300 240" role="img" aria-label="Original front elevation of stepper"><rect x="54" y="25" width="205" height="190" fill="#c7c4b4" stroke="#444"/><rect x="54" y="25" width="205" height="28" fill="#969a97"/><path d="M122 25V53M191 25V53" stroke="#444"/><rect x="54" y="53" width="205" height="7" fill="#222"/><rect x="54" y="126" width="205" height="37" fill="#333"/>{[64,114,164,214].map(x=><rect x={x} y="107" width="42" height="36" fill="#b58c42" stroke="#333"/>)}<rect x="54" y="180" width="205" height="12" fill="#222"/><rect x="10" y="113" width="33" height="99" fill="#aeb2b2" stroke="#444"/><rect x="5" y="85" width="43" height="30" fill="#173b4a"/><path d="M156 31L280 11M155 112L280 87M28 100L15 71" stroke="currentColor" fill="none"/><g font-size="10" fill="currentColor"><text x="208" y="10">Upper covers</text><text x="220" y="84">Handler</text><text x="0" y="69">Console</text><text x="77" y="232">Estimated enclosure ~2.05 m wide</text></g></svg><figcaption>Front / whole instrument: cabinet, black fascia, amber loading covers and console. Compare <a href={nist}>NIST 275D installation photograph</a> and <a href="https://jp.caeonline.com/buy/wafer-steppers/asml-pas-5500-275d/9163245">275D resale photo</a>. No measured enclosure dimensions.</figcaption></figure>
<figure><svg viewBox="0 0 300 240" role="img" aria-label="Original sectional projection schematic"><rect x="41" y="25" width="225" height="184" fill="none" stroke="currentColor"/><rect x="140" y="36" width="84" height="30" fill="#2b4d6c"/><rect x="232" y="40" width="27" height="24" fill="#555"/><rect x="58" y="78" width="73" height="25" fill="#555"/><rect x="148" y="88" width="40" height="5" fill="#6fa4b3"/><rect x="146" y="103" width="46" height="54" rx="8" fill="#8b9ba3"/><path d="M169 157V174" stroke="#9a73ca" stroke-width="3"/><ellipse cx="169" cy="179" rx="17" ry="5" fill="#597fa7"/><rect x="110" y="187" width="116" height="15" fill="#555"/><path d="M144 91H100M169 115H220M169 180H77M188 49H120" stroke="currentColor" fill="none"/><g font-size="10" fill="currentColor"><text x="45" y="73">Reticle handler</text><text x="43" y="92">Reticle</text><text x="217" y="113">Lens</text><text x="50" y="176">Wafer</text><text x="72" y="224">XY stage + electrostatic chuck</text><text x="65" y="47">Illuminator</text><text x="227" y="35">Lamp</text></g></svg><figcaption>Sectional reconstruction: upper illuminator and reticle handler, central lens, lower stage, side wafer transfer. Compare <a href={newsletter}>NIST CNST News, Winter 2011, p. 7</a>. Optical path and mechanism dimensions are schematic, not optical prescription.</figcaption></figure>
<figure><svg viewBox="0 0 300 240" role="img" aria-label="Original reticle and wafer scale illustration"><rect x="12" y="26" width="115" height="115" fill="#adc5c9" stroke="currentColor"/><rect x="28" y="42" width="83" height="83" fill="none" stroke="#444"/><path d="M40 100H80V91H49V57H40Z" fill="#494e52"/><path d="M132 84H163" stroke="currentColor" stroke-width="2"/><text x="134" y="77" font-size="10" fill="currentColor">5:1</text><circle cx="230" cy="85" r="46" fill="#7692aa" stroke="currentColor"/>{[-18,0,18].map(x=>[-9,9].map(y=><rect x={230+x-8} y={85+y-8} width="16" height="16" fill="none" stroke="#344e43"/>))}<g fill="currentColor" font-size="10"><text x="10" y="158">152.4 mm reticle</text><text x="179" y="147">100 mm wafer</text><text x="12" y="190">110 mm reticle field → 22 mm wafer field</text><text x="12" y="210">Repeated placements, not a full-wafer contact mask</text></g></svg><figcaption>Specimen and field dimensions. See <a href={paper+'#page=8'}>NIST AMS 100-63, printed p. 2</a> for the 110 mm reticle field mapped to 22 mm. Schematic is illustrative; labels give physical dimensions.</figcaption></figure>
</div>
<h3>Views projected from the actual 3D model</h3><div class="pas-refs"><figure><img src={base+'reference-front.svg'} alt="Original model projection: Front-left" loading="lazy"/><figcaption><strong>Front-left.</strong> Compare the NIST photograph: three upper covers, black fascia and front loading modules. Angle and proportions are approximate; not a calibrated photo overlay. <a href="https://www.nist.gov/laboratories/tools-instruments/nanofab-tool-asml-pas5500275d-stepper">Source</a></figcaption></figure><figure><img src={base+'reference-side.svg'} alt="Original model projection: Right side" loading="lazy"/><figcaption><strong>Right side.</strong> Side panel and module depth are inferred from the available oblique views; no orthogonal 275D photograph was found. <a href="https://www.nist.gov/laboratories/tools-instruments/nanofab-tool-asml-pas5500275d-stepper">Source</a></figcaption></figure><figure><img src={base+'reference-rear.svg'} alt="Original model projection: Rear" loading="lazy"/><figcaption><strong>Rear.</strong> Service vents and ports are illustrative; their actual placement is unknown. <a href="https://edge.sitecorecloud.io/asmlnetherlaaea-asmlcom-prd-5369/media/project/asmlcom/asmlcom/asml/files/products/refurbished-products/pas-5500-275d.pdf">Source</a></figcaption></figure><figure><img src={base+'reference-cutaway.svg'} alt="Original model projection: Cutaway" loading="lazy"/><figcaption><strong>Cutaway.</strong> Compare labeled internal assembly layout from NIST CNST News p. 7; optical path is symbolic. <a href="https://www.nist.gov/system/files/documents/cnst/CNST_News_Winter2011.pdf#page=7">Source</a></figcaption></figure></div><h3>Specifications and assumptions</h3><div class="pas-table"><table><thead><tr><th>Parameter</th><th>Value</th><th>Use / conditions</th><th>Source</th></tr></thead><tbody>{specs.map(([a,b,c,d])=><tr><td>{a}</td><td>{b}</td><td>{c}</td><td><a href={d}>Reference</a></td></tr>)}</tbody></table></div>
<h3>Scientific model and handoff</h3><p>Each reticle rectangle is projected at q = 0.2 about the field center. Field center coordinates are x = (column − (columns − 1)/2) × pitchX + offsetX, with the analogous y expression. The nominal artwork points p are transformed to actual points R(θ)p + Δ, where θ is the imposed wafer rotation (µrad × 10⁻⁶ rad) and Δ is translation (nm × 10⁻⁶ mm). Per-field overlay is the center displacement in nanometers. The rectangle is full if all transformed corners lie within the usable wafer disk; outside if its nearest point to the wafer origin is at or beyond the disk radius; otherwise partial. Partial exposure is either skipped or intersected with that disk. Nominal fields must not overlap.</p>
<p>Inputs are full circular photoresist-coated wafers of documented diameters, reticle rectangles and thickness, commanded field/pitch/grid and deterministic overlay. Output is an exposure revision containing stable sample and reticle IDs, prior/new revision, all field poses and flags, feature dimensions, nominal and actual polygon coordinates, usable disk and commanded dose. JSON retains unclipped polygons plus the exact intersection rule; CSV provides field positions and overlay only. No resist development, focus, diffraction, distortion, dose calibration, interference, thermal response, alignment sensor or actual accuracy prediction. Sub-280 nm features are flagged, not treated as printable. No compatible downstream adapter was verified, so a schema and complete example are supplied.</p>
<h3>Verification</h3><p>Analytic checks executed before repository integration. Tolerances are floating-point numerical tolerances, not machine accuracy. No empirical printing comparison has been performed; enclosure accuracy is not verified.</p><div class="pas-table"><table><thead><tr><th>Test</th><th>Expected</th><th>Actual</th><th>Tolerance</th><th>Outcome</th></tr></thead><tbody>{verification.tests.map(t=><tr><td>{t.name}</td><td>{JSON.stringify(t.expected)}</td><td>{JSON.stringify(t.actual)}</td><td>{t.tolerance}</td><td>{t.pass?'Pass':'Fail'}</td></tr>)}</tbody></table></div><p><a href={base+'verification.json'} download>Verification results</a> · <a href="https://github.com/corbins-cryo-pod/buildthesimulation/blob/main/tests/equipment-02-06.mjs">Repository tests</a></p>
</section>
</article>
</Layout>
<script>
import {initPAS} from '../../../../lib/equipment/02-06/viewer.js';
initPAS();
</script>
<style>
.pas{font-size:1rem;max-width:76rem}.pas-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);gap:1rem}.pas-panel{border:1px solid var(--border);padding:1rem;margin:1rem 0;min-width:0}.pas-head{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem;border-bottom:1px solid var(--border);padding-bottom:.55rem;margin-bottom:.8rem;font-family:var(--font-label,Arial,sans-serif);font-size:.82rem;text-transform:uppercase}#pas-view{height:clamp(280px,43vw,490px);background:#242c32;position:relative;overflow:hidden;touch-action:none}#pas-view :global(canvas){display:block;width:100%;height:100%;touch-action:none}.pas-small{font-size:.85rem;line-height:1.4}.pas-buttons{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:.6rem 0}.pas button,.pas input,.pas select,.pas textarea{font:inherit;border:1px solid var(--border);border-radius:0;color:var(--text);background:var(--panel);padding:.45rem;max-width:100%;box-sizing:border-box}.pas button{cursor:pointer}.pas button:disabled{opacity:.45;cursor:default}.pas button[aria-pressed=true]{outline:2px solid var(--accent)}#pas-auto{border:2px solid var(--accent);font-weight:bold}.pas-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin:.8rem 0}.pas label{display:grid;gap:.25rem;min-width:0;margin:.25rem 0}.pas label :is(input,select,textarea){width:100%;min-width:0}.pas textarea{font:12px monospace;resize:vertical}.pas progress{width:100%;height:.65rem}.pas-maps,.pas-refs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.pas-refs{grid-template-columns:repeat(3,minmax(0,1fr))}.pas figure{margin:0;min-width:0}.pas figcaption{font-size:.85rem;margin:.4rem 0}.pas-maps canvas{display:block;width:100%;height:auto;background:#15212a;max-width:500px}.pas-refs img,.pas-refs svg{display:block;width:100%;height:auto;border:1px solid var(--border)}.pas-table{overflow-x:auto}.pas-table table{border-collapse:collapse;width:100%;font-size:.86rem}.pas-table :is(td,th){text-align:left;padding:.55rem;border-bottom:1px solid var(--border);vertical-align:top}.pas-table td{overflow-wrap:anywhere}.pas h3{font-size:1.4rem}.pas details{margin-top:.75rem}.pas summary{cursor:pointer}.pas select option{background:var(--menuBg);color:var(--text)}
@media(max-width:820px){.pas-grid{grid-template-columns:1fr}.pas-refs{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.pas-panel{padding:.65rem}.pas-maps,.pas-refs{grid-template-columns:1fr}.pas-fields{gap:.35rem}#pas-view{height:315px}}
</style>
