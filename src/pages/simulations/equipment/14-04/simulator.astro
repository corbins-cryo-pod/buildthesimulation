#mcr .grid,#mcr .fields{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:.8rem}#mcr section{border:1px solid var(--border);padding:1rem;margin:.8rem 0;min-width:0}#mcr .grid section{margin:0}#mcr h3{font-size:1.5rem;margin:.25rem 0 .6rem}#mcr .eq-meta{margin:0}#mcr .tools{display:flex;align-items:center;flex-wrap:wrap;gap:.45rem;margin:.6rem 0}#mcr #tr-view{height:clamp(250px,30vw,390px);background:#253238}#mcr #tr-view canvas{width:100%;height:100%;display:block;touch-action:none}#mcr label{display:flex;flex-direction:column}#mcr button,#mcr input{min-height:40px;padding:.35rem;color:var(--text);background:var(--panel,transparent);border:1px solid var(--border);font:inherit;max-width:100%;box-sizing:border-box}#mcr button{cursor:pointer}#mcr button:disabled{opacity:.45}#tr-run{background:#345d58!important;color:#fff!important}#tr-plot{width:min(100%,780px);height:auto}#mcr .over{overflow:auto}#mcr td,#mcr th{border-bottom:1px solid var(--border);padding:.4rem;text-align:left}#mcr #tr-read{font-weight:bold}#mcr code{overflow-wrap:anywhere}@media(max-width:760px){#mcr .grid{grid-template-columns:1fr}#mcr section{padding:.6rem}}
</style>
