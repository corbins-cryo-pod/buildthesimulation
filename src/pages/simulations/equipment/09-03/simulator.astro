.smu .head{max-width:68ch;padding:1.4rem 0}.smu h2{font-size:clamp(2rem,6vw,4rem);margin:.15rem 0 .5rem;line-height:1}.smu h3{margin:.2rem 0 .8rem}.smu section{margin:1rem 0}.bench{display:grid;grid-template-columns:1.12fr 1fr;gap:1rem}.card{border:1px solid var(--border,#999);padding:clamp(.7rem,2vw,1.2rem);min-width:0}.smu .bar{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0}.smu button,.smu select,.smu input{border:1px solid var(--border,#aaa);border-radius:3px;color:var(--text,#222);background:var(--panel,transparent);padding:.42rem .52rem;font:inherit}.smu select option{background:var(--menuBg,Canvas);color:var(--text,CanvasText)}.smu button{cursor:pointer;min-height:2.5rem}.smu button:disabled{opacity:.55;cursor:default}.smu button.run{background:#275c53;color:white}.smu input,.smu select{width:100%;min-width:0;box-sizing:border-box;height:2.5rem}.fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem .65rem}.fields label{display:block;letter-spacing:0}.fields label input,.fields label select{display:block;margin-top:.2rem}#instrument{display:block;touch-action:none;width:100%;height:clamp(250px,34vw,450px);background:#ece8dd}.small{font-size:.85rem}.scroll{overflow:auto}.smu table{border-collapse:collapse;width:100%;font-size:.85rem}.smu th,.smu td{padding:.4rem;border-bottom:1px solid var(--border,#bcb7a9);text-align:left;vertical-align:top}.refs{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.refs figure{margin:.25rem 0}.refs img{display:block;background:#ebe8df;width:100%;height:auto}.refs figcaption{font-size:.88rem}.smu svg{max-height:12rem;width:100%}.smu section>p{max-width:94ch}.readings p{font-variant-numeric:tabular-nums}@media(max-width:800px){.bench{grid-template-columns:1fr}.bench>.card{margin:.3rem 0}.fields{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.refs{grid-template-columns:1fr}}
</style>
