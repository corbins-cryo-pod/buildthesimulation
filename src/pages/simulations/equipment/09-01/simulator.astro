<style>
#rx .rx-head{padding:1.4rem 0;max-width:74ch}#rx h2{font-size:clamp(2rem,6vw,4rem);line-height:1.1;margin:.3rem 0}#rx section{margin:1rem 0}#rx section>p{max-width:96ch}.rx-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:1rem}.rx-card{border:1px solid var(--border);padding:.85rem;min-width:0}.rx-card h3{margin:.25rem 0 .65rem}.rx-bar{display:flex;gap:.35rem;flex-wrap:wrap;margin:.45rem 0}.rx-bar :is(button),.rx-fields :is(select,input){min-height:2.45rem;border:1px solid var(--border);background:var(--panel);color:var(--text);border-radius:3px;padding:.25rem .45rem;font:inherit}.rx-fields :is(input,select){width:100%;min-width:0;box-sizing:border-box}.rx-fields option{background:var(--menuBg,Canvas);color:var(--text,CanvasText)}.rx-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.rx-fields label{display:grid;gap:.2rem}.rx-run{background:#705423!important;color:white!important}#rx-canvas{display:block;width:100%;height:clamp(260px,34vw,430px);background:#eae8e0;touch-action:none}.rx-table{overflow:auto}#rx table{border-collapse:collapse;width:100%;font-size:.85rem}#rx th,#rx td{text-align:left;padding:.45rem;border-bottom:1px solid var(--border);vertical-align:top}.rx-refs{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.rx-refs figure{margin:.5rem 0}.rx-refs img{display:block;width:100%;height:auto;background:#ece8df}.rx-refs figcaption{font-size:.88rem}#rx-chart{display:block;width:100%;max-height:15rem}#rx button{cursor:pointer}#rx button:disabled{cursor:default;opacity:.6}@media(max-width:800px){.rx-grid{grid-template-columns:1fr}.rx-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:530px){.rx-refs{grid-template-columns:1fr}}
</style>
