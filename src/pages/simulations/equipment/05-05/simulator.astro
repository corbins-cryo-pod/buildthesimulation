import Layout from '../../../../layouts/Layout.astro';import '../../../../styles/equipment.css';
const a='/equipment/05-05/',kni='https://www.lab.kni.caltech.edu/Light_Microscope_with_Spectroscopic_Reflectometer',photo='https://www.lab.kni.caltech.edu/images/labkni/f/f5/Olympus-BX51M-with-Filmetrics-F40.jpg',ds='https://www.kla.com/wp-content/uploads/Filmetrics_Datasheet_-_F40_n6v.pdf',bx='https://www.lri.se/pdf/olympus/bx2m-mx51.pdf',man='https://spectraservices.com/mm5/graphics/00000001/BX51M%20Metallurgical%20Microscope%20Manual.pdf';
const refs=[['station','01 / Complete station','The KNI photograph identifies the BX51M with receiver to the left, the binocular head, tall black F40 adapter and camera out to its side. The modeled receiver shell and fiber route are visually inferred, not manufacturer CAD.',photo],['spot','02 / Stage and objectives','Compare the rectangular manual stage, nosepiece, reflected-light optics and focusing controls with the Olympus BX51M instruction manual and KNI photograph. The 10 × 10 mm coupon and 45 × 32 mm slide are original teaching fixtures.',man],['head','03 / C-mount and fiber','The phototube, side camera and fiber connector are reconstructed from the model-specific KNI bench photo. The 2022 KLA brochure cover shows an EXR variant on a different stand, not the device represented here.',photo],['rear','04 / Chassis and lamp','Olympus front and right-side dimensional elevations constrain the 318 mm base width, 341 mm base depth, working plane and rear lamp projection. The receiver power/USB cutouts are schematic: no serial-specific rear photo or port pitch was located.',bx+'#page=12']];
---
<Layout pageTitle="Thin-film reflectometer laboratory" subtitle="" description="Calibrate, measure and fit a virtual thin dielectric film on an Olympus BX51M and Filmetrics F40 station." wide={true}>
<article id="f40" class="equipment"><nav class="eq-nav"><a href="/simulations/equipment/05-05/">← Equipment 05-05</a><a href="/simulations/equipment/">Register</a><a href="#references">Reference sheet</a><a href="#evidence">Verification</a></nav><header class="eq-mast"><span class="eq-meta">05-05 / OPTICAL METROLOGY</span><h2>Read the thickness in a reflection</h2><p class="eq-lede">A transparent film reflects light from two interfaces. As wavelength changes, the reflections interfere. Scan the 300 nm silica-on-silicon coupon, then move right to measure a second, thicker patch. A broad spectrum can resolve the difference; a nearly single-color measurement cannot.</p></header>
<div class="f-grid"><section><p class="eq-meta">01 / MEASUREMENT STATION</p><h3>Filmetrics F40 on Olympus BX51M</h3><canvas id="f-model" aria-label="Metric 3D F40 microscope, receiver, fiber and movable stage"></canvas><div class="f-tools">{[['station','Reset / whole station'],['spot','Sample spot'],['head','C-mount'],['rear','Rear'],['side','Side / focus']].map(([k,v])=><button data-camera={k}>{v}</button>)}</div><p id="f-viewstate" role="status">Loading metric GLB…</p><p>Drag to orbit and pinch or scroll to zoom. Click the fiber plug, coarse focus, stage X wheel, objective turret or coupon. The stage moves opposite the selected sample coordinate. Shift-click reverses the stage-wheel step. Optics are shown at physical size; film thickness is not exaggerated in geometry.</p></section>
<section><p class="eq-meta">02 / EXPERIMENT</p><h3>Calibrate and scan</h3><p>The initial example has an acquired dark and BK7 reference. To repeat calibration, change lamp power, acquire a dark baseline, read the reflectance standard, then load the film.</p>
<form id="f-form"><label>Specimen optical stack<select id="f-modelsel"><option value="silicaSi">Fused-silica film / Si</option><option value="constantGlass">Constant n=1.38 film / n=1.52 glass</option><option value="indexMatched">Index-matched film / glass</option><option value="AZ1500Si">Unexposed AZ 1500 family / Si</option></select></label><label>Synthetic film (nm)<input id="f-thickness" type="number" min="0" max="4000" step="any" /></label><label>Stage X (mm)<input id="f-x" type="number" min="-25" max="25" step="any" /></label><label>Stage Z toward operator (mm)<input id="f-z" type="number" min="-25" max="25" step="any" /></label><label>Objective<select id="f-objective"><option value="5">5×</option><option value="10">10×</option></select></label><label>Field aperture<select id="f-ap"><option value="100">100 µm</option><option value="250">250 µm</option><option value="500">500 µm</option></select></label><label>Wavelength grid<select id="f-band"><option value="wide">Wide / material range</option><option value="narrow">630–640 nm · ambiguity demo</option></select></label><label>Lamp fraction<input id="f-lamp" type="number" min=".2" max="1" step="any" /></label><label>Count noise amplitude<input id="f-noise" type="number" min="0" max="100" step="any"/></label><label>Fit upper limit (nm)<input id="f-max" type="number" min="100" max="4000" step="any"/></label></form>
<div class="f-tools"><button id="f-fiber">Disconnect fiber</button><button id="f-focus">Defocus</button><button id="f-dark">1 · Acquire dark</button><button id="f-reference">2 · Read BK7</button><button id="f-specimen">3 · Load film</button><button id="f-slide">Remove specimen</button></div><p id="f-cal"></p><div class="f-tools"><button id="f-run" class="run">Scan and fit</button><button id="f-step">Move to second patch</button><button id="f-reset">Restore 300 nm example</button></div><p id="f-status" role="status" aria-live="polite"></p></section></div>
<section><p class="eq-meta">03 / OPTICAL RESULT</p><h3>Absolute reflectance and fit</h3><canvas id="f-chart" width="1000" height="365" aria-label="Blue acquired reflectance and gold fitted spectrum, with residuals below the spectrum in percentage points"></canvas><p id="f-read" aria-live="polite"></p><div class="f-tools"><button id="f-csv">Download spectrum CSV</button><button id="f-export">Download spectrum JSON</button><button id="f-fitout">Download fit JSON</button></div><p>Reflectance is a dimensionless fraction in downloads; the plot shows percent. Residual = observed − modeled. An ambiguous or rejected fit exports a diagnostic and null thickness rather than a trustworthy-looking number.</p></section>
<section><p class="eq-meta">04 / SAMPLE HANDOFF</p><h3>Inspect a resist layer from the spin coater</h3><p>Load the <a href="/simulations/equipment/02-07/simulator/">Laurell spin coater</a> export as a 10 × 10 mm digital crop from the center of its wafer. This does not imply mounting a 150 mm wafer on this stage. For this teaching import the support must be silicon and the resist unexposed AZ 1512; the upstream file does not independently establish those conditions. The micron-valued coating map is converted to nm; we use the nearest point, not invented sub-grid texture.</p><label class="check"><input id="f-assume" type="checkbox"/>Use unexposed AZ 1512 on silicon for this digital crop.</label><div class="f-tools"><button id="f-spin" disabled>Load published 02-07 example</button><label>Open coat map or calibrated spectrum JSON <input type="file" id="f-import" accept=".json,application/json"/></label></div><p><a href={a+'spin-handoff.json'}>Actual handoff verification</a> · <a href={a+'schema.json'}>Input/output contract</a> · <a href={a+'example-spectrum.json'} download>Reference spectrum</a> · <a href={a+'example-fit.json'}>Example fit</a></p></section>
<section id="references"><p class="eq-meta">05 / OPTICAL HARDWARE</p><h3>Reference sheet</h3><p>Selected configuration: the visible-band F40 (not UV, EXR or NIR) on the Olympus BX51M host documented at <a href={kni}>Caltech KNI</a>. A 250 µm aperture / 5× objective is the selected model configuration, not an assertion about Caltech’s installed aperture. All images below are original renders; open the adjacent links to the institutional photograph or the manufacturer’s illustration.</p><div class="f-refs">{refs.map(([file,title,cap,url])=><figure><img src={a+file+'.webp'} alt={title+' original reconstruction'} width="730" height="450" loading="lazy"/><figcaption><b>{title}.</b> {cap} <a href={url}>Reference</a></figcaption></figure>)}</div>
<div class="f-scroll"><table><thead><tr><th>Quantity</th><th>Value and use</th><th>Evidence</th></tr></thead><tbody>
<tr><th>Standard F40 spectrometer</th><td>400–850 nm visible. Only broad visible mode is represented; 2 nm simulated sampling is a numerical grid, not hardware spectral resolution.</td><td><a href={ds+'#page=2'}>KLA F40 datasheet, rev. 05.22, p. 2</a></td></tr>
<tr><th>Manufacturer film range</th><td>20 nm–40 µm with 5× (material dependent). Teaching search 0–4 µm; zero is included for the physical reference case, not a claim of device detection limit.</td><td><a href={kni}>KNI configuration</a>, <a href={ds+'#page=2'}>datasheet p. 2</a></td></tr>
<tr><th>Spot size</th><td>100/250/500 µm aperture divided by 5× or 10×; default 50 µm at 5×. Uniform patch assumption; reject mixed zones/edges. No diffraction or NA weighting.</td><td><a href={ds+'#page=2'}>KLA spot-size table, p. 2</a></td></tr>
<tr><th>Olympus BX51M frame</th><td>318 mm base width, 341 mm base depth, working plane 209 mm above bench on selected drawing. These anchor the mesh; photo tube adds height beyond the host drawing. No serial-specific F40 enclosure CAD.</td><td><a href={bx+'#page=12'}>Olympus BX2M brochure, printed p. 22 / PDF p. 12</a></td></tr>
<tr><th>Virtual specimen and motion</th><td>10 × 10 mm coupon; teaching-stage range ±25 mm, 2 mm defocus illustration, 90° turret index. These are design choices, not measured travel limits.</td><td><a href={a+'build-model.py'}>Editable source</a></td></tr></tbody></table></div></section>
<section id="evidence"><p class="eq-meta">06 / METHOD AND VERIFICATION</p><h3>How thickness is inferred</h3><p>At normal incidence, r₀₁ and r₁₂ are Fresnel field reflection coefficients at the two interfaces; the substrate may have a complex index n + ik. For a lossless layer, r = (r₀₁ + r₁₂ exp(i4πnd/λ)) / (1 + r₀₁r₁₂ exp(i4πnd/λ)), and R = |r|². The synthetic detector applies a smooth wavelength-dependent gain and dark offset; calibration uses Rfilm = RBK7 × (Ifilm − Idark)/(IBK7 − Idark). Optional bounded repeatable noise is added to sample counts. The synthetic reference plate is an ideal single BK7 front surface; ignore backside reflection.</p>
<p>Fit the full band on a 2 nm thickness grid, bracket local minima, refine each, and report RMS residual in absolute reflectance. Suppress thickness for &lt;50 nm bandwidth, index matching, near-equal minima separated by &gt;15 nm, an upper search boundary, or RMS &gt;0.015. These are declared teaching diagnostics, not a confidence interval or vendor FILMeasure implementation. With lossy films, roughness, multiple layers, high-NA angles or unknown n,k, this model is not supported. No measured spectrum was used for hardware accuracy validation.</p>
<p>Silica dispersion: <a href="https://doi.org/10.1364/JOSA.55.001205">Malitson (1965), 20 °C</a>. Silicon: <a href="https://doi.org/10.1016/j.solmat.2008.06.009">Green (2008), 300 K</a>, <a href="https://github.com/polyanskiy/refractiveindex.info-database/blob/master/database/data/main/Si/nk/Green-2008.yml">CC0 n,k tabulation, linearly interpolated</a>. Reference: <a href="https://www.schott.com/shop/advanced-optics/en/Optical-Glass/N-BK7/c/glass-N-BK7">SCHOTT N-BK7</a>. Unexposed AZ family film: <a href="https://www.microchemicals.com/dokumente/datenblaetter/tds/merck/en/tds_az_1500_series.pdf">Merck AZ 1500 Cauchy constants, p. 2</a>; k=0 at 633 nm extended as a transparent-film approximation over 550–750 nm. Coating history and porosity can change n and bias thickness.</p>
<div class="f-scroll"><table><thead><tr><th>Case</th><th>Expected</th><th>Actual</th><th>Criterion</th><th>Outcome</th></tr></thead><tbody id="f-table"></tbody></table></div><p><a href={a+'acceptance.md'}>Predeclared cases</a> · <a href={a+'verification.json'}>Verification</a> · <a href={a+'optics.mjs'}>Solver / VR actions</a> · <a href={a+'materials.mjs'}>Optical constants</a> · <a href={a+'build-model.py'} download>Blender source</a> · <a href={a+'f40.glb'} download>Metric GLB</a> · <a href={a+'vr-manifest.json'}>VR ray targets, bounds and budget</a></p><p>No headset run or physical instrument validation is claimed.</p></section></article></Layout>
