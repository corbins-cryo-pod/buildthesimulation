@media(max-width:800px){#f40 .f-grid{grid-template-columns:1fr}#f-model{height:330px}}@media(max-width:520px){#f40 .f-refs{grid-template-columns:1fr}#f40 section{padding:.65rem}#f40 button{min-height:42px}#f-model{height:275px}}
