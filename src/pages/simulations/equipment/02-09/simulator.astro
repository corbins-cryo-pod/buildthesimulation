import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
const base='/equipment/02-09/';
const sheet='https://yieldengineering.com/wp-content/uploads/2022/12/YES-TA-Series-Brochure_112822-WEB.pdf';
const epfl='https://www.epfl.ch/research/facilities/cmi/equipment/photolithography/yes-iii-hmds-primer-oven/';
const specs=[
['Cabinet (W × D × H)','631.95 × 501.7 × 772.9 mm','Nominal body; external tower and protrusions inferred',sheet+'#page=2'],
['Clear chamber (W × D × H)','304.8 × 336.6 × 304.8 mm','Metric hollow chamber, 316L; aluminum door',sheet+'#page=2'],
['Wafer size','≤ 200 mm','Vendor rating; virtual carrier 100/150 mm only',sheet+'#page=2'],
['Carrier capacity','25 slots, 4 or 6 inch','EPFL metal cassette; one virtual witness per job',epfl],
['Temperature','Ambient to 160 °C','Vendor range; selected EPFL cycle fixed at 150 °C',sheet+'#page=2'],
['HMDS exposure / total','300 s / about 900 s','Nominal EPFL recipe 01; time compressed on screen',epfl],
['Temperature uniformity','±5 °C after stabilization','Rated; not modeled',sheet+'#page=2'],
['Process inputs','N₂ vent, ammonia, vapor flask','HMDS mode only; no gas transport; port placement inferred',sheet+'#page=2'],
['Door travel','0–100°','Inferred animation, not documented travel',null],
['Power','188–253 VAC, 50/60 Hz, 10 A','Vendor rating; electrical circuits not modeled',sheet+'#page=2']
];
---
<Layout pageTitle="Vapor prime oven laboratory" subtitle="" description="Operate a scaled YES 310TA reconstruction and compare primed and untreated virtual coupons.">
<article class="equipment eq-sheet vp" id="vp">
<nav class="eq-nav"><a href="/simulations/equipment/02-09/">← Equipment 02-09</a><a href="/simulations/equipment/">Equipment register</a><a href="#vp-evidence">References &amp; verification</a></nav>
<header class="eq-mast"><span class="eq-meta">02-09 / SURFACE PREPARATION / MODEL 1.0</span><h2>YES 310TA vapor prime oven</h2><p>Yield Engineering Systems · EPFL CMi white touchscreen-style configuration · HMDS only. Reference-informed 3D reconstruction, not manufacturer CAD or an actual equipment controller.</p></header>
<div class="vp-grid">
<section><h3>01 / Instrument</h3><div id="vp-view" aria-label="Interactive 3D vapor prime oven"><p>Loading metric model…</p></div><p id="vp-model-status" role="status">Loading glTF asset…</p><div class="vp-actions">{['whole','front','left','rear','chamber'].map(v=><button type="button" data-vp-view={v}>{v==='whole'?'Reset view':v}</button>)}<button id="vp-glb" type="button" disabled>Export GLB</button></div><p>Drag to orbit; pinch or scroll to zoom. Open the door to inspect chamber, cassette, and witness. External tray is a virtual comparison station, not part of YES hardware.</p><p><a href={base+'yes310ta.gltf'} download>Download glTF</a> · <a href={base+'model.json'} download>Editable geometry</a> · <a href={base+'build-model.mjs'} download>Model builder</a></p></section>
<section><h3>02 / Virtual preparation</h3><p id="vp-status" role="status" aria-live="polite">Ready: open door and load a coupon.</p><div class="vp-actions"><button id="vp-example" type="button" class="vp-primary">Run ready example</button><button id="vp-reset" type="button">Reset</button><button id="vp-door" type="button">Open door</button><button id="vp-load" type="button">Load coupon</button><button id="vp-run" type="button">Run cycle</button><button id="vp-unload" type="button">Unload coupon</button></div><progress id="vp-progress" max="1" value="0" aria-label="Compressed simulated cycle"></progress>
<div class="vp-fields"><label>Coupon to load<select id="vp-selected"><option value="CP-A">CP-A</option><option value="CP-B">CP-B</option></select></label><label>Surface (both witnesses)<select id="vp-surface"><option value="silicon-native-oxide">Si native oxide</option><option value="thermal-oxide">Thermal SiO₂</option><option value="silicon-nitride">Si₃N₄</option><option value="glass">Glass</option></select></label><label>Wafer diameter (mm)<select id="vp-size"><option value="100">100</option><option value="150">150</option><option value="200">200 (unsupported carrier test)</option></select></label><label>Mode<select id="vp-recipe"><option value="prime">HMDS prime (EPFL 01)</option><option value="dehydrate">Dehydrate only (abstract)</option></select></label><label>Resist calibration ID key<input id="vp-resist" value="virtual-positive-resist"/></label><label><span>Incompatible specimen test</span><span><input id="vp-coated" type="checkbox"/> Already resist coated</span></label></div>
<details><summary>Optional matched adhesion calibration (user-supplied)</summary><p>No peel strength is inferred from contact angle. Enter matched values only for the selected material, resist and EPFL prime recipe. Values are transferred as submitted, not measured by this simulator.</p><label>Calibration identifier<input id="vp-cal-id" placeholder="Dataset ID"/></label><div class="vp-fields"><label>Before (N/mm)<input id="vp-before" type="number" min="0" step="any"/></label><label>After (N/mm)<input id="vp-after" type="number" min="0" step="any"/></label></div></details>
</section></div>
<section><h3>03 / Coupon comparison</h3><div class="vp-table"><table><thead><tr><th>Coupon</th><th>Revision</th><th>Surface state</th><th>Events</th><th>Adhesion</th></tr></thead><tbody id="vp-results"></tbody></table></div><p id="vp-event">No committed preparation event.</p><p>Published reference only: NIST's 2009 YES-oven example measured water contact angles of 10° untreated, 69° liquid HMDS, 81° vapor prime. The installed model was not specified; these are not predicted values or peel strength. <a href="https://www.nist.gov/system/files/documents/2017/05/09/NanoFabNews_v1_i4_Nov09.pdf#page=2">NIST p.2</a>.</p><div class="vp-actions"><button id="vp-export" disabled type="button">Export preparation JSON</button><a href={base+'example-output.json'} download>Example output</a><a href={base+'output-schema.json'} download>Output schema</a><a href={base+'solver.mjs'} download>Simulation source</a></div></section>
<section id="vp-evidence"><h3>Reference sheet</h3><figure><img src={base+'reference-sheet.svg'} alt="Original annotated front, open chamber, and schematic rear elevations" width="720" height="420" loading="lazy"/><figcaption>Original simplified diagrams. The nominal geometry follows the manufacturer; offsets, cassette shape, utility placement and hinge angle are inferred.</figcaption></figure><p>Photographs were inspected and linked rather than republished: <a href={sheet+'#page=1'}>YES 2022 brochure p.1 (front oblique and side module)</a>; <a href={epfl}>EPFL installed 310TA front and process-screen gallery</a>; <a href="https://www.colorado.edu/facility/cosinc/facilities">CU Boulder 310TA front oblique (door latch, gauge, tower)</a>; <a href="https://nanofab.ece.cmu.edu/facilities-equipment/yes.html">CMU older YES oven open door (generic loading context only)</a>. No verified rear or open-chamber image of the selected revision was obtained. Stanford's <a href="https://snfguide.stanford.edu/guide/equipment/hmds-vapor-prime-oven-yes-yes">facility record</a> does not resolve its exact variant.</p>
<h3>Specifications and assumptions</h3><div class="vp-table"><table><thead><tr><th>Parameter</th><th>Value</th><th>Use / conditions</th><th>Source</th></tr></thead><tbody>{specs.map(([n,v,u,s])=><tr><td>{n}</td><td>{v}</td><td>{u}</td><td>{s?<a href={s}>Reference</a>:'Inferred'}</td></tr>)}</tbody></table></div>
<h3>Scientific model and handoff</h3><p>HMDS modifies suitable hydroxylated surfaces by methyl termination, reducing water affinity and often improving photoresist adhesion. This event model does not calculate surface coverage, pressure, kinetics, gas concentrations, temperature gradients or actual adhesion. On completion, only the selected coupon receives a new revision, preparation event and material-specific adhesion state. If the supplied calibration matches surface, resist and recipe, its reported change equals after minus before, N/mm; otherwise adhesion is unknown. Dehydrate-only records a separate event without HMDS. Contact angle is a wettability monitor rather than a direct adhesion-strength measurement. <a href="https://www.epfl.ch/research/facilities/cmi/process/hmds-application/">EPFL process evidence</a>.</p><p>Inputs: two stable witness IDs, bare compatible surface, 100/150 mm carrier, selected sample, recipe and optional matched calibration. Output: bts.surface-preparation.v1 revision event, prior history, material, calibration provenance and units. No verified downstream adapter exists; the schema and example describe the handoff to a future coater. This is an educational model, not a hazardous-chemical operating procedure or real machine control system.</p>
<h3>Verification</h3><p>Exact, independent hand-defined event counts and synthetic calibration arithmetic (0.75 − 0.25 = 0.50 N/mm). Geometry checks are construction dimensions only; no physical survey or experimental adhesion validation. <a href={base+'verification.json'} download>Recorded checks</a> · <a href={base+'RESEARCH.md'}>Research and limitations</a>.</p><div class="vp-table"><table><thead><tr><th>Check</th><th>Expected</th><th>Actual</th><th>Units</th><th>Tolerance</th><th>Outcome</th></tr></thead><tbody id="vp-verification"></tbody></table></div></section>
</article></Layout>
<style>
.vp{max-width:1200px;margin:auto}.vp section{min-width:0;margin-top:1rem}.vp-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:1rem}.vp-actions{display:flex;gap:.45rem;flex-wrap:wrap;align-items:center;margin:.65rem 0}.vp button,.vp select,.vp input{font:inherit;color:inherit;background:transparent;border:1px solid currentColor;border-radius:3px;padding:.42rem;min-height:38px;box-sizing:border-box;max-width:100%}.vp button{cursor:pointer}.vp button:disabled{opacity:.45;cursor:default}.vp-primary{background:#bca47f!important;color:#171614!important;font-weight:bold}.vp-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem}.vp label{display:flex;flex-direction:column;gap:.25rem;font-size:.88rem}.vp input[type=checkbox]{min-height:0}.vp progress{width:100%}.vp-table{overflow-x:auto}.vp table{border-collapse:collapse;width:100%;font-size:.86rem}.vp td,.vp th{padding:.5rem;border-bottom:1px solid currentColor;text-align:left;vertical-align:top}.vp figure{margin:0}.vp figure img{width:100%;height:auto;max-width:720px}.vp figcaption{font-size:.85rem}#vp-view{height:clamp(330px,44vw,520px);background:#253039;color:#f5f1e6;overflow:hidden;display:grid;place-items:center}#vp-view canvas{width:100%;height:100%;display:block;touch-action:none}@media(max-width:800px){.vp-grid{grid-template-columns:1fr}#vp-view{height:390px}}@media(max-width:480px){#vp-view{height:320px}.vp-fields{grid-template-columns:1fr}}
</style>
