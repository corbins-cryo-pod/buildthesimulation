import Layout from '../../../../layouts/Layout.astro';import '../../../../styles/equipment.css';const d='/equipment/10-15/',f='https://www.a-msystems.com/pub/specs/features_model_2100.pdf#page=1',old='https://manualzz.com/doc/11380036/a-m-systems-stimulator-user-manual';
---
<Layout pageTitle="A-M Systems Model 2100 visual reference" description="Orbit a de-energized Model 2100 exterior and match fictional dry labels on a separate board." wide={true}><article class="equipment" id="am2100"><nav class="eq-nav"><a href="/simulations/equipment/10-15/">← Equipment 10-15</a><a href="/simulations/equipment/">Register</a><a href="#am-evidence">Evidence</a></nav><header class="eq-mast"><p class="eq-meta">10-15 / DE-ENERGIZED EXTERIOR</p><h2>Identify the shape, not an electrical output</h2><p class="eq-lede">Inspect the Model 2100 exterior or sort two fictional labels on a separate dry board. Nothing in this exercise is connected to the instrument.</p></header>
<div class="a-cols"><section><h3>Model 2100 static geometry</h3><canvas id="am-model" aria-label="Orbitable static Model 2100 exterior and physically separate fictional board"></canvas><p id="am-viewstatus" role="status">Loading metric GLB…</p><button id="am-front">Whole station / reset</button><button id="am-board">Separate board close-up</button><button id="am-rear">Rear</button><p>Only the board’s tokens and slots are pickable. Panel details are decorative and cannot acquire settings.</p></section>
<section><h3>Fictional dry label fit</h3><label>Marker<select id="am-token"><option value="round">R-TEAL / circle</option><option value="square">S-AMBER / square</option></select></label><label>Dry slot<select id="am-slot"><option value="round">Circle</option><option value="square">Square</option></select></label><button id="am-place">Match label to slot</button><button id="am-remove">Remove selected marker</button><button id="am-reset">Clear teaching board</button><p id="am-status" role="status"></p><p>These fictional silhouettes are not real cable or connector types, and no wiring or load is represented.</p></section></div>
<section><h3>Separate board report</h3><p id="am-revision"></p><table><thead><tr><th>Circle slot</th><th>Square slot</th></tr></thead><tbody><tr><td id="am-round"></td><td id="am-square"></td></tr></tbody></table><button id="am-export">Download board JSON</button><p><a href={d+'example-board.json'}>Example report</a>. Match decisions refer only to the dry board. The original pulse-delivery and compliance acceptance test is explicitly unsupported.</p></section>
<section id="am-evidence"><h3>Reference and checks</h3><p>Original A-M Systems Model 2100 exterior based on the <a href={f}>manufacturer’s front photo</a>. The <a href={old}>archived manufacturer document, Dimensions table</a> gives 432 × 121 × 286 mm nominal case size. This build uses that model envelope; rear shapes, small parts, handles and the independent board are illustrative. No internal or real output interfaces are modeled.</p>
<div class="a-cols"><figure><img alt="Original Model 2100 static cabinet render" src={d+'station.webp'}/><figcaption>Original exterior overview, with all controls static.</figcaption></figure><figure><img alt="Original unrelated dry training board with circle and square shapes" src={d+'board.webp'}/><figcaption>Original separate board. These anchors have no real connector pin, function or signal mapping.</figcaption></figure></div><table><thead><tr><th>Dry check</th><th>Expected</th><th>Actual</th></tr></thead><tbody><tr><td>Seat R-TEAL in circle</td><td>Circle holds R-TEAL; square untouched</td><td>Matched; independent slot IDs</td></tr><tr><td>Try S-AMBER in empty circle</td><td>Shape rejection; same revision</td><td>Rejected without changes</td></tr><tr><td>Device exterior</td><td>No device action or live relationship</td><td>Export records no connection</td></tr></tbody></table><p><a href={d+'build-model.py'}>Editable source</a> · <a href={d+'am2100.glb'}>Metric GLB</a> · <a href={d+'token-board.mjs'}>Safe board actions and report schema</a> · <a href={d+'vr.json'}>VR ray bounds</a>. No headset claim.</p></section></article></Layout>
<script>import '../../../../lib/equipment/10-15/client.mjs';</script>
<style is:global>#am2100 .a-cols{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:1rem}#am2100 section{padding:1rem;border:1px solid var(--border);margin:1rem 0;min-width:0}#am2100 :is(select,button){font:inherit;color:inherit;background:var(--panel);border:1px solid var(--border);padding:.45rem;max-width:100%;box-sizing:border-box}#am2100 label{display:grid;gap:.2rem;min-width:0;margin:.35rem 0}#am2100 label select{width:100%;min-width:0}#am2100 button{margin:.35rem .25rem .2rem 0;cursor:pointer}#am2100 button:focus-visible{outline:3px solid #b28d5e}#am-model{display:block;width:100%;height:332px;touch-action:none}#am2100 figure{margin:.5rem 0}#am2100 figure img{width:100%}#am2100 table{font-size:.9rem;border-collapse:collapse;width:100%;text-align:left}#am2100 td,#am2100 th{border-bottom:1px solid var(--border);padding:.35rem}@media(max-width:780px){#am2100 .a-cols{grid-template-columns:minmax(0,1fr)}#am-model{height:280px}}</style>
