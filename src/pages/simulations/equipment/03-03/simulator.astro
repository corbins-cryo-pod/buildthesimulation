---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
const assets='/equipment/03-03/';
const manual='https://www.equipx.net/uploads/Kurt%20Lesker/KurtLeskerPVD75operating-manual.pdf';
const washu='https://imse.washu.edu/facilities/micronanofab/deposition.html';
const photo='https://imse.washu.edu/images/SPUTTER.jpg';
const tamu='https://aggiefab.tamu.edu/wp-content/uploads/2023/06/Operation-Spec-Lesker-PVD-75-RF-Sputter-Rev2.pdf';
const specs=[
 ['Cabinet envelope','1194 × 889 × 1905 mm','Legacy nominal, manual v8 p. 8',manual,'Geometry; modeled plinth/height'],
 ['Process chamber','75 L nominal; 356 × 356 × 610 mm','D-shaped 304L, manual v8 p. 8 (inch transcription inconsistent)',manual,'Geometry; internal arrangement approximate'],
 ['Maximum substrate','203.2 mm diameter','WashU RF/DC station',washu,'Input limit; actual carrier geometry unknown'],
 ['Heating','300 °C maximum','WashU RF/DC station',washu,'Documented only; not modeled'],
 ['Rotation','Up to 20 rpm','Family optional platen, manual v8 p. 8',manual,'Teaching limit; installation not confirmed'],
 ['Typical growth rate','0.5 nm/s','WashU; not target/recipe-specific',washu,'Context only; demo rate synthetic'],
 ['Source arrangement','Three 76.2 mm discs','Inferred teaching configuration; 3-inch source option supported by PVD 75 family','https://smif.pratt.duke.edu/capabilities/55552','Geometry only; exact WashU count and locations unknown'],
 ['Sputter direction','Upward','Family option; actual WashU arrangement not confirmed',manual,'Assumed model configuration'],
 ['Power/pressure','100 W / 5 mTorr','Synthetic demo metadata, not equipment operating limits',null,'Must match map; no rate extrapolation'],
 ['Material options','Al, Ti, Cu, Nb, Zn (DC); SiO₂, SiN, ZnO (RF)','WashU target list; illustrative mode assignment',washu,'Material/mode matching required'],
];
---
<Layout pageTitle="Magnetron sputtering laboratory" subtitle="" description="PVD 75 RF/DC calibrated witness-coupon deposition experiment">
<article class="equipment eq-sheet pvd" data-pvd75>
<nav class="eq-nav"><a href="/simulations/equipment/03-03/">← Equipment 03-03</a><a href="/simulations/equipment/">Equipment register</a></nav>
<header class="eq-mast"><span class="eq-meta">03-03 · Deposition · Numerical teaching model</span><h2>Kurt J. Lesker PVD 75 RF/DC</h2><p>Legacy enclosed cabinet, reconstructed from the WashU installation photograph and family specifications. Internal arrangement is inferred. This is not the newer PRO Line or a machine-control system.</p></header>
<div class="pvd-grid">
<section class="pvd-instrument">
<h3>Instrument</h3>
<div class="pvd-toolbar">{['perspective','front','side','rear','chamber'].map(v=><button type="button" data-pvd-view={v}>{v}</button>)}</div>
<div id="pvd-viewer" role="img" aria-label="Interactive 3D vacuum sputtering instrument. Orbit by dragging; zoom by scrolling or pinching."><p>Loading 3D asset…</p></div>
<p class="pvd-small" id="pvd-model-status">Loading metric glTF…</p><p class="pvd-small">Drag to orbit · pinch/scroll to zoom · perspective resets the view. Chamber view opens a vented door. Shutter, stage and sample follow the experiment.</p>
<div class="pvd-toolbar"><a href={assets+'pvd75.gltf'} download>Download glTF</a><a href={assets+'model-source.json'} download>Editable metric source</a><button type="button" id="pvd-glb" disabled>Export current GLB</button></div>
</section>
<section class="pvd-controls">
<h3>Experiment controls</h3><p id="pvd-status" class="pvd-readout" aria-live="polite"></p><p>Pressure: <strong id="pvd-pressure"></strong></p>
<div class="pvd-toolbar"><button type="button" id="pvd-door">Open chamber</button><button type="button" id="pvd-load">Load sample</button><button type="button" id="pvd-pump">Pump</button><button type="button" id="pvd-vent">Vent</button></div>
<div class="pvd-fields">
<label>Sample ID<input id="sampleId" value="WITNESS-001"/></label>
<label>Diameter (mm)<input id="diameter_mm" type="number" min="0.1" max="203.2" step="0.1" value="100"/></label>
<label>Target<select id="material"><option>Al</option><option>Ti</option><option>Cu</option><option>Nb</option><option>Zn</option><option>SiO2</option><option>SiN</option><option>ZnO</option></select></label>
<label>Mode<select id="mode"><option>DC</option><option>RF</option></select></label>
<label>Power (W)<input id="power_W" type="number" min="0" step="any" value="100"/></label>
<label>Pressure (mTorr)<input id="pressure_mTorr" type="number" min="0" step="any" value="5"/></label>
<label>Open shutter time (s)<input id="duration_s" type="number" min="0" max="3600" step="any" value="120"/></label>
<label>Orientation (deg)<input id="angle_deg" type="number" min="-360" max="360" step="any" value="0"/></label>
<label>Stage rotation (rpm)<input id="rpm" type="number" min="0" max="20" step="any" value="0"/></label>
<label>Coverage threshold (nm)<input id="threshold_nm" type="number" min="0" step="any" value="50"/></label>
</div>
<h4>Witness map</h4><p id="pvd-cal" class="pvd-small"></p>
<div class="pvd-toolbar"><button type="button" id="pvd-demo-cal">Demo calibration</button><button type="button" id="pvd-clear-cal">Clear map</button></div><label class="pvd-file">Import rate-map JSON<input type="file" id="pvd-import" accept=".json,application/json"/></label>
<div class="pvd-toolbar"><button type="button" id="pvd-example" class="pvd-primary">Run ready example</button><button type="button" id="pvd-run">Run current recipe</button></div>
<progress id="pvd-progress" max="1" value="0" aria-label="Compressed simulation progress"></progress><p class="pvd-small">Two-second visual playback represents the configured shutter duration. Pumping and venting are conceptual interlocks, not time-resolved vacuum physics.</p><p id="pvd-error" role="alert" class="pvd-error"></p>
</section></div>
<section><h3>Result · sample revision</h3><div class="pvd-output"><canvas id="pvd-map" width="320" height="320" aria-label="Calculated wafer thickness map"></canvas><div><p id="pvd-map-scale" class="pvd-small"></p><p id="pvd-results" aria-live="polite">No result for the current settings.</p><div class="pvd-toolbar"><button type="button" id="pvd-export" disabled>Export revision JSON</button><button type="button" id="pvd-csv" disabled>Export thickness CSV</button></div><p id="pvd-history" class="pvd-small"></p><p>Exports preserve the sample ID, revision and parent revision, calibration, recipe, coordinates and units. Independent layers are not accumulated into total stack thickness. <a href={assets+'example-layer.json'} download>Example layer / handoff schema</a>. No downstream station is connected yet.</p></div></div></section>
<section><h3>Illustrated reference sheet</h3><p>Original reconstruction views are available via the camera presets above. The diagrams below are original schematic annotations, not manufacturer CAD. Source photographs and proprietary manual are linked rather than reproduced.</p>
<div class="pvd-references">
<figure><svg viewBox="0 0 320 255" role="img" aria-label="Original front schematic of cabinet and control console"><g stroke="currentColor" fill="none" stroke-width="1.5"><rect x="62" y="20" width="151" height="220"/><rect x="62" y="20" width="151" height="15"/><path d="M139 35V240 M62 169H139 M139 185H213"/><rect x="82" y="63" width="40" height="68" fill="#323a3e"/><rect x="93" y="90" width="18" height="28" fill="#7796a0"/><rect x="155" y="62" width="42" height="35" fill="#7796a0"/><path d="M154 121H198L202 132H150Z" fill="#323a3e"/><circle cx="129" cy="163" r="4" fill="#b83226"/><path d="M62 56H22 M99 104H24 M196 79H240 M198 125H240 M130 163H20"/></g><g fill="currentColor" font-size="10"><text x="69" y="31">PVD 75</text><text x="6" y="52">Door</text><text x="4" y="99">Viewport</text><text x="240" y="75">HMI</text><text x="240" y="121">Keyboard</text><text x="4" y="159">E-stop</text><text x="60" y="252">Front elevation · nominal cabinet</text></g></svg><figcaption>Front: enclosed cabinet, left dark viewport panel, right recessed monitor and keyboard correspond to <a href={photo}>WashU's installation photo</a>. Width/height use legacy family dimensions. Exact serial and trim dimensions unverified.</figcaption></figure>
<figure><svg viewBox="0 0 320 255" role="img" aria-label="Original section drawing of upward sputtering"><g stroke="currentColor" fill="none" stroke-width="1.5"><rect x="66" y="20" width="155" height="211"/><path d="M100 50H187V60H100Z" fill="#98a4aa"/><path d="M112 65H175" stroke="#6096c2" stroke-width="5"/><path d="M137 25V50 M90 93H195" stroke-width="3"/><path d="M91 177H131V195H91Z M151 177H191V195H151Z" fill="#9fa4a8"/><path d="M100 176H122 M160 176H182" stroke="#b8a273" stroke-width="5"/><path d="M110 165L137 72 M170 165L150 72" stroke="#9e68b1" stroke-dasharray="4 3"/><path d="M76 206H42 M188 54H240 M195 93H240 M191 180H240 M112 65H25"/></g><g fill="currentColor" font-size="10"><text x="240" y="51">Platen</text><text x="240" y="89">Shutter</text><text x="240" y="176">Targets</text><text x="4" y="60">Wafer</text><text x="4" y="201">Pump</text><text x="57" y="246">Inferred chamber section · sputter up</text></g></svg><figcaption>Working section: source faces, shields, shutter and downward-facing substrate. Related installation target photographs: <a href={tamu+'#page=11'}>Texas A&amp;M RF SOP, p. 11</a>. Exact WashU internal positions, door travel and rear utilities are unknown.</figcaption></figure>
</div><p>For side/rear inspection use the original reconstructed model presets; the rear connector layout and side panels are inferred. <a href={manual}>Legacy PVD 75 operation manual v8 (November 2012)</a>, pp. 7–9, documents the nominal cabinet, chamber and utility categories. <a href="https://www.lesker.com/process-equipment-division/thin-film-systems/pro-line-pvd-75-deposition-platform.cfm">Current PRO Line</a> is a different generation and is not the exterior reference. <a href="https://caeonline.com/buy/sputtering-systems/kurt-j-lesker-pvd-75/293725391">Related legacy 2011 three-quarter/side photo</a> corroborates cabinet styling, not the exact WashU serial. No confirmed exact rear photo or CAD was found.</p>
</section>
<section><h3>Specifications and provenance</h3><div class="pvd-table"><table><thead><tr><th>Quantity</th><th>Value</th><th>Evidence</th><th>Use</th></tr></thead><tbody>{specs.map(([q,v,s,link,use])=><tr><td>{q}</td><td>{v}</td><td>{link?<a href={link}>{s}</a>:s}</td><td>{use}</td></tr>)}</tbody></table></div></section>
<section><h3>Numerical model and limits</h3><p>For sample coordinates x,y in mm, rotate them into the calibrated stationary plane by angle θ(t) = θ₀ + 2π·rpm·t/60. Bilinear interpolation of the measured or synthetic rate grid gives R(x′,y′) in nm/s. Thickness h(x,y) = ∫ R(x′,y′) dt. The integrator uses 180 midpoint samples per complete rotation plus a proportional partial rotation; zero rpm uses direct interpolation. The circular sample is sampled on a 41 × 41 Cartesian grid with exterior points removed. Coverage is the fraction of sampled points above the chosen thickness threshold; nonuniformity is (max − min)/(2 mean). Both depend on the map resolution.</p><p>Rate calibration must match material, RF/DC mode, pressure and power exactly. Changing a setting does not invent a rate; import a matching map. Sample diameter must fit both the 203.2 mm station bound and map domain. Rate map is square, ordered rows by y and columns by x, with monotonically increasing axis in mm. See <a href={assets+'demo-rate-map.json'} download>demo rate-map JSON</a>. The witness example is synthetic; its central value resembles the facility's typical growth rate but is not a measured recipe. Stress remains null without independent stress data. Plasma, reactive chemistry, target erosion, heating, vacuum dynamics, step coverage and adhesion are not calculated; this is not an operational procedure or safety assessment.</p></section>
<section><h3>Verification</h3><p>Geometry: nominal plinth 1.194 × 0.889 m; nominal cabinet height 1.905 m; exact internal geometry and external protrusions are unmeasured. These are construction checks, not as-built metrology. Independent hand calculations and synthetic solver checks below do not establish agreement with experimental deposition data.</p><div class="pvd-table"><table><thead><tr><th>Test</th><th>Expected</th><th>Actual</th><th>Units</th><th>Tolerance</th><th>Outcome</th></tr></thead><tbody id="pvd-verification"></tbody></table></div><p><a href={assets+'verification.json'} download>Recorded verification results (JSON)</a></p></section>
</article>
</Layout>
<style>
.pvd{max-width:1240px;margin:auto}.pvd-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:1rem;align-items:start}.pvd-instrument,.pvd-controls{min-width:0}.pvd-toolbar{display:flex;gap:.45rem;align-items:center;flex-wrap:wrap;margin:.5rem 0}.pvd button,.pvd input,.pvd select{font:inherit;color:inherit;background:transparent;border:1px solid currentColor;border-radius:3px;padding:.42rem .55rem;min-height:38px;max-width:100%}.pvd button{cursor:pointer}.pvd button:disabled{opacity:.4;cursor:default}.pvd button.pvd-primary{font-weight:bold;background:#bca47f;color:#171614;border-color:#7d6947}.pvd button:hover:not(:disabled){outline:1px solid currentColor}.pvd input[type=file]{width:100%;font-size:.82rem}.pvd-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.pvd-fields label,.pvd-file{display:flex;flex-direction:column;font-size:.8rem;gap:.2rem}.pvd-fields input,.pvd-fields select{width:100%;box-sizing:border-box}.pvd select option{background:#eee;color:#111}.pvd-readout{border:1px solid currentColor;padding:.55rem;font-family:monospace;font-size:.83rem}.pvd-small{font-size:.82rem}.pvd-error{color:#c04b3b;font-weight:bold;min-height:1.3em}.pvd progress{width:100%}#pvd-viewer{height:clamp(350px,53vw,580px);background:#242b30;color:#eee;overflow:hidden;border:1px solid #777;display:flex;align-items:center;justify-content:center}#pvd-viewer canvas{display:block;width:100%;height:100%;touch-action:none}.pvd-output{display:grid;grid-template-columns:minmax(0,320px) minmax(0,1fr);gap:1rem;align-items:start}#pvd-map{width:100%;height:auto;max-width:320px;aspect-ratio:1}.pvd-table{overflow-x:auto}.pvd table{width:100%;border-collapse:collapse;font-size:.84rem}.pvd th,.pvd td{padding:.5rem;border-bottom:1px solid currentColor;text-align:left;vertical-align:top}.pvd-references{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.pvd figure{margin:0;border:1px solid currentColor;padding:.7rem}.pvd figure svg{width:100%;max-height:240px}.pvd figcaption{font-size:.82rem}.pvd h3{margin-top:1rem}.pvd section{margin-top:1rem}@media(max-width:800px){.pvd-grid,.pvd-output,.pvd-references{grid-template-columns:1fr}#pvd-viewer{height:380px}}@media(max-width:420px){#pvd-viewer{height:330px}.pvd-fields{gap:.4rem}}
</style>
<script>
import '../../../../lib/equipment/03-03/client.mjs';
</script>
