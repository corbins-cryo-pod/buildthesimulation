<style>
.pi{max-width:76rem}.pi .panel{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}.pi section{border-top:1px solid var(--border);margin:.85rem 0;padding:.85rem 0;min-width:0}.pi .bar{display:flex;flex-wrap:wrap;gap:.45rem;margin:.6rem 0}.pi .fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.pi label{display:flex;flex-direction:column;gap:.2em}.pi button,.pi input,.pi select{font:inherit;border:1px solid var(--border);color:var(--text);background:var(--panel);border-radius:.14rem;min-height:2.35em;padding:.35em .55em;min-width:0;max-width:100%}.pi button{cursor:pointer}.pi button:disabled{opacity:.52;cursor:default}.pi .primary{background:#224950;color:white}.pi #pi-view{height:clamp(275px,31vw,440px);background:#d7dddf;touch-action:none}.pi #pi-view :global(canvas){display:block;width:100%;height:100%}.pi #pi-chart{width:100%;height:auto}.pi #pi-results{display:block;white-space:pre-line;font-family:monospace}.pi #pi-status.error{color:#a64b31}.pi table{border-collapse:collapse;font-size:.88rem}.pi td,.pi th{border-bottom:1px solid var(--border);padding:.44em;text-align:left}.pi .scroll{overflow-x:auto}.pi [hidden]{display:none!important}@media(max-width:800px){.pi .panel{grid-template-columns:1fr}}
@media(max-width:680px){:global(body:has(#pi-view) .hero .pageTitle){hyphens:auto;overflow-wrap:anywhere}}
</style>
