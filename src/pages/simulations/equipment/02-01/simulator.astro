---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
import checks from '../../../../data/equipment/02-01-verification.json';
const a='/equipment/02-01/';
const refs=[["Front three-quarter","https://www.nist.gov/laboratories/tools-instruments/nanofab-tool-suss-microtec-maba6-gen4-mask-aligner","NIST Gen4 product photo: silver enclosure, black upper exposure head, stand, right-side digital screen, keyboard, trackball and joystick."],["Front","https://nanofab.usc.edu/ma-ba-gen4-mask-aligner/","USC Gen4 installed front: shielded central bay and loading drawer, front emergency control, optical hood."],["Side / controls","https://nano.tau.ac.il/mask-aligner-ma6-gen4","Tel Aviv Gen4 installation: digital monitor on operator-side arm; no CRT. Side dimensions not measured."],["Working area","https://img01.71360.com/w3/og8vgq/20240613/acc6e920866073068e2062d537b7ef0d.pdf#page=4","Manufacturer Gen4 brochure p.4: face-to-face digital microscopes, objective barrels and sample plane. Selected top-side only."],["Rear / utilities","https://img01.71360.com/w3/og8vgq/20240613/acc6e920866073068e2062d537b7ef0d.pdf#page=11","Gen4 technical data p.11: vacuum, compressed air, nitrogen, AC power. Rear rendering schematic; orthogonal rear photo not found."],["Recipe controls","https://nff.gmu.edu/wp-content/uploads/2025/12/SOP-SUSS-MABA6.pdf#page=6","GMU SOP December 2025 p.6: touchscreen recipe, tools, start process. Original simplified interface, not proprietary UI."]];
const specs=[["Envelope","1173 × 1000 × 1860 mm","Width × depth × height; brochure p.11","https://img01.71360.com/w3/og8vgq/20240613/acc6e920866073068e2062d537b7ef0d.pdf#page=11"],["Selected substrate / mask","150 mm circular / 178 × 178 mm","NIST Gen4 tool; selected standard tooling","https://www.nist.gov/laboratories/tools-instruments/nanofab-tool-suss-microtec-maba6-gen4-mask-aligner"],["Mask alignment travel","X ±5 mm, Y ±5 mm, θ ±5°","MA mode, not BA; brochure p.11","https://img01.71360.com/w3/og8vgq/20240613/acc6e920866073068e2062d537b7ef0d.pdf#page=11"],["Topside focus","40 mm span","Centered ±20 mm software convention; brochure p.11","https://img01.71360.com/w3/og8vgq/20240613/acc6e920866073068e2062d537b7ef0d.pdf#page=11"],["Proximity","1–300 µm; 1 µm gap-setting accuracy","Brochure p.11; simulated contact uses 0","https://img01.71360.com/w3/og8vgq/20240613/acc6e920866073068e2062d537b7ef0d.pdf#page=11"],["Exposure wavelengths","365 / 405 / 436 nm; 350–450 nm broadband","Selected 365 nm nominal; intensity entered by user","https://www.nist.gov/laboratories/tools-instruments/nanofab-tool-suss-microtec-maba6-gen4-mask-aligner"],["Rated resolution / overlay","1 µm / 500 nm TSA","NIST tool; not reproduced by this solver","https://www.nist.gov/laboratories/tools-instruments/nanofab-tool-suss-microtec-maba6-gen4-mask-aligner"],["Wafer thickness","≤10 mm","Brochure p.11; model lower bound 100 µm is software assumption","https://img01.71360.com/w3/og8vgq/20240613/acc6e920866073068e2062d537b7ef0d.pdf#page=11"],["Loading slide","160 mm virtual travel","Inferred, no manufacturer stroke measurement","https://nff.gmu.edu/wp-content/uploads/2025/12/SOP-SUSS-MABA6.pdf#page=7"],["Illumination intensity","8 mW/cm² demo, user-entered","Assumed example, not measured/calibrated at NIST","https://www.nist.gov/laboratories/tools-instruments/nanofab-tool-suss-microtec-maba6-gen4-mask-aligner"]];
---
<Layout pageTitle="Contact mask aligner" subtitle="" description="SUSS MA/BA6 Gen4 alignment and virtual photolithography laboratory." wide={true}>
<article class="equipment ma6" id="ma6-lab" data-model-revision="2">
<nav class="eq-nav"><a href="/simulations/equipment/02-01/">← Equipment 02-01</a><a href="/simulations/equipment/">Equipment register</a><a href="#evidence">Evidence & verification</a></nav>
<header class="eq-mast"><span class="eq-meta">02-01 / MASK ALIGNMENT / VIRTUAL INSTRUMENT</span><h2>SUSS MA/BA6 Gen4</h2><p>Standard six-inch Gen4 platform, configured for top-side mask alignment, 150 mm wafer, 178 mm mask and nominal 365 nm exposure. Digital screen, not the older CRT-equipped MA6. Geometry uses the Gen4 brochure envelope and original estimates for undocumented parts.</p></header>
<div class="ma6-grid">
<section class="ma6-panel"><h3>Instrument</h3><div class="ma6-buttons"><button data-view="reset">Reset</button><button data-view="front">Front</button><button data-view="side">Side</button><button data-view="rear">Rear</button><button data-view="stage">Stage</button><button data-view="optics">Optics</button><button data-view="wafer">Wafer top</button><button data-view="screen">Controls</button></div>
<div class="ma6-view"><canvas id="ma6-canvas" aria-label="Interactive scale model of the Gen4 mask aligner"></canvas></div><p id="ma6-model-status" role="status">Loading physical-scale model…</p>
<div class="ma6-buttons"><button id="ma6-slide">Withdraw drawer</button><button id="ma6-load" disabled>Unload wafer</button><button id="ma6-masklock">Release mask</button><button id="ma6-engage">Engage mode</button><button id="ma6-cut">Inspect working area</button></div><p id="ma6-state" aria-live="polite"></p>
<p class="ma6-note">Orbit by dragging, zoom by scroll or pinch. X/Y/θ are physical-scale stage motion; focus and loading travel are simplified. At overview scale the exposure gap is too small to see.</p></section>
<section class="ma6-panel"><h3>Experiment setup</h3>
<form id="ma6-fields" onsubmit="return false">
<label>Wafer ID<input name="sampleId" maxlength="100"/></label><label>Parent revision<input name="revision" type="number" min="0" step="1"/></label><label>Wafer diameter (mm)<input name="diameterMm" type="number" step="1"/></label><label>Thickness (µm)<input name="thicknessUm" type="number" min="100" max="10000"/></label>
<label>X (mm)<input name="xMm" type="number" min="-5" max="5" step=".001"/></label><label>Y (mm)<input name="yMm" type="number" min="-5" max="5" step=".001"/></label><label>θ (°)<input name="thetaDeg" type="number" min="-5" max="5" step=".001"/></label><label>Relative focus (mm)<input name="focusMm" type="range" min="-20" max="20" step=".1"/><output id="ma6-focus-value"></output></label>
<label>Exposure mode<select name="mode"><option value="hard">Ideal hard contact</option><option value="proximity">Proximity</option></select></label><label>Proximity gap (µm)<input name="gapUm" type="number" min="1" max="300" step="1"/></label><label>Incident intensity (mW/cm²)<input name="intensity" type="number" min=".01" max="100" step=".01"/></label><label>Exposure time (s)<input name="seconds" type="number" min=".01" max="120" step=".01"/></label>
<label>ROI center X (mm)<input name="roiX" type="number" step=".001"/></label><label>ROI center Y (mm)<input name="roiY" type="number" step=".001"/></label><label>Raster pitch (µm)<select name="pitchUm"><option>2</option><option selected>4</option><option>8</option><option>16</option></select></label>
</form>
<details><summary>Mask and wafer alignment marks (JSON)</summary><label>Mask transmission rectangles and fiducials<textarea id="ma6-mask" rows="9" spellcheck="false"></textarea></label><label>Corresponding wafer marks<textarea id="ma6-marks" rows="5" spellcheck="false"></textarea></label><label>Import mask JSON<input id="ma6-import" type="file" accept=".json,application/json"/></label><p class="ma6-note">Clear rectangles (ID, x, y, w, h in mm) must not overlap. Two fiducials use corresponding ordered IDs. All coordinates are already in the mask-as-seen-from-wafer frame; no mirroring.</p></details>
<div class="ma6-buttons"><button id="ma6-apply">Apply pose</button><button id="ma6-align">Align two marks</button><button id="ma6-run" disabled>Expose wafer</button><button id="ma6-example" class="ma6-primary">Run aligned example</button></div>
<p id="ma6-status" role="status" aria-live="polite">Inspect the offset crosses, align, engage exposure and run.</p></section></div>
<section class="ma6-panel"><h3>Split-field microscope and latent-dose image</h3><div class="ma6-grid"><figure><canvas id="ma6-overlay" width="600" height="300"></canvas><figcaption>Left and right fields; gold mask target, cyan wafer cross. Optical view is schematic; focus changes displayed clarity, not true image formation.</figcaption></figure><figure><canvas id="ma6-dose" width="600" height="300"></canvas><figcaption>Local 1.28 × 1.28 mm wafer ROI. Values are area-averaged mJ/cm²; outside ROI unknown.</figcaption></figure></div><figure class="ma6-wafer"><canvas id="ma6-wafer-map" width="600" height="300" aria-label="Wafer and illumination footprint; click to choose ROI"></canvas><figcaption>Wafer overview in wafer coordinates, with the fixed 150 mm optical aperture projected through the applied stage pose. Select the ROI on the map or enter X/Y above. Crosshair is enlarged for visibility.</figcaption></figure><div id="ma6-result" aria-live="polite">No exposure result.</div><div class="ma6-buttons"><button id="ma6-json" disabled>Export sample revision (JSON)</button><button id="ma6-csv" disabled>Export dose map (CSV)</button><a href={a+'example-result.json'} download>Example result</a><a href={a+'output-schema.json'} download>Handoff schema</a></div></section>
<section id="evidence" class="ma6-panel"><h3>Illustrated reference sheet</h3><p>Original model renders (not photographs) paired with viewed manufacturer and facility references. Exterior proportions and feature placements are qualitative; internal and rear dimensions are not measured. No photos are republished without established reuse rights.</p>
<div class="ma6-refs">{refs.map(([title,url,caption],i)=><figure><img id={'ma6-ref-'+i} alt={'Original '+title+' model rendering'}/><figcaption><strong>{title}</strong> — {caption} <a href={url}>Source / original photograph or manual</a></figcaption></figure>)}</div>
<h3>Specifications and provenance</h3><div class="ma6-scroll"><table><thead><tr><th>Specification</th><th>Value</th><th>Conditions / role</th></tr></thead><tbody>{specs.map(([k,v,c,u])=><tr><td>{k}</td><td>{v}</td><td>{c} <a href={u}>Source</a></td></tr>)}</tbody></table></div>
<h3>Model and handoff</h3><p>Wafer coordinates are mapped to the mask by q = R(θ)p + t. Two matched fiducials determine the rigid fit using their line angle and midpoint. Residuals are measured in mm; a spacing mismatch cannot be fixed by a rigid pose. For hard contact, each raster cell stores incident dose × exact overlap fraction of the rotated pixel, clear rectangles and fixed 150 mm circular illumination aperture (polygon clipping and analytic circle segments). This conserves clear area, including subpixel lines. For proximity, use the Gaussian-convolved clear rectangles with σ = 0.5√(λg), λ and g in µm. The integral is evaluated with the separable Gaussian CDF; this is a scale-inspired surrogate, not Fresnel wave optics, calibrated photoresist chemistry, or a resolution prediction. For non-overlapping rectangles convolution is linear. Unrotated proximity cells inside the aperture integrate the separable Gaussian analytically; rotated or aperture-edge proximity cells use 4 × 4 Gauss–Legendre quadrature. Very small gaps or coarse rotated grids may need refinement. Cell averaging conserves geometry but does not resolve subpixel detail; a 2–16 µm pitch cannot validate submicron claims. The NIST 150 mm illumination field is modeled as a uniform circular aperture; illumination roll-off and measured uniformity are not available.</p>
<p>Inputs: ID, parent revision, selected 150 mm wafer, thickness, non-overlapping rectangular mask, two corresponding marks, X/Y/θ, focus, exposure mode, gap, intensity, time and ROI. Invalid fit, mark IDs, travel, gap or missing loading state returns no revision. Output shares the 02-02 latent-dose schema family; downstream development must honor the ROI grid and treat outside-ROI dose as unknown. No downstream developer was run; station 02-10 is not yet implemented. The example JSON uses the same default 4 µm pitch as the UI.</p>
<div class="ma6-buttons"><a href={a+'model-source.json'} download>Editable geometry JSON</a><a href={a+'build-model.mjs'} download>Model generator</a><a href={a+'ma6-gen4.glb'} download>GLB asset</a><a href={a+'ma6-gen4.gltf'} download>glTF asset</a><a href={a+'solver.mjs'} download>Numerical source</a><a href={a+'verification.json'} download>Verification data</a></div>
<h3>Numerical and geometry verification</h3><p>{checks.evidence}</p><div class="ma6-scroll"><table><thead><tr><th>Check</th><th>Expected</th><th>Actual</th><th>Unit</th><th>Tolerance</th><th>Result</th></tr></thead><tbody>{checks.checks.map(c=><tr><td>{c.name}</td><td>{String(c.expected)}</td><td>{typeof c.actual==='number'?Number(c.actual.toPrecision(9)):c.actual}</td><td>{c.unit}</td><td>{String(c.tolerance)}</td><td>{c.pass?'PASS':'FAIL'}</td></tr>)}</tbody></table></div></section></article>
</Layout>
<script>
import '../../../../lib/equipment/02-01/client.mjs';
</script>
<style>
.ma6-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.ma6-panel{border:1px solid var(--border);padding:1rem;margin:1rem 0;min-width:0}.ma6-panel h3{margin:.1rem 0 .8rem}.ma6-view{height:470px;background:#1b242c;position:relative}.ma6-view canvas{display:block;width:100%;height:100%;touch-action:none}.ma6-buttons{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:.6rem 0}.ma6 button,.ma6 input,.ma6 select,.ma6 textarea{color:var(--text);background:var(--panel);border:1px solid var(--border);padding:.45rem;font:inherit;min-width:0;max-width:100%}.ma6 button{cursor:pointer}.ma6 button:disabled{opacity:.45;cursor:default}.ma6-primary{font-weight:bold}.ma6 form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.ma6 label{display:grid;gap:.25rem;min-width:0}.ma6 textarea{width:100%;box-sizing:border-box;font-family:monospace;font-size:.82rem}.ma6 figure{margin:0;min-width:0}.ma6 figure canvas,.ma6 figure img{width:100%;height:auto;display:block;background:#1b242c}.ma6 .ma6-wafer{max-width:600px;margin:1rem auto}.ma6 #ma6-wafer-map{cursor:crosshair}.ma6 figcaption,.ma6-note{font-size:.9rem;line-height:1.4}.ma6-refs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1rem 0}.ma6-scroll{overflow:auto}.ma6 table{width:100%;border-collapse:collapse;font-size:.88rem}.ma6 th,.ma6 td{border-bottom:1px solid var(--border);padding:.5rem;text-align:left}.ma6 [data-fail=true]{font-weight:bold;color:#b95142}.ma6 #ma6-result dl{display:grid;grid-template-columns:1fr 1fr;gap:.3rem}.ma6 #ma6-result dd{margin:0}.ma6 #ma6-state{font-family:var(--font-label,Arial,sans-serif);font-size:.85rem}@media(max-width:820px){.ma6-grid{grid-template-columns:1fr}.ma6-view{height:400px}.ma6-refs{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.ma6-view{height:330px}.ma6-panel{padding:.65rem}.ma6-refs{grid-template-columns:1fr}}
</style>
