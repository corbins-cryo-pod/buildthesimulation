---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
const asset='/equipment/04-04/';
const inputs=[['rate','Normal calibrated rate (nm/min)',0,500,1,30],['minutes','Exposure (min)',0,60,.1,2],['angle','Incidence from normal (deg)',0,80,1,0],['azimuth','Source azimuth (deg)',0,360,1,0],['rpm','Stage rotation (rpm)',0,45,.1,0],['maskFraction','Left mask coverage (fraction)',0,1,.01,.5],['maskGap','Mask gap (mm)',0,2,.01,0],['maskThickness','Mask thickness (mm)',.001,2,.001,.5],['redeposition','Retained sputtered fraction (proxy)',0,.5,.01,0]];
---
<Layout pageTitle="ION MILLING LABORATORY" subtitle="" description="Directional ion-beam milling and mask shadowing">
<article class="equipment eq-sheet" id="ionmill">
<nav class="eq-nav"><a href="/simulations/equipment/04-04/">← Equipment 04-04</a><a href="/simulations/equipment/">Equipment register</a></nav>
<header class="eq-mast"><span class="eq-meta">04-04 · ION BEAM ETCHING · RECONSTRUCTED MODEL</span><h2>Intlvac Nanoquest I</h2><p>Direct-load, argon-only research configuration with a water-cooled stage and 100 mm carrier. The default example is loaded and virtually pumped down. The instrument geometry is an approximation, not factory CAD. The shutter and stage animate on compressed time; exposure is integrated using the configured physical time.</p></header>
<div class="mill-grid">
<div><div id="mill-view" aria-label="Interactive 3D Nanoquest instrument"><span id="mill-model-status" role="status">Loading 3D asset…</span></div>
<div class="mill-actions"><button id="view-reset">Reset</button><button id="view-front">Front</button><button id="view-side">Side</button><button id="view-stage">Stage close-up</button><label><input id="cutaway" type="checkbox"/> Cutaway</label></div>
<p class="small">Orbit by dragging; zoom with scroll/pinch. Stage close-up opens the cutaway. Metal geometry, motion limits and beam placement are schematic where no drawings were available.</p></div>
<div><h2>Chamber and specimen</h2><p id="mill-state" role="status"></p><div class="mill-actions"><button id="vent">Vent</button><button id="door">Open door</button><button id="load">Load example</button><button id="pump">Pump chamber</button></div>
<label>Import sample or prior result JSON<input type="file" id="sample-file" accept=".json,application/json"/></label>
<p id="sample-info"></p>
<div class="mill-fields">{inputs.map(([id,label,min,max,step,value])=><label>{label}<input type="number" id={id} min={min} max={max} step={step} value={value}/></label>)}</div>
<div class="mill-actions"><button id="mill-run" class="primary">Run ion mill</button><button id="mill-export" disabled>Export JSON</button><button id="mill-csv" disabled>Export CSV</button></div><p id="mill-error" role="alert"></p>
</div></div>
<section><h2>Calculated measurements — simulated</h2><div id="mill-readout" aria-live="polite">Run the example to calculate the thickness and directional shadow maps.</div><div class="map-grid"><figure><canvas id="thickness-map" width="320" height="320" aria-label="Thickness map"></canvas><figcaption id="thickness-caption">Remaining thickness (nm)</figcaption></figure><figure><canvas id="shadow-map" width="320" height="320" aria-label="Directional shadow map"></canvas><figcaption>Shadow fraction · black 0, white 1</figcaption></figure></div><canvas id="profile" width="640" height="180" aria-label="Centerline thickness profile"></canvas><p class="small">Maps show the coupon from its outward normal; x right, y up. Profile uses the central row. The virtual film cannot etch below the substrate.</p></section>
<section><h2>Reference sheet and geometry provenance</h2><img src={asset+'reference.svg'} alt="Original labeled front and side schematic, with chamber, control rack and stage" width="800" height="330"/><p><strong>Original schematic, not a manufacturer photograph.</strong> Front controls and protruding chamber are reconstructed from the reference views. Rear and hidden source layout are inferred; no dimensioned mechanical drawing was found.</p>
<dl class="eq-fields"><dt>Installed front / three-quarter</dt><dd><a href="https://snsf.stanford.edu/facilities/fab/fcr/ionmill">Stanford Nano Shared Facilities</a> · <a href="https://snsf.stanford.edu/sites/g/files/sbiybj18236/files/styles/large/public/media/image/ionmill_2_0.jpg?itok=rcGwE4dH">installed-tool photograph</a>. Chamber, side ports, controller rack and cabinet; Stanford does not identify the generation.</dd><dt>Manufacturer exterior and stage</dt><dd><a href="https://intlvac.com/Portals/0/Resources-Download/Nanoquest_I_2018.pdf?ver=2018-04-26-150333-020">Nanoquest I brochure, March 2018</a>, stage specification p. 2, accessory overview p. 3. Also <a href="https://www.intlvac.com/en-us/products-technology/intlvac-systems/ibe-milling-systems/nanoquest-i">manufacturer product page</a>. Door-mounted stage, cooling, shutter, and motion.</dd><dt>Front close-up</dt><dd><a href="https://www.sistemtechnology.com/product/intlvac-nanoquest-i-ion-beam-etch-milling/">SiSTEM Nanoquest I</a> · circular cover, feedthrough and ports. Used for visual proportion only.</dd><dt>Operator interface</dt><dd><a href="https://bpb-us-w2.wpmucdn.com/sites.udel.edu/dist/9/3681/files/2018/03/Ion-Mill-Detailed-Operating-Procedure-1k2pbrw.pdf">University of Delaware procedure</a>, pp. 1–2, figures 1–2; different installation. Load/vent/pump and process interlocks, not a recipe for this model.</dd><dt>Side and rear</dt><dd>No calibrated orthogonal rear/side photograph located; connector positions, chamber depth, hinge travel and all cabinet dimensions are inferred. Source photographs linked rather than copied because reuse permission was not established.</dd></dl>
<table><thead><tr><th>Quantity</th><th>Value / condition</th><th>Evidence and role</th></tr></thead><tbody><tr><td>Carrier</td><td>100 mm maximum coupon diagonal</td><td>Stanford 100 mm stage; geometry/input bound. Nanoquest I brochure p. 2 lists up to 6 in for other options.</td></tr><tr><td>Stage rotation</td><td>0–45 rpm</td><td>Manufacturer brochure p. 2; simulation control.</td></tr><tr><td>Stage mechanical tilt</td><td>0–270°; better than ±0.1° incidence control under vacuum</td><td>Brochure p. 2. Virtual face-on incidence limited to 0–80°, not the mechanical dial convention.</td></tr><tr><td>Cooling / source</td><td>Water-cooled platen; broad argon beam</td><td>Brochure p. 2 and Stanford; thermal effects not solved. Source diameter/location inferred.</td></tr><tr><td>Pre-process vacuum</td><td>≤5×10⁻⁵ Torr virtual permissive</td><td>Delaware p. 1, distinct configuration; simple interlock, no pressure dynamics.</td></tr><tr><td>Cabinet, main chamber diameter</td><td>1.53 × 1.65 × 0.76 m cabinet; 0.53 m chamber</td><td>Original inferred design dimensions, not measured. Carrier 0.10 m is the documented scale anchor.</td></tr><tr><td>Mask / film / calibrated rate</td><td>0.5 mm shield / 200 nm film / 30 nm/min default</td><td>Original example assumptions, not measured Au etch data.</td></tr></tbody></table>
<p><a href={asset+'nanoquest.glb'} download>Download metric GLB</a> · <a href={asset+'model.mjs'} download>Editable model generator</a> · <a href={asset+'example.json'} download>Example sample JSON</a> · <a href={asset+'example-result.json'} download>Example milled result</a> · <a href={asset+'output-schema.json'} download>Output schema</a> · <a href="https://github.com/corbins-cryo-pod/buildthesimulation/blob/main/src/lib/equipment/04-04/solver.mjs">Solver source</a></p></section>
<section><h2>Numerical model and output contract</h2><p>For a grid cell of initial thickness h, the directional source ray is intersected with an opaque mask slab and (for a nonflat input) sampled against the initial heightfield. The time-weighted blocked fraction is B. With calibrated normal-incidence rate R, time t, and incidence θ, removal is min(h, R t cos θ (1−B)). Rotation averages 72 midpoint phases per full turn plus the remaining partial turn. The proxy returns a fraction of total removed volume to shadowed cells, weighted by B; it is not a transport simulation. All cells have equal area. The dose is applied once to the initial surface; mask erosion, evolving topology, energy dependence, material selectivity, chamber pumping, collisions, charging and thermal effects are not modeled. The angle dependence is projected flux only; actual sputter yield varies with material, energy and angle.</p><p>Sample schema bts.ionmill.sample.v1: sampleId, revision, material, widthMm, heightMm, nx, ny, thicknessNm (row-major; 8–96 cells per axis; 0.1–100 mm sides; diagonal ≤100 mm; 0–100,000 nm). The mask is a rectangular shield covering the left fraction of the coupon. Result schema bts.ionmill.result.v1 includes the incremented sample, parent revision, inputs, frame, per-cell shadow fraction, removal and redeposition in nm, and volume balance in mm³. JSON can be reloaded as a subsequent sample; CSV contains center coordinates and values. No downstream station compatibility verified.</p></section>
<section><h2>Verification</h2><p>Analytical cases defined independently of material rate: 200 nm flat coupon, 30 nm/min × 2 min, normal incidence, opaque left half. Exact tolerances for algebraic checks, not manufacturing tolerances.</p><table><thead><tr><th>Test</th><th>Expected</th><th>Calculated</th><th>Tolerance</th></tr></thead><tbody><tr><td>2048 protected cells</td><td>200 nm each</td><td>200 nm each</td><td>10⁻⁹ nm · pass</td></tr><tr><td>2048 exposed cells</td><td>140 nm each</td><td>140 nm each</td><td>10⁻⁹ nm · pass</td></tr><tr><td>Mean removal</td><td>30 nm</td><td>30 nm</td><td>10⁻⁹ nm · pass</td></tr><tr><td>Unmasked 60° incidence</td><td>30 nm</td><td>30 nm</td><td>10⁻⁹ nm · pass</td></tr><tr><td>45° toward −x, 0.5 mm shield</td><td>2240 blocked cells</td><td>2240</td><td>exact · pass</td></tr><tr><td>Overetch, no mask</td><td>0 nm remaining</td><td>0 nm minimum</td><td>10⁻⁹ nm · pass</td></tr><tr><td>20% redeposition</td><td>0.2 volume fraction</td><td>0.2</td><td>10⁻⁹ · pass</td></tr><tr><td>Zero exposure / 90° input</td><td>0 nm / reject</td><td>0 nm / rejected</td><td>exact · pass</td></tr></tbody></table><p>Analytical verification only. No measured etch-rate validation or dimensional metrology. The exterior is an evidence-informed approximation; no orthogonal calibrated image overlay was possible.</p></section>
</article>
</Layout>
<style>
.mill-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:1rem;margin-top:1rem}.mill-grid>div{min-width:0}
#mill-view{height:430px;position:relative;background:#31383b;border:1px solid var(--border);overflow:hidden;touch-action:none}#mill-view canvas{display:block;width:100%;height:100%}#mill-model-status{position:absolute;left:1rem;top:1rem;color:#fff;background:#25292b;padding:.5rem;z-index:1}
.mill-actions{display:flex;gap:.45rem;flex-wrap:wrap;align-items:center;margin:.55rem 0}.mill-actions button,.mill-fields input,#sample-file{padding:.45rem;border:1px solid var(--border);background:var(--panel);color:var(--text);font:inherit;border-radius:2px}.mill-actions button:disabled{opacity:.45}.mill-actions button.primary{font-weight:bold;border:2px solid var(--text)}.mill-fields{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}.mill-fields label{display:grid;gap:.2rem}.mill-fields input{min-width:0;width:100%;box-sizing:border-box}.small{font-size:.88rem}.map-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.map-grid figure{margin:0}.map-grid canvas,#profile{max-width:100%;height:auto;border:1px solid var(--border);image-rendering:pixelated}.eq-sheet table{width:100%;border-collapse:collapse;font-size:.94rem}.eq-sheet td,.eq-sheet th{border-bottom:1px solid var(--border);padding:.5rem;text-align:left;vertical-align:top}.eq-sheet img{max-width:100%;height:auto}#mill-error{color:#c65836;min-height:1em}@media(max-width:760px){.mill-grid{grid-template-columns:1fr}#mill-view{height:340px}.eq-sheet table{font-size:.82rem}}
</style>
<script>
import * as THREE from 'three';
import {OrbitControls} from 'three/addons/controls/OrbitControls.js';
import {GLTFLoader} from 'three/addons/loaders/GLTFLoader.js';
import {defaults,exampleSample,validateSample,runMill} from '../../../../lib/equipment/04-04/solver.mjs';
const el=id=>document.getElementById(id);
let sample=exampleSample(),result=null,doorOpen=false,pumped=true,shutterOpen=false,busy=false,model=null,renderer=null,controls=null,camera=null,scene=null,mask=null,coupon=null;
const input=()=>Object.fromEntries(Object.keys(defaults).map(k=>[k,el(k).valueAsNumber]));
const error=e=>{el('mill-error').textContent=e instanceof Error?e.message:String(e)};
function clear(){result=null;el('mill-export').disabled=true;el('mill-csv').disabled=true;el('mill-readout').textContent='Settings changed. Run to calculate a new result.';for(const id of ['thickness-map','shadow-map','profile']){const c=el(id);c.getContext('2d').clearRect(0,0,c.width,c.height)}}
function state(){
 el('mill-state').textContent=(pumped?'Vacuum permissive ≤5×10⁻⁵ Torr (virtual)':'Vented · atmosphere (virtual)')+' | door '+(doorOpen?'open':'closed')+' | shutter '+(shutterOpen?'open':'closed');
 el('sample-info').textContent=sample?sample.sampleId+' · revision '+sample.revision+' · '+sample.widthMm+' × '+sample.heightMm+' mm · '+sample.material:'No specimen';
 el('door').textContent=doorOpen?'Close door':'Open door';
 el('door').disabled=pumped||busy;el('vent').disabled=busy||!pumped;el('pump').disabled=busy||doorOpen||pumped;
 el('load').disabled=busy||!doorOpen;el('sample-file').disabled=busy||!doorOpen;el('mill-run').disabled=busy||doorOpen||!pumped||!sample;
 for(const k of Object.keys(defaults))el(k).disabled=busy;
 syncModel()
}
function syncModel(){
 if(!model)return;const c=input(),ang=Number.isFinite(c.angle)?c.angle:0,az=Number.isFinite(c.azimuth)?c.azimuth:0;
 model.getObjectByName('Door_hinge_pivot').rotation.y=doorOpen?-Math.PI*.64:0;
 model.getObjectByName('Stage_tilt').rotation.y=ang*Math.PI/180;
 model.getObjectByName('Stage_spin').rotation.z=-az*Math.PI/180;
 model.getObjectByName('Shutter_slide').position.x=shutterOpen?-.41:-.19;
 if(sample){coupon.scale.set(sample.widthMm/1000,sample.heightMm/1000,.002);const f=Math.min(1,Math.max(0,c.maskFraction||0));mask.visible=f>0;mask.scale.set(sample.widthMm/1000*f,sample.heightMm/1000,Math.max(.000001,(c.maskThickness||0)/1000));mask.position.set(-sample.widthMm/2000*(1-f),0,-.017-Math.max(0,c.maskGap||0)/1000-mask.scale.z/2)}
 for(const n of ['Door_plate','Front_stage_feedthrough','Front_black_cap','Chamber_shell','Front_flange','Chamber_rear','Cabinet_back_panel','Cabinet_left_panel','Cabinet_top']){const o=model.getObjectByName(n);if(o)o.visible=!el('cutaway').checked}
 model.traverse(o=>{if(o.name.startsWith('Flange_bolt_'))o.visible=!el('cutaway').checked});
}
function view(name){if(!camera)return;const presets={reset:[[2.4,1.95,2.6],[0,.86,.04]],front:[[0,1.02,3.1],[0,.86,0]],side:[[3,1.2,0],[0,.86,0]],stage:[[.05,1.25,-.10],[-.19,1.10,.24]]};if(name==='stage'){el('cutaway').checked=true;syncModel()}const [p,t]=presets[name];camera.position.set(...p);controls.target.set(...t);controls.update()}
try{
 scene=new THREE.Scene();scene.background=new THREE.Color(0x353d40);camera=new THREE.PerspectiveCamera(42,1,.005,20);renderer=new THREE.WebGLRenderer({antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;el('mill-view').append(renderer.domElement);controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.minDistance=.06;controls.maxDistance=7;scene.add(new THREE.HemisphereLight(0xf5f6ff,0x4b473f,2.5));for(const p of [[3,4,4],[-3,2,1],[0,4,-3]]){const l=new THREE.DirectionalLight(0xffffff,2);l.position.set(...p);scene.add(l)}const floor=new THREE.GridHelper(5,25,0x829096,0x505a5f);scene.add(floor);const resize=()=>{const v=el('mill-view');renderer.setSize(v.clientWidth,v.clientHeight,false);camera.aspect=v.clientWidth/v.clientHeight;camera.updateProjectionMatrix()};new ResizeObserver(resize).observe(el('mill-view'));resize();view('reset');
 new GLTFLoader().load('/equipment/04-04/nanoquest.glb',g=>{model=g.scene;scene.add(model);coupon=model.getObjectByName('Coupon');mask=model.getObjectByName('Opaque_mask');el('mill-model-status').textContent='3D asset loaded';el('mill-model-status').hidden=true;syncModel()},undefined,e=>{el('mill-model-status').textContent='3D load failed: '+String(e);});
 renderer.setAnimationLoop(()=>{if(model&&busy){const a=Number(el('azimuth').value)||0,rpm=Number(el('rpm').value)||0;model.getObjectByName('Stage_spin').rotation.z=-(a*Math.PI/180+performance.now()/1000*rpm*Math.PI/30)}controls.update();renderer.render(scene,camera)});
}catch(e){el('mill-model-status').textContent='3D unavailable: '+String(e)}
for(const name of ['reset','front','side','stage'])el('view-'+name).onclick=()=>view(name);
el('cutaway').onchange=syncModel;
el('vent').onclick=()=>{pumped=false;shutterOpen=false;state()};
el('door').onclick=()=>{doorOpen=!doorOpen;state()};
el('pump').onclick=()=>{if(!doorOpen)pumped=true;state()};
el('load').onclick=()=>{sample=exampleSample();clear();error('');state()};
el('sample-file').onchange=async ev=>{try{const raw=JSON.parse(await ev.target.files[0].text());sample=validateSample(raw.schema==='bts.ionmill.result.v1'?raw.sample:raw);clear();error('');state()}catch(e){error(e)}finally{ev.target.value=''}};
for(const k of Object.keys(defaults))el(k).addEventListener('input',()=>{clear();error('');syncModel()});
function heat(id,data,lo,hi,gray=false){
 const c=el(id),ctx=c.getContext('2d'),small=document.createElement('canvas');small.width=sample.nx;small.height=sample.ny;const sc=small.getContext('2d'),im=sc.createImageData(sample.nx,sample.ny);
 for(let j=0;j<sample.ny;j++)for(let i=0;i<sample.nx;i++){const v=Math.max(0,Math.min(1,(data[j*sample.nx+i]-lo)/(hi-lo||1))),k=4*((sample.ny-1-j)*sample.nx+i);im.data.set(gray?[v*255,v*255,v*255,255]:[35+210*v,72+115*v,125-78*v,255],k)}
 sc.putImageData(im,0,0);ctx.imageSmoothingEnabled=false;ctx.drawImage(small,0,0,c.width,c.height)
}
function show(r){
 const a=r.sample.thicknessNm,lo=Math.min(...a),hi=Math.max(...a);heat('thickness-map',a,lo,hi);heat('shadow-map',r.shadowFraction,0,1,true);
 el('thickness-caption').textContent='Remaining thickness: blue '+lo.toFixed(2)+' nm · gold '+hi.toFixed(2)+' nm';
 el('mill-readout').textContent='Revision '+r.sample.revision+' | thickness '+lo.toFixed(3)+'–'+hi.toFixed(3)+' nm | mean removed '+r.meanRemovedNm.toFixed(3)+' nm | mean redeposited '+r.meanRedepositedNm.toFixed(3)+' nm | removed volume '+r.removedVolumeMm3.toExponential(4)+' mm³';
 const c=el('profile'),ctx=c.getContext('2d'),max=Math.max(1,...a,...sample.thicknessNm),row=Math.floor(sample.ny/2);ctx.fillStyle='#f3f0e8';ctx.fillRect(0,0,c.width,c.height);ctx.strokeStyle='#9a9a96';ctx.beginPath();ctx.moveTo(45,10);ctx.lineTo(45,150);ctx.lineTo(625,150);ctx.stroke();ctx.fillStyle='#333';ctx.font='12px sans-serif';ctx.fillText(max.toFixed(1)+' nm',4,12);ctx.fillText('0',22,150);ctx.fillText('0 mm',45,170);ctx.fillText(sample.widthMm+' mm',580,170);
 for(const [data,color] of [[sample.thicknessNm,'#888'],[a,'#135d82']]){ctx.strokeStyle=color;ctx.lineWidth=2;ctx.beginPath();for(let i=0;i<sample.nx;i++){const x=45+580*(i+.5)/sample.nx,y=150-140*data[row*sample.nx+i]/max;i?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.stroke()}
 el('mill-export').disabled=false;el('mill-csv').disabled=false
}
el('mill-run').onclick=()=>{if(busy||doorOpen||!pumped)return;clear();error('');busy=true;shutterOpen=true;state();const c=input();setTimeout(()=>{try{result=runMill(sample,c);show(result)}catch(e){error(e)}finally{shutterOpen=false;busy=false;state()}},700)};
function save(data,name,type){const url=URL.createObjectURL(new Blob([data],{type})),a=document.createElement('a');a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}
el('mill-export').onclick=()=>{if(result)save(JSON.stringify(result,null,2),'ionmill-result.json','application/json')};
el('mill-csv').onclick=()=>{if(!result)return;const r=result,dx=r.frame.pitchMm[0],dy=r.frame.pitchMm[1],rows=['x_mm,y_mm,thickness_nm,shadow_fraction,removed_nm,redeposited_nm'];for(let k=0;k<r.sample.thicknessNm.length;k++)rows.push([(k%sample.nx+.5)*dx,(Math.floor(k/sample.nx)+.5)*dy,r.sample.thicknessNm[k],r.shadowFraction[k],r.removedNm[k],r.redepositedNm[k]].join(','));save(rows.join('\n'),'ionmill-map.csv','text/csv')};
state();
</script>
