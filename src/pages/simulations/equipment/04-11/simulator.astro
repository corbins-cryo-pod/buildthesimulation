<style>
.gx{max-width:76rem}.gx .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem}.gx section{border-top:1px solid var(--border);padding:.8rem 0;margin:.8rem 0;min-width:0}.gx .bar{display:flex;flex-wrap:wrap;gap:.44rem;margin:.55rem 0}.gx .fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.48rem}.gx label{display:flex;flex-direction:column;gap:.2rem;font-size:.92rem}.gx input,.gx select,.gx button{font:inherit;color:var(--text);background:var(--panel);border:1px solid var(--border);border-radius:.14rem;max-width:100%;min-width:0;min-height:2.4em;padding:.32em .52em}.gx button{cursor:pointer}.gx button:disabled{opacity:.52;cursor:default}.gx .primary{color:white;background:#245350}.gx #gx-view{height:clamp(270px,31vw,435px);background:#d9dddf;touch-action:none}.gx #gx-view :global(canvas){width:100%;height:100%;display:block}.gx #gx-plot,.gx img{width:100%;height:auto}.gx #gx-result{display:block;white-space:pre-line;margin:.45rem 0;font:1rem monospace}.gx #gx-status.error{color:#a54a34}.gx .scroll{overflow:auto}.gx table{border-collapse:collapse;font-size:.89rem}.gx td,.gx th{border-bottom:1px solid var(--border);text-align:left;padding:.45rem}.gx figure{margin:.8rem 0}@media(max-width:800px){.gx .grid{grid-template-columns:1fr}}
</style>
