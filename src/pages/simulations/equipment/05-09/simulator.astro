---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
import evidence from '../../../../../public/equipment/05-09/verification.json';
import model from '../../../../../public/equipment/05-09/interactions.json';
const a='/equipment/05-09/';
const phi='https://www.depts.ttu.edu/coe/research/mcc/brochures/PHI5000VersaProbeIIXPS.pdf',yale='https://ywcmatsci.yale.edu/sites/default/files/files/Yale%20MCC%20XPS%20SOP-basic%20v1_53%281%29.pdf',ku='https://mai.ku.edu/mct/phi-5000-versa-probe-ii',iso='https://www.iso.org/standard/55796.html',ref='https://www.phi.com/2020-siol-sia-chemical-state-analysis.pdf';
const refs=[['front','System front',phi+'#page=1','ULVAC-PHI product photo: three ordered blocks, bright vacuum chamber, electronics rack and workstation.'],['side','Analyzer and transfer side',ku,'Kansas facility identifies VersaProbe II and its sample holders, and documents the beam/analyzer configuration. Rearward chamber spacing is inferred.'],['work','25 mm carrier and intro cover',yale,'Yale basic XPS SOP, printed pp. 9–12: observed intro cover, round 25 mm holder and forked transfer assembly. Only their visible role is reproduced.'],['rear','Rear services',phi,'Original inferred silhouette: rear cabinet depth and panel breaks are not documented, and connectors are not represented as evidence of actual hardware.']];
const inputs=[['auArea','Au integrated counts',0,100000,1000],['agArea','Ag integrated counts',0,100000,1000],['rsfAu','Au response factor',.05,10,1],['rsfAg','Ag response factor',.05,10,1],['offsetEv','Raw offset (eV)',-3,3,.3],['gainPpm','Raw gain error (ppm)',-1000,1000,500],['baseline','Background (counts/eV)',0,1000,0]];
const show=x=>typeof x==='string'?x:Object.entries(x).map(([k,v])=>k+': '+Number(v.toPrecision(8))).join('; ');
---
<Layout pageTitle="PHI 5000 VersaProbe II" subtitle="" description="Use reference lines to test a virtual XPS energy axis and fit two known signals." wide={true}>
<article id="xps" class="equipment">
<nav class="eq-nav"><a href="/simulations/equipment/05-09/">← Equipment 05-09</a><a href="/simulations/equipment/">Equipment register</a><a href="#xps-references">References</a><a href="#xps-verify">Verification</a></nav>
<header class="xps-head"><p class="eq-meta">05-09 / X-ray photoelectron spectroscopy / Energy-reference bench</p><h2>PHI 5000 VersaProbe II</h2><p>Acquire equal-area Au and Ag reference signals, then change a response factor or inspect how a raw energy scale shifts. This is the ULVAC-PHI VersaProbe II with monochromated Al Kα, a 25 mm holder, an intro chamber, and a hemispherical analyzer. The inert test fixture is already at the analysis position.</p></header>
<div class="xps-grid">
<section class="xps-panel"><h3>01 · Inspect the instrument</h3><div class="xps-bar" id="xps-views">{['Bench','Front','Side','Rear','Work'].map(v=><button data-view={v.toLowerCase()}>{v}</button>)}<button id="xps-xr" disabled>VR unavailable</button></div>
<canvas id="xps-model" aria-label="Orbitable VersaProbe II with interactive intro cover and transfer rod"></canvas><p id="xps-asset" role="status">Loading metric GLB…</p><p>Drag to orbit; pinch or scroll to zoom. Work isolates the sample access. The cover, transfer grip, holder and host panel respond to a click or tap. Use the bench buttons for an equivalent keyboard workflow.</p></section>
<section class="xps-panel"><h3>02 · Load and acquire</h3><form id="xps-config">
<div class="xps-bar"><button type="button" id="xps-transfer">Retract to intro</button><button type="button" id="xps-door">Open intro cover</button><button type="button" id="xps-load">Remove carrier</button></div>
<div class="xps-fields"><label>Specimen ID<input name="sampleId" maxlength="96" required value="inert-line-reference-01"/></label>
<label>Axis<select name="axis"><option value="calibrated">Au/Cu corrected</option><option value="raw">Uncorrected raw</option></select></label>
<label>Pass energy (eV)<select name="passEv"><option>11.75</option><option>23.5</option><option>46.95</option><option>93.9</option></select></label>
{inputs.map(([name,t,min,max,value])=><label>{t}<input name={name} type="number" min={min} max={max} value={value} step="any"/></label>)}</div>
<div class="xps-bar"><button type="submit" class="xps-run" id="xps-run">Acquire and fit</button><button type="button" id="xps-reset">Restore test fixture</button></div>
</form><p id="xps-status" role="status">Carrier at analysis position. Ready.</p></section>
</div>
<section class="xps-panel"><h3>03 · Inspect the fit</h3><p id="xps-result" role="status">No spectrum acquired.</p>
<div id="xps-plots" class="xps-grid"></div><div class="xps-table"><table><thead><tr>{['Line','Center (eV)','FWHM (eV)','Area (counts)','Response factor','Relative signal','Fit RMS (counts/eV)'].map(x=><th>{x}</th>)}</tr></thead><tbody id="xps-rows"></tbody></table></div>
<div class="xps-bar"><button id="xps-json" disabled>Fit and spectra JSON</button><button id="xps-csv" disabled>Point CSV</button></div>
</section>
<section id="xps-references"><h3>Illustrated references</h3><p>These are original projections of the model, not manufacturer photographs or factory CAD. Compare the linked photographs or documented diagrams. No serial number, enclosure drawing or calibrated internal geometry was available.</p><div class="xps-grid xps-refs">{refs.map(([k,t,url,d])=><figure><img src={a+k+'.svg'} width="760" height="450" loading="lazy" alt={'Original illustration: '+t}/><figcaption><b>{t}.</b> {d} <a href={url}>Reference</a>.</figcaption></figure>)}</div>
<div class="xps-table"><table><thead><tr><th>Specification</th><th>Value / condition</th><th>Source and use</th></tr></thead><tbody>
<tr><td>Model</td><td>ULVAC-PHI PHI 5000 VersaProbe II; 25 mm disc holder; monochromatic Al Kα excitation</td><td><a href={phi}>PHI operating slides</a> and <a href={yale}>Yale SOP pp. 9–12</a>. Only the 25 mm carrier geometry is anchored to a documented accessory dimension.</td></tr>
<tr><td>Chamber mechanics</td><td>Separate intro chamber and main analysis position; forked transfer; hemispherical analyzer</td><td><a href={yale}>Yale operating sequence</a> and <a href={ku}>KU facility record</a>. The 0.23 m simplified transfer and 78° viewing swing are model choices, not OEM motions or interlocks.</td></tr>
<tr><td>Calibration line references</td><td>Au 4f₇/₂: 83.96 eV; Ag 3d₅/₂: 368.21 eV; Cu 2p₃/₂: 932.62 eV, monochromated Al Kα</td><td><a href={iso}>ISO 15472:2010</a>, Table 2; <a href={ref}>manufacturer-hosted calibration research</a>. Values are references, not measured simulator data.</td></tr>
<tr><td>Virtual acquisition</td><td>±6 eV per line, 0.05 eV nominal spacing; 11.75–93.9 eV selectable pass settings; modeled offset ±3 eV</td><td>Software bounds. FWHM response is a deliberate approximation, not instrument performance specification.</td></tr>
</tbody></table></div></section>
<section><h3>Scientific and file contract</h3>
<p>This exercise models isolated binding-energy lines normalized to supplied integrated counts. Peak width is Gaussian with FWHM = √[0.34² + (0.017 × pass energy)²] eV. The raw scale is r = aE + b. Separately generated Au and Cu references give the two fitted anchors; Ag is a check inside the span. Calibrated coordinates use (r − b)/a and multiply counts/eV by a to preserve area. This is a two-point teaching alignment, not a full ISO calibration.</p>
<p>Edge samples estimate a constant baseline in each window. A trapezoidal integral, weighted centroid and second moment estimate area, center and width. Relative signal for component i is (areaᵢ/RSFᵢ)/Σ(area/RSF); response factors here are entered teaching values, not measured factors for this instrument. Two test signals are not an alloy analysis. No line libraries are inferred automatically, no overlapping peaks are fitted, and no backgrounds beyond a constant are modeled. An empty fit yields no relative percentages.</p>
<p>Inputs are a known synthetic Au/Ag sample ID, per-line received area, pass energy, relative response factors, raw energy error, baseline and valid carrier state. Units, identifiers, fit residual, calibration anchors, raw centers, sampled calibrated or raw eV values, and parent/result revisions are exported. <a href={a+'output-schema.json'}>Output schema</a> · <a href={a+'example-result.json'}>Sample result</a>. No hardware, real radiation, live pumps or OEM commands are controlled.</p></section>
<section id="xps-verify"><h3>Verification</h3><p>Before coding, analytic references set the expected values and tolerance. The 25 mm digital disc can be checked from the GLB; chassis matches proportions, not certified overall size. No independent real spectrometer data were used.</p>
<div class="xps-table"><table><thead><tr>{['Case','Expected','Actual','Tolerance','Outcome'].map(x=><th>{x}</th>)}</tr></thead><tbody>{evidence.map(r=><tr><td>{r.id}</td><td>{show(r.expected)}</td><td>{show(r.actual)}</td><td>{r.absTolerance??'Exact state'} {r.unit??''}</td><td>{r.pass?'Pass':'Fail'}</td></tr>)}</tbody></table></div>
<p>25 mm carrier GLB projected span: 25.000 mm X and 24.863 mm Z; ±0.2 mm for the 30-sided outline. <a href={a+'geometry-check.json'}>Geometry checks</a> · <a href={a+'reference-plan.json'}>Predeclared fixtures</a> · <a href={a+'verification.json'}>Numerical results</a>.</p></section>
<section><h3>Editable 3D model</h3><p><a href={a+'versaprobe-ii.glb'} download>Download metric GLB</a> · <a href={a+'geometry-source.mjs'}>Editable component source</a> · <a href={a+'make-model.mjs'}>Generator</a> · <a href={a+'mesh-writer.mjs'}>Mesh writer</a> · <a href={a+'interactions.json'}>Interaction anchors</a>. The geometry is {model.triangles.toLocaleString()} triangles, {model.draws} material draws and {Math.round(model.bytes/1024)} KiB. Supported WebXR sessions can use controller rays on the modeled assembly and host panel. Physical headset behavior is untested.</p></section>
</article></Layout>
<script>import '../../../../lib/equipment/05-09/client.mjs';</script>
<style>
.xps-head{padding:1.35rem 0;max-width:74ch}#xps h2{font-size:clamp(1.9rem,6vw,4rem);line-height:1.07;margin:.2rem 0}#xps section{margin:1rem 0}#xps section>p{max-width:95ch}.xps-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem}.xps-panel{border:1px solid var(--border);padding:.85rem;min-width:0}.xps-panel h3{margin:.3rem 0}.xps-bar{display:flex;gap:.35rem;flex-wrap:wrap;margin:.5rem 0}.xps-bar button,.xps-fields :is(select,input){min-height:2.45rem;border:1px solid var(--border);background:var(--panel);color:var(--text);border-radius:3px;font:inherit;padding:.3rem .47rem}.xps-fields :is(select,input){width:100%;min-width:0;box-sizing:border-box}.xps-fields option{background:var(--menuBg,Canvas);color:var(--text,CanvasText)}.xps-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem}.xps-fields label{display:grid;gap:.22rem}.xps-run{background:#345672!important;color:white!important}#xps-model{display:block;width:100%;height:clamp(260px,34vw,430px);touch-action:none;background:#e9e8e2}.xps-table{overflow:auto}#xps table{border-collapse:collapse;width:100%;font-size:.85rem}#xps th,#xps td{text-align:left;padding:.5rem;border-bottom:1px solid var(--border);vertical-align:top}.xps-refs figure{margin:.3rem 0}.xps-refs img{width:100%;height:auto;display:block;background:#e9e8e2}.xps-refs figcaption{font-size:.88rem}#xps button{cursor:pointer}#xps button:disabled{cursor:default;opacity:.55}#xps-plots svg{width:100%}@media(max-width:820px){.xps-grid{grid-template-columns:1fr}.xps-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
