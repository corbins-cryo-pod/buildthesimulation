---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
import {readFileSync} from 'node:fs';
const base='/equipment/05-03/',manual='https://www.fullertonlab.pitt.edu/sites/default/files/Bruker_Dimension.pdf',probe='https://www.brukerafmprobes.com/product/3905/rtesp-300',nist='https://www.nist.gov/publications/algorithms-scanned-probe-microscope-image-simulation-surface-reconstruction-and-tip';
const file=n=>JSON.parse(readFileSync('public/equipment/05-03/'+n,'utf8')),proof=file('verification.json'),geom=file('geometry.json');
const ref=[['hood','01 · Isolation station','AVH-1000 hood, windowed access hatch, raked upper face and braced floor stand. Compare the general arrangement and envelope, not the finish or civil installation.','39, 42–44',68],['spm','02 · Sample-loading bay','Cutaway from the front oblique angle: edge-striped base, bridge, motorized stage, round chuck and forward head access. The manual photographs fix the envelope; minor radii and positions are estimated.','13–14, 40',66],['scanner','03 · Probe and stationary sample','The scanner moves the detector/probe assembly, not the whole chuck, during the fine raster. The holder, clip and coarse head shape are inferred from the illustrated components. The actual micron-scale beam is not enlarged here.','15–18, 144–145',44],['rear','04 · Controller / cable side','The original NanoScope V has two rear fans, instrument/data connections and mains. This rear reconstruction groups the documented connections; routing, cabinet position, pin detail and monitor dimensions are not metrology.','85–88',111]];
const spec=[['Icon SPM envelope','594.36 W × 637.54 D × 406.40 H mm','Metric model; converted from 23.4 × 25.1 × 16.0 in; pad excluded.','40',66],['Isolator','25.4 mm silicone pad','Below SPM base; 1 in nominal.','40',66],['AVH-1000 envelope','914.4 W × 812.8 D × 1652.778 H mm','Housing; depth omits access handle. Deck 733.298 mm above floor.','43–44',70],['Motorized coarse XY / chuck','154 × 185 mm travel; 200 mm chuck','Specimen positioning; not the nanoscale scan. Rev E, not the newer 210 mm option.','4, 14',30],['Original sample capacity','≤200 mm diameter × 17 mm thick','Standard configuration capacity. Example coupon is an inferred 18 × 12 × 0.5 mm virtual witness.','20',46],['Probe / RTESP-300','125 × 40 × 3.4 µm beam; 10–15 µm tip','Silicon; 15 µm tip modeled. Probe angle, die and clip contact are schematic.','probe',0],['Apex / dynamics','8 nm nominal radius, ≤12 nm catalog maximum; 300 kHz, 40 N/m nominal','Geometry model uses only R. A 20 nm comparison is a virtual blunt alternative, not a nominal RTESP-300. No oscillation calculation.','probe',0]];
const fields=[['scanNm','Field width (nm)',128,16,2000],['points','Samples per axis',129,17,257],['widthNm','Feature width (nm)',20,1,1000],['heightNm','Feature height (nm)',4,0,100],['radiusNm','Apex radius (nm)',8,0,100],['offsetNm','Feature x offset (nm)',0,-250,250]];
---
<Layout pageTitle="Atomic force microscope: Dimension Icon" subtitle="" description="Compare true and apparent nanometre topography on a reference-informed Bruker Dimension Icon." wide={true}>
<article class="equipment" id="afm"><nav class="eq-nav"><a href="/simulations/equipment/05-03/">← Equipment 05-03</a><a href="/simulations/equipment/">Register</a><a href="#refs">Reference sheet</a><a href="#proof">Verification</a></nav>
<header class="eq-mast"><p class="eq-meta">05-03 / SURFACE METROLOGY</p><h2>How wide is a 20 nm ridge?</h2><p class="eq-lede">An atomic force microscope can recover a ridge’s height while overstating its width. Acquire the loaded coupon with an 8 nm tip, then set the radius to 20 nm. Compare the apparent base and the peak height.</p></header>
<div class="cols"><section class="card"><p class="eq-meta">01 / INSTRUMENT</p><h3>Dimension Icon</h3><p>Original-generation Veeco/Bruker Icon SPM, AVH-1000 isolation hood, NanoScope V, standard air holder and uncoated silicon RTESP-300. The inspection cutaway does not physically open the hood.</p><div id="viewer" aria-label="Interactive metric model of the AFM"></div><small id="model" role="status">Loading instrument…</small><div class="tools">{[['reset','Whole station'],['spm','Microscope'],['probe','Probe bay'],['rear','Rear I/O']].map(([v,t])=><button data-view={v}>{t}</button>)}<button id="cutaway">Show acoustic shell</button><button id="vr" hidden>Enter / exit VR</button></div>
<details><summary>Operate the hardware</summary><p>Withdraw the probe, open the hatch, remove and replace the coupon, then close and engage. Scan interlocks are teaching safeguards, not service instructions. Select the hatch, chuck, scanner or workstation screen in the 3D view for the same actions.</p><div class="tools"><button id="engage">Withdraw probe</button><button id="door">Open hatch</button><button id="load">Remove coupon</button></div></details>
</section><section class="card"><p class="eq-meta">02 / ACQUISITION</p><h3>Configure the raster</h3><div class="fields"><label>Specimen<select id="source"><option value="ridge">Long rectangular ridge</option><option value="mesa">Square mesa</option><option value="flat">Flat reference</option><option value="import">Import heightmap…</option></select></label><label>Sample ID<input id="sampleId" maxlength="64" value="RIDGE-20"/></label>{fields.map(([k,l,v,min,max])=><label>{l}<input id={k} type="number" value={v} min={min} max={max} step={k==='points'?'1':'any'}/></label>)}</div>
<div class="tools"><button class="run" id="run">Acquire raster</button><button id="reset">Reset example</button></div><p id="status" role="status" aria-live="polite">Ready.</p><details><summary>Load a specimen file</summary><p><a href={base+'reference-grid.json'} download>Download the control mesa</a> or use it now. Imported grids set their own sample ID, revision, width and pitch. Derived apparent surfaces retain their provenance.</p><button id="fixture">Load control mesa</button><label>Import grid JSON<input type="file" id="file" accept=".json,application/json"/></label></details>
</section></div>
<section class="card"><p class="eq-meta">03 / RESULTS</p><h3>Specimen versus tip envelope</h3><div class="cols"><div><canvas id="maps" width="585" height="313" aria-label="Input and apparent surface maps; darker border excluded"></canvas><p>Blue is low; gold is high. Both maps share the same height scale. The darker border of the apparent map is excluded because material outside the scan is unknown.</p></div><div><canvas id="slice" width="585" height="166" aria-label="Paired line profiles in nanometres"></canvas><p><b>Teal</b> = source height; <b>gold</b> = simulated readout. Move along the acquisition order to inspect each fast-axis line. The marker, working tip and screen follow the same state.</p><label>Raster replay, pixel index <input id="cursor" type="range" min="0" max="0" value="0" disabled/></label></div></div><p id="readings" aria-live="polite"></p><div class="tools"><button id="json" disabled>Export acquisition JSON</button><button id="grid" disabled>Export apparent grid</button><button id="csv" disabled>Export center line CSV</button></div></section>
<section id="refs" class="card"><p class="eq-meta">04 / ILLUSTRATED REFERENCE SHEET</p><h3>From the Rev. E instrument to this model</h3><p>All four images below are original renders of the supplied geometry. The linked photos and drawings come from the manufacturer’s <a href={manual}>Dimension Icon Instruction Manual, Revision E</a>, hosted by the University of Pittsburgh. No manufacturer images are republished.</p><div class="cols">{ref.map(([img,title,cap,pp,p])=><figure><img loading="lazy" width="640" height="425" src={base+img+'.jpg'} alt={title}/><figcaption><b>{title}</b><br/>{cap} <a href={manual+'#page='+p}>Rev. E, printed pp. {pp}.</a></figcaption></figure>)}</div>
<div class="scroll"><table><caption>Specifications and conditions</caption><thead><tr><th>Component</th><th>Documented value</th><th>Used here</th><th>Source</th></tr></thead><tbody>{spec.map(([k,v,use,label,page])=><tr><th>{k}</th><td>{v}</td><td>{use}</td><td><a href={page?manual+'#page='+page:probe}>{page?'Rev. E p. '+label:'Bruker probe sheet'}</a></td></tr>)}</tbody></table></div>
<p>The cutaway is not a motion of the real isolation canopy. The 80° access-hatch swing and 10 mm coarse retract are illustrative; neither is specified mechanical travel. Sample frame +X to the right, +Y to the rear, height +Z away from the coupon; glTF uses +Y for world up.</p></section>
<section class="card"><p class="eq-meta">05 / METHOD AND EXCHANGE</p><h3>Geometric exclusion, not tapping dynamics</h3><p>Following <a href={nist}>Villarrubia (NIST, 1997), image simulation by dilation</a>, the software places the rigid probe as low as possible without intersecting the surface. At each pixel it takes the maximum of h(x+u,y+v) − s(d), where d²=u²+v² and s(d)=R−√(R²−d²) for d≤R. R=0 returns the source. This is a nonlinear upper envelope, not a blur. The fast path for identical rows gives the same maximum as the 2D disk search.</p><p>Raster pitch is field width/(N−1) on an ideal SI calibration (BTS-IDEAL-XY-Z-UNITY); 1 µm = 1000 nm. Scan order is serpentine; saved grids have columns +X and rows +Y. Exclude ceil(R/pitch) border pixels on every side. Sa and Sq are the mean absolute deviation and RMS deviation from the valid-area mean, respectively, without leveling or filtering. “Apparent base” spans the first/last strictly positive center-line samples. It is only defined for the isolated synthetic long ridge.</p><p><b>Limits:</b> Square fields 16–2000 nm, 17–257 samples/side, R≤100 nm, ≤20 million candidate contacts. Non-point probes require relief≤R. Out-of-range geometry, inadequate interior, incompatible units or disconnection blocks acquisition. The model omits cone/shank contact, finite feedback bandwidth, drift, noise, optical-lever dynamics, tip wear and indentation. It does not validate real samples or recover a lost ground truth.</p><p><a href={base+'handoff.json'}>Machine-readable file contract</a> · <a href={base+'reference-grid.json'}>Example source</a>. Complete JSON includes original and apparent grids, units, coordinates, sample and parent revision, valid bounds, settings and source. Apparent-grid export is explicitly derived: importing it again simulates a second dilation. It does not undo the first. Repeated scans of one source produce alternative acquisition revisions, not physical changes to a coupon.</p><p><b>Why no optical or stylus transfer?</b> The <a href="/simulations/equipment/05-02/">05-02 optical</a> example samples 5 µm per pixel, wider than this station’s entire 2 µm limit. The <a href="/simulations/equipment/05-01/">05-01 stylus</a> bench requires ≥20 µm of trace, far exceeding the 0.128 µm default AFM raster. Upsampling would invent information. Use the explicit grid contract for a compatible consumer.</p></section>
<section class="card" id="proof"><p class="eq-meta">06 / VERIFICATION</p><h3>Independent checks</h3><p>A vertical-sided continuous ridge of physical width W and height h≤R has base span W+2√(2Rh−h²). A strictly positive sampled span may undershoot by two pixel spacings. With W=20 nm and h=4 nm, broadening changes but peak height must not. These are numerical checks against analytic results, not comparison with independently measured AFM data.</p>
<div class="scroll"><table><caption>Predeclared numerical benchmarks</caption><thead><tr><th>Test</th><th>Expected</th><th>Actual</th><th>Unit</th><th>± tolerance</th><th>Result</th></tr></thead><tbody>{proof.map(r=><tr><th>{r.test}</th><td>{+r.expected.toPrecision(7)}</td><td>{+r.actual.toPrecision(7)}</td><td>{r.unit}</td><td>{r.tolerance}</td><td>{r.pass?'Pass':'Fail'}</td></tr>)}</tbody></table></div>
<details><summary>Metric geometry checks ({geom.rows.length})</summary><div class="scroll"><table><thead><tr><th>Member</th><th>Expected mm</th><th>GLB mm</th><th>± mm</th><th>Result</th></tr></thead><tbody>{geom.rows.map(r=><tr><th>{r.label}</th><td>{r.expectedMm}</td><td>{+r.actualMm.toPrecision(8)}</td><td>{r.toleranceMm}</td><td>{r.pass?'Pass':'Fail'}</td></tr>)}</tbody></table></div></details>
<div class="tools"><a href={base+'build-model.py'} download>Editable Blender source</a><a href={base+'dimension-icon.glb'} download>Download GLB</a><a href={base+'geometry.json'}>Geometry report</a><a href={base+'verification.json'}>Numerical results</a><a href={base+'solver.mjs'}>Solver</a><a href={base+'station.mjs'}>Station actions</a><a href={base+'xr.json'}>VR ray targets and bounds</a></div><p>Metric GLB: {geom.asset.triangles.toLocaleString('en-US')} triangles, {geom.asset.nodes} nodes, {(geom.asset.bytes/1e6).toFixed(2)} MB. The WebXR button appears only when immersive VR is supported. Desktop/mobile and numerical checks do not establish physical Quest performance.</p></section>
</article></Layout><script>import '../../../../lib/equipment/05-03/client.mjs';</script>
<style is:global>
#afm{--line:var(--border,#807969);font-size:1.02rem}#afm .cols,#afm .fields{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:.9rem}#afm .card{margin:.85rem 0;border:1px solid var(--line);padding:1rem;min-width:0}#afm .cols>.card{margin:0}#afm h3{font-size:1.55rem;margin:.3rem 0 .55rem}#afm .eq-meta{margin:0}#afm .tools{display:flex;gap:.45rem;align-items:center;flex-wrap:wrap;margin:.65rem 0}#afm button,#afm input,#afm select{color:var(--text);background:var(--panel,transparent);border:1px solid var(--line);font:inherit;padding:.42rem;box-sizing:border-box;max-width:100%;min-height:40px}#afm button{cursor:pointer}#afm button.run{background:#305f5b;color:#fff}#afm button:disabled{opacity:.45}#afm label{display:flex;flex-direction:column;gap:.2rem;min-width:0}#afm #viewer{height:clamp(260px,33vw,420px);background:#283337;position:relative}#afm #viewer canvas{display:block;width:100%;height:100%;touch-action:none}#afm #maps,#afm #slice{width:100%;height:auto;display:block;background:#17262a}#afm .scroll{overflow:auto}#afm table{border-collapse:collapse;width:100%;font-size:.92rem}#afm th,#afm td{border-bottom:1px solid var(--line);padding:.42rem;text-align:left}#afm figure{margin:.45rem 0}#afm figure img{width:100%;height:auto;display:block}#afm figcaption{padding:.4rem 0}#afm details{margin:.8rem 0}#afm summary{cursor:pointer;font-weight:bold}#afm caption{text-align:left;font-weight:bold;padding:.4rem 0}#afm #readings{border-left:3px solid #b28f50;padding:.35rem .65rem}#afm button:focus-visible,#afm input:focus-visible,#afm select:focus-visible{outline:3px solid #43888a}@media(max-width:760px){#afm .cols{grid-template-columns:1fr}#afm .card{padding:.7rem}#afm .fields{grid-template-columns:1fr 1fr}}
</style>
