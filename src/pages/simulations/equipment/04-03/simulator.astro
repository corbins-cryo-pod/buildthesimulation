var(--border);padding:.75rem 0}.cobra #result :global(dt){font-size:.86rem}.cobra #result :global(dd){margin:.2rem 0;font-size:1.4rem;font-variant-numeric:tabular-nums}.cobra code{overflow-wrap:anywhere}.cobra p{line-height:1.5}@media(max-width:800px){.cobra .bench,.plots{grid-template-columns:1fr}.reference-grid{grid-template-columns:1fr}.reference-grid figure{max-width:26rem}.cobra #result :global(dl){grid-template-columns:1fr 1fr}} 
