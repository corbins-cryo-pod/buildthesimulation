---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
import report from '../../../../../public/equipment/10-01/verification.json';
const asset='/equipment/10-01/';
const manual='https://neurophysics.ucsd.edu/Manuals/Axon%20Instruments/MultiClamp_700B.pdf';
const data='https://www.moleculardevices.com/sites/default/files/en/assets/data-sheets/dd/cns/multiclamp-700b-microelectrode-amplifier.pdf';
const gallery='https://www.crowleyscientific.co.uk/product/multiclamp-700b-microelectrode-amplifier-axon-instruments-cv-7b/';
const photo=(n:string)=>'https://www.crowleyscientific.co.uk/wp-content/uploads/2026/05/IMG_'+n+'.jpeg';
const refs=[
 ['front','Operator face','Two color-coded channels, indicator lamps, BNC rows, rack ears and handles. Port positions estimated. Compare with the 700B front photo.',photo('3222')],
 ['rear','Connector panel','Headstage and auxiliary D-sub connectors, rear BNCs, USB and mains. Cable routing and unlabelled clearances inferred. Compare with the 700B rear photo.',photo('3223')],
 ['headstage','CV-7B & electronic specimen','Rectangular headstage, collet, CELL port and test load. Working topology follows manual Fig. 5.15; module envelope and pin spacing estimated. Compare with the CV-7B photos.',photo('3338')]
];
const specs=[
 ['Rack chassis incl. ears','482.6 W × 304.8 D × 88.9 H mm','Nominal; feet, handles and cables excluded. Geometry.','Manual p. 141',manual+'#page=151'],
 ['CV-7B housing','40.6 W × 83.8 L × 20.3 H mm','Body only; dovetail and collet extend outside. Geometry.','Manual p. 141',manual+'#page=151'],
 ['PATCH-1U CELL','500 MΩ ∥ 33 pF, in series with 10 MΩ','Reduced whole-cell model, resistors/capacitor at nominal values. Behavior.','Manual pp. 112–113',manual+'#page=122'],
 ['Patch stray capacitance','About 4 pF at pipette','Not included; fast capacitive artifacts are not predicted.','Manual Fig. 5.15',manual+'#page=123'],
 ['Primary output scaling','10 mV/mV in IC; 0.5 V/nA in VC (×1 presets)','Simulated command and monitor signal; virtual gain choices ×1, 2, 5, 10.','Manual pp. 18, 20',manual+'#page=28'],
 ['Front and back connections','Two measurement channels; one modeled active load','Channel 1 populated; second channel and rear accessories visual only. Geometry.','Manual pp. 107–110',manual+'#page=117'],
 ['Time base / receiver','100 kS/s; ±10 V','Tutorial receiver and observation clock, not a measured bandwidth or amplifier saturation specification.','Implementation',asset+'solver.mjs']
];
const fmt=(v:number)=>Number(v.toPrecision(9)).toString();
---
<Layout pageTitle="MultiClamp 700B · passive model cell" wide={true}>
<article class="equipment mcc">
<nav class="eq-nav"><a href="/simulations/equipment/10-01/">← 10-01 equipment record</a><a href="#reference">Photographs & drawings</a><a href="#verify">Verification</a><a href="#files">Model & files</a></nav>
<header><p class="eq-meta">EQUIPMENT 10-01 · ELECTROPHYSIOLOGY</p><h1>MultiClamp 700B</h1><p class="eq-lede">Inject a current step into an electronic model cell and watch its voltage rise. Switch to voltage clamp to see how the very same load draws a transient current.</p></header>
<div class="bench"><section class="panel"><h2>Instrument bench</h2><div id="mc-view"><img src={asset+'front.png'} alt="Original 700B front view; interactive model loads above this preview" width="720" height="390"/></div><p id="mc-model" role="status">Loading the instrument…</p>
<div class="buttons" aria-label="Instrument viewpoints">{[['full','Reset view'],['face','Controls'],['cell','Electronic load'],['rear','Rear ports']].map(([v,s])=><button data-view={v}>{s}</button>)}<button id="mc-vr" hidden>Enter VR</button></div><p class="note">Drag to orbit, pinch or scroll to zoom. Select the power switch or model cell in 3D, or use the buttons at right. Only channel 1 is active.</p></section>
<section class="panel"><h2>Commander</h2><p class="note">The real 700B is computer controlled. These are virtual Commander controls, not extra knobs on the front panel.</p><div class="buttons"><button id="mc-power">Power: on</button><button id="mc-load">Disconnect CELL</button><button id="mc-example">Reset example</button></div>
<form id="mc-settings" onsubmit="return false">
<label>Clamp mode<select id="mc-mode"><option value="IC">IC · current clamp</option><option value="VC">VC · voltage clamp</option></select></label>
<label>Sample ID<input id="mc-sampleId" maxlength="64" value="PATCH1U-CH1"/></label>
{[['holding','Holding','0','any'],['step','Pulse increment','20','any'],['durationMs','Pulse duration (ms)','100','any'],['rmMOhm','Membrane R (MΩ)','500','any'],['cmPf','Membrane C (pF)','33','any'],['rsMOhm','Series R (MΩ)','10','any']].map(([key,title,v,step])=><label><span>{title}{(key==='holding'||key==='step')&&<span class="command-unit"> (pA)</span>}</span><input type="number" id={'mc-'+key} value={v} step={step}/></label>)}
<label>Primary output gain<select id="mc-gain">{[1,2,5,10].map(n=><option value={n}>×{n}</option>)}</select></label></form>
<div class="buttons"><button class="run" id="mc-run">Run sweep →</button></div><p role="status" aria-live="polite" id="mc-status">Ready with the PATCH-1U CELL port connected.</p>
</section></div>
<section class="panel"><h2>Sweep monitor</h2><p id="mc-result">Run the example to measure the passive step response.</p><canvas id="mc-plot" width="1100" height="290" aria-label="Simulated signal and rectangular command against time; numeric values provided above"></canvas><div class="buttons"><button id="mc-wave" disabled>Export primary BNC · JSON</button><button id="mc-all" disabled>Export full sweep · JSON</button></div>
<p class="note">The plotted response is electrode voltage in current clamp or electrode current in voltage clamp; the separate primary BNC export is in volts after gain and virtual receiver clipping. Send the primary file to the <a href="/simulations/equipment/10-02/">Digidata 1550B station</a>. The checked-in 131-sample example was digitized within ½ LSB by the 10-02 solver, with channel identity and revision retained.</p></section>
<section id="reference"><h2>Reference sheet</h2><p>Molecular Devices / Axon Instruments MultiClamp <b>700B</b> (not 700A), CV-7B headstage on channel 1 and PATCH-1U model cell, CELL connector. Original digital illustrations below; photographs stay with their owners.</p><div class="refs">{refs.map(([id,title,caption,link])=><figure><img src={asset+id+'.png'} alt={title+' — original reconstruction'} loading="lazy" width="720" height="390"/><figcaption><b>{title}.</b> {caption} <a href={link}>Source photo</a>.</figcaption></figure>)}</div><p class="note"><a href={gallery}>Condition & configuration: Crowley Scientific 700B gallery</a> · <a href={photo('3227')}>side view</a> · <a href={data}>manufacturer illustrated datasheet 0120-1421E, pp. 1–2, 4</a> · <a href={manual+'#page=123'}>Axon, Theory and Operation (2005), original model-cell circuit</a>. Exterior proportions were compared from front, rear and headstage perspectives; there is no calibrated camera or photographic dimensional fit. The model cell replaces a pipette: no biological sample or holder is required for this configuration.</p>
<div class="scroll"><table><thead><tr><th>Feature</th><th>Value</th><th>Condition / use</th><th>Source</th></tr></thead><tbody>{specs.map(([k,v,s,t,l])=><tr><td>{k}</td><td>{v}</td><td>{s}</td><td><a href={l}>{t}</a></td></tr>)}</tbody></table></div></section>
<section><h2>Experiment contract</h2><p><b>Input.</b> A grounded passive electronic load. Enter R<sub>m</sub> 10–1000 MΩ, C 1–250 pF, R<sub>s</sub> 0–50 MΩ (≥0.1 MΩ in VC). Holding, increment and their sum must each stay within ±200 pA in IC or ±100 mV in VC. A rectangular pulse of 1–500 ms follows a 5 ms pre-hold and precedes 25 ms recovery. These are tutorial limits, not all 700B ranges.</p>
<p><b>Calculation.</b> Start at the holding equilibrium. On every constant-command segment, V<sub>m</sub>(t) = V<sub>∞</sub> + (V<sub>start</sub> − V<sub>∞</sub>) exp(−t/τ). In IC, V<sub>∞</sub> = I·R<sub>m</sub>, τ = R<sub>m</sub>C and V<sub>electrode</sub> = V<sub>m</sub> + I·R<sub>s</sub>. In VC, V<sub>∞</sub> = V<sub>cmd</sub>·R<sub>m</sub>/(R<sub>m</sub>+R<sub>s</sub>), τ = (R<sub>m</sub> ∥ R<sub>s</sub>)C and I = (V<sub>cmd</sub> − V<sub>m</sub>)/R<sub>s</sub>. Positive current charges the cell. Compensation disabled, zero leak reversal, no pipette stray, clamp-loop dynamics, noise or filtering. Bypass is mathematical, not an assertion of unlimited hardware bandwidth.</p>
<p><b>Outputs.</b> SI arrays (s, A, V) with 10 µs sampling, contact CH1-CELL, gain, input settings, simulated provenance, clipping mask and child revision. Each sweep is a new result from the named input revision; repeated runs of the same input are not serial specimen changes. A powered-off or disconnected input, invalid setting or singular VC circuit returns no result; changing controls invalidates stale exports.</p></section>
<section id="verify"><h2>Verification ledger</h2><p>Independent targets fixed from Fig. 5.15 and elementary circuit identities. Tight numerical tolerances test implementation, not real hardware accuracy. <a href={asset+'geometry-report.json'}>Six nominal dimensions and actual mesh results</a> are reported separately with a 2 µm export tolerance. Nominal resistors and capacitors have no modeled manufacturing tolerance.</p><div class="scroll"><table><thead><tr><th>Test</th><th>Expected</th><th>Actual</th><th>Units</th><th>Absolute tolerance</th><th>Result</th></tr></thead><tbody>{report.rows.map(r=><tr><td>{r.label}</td><td>{fmt(r.expected)}</td><td>{fmt(r.actual)}</td><td>{r.unit}</td><td>{r.tol}</td><td>{r.passed?'PASS':'FAIL'}</td></tr>)}</tbody></table></div><p><b>Geometry:</b> nominal body and headstage lengths are checked in exported mesh geometry, not physical measurements. Unspecified control locations, clearances, cable routing and 18 mm disconnect travel are illustrative. <b>Not experimentally validated:</b> no measured amplifier traces, clamp stability, noise, rapid pipette transient, aging, or live tissue.</p></section>
<section id="files"><h2>Reproduce & integrate</h2><div class="links">{[['multiclamp.glb','Download GLB'],['build-model.py','Editable Blender source'],['solver.mjs','Circuit implementation'],['station.mjs','State/actions adapter'],['xr.json','XR interaction manifest'],['geometry-report.json','Measured GLB extents'],['benchmarks.json','Predeclared targets'],['verification.json','Numerical report'],['waveform-schema.json','Primary waveform schema'],['primary-example.json','Example primary waveform']].map(([f,t])=><a href={asset+f} download>{t} ↓</a>)}</div><p class="note">Blender 4.x: run the source with <code>blender -b -P build-model.py -- --renders</code>. GLB: 1,079,048 bytes, 273 named nodes, 16,596 triangles. Metres; Y up, +Z faces the operator. Insert into another VR lab at scale 1. Compatible browsers can enter optional WebXR and ray-select power, connection, mode and sweep controls. Physical Quest performance and ergonomics have not been verified.</p></section>
</article></Layout>
<script is:inline>window.mcStationModule=import("/equipment/10-01/station.mjs");</script>
<script>import '../../../../lib/equipment/10-01/client.mjs';</script>
<style is:global>
.mcc section{margin:1.9rem 0}.mcc h2{margin:.4rem 0 .6rem}.mcc .panel{border:1px solid var(--border);padding:1rem;margin:0;min-width:0}.mcc .bench{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:1rem;margin:1rem 0}.mcc .buttons,.mcc .links{display:flex;gap:.5rem;flex-wrap:wrap;margin:.6rem 0}.mcc a{overflow-wrap:anywhere}.mcc button,.mcc input,.mcc select{font:inherit;background:var(--panel);border:1px solid var(--border);border-radius:2px;padding:.4rem .52rem;color:var(--text);max-width:100%;min-width:0}.mcc button{cursor:pointer;min-height:40px}.mcc button:disabled{opacity:.48;cursor:not-allowed}.mcc button.run{font-weight:bold;background:#e3bf7e;color:#211b12}.mcc .note,.mcc figcaption,.mcc #mc-model{font-size:.88rem}.mcc form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.mcc form label{display:grid;gap:.15rem;min-width:0}.mcc #mc-view{position:relative;background:#252c35;width:100%;height:clamp(260px,37vw,435px);overflow:hidden}.mcc #mc-view img,.mcc #mc-view canvas{width:100%;height:100%;object-fit:contain;display:block}.mcc #mc-view canvas{position:absolute;inset:0;touch-action:none}.mcc #mc-plot{width:100%;height:auto;display:block}.mcc .refs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem}.mcc figure{margin:0}.mcc figure img{width:100%;height:auto;display:block;margin-bottom:.4rem}.mcc table{width:100%;border-collapse:collapse}.mcc td,.mcc th{text-align:left;vertical-align:top;padding:.48rem;border-bottom:1px solid var(--border)}.mcc .scroll{overflow:auto}.mcc #mc-status[data-err=true]{border-left:3px solid #c55c30;padding-left:.6rem}.mcc .links a{border:1px solid var(--border);padding:.32rem .55rem}
@media(max-width:760px){.mcc .bench,.mcc .refs{grid-template-columns:1fr}.mcc .panel{padding:.65rem}.mcc select,.mcc input{width:100%;box-sizing:border-box}.mcc .scroll{max-width:100%}.mcc th,.mcc td{padding:.3rem}}
</style>
