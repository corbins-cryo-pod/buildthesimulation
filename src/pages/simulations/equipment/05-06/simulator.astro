---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/equipment.css';
const root='/equipment/05-06/';
const m='https://cde-resmap.com/up-to-8-resmap-178/';
const brochure='https://www.jandel.co.uk/site/wp-content/uploads/2024/04/Jandel-Brochure.pdf';
const n='https://nvlpubs.nist.gov/nistpubs/Legacy/TN/nbstechnicalnote199.pdf';
const refs=[
 ['open','Opened load bay','Manufacturer Model 178 photograph: ivory shell, recessed black stage, circular chuck and hinged cover.', 'https://cde-resmap.com/wp-content/uploads/2016/03/up-to-8-remap178.jpg'],
 ['closed','Closed view with host','Waterloo’s Model 178 installation: closed dark cover, front plaque, right-side control panel and a separate computer.', 'https://uwaterloo.ca/quantum-nano-fabrication-and-characterization-facility/qnc-lab-equipment/cde-4pp'],
 ['head','Jandel cartridge and contact tips','Jandel brochure p. 4: 6-way CDE cartridge with a black nose and 1.5 mm projection. Four tip positions are rendered at true scale.',brochure+'#page=4'],
 ['rear','Rear and cable routing','No authoritative rear photograph or pinout found. Simplified, inferred power and data connector blocks, not a rear-panel reproduction. Compared only on footprint.',m]];
const specs=[
 ['Cabinet W × H × D','304.8 × 254 × 482.6 mm','CDE current page lists 12 × 19 × 10 in without axis labels; W/D/H inferred. Older manual Ch. 2 comparison, p. 2.6, reports 18 in depth. Neither is a unit measurement.',m],
 ['Sample handling','2–8 in diameter round wafer, manual loading','Manufacturer range; exact simulator limits 50.8–203.2 mm. Side/chuck geometry and pivot travel inferred.',m],
 ['Cartridge','Jandel CDE 6-way; Ø25.4 × 43 mm; 1.5 mm projection','Nominal documented dimensions. Simulated head is Jandel-compatible, not evidence of any particular lab’s installed head.',brochure+'#page=4'],
 ['Contact spacing','1.000 mm; 0.40 mm needle diameter','Nominal linear-head choice, Jandel p. 3; manufacturing tolerance not modeled. Tip radius and load not simulated.',brochure+'#page=3'],
 ['CDE sheet-resistance range','1 mΩ/□ to 10 MΩ/□ (manufacturer listing)','Sim accepts this film baseline range, but teaching current and ±1 V sense limit can reject combinations. No vendor accuracy claim.',m],
 ['Model motion and limits','7 mm Z head travel; shield opens 97°','Illustrative interlocks and clearances, not OEM motion settings. Reads only the homogeneous 2D limit.',n+'#page=6']
];
---
<Layout pageTitle="ResMap 178 · four-point sheet resistance" description="Load a virtual conducting film, reverse the current, and correct four-point measurements for the edge of a round wafer." wide={true}>
<article class="equipment rm">
<nav class="eq-nav"><a href="/simulations/equipment/05-06/">← Equipment 05-06</a><a href="/simulations/equipment/">Equipment register</a><a href="#rm-refs">References</a><a href="#rm-verification">Verification</a></nav>
<header class="eq-mast"><span class="eq-meta">05-06 · FILM METROLOGY</span><h2>CDE ResMap 178</h2><p>Manual-load tabletop mapper with a single Jandel CDE 6-way, 1.000 mm inline cartridge. Compare an ideal infinite sheet with a finite round wafer and watch voltage change near its insulating edge.</p></header>
<div class="rm-grid"><section><span class="eq-meta">01 / INSPECT</span><h3>Instrument</h3><div id="rm-stage" aria-label="Orbitable model of the ResMap wafer fixture"></div><div class="bar">{['Overall','Chuck','Head','Tips','Rear','Station'].map(x=><button data-rm-view={x}>{x}</button>)}<button id="rm-vr" hidden>Enter VR</button></div><p id="rm-view-status" role="status">Loading metric instrument…</p><p class="small">Drag to orbit, pinch or scroll to zoom. Model shield is selectable. Open it for the Chuck, Head or Tips close-ups, then close it to measure. Host screen in Station view previews an original readout, not vendor software.</p></section>
<section><span class="eq-meta">02 / OPERATE</span><h3>Recipe and interlocks</h3><div class="bar"><button id="rm-lid">Close shield</button><button id="rm-head">Seat probe</button><button id="rm-load">Load standard</button><button id="rm-unload">Unload wafer</button></div>
<div class="form"><label>Wafer diameter (mm)<input id="rm-diameter" type="number" min="50.8" max="203.2" step="any" value="100"/></label><label>Film thickness (nm)<input id="rm-thickness" type="number" min="1" max="100000" step="any" value="20"/></label><label>Resistivity (µΩ·m)<input id="rm-rho" type="number" min="0" step="any" value="2"/></label>
<label>Drive current (mA)<input id="rm-current" type="number" min="-10" max="10" step="any" value="1"/></label><label>Sense offset (mV)<input id="rm-offset" type="number" min="-10" max="10" step="any" value=".5"/></label>
<label>Boundary<select id="rm-boundary"><option value="disk">Round wafer · corrected</option><option value="infinite">Infinite sheet comparison</option></select></label><label>Site x (mm)<input id="rm-x" type="number" step="any" min="-101.6" max="101.6" value="0"/></label><label>Site y (mm)<input id="rm-y" type="number" step="any" min="-101.6" max="101.6" value="0"/></label><label>Probe azimuth (°)<input id="rm-angle" type="number" min="-360" max="360" step="any" value="0"/></label><label>Automatic recipe<select id="rm-recipe"><option value="edge">Radial edge sweep · 7 sites</option><option value="ring">Center + outer ring · 9 sites</option></select></label></div>
<label class="check"><input type="checkbox" id="rm-reverse" checked/> Use forward/reverse pair to cancel DC sense offset</label>
<div class="bar"><button id="rm-apply">Apply specimen values</button><button id="rm-run">Measure selected site</button><button id="rm-scan">Run mapped recipe</button><button id="rm-demo" class="primary">Run 100 Ω/□ example</button></div>
<p id="rm-status" aria-live="polite">Ready to load.</p>
<details><summary>Import a specimen or a set of measurements</summary><p>Load a uniform circular film (<code>bts.sheet-film.v1</code>, shield open) or process supplied site voltages (<code>bts.sheet-voltage-map.v1</code>, probe retracted). File processing does not change the physical fixture.</p><label>JSON file<input id="rm-import" type="file" accept=".json,application/json"/></label><p><a href={root+'film-example.json'}>Specimen example</a> · <a href={root+'voltage-map-example.json'}>Voltage map example</a> · <a href={root+'contract.schema.json'}>Input and output schemas</a></p></details></section></div>
<section><span class="eq-meta">03 / READ OUT</span><h3>Sheet resistance and correction</h3><div class="rm-results"><div><canvas id="rm-map" width="560" height="420" aria-label="Wafer site and four-contact diagram"></canvas></div><div><label>Measurement<select id="rm-row" disabled></select></label><output id="rm-stats" aria-live="polite">No acquisition.</output><div class="bar"><button id="rm-json" disabled>Export map (JSON)</button><button id="rm-csv" disabled>Export map (CSV)</button></div></div></div></section>
<section><h3>What the experiment calculates</h3>
<p>Positive signed current enters P1 and returns through P4. The inner contacts read V(P2) − V(P3), without drawing current. An ideal unbounded sheet gives R<sub>s</sub> = (π/ln 2)·V/I; the round insulating boundary adds logarithmic image terms. For sense point b and drive point a in wafer coordinates, let <code>M(b,a)=|1−b·conj(a)/R²|</code> using their complex coordinates and wafer radius R. The disk geometry factor is <code>2π / (2ln 2 + ln[M(2,4) M(3,1)/(M(2,1) M(3,4))])</code>. Multiply that factor by V/I. The image term is zero in the infinite comparison. Forward/reverse mode reports both readings, their half-difference and the estimated common offset.</p>
<p>The supplied specimen is 20 nm thick, 2 µΩ·m and uniformly 100 Ω/□. Moving toward the edge raises the sensed voltage even when material is uniform; the circular correction recovers the same resistance at every valid point. Switch off reversal to see the +0.5 mV artificial offset bias. Geometry factor and voltage are independent of the color scale. No thickness map is inferred without known resistivity.</p>
<p><strong>Scope.</strong> Conductive films on insulating substrates, circular boundary, point contacts, homogeneous and isotropic sheet, active film thickness ≤0.1× probe spacing. A 0.2 mm teaching margin rejects off-wafer contacts. Map inference on imported voltages gives effective values under the same assumptions, not an inverse reconstruction of nonuniform sheet conductivity. Contact resistance, tip indentation, leakage, thermal drift, compliance voltage, wafer stack corrections and ASTM/SRM metrology are not modeled. No physical measurements are claimed. No compatible downstream station currently consumes this map schema.</p>
</section>
<section id="rm-refs"><span class="eq-meta">04 / EVIDENCE</span><h3>Reference sheet</h3><p>The images here are original model renders. Compare the first three with the linked ResMap 178/Jandel photographs. Rear internals, controls and manufacturer setup/software revisions were not identified; the station is a teaching configuration, not a serial-number copy.</p><div class="figs">{refs.map(([id,title,caption,source])=><figure><img src={root+id+'.webp'} alt={'Original ResMap geometry: '+title} loading="lazy"/><figcaption><b>{title}.</b> {caption} <a href={source}>Reference</a></figcaption></figure>)}</div>
<div class="scroll"><table><thead><tr><th>Specification</th><th>Value</th><th>Applicability</th><th>Source</th></tr></thead><tbody>{specs.map(([title,value,notes,url])=><tr><td>{title}</td><td>{value}</td><td>{notes}</td><td><a href={url}>Primary reference</a></td></tr>)}</tbody></table></div><p><a href="https://cores.arizona.edu/sites/default/files/attachments-service/cde_operation_manual.pdf">CDE operator guide</a> · <a href="https://aemd.sjtu.edu.cn/en/platform/738.html">SJTU 178 station</a> · <a href={n}>NBS correction factor tables</a></p></section>
<section id="rm-verification"><span class="eq-meta">05 / VERIFICATION</span><h3>Independent checks</h3><div class="scroll"><table><thead><tr><th>Check</th><th>Expected</th><th>Actual</th><th>Tolerance</th><th>Outcome</th></tr></thead><tbody><tr><td>Ideal infinite film, 1 mA</td><td>22.063560 mV</td><td>22.063560 mV</td><td>10⁻⁹ mV analytical</td><td>Pass</td></tr><tr><td>NBS radial factor, Δ/r=.81</td><td>4.49925</td><td>4.499245</td><td>6×10⁻⁶, rounded table</td><td>Pass</td></tr><tr><td>NBS tangential factor, Δ/r=.81</td><td>4.49961</td><td>4.499608</td><td>6×10⁻⁶, rounded table</td><td>Pass</td></tr><tr><td>Known film &amp; current reversal</td><td>100 Ω/□ both directions</td><td>100 Ω/□ both</td><td>10⁻⁹ Ω/□</td><td>Pass</td></tr><tr><td>Drive overload / off-wafer tip</td><td>Reject with no export</td><td>Rejected</td><td>Exact</td><td>Pass</td></tr></tbody></table></div>
<p><a href={root+'reference-cases.json'}>Predeclared inputs</a> · <a href={root+'verification.json'}>Verification results</a> · <a href={root+'example-map.json'}>Example output (JSON)</a> · <a href={root+'example-map.csv'}>Example CSV</a> · <a href={root+'resmap-178.glb'} download>Metric GLB</a> · <a href={root+'build-model.py'} download>Editable parametric model</a> · <a href={root+'resmap.mjs'}>Solver / actions</a> · <a href={root+'xr-manifest.json'}>VR anchors and asset budget</a></p><p class="small">Model scale is metric and controller actions share the desktop state. Optional WebXR requires an immersive browser and the local-floor coordinate reference. Quest reach, comfort and performance have not been tested.</p></section>
</article></Layout>
<script>import '../../../../lib/equipment/05-06/client.mjs';</script>
<style>
.rm{max-width:80rem}.rm-grid,.rm-results{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(19rem,1fr);gap:1rem}.rm section{border-top:1px solid var(--border);margin:.9rem 0;padding:.85rem 0;min-width:0}.rm header h2{margin:.22em 0}.rm h3{margin:.45em 0}.rm p{line-height:1.45}.rm button,.rm select,.rm input{font:inherit;border:1px solid var(--border);border-radius:.18em;background:var(--panel);color:var(--text);padding:.42em .53em;min-height:2.4rem;min-width:0;max-width:100%}.rm button{cursor:pointer}.rm button:disabled{opacity:.55;cursor:default}.rm button.primary{background:#1d4845;color:#fff}.rm label{display:flex;flex-direction:column;gap:.2em;min-width:0}.rm label.check{flex-direction:row;align-items:center;margin:.4rem 0}.bar{display:flex;flex-wrap:wrap;gap:.45rem;margin:.6rem 0}.form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.rm #rm-stage{height:clamp(280px,36vw,455px);width:100%;background:#d3dcda;touch-action:none}.rm #rm-stage :global(canvas){width:100%;height:100%;display:block}.rm #rm-map{width:100%;height:auto;display:block}.rm #rm-stats{display:block;white-space:pre-line;font-family:monospace;margin-top:1rem}.small,.rm figcaption{font-size:.88rem}.figs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.rm figure{margin:0}.rm img{width:100%;height:auto;display:block}.rm table{border-collapse:collapse;font-size:.88rem}.rm th,.rm td{text-align:left;border-bottom:1px solid var(--border);padding:.45rem}.scroll{overflow-x:auto}.rm #rm-status.error{color:#a65037}.rm [hidden]{display:none!important}.rm code{overflow-wrap:anywhere}@media(max-width:790px){.rm-grid,.rm-results,.figs{grid-template-columns:1fr}.figs img{max-width:36rem}}
</style>
