const A='/equipment/09-08/', spec='https://www.keysight.com/zz/en/assets/9018-04526/technical-specifications/9018-04526.pdf',service='https://www.keysight.com/jo/en/assets/9018-04565/service-manuals/9018-04565.pdf',front='https://helpfiles.keysight.com/csg/NA520xA/Front_Panel/XTour.htm',rear='https://helpfiles.keysight.com/csg/NA520xA/Rear_Panel/XRtour.htm',kit='https://www.keysight.com/gb/en/product/85058V/verification-kit-1-85-mm.html',cal='https://helpfiles.keysight.com/csg/e5063a/measurement/calibration/basic_calibrations/thru_response_calibration_transmission_test.htm',touch='https://ibis.org/connector/touchstone_spec11.pdf';
const refs=[
 ['front','Operator face','Manufacturer product photograph (four-port catalog variant) establishes the bezel, touchscreen, rotary entry, keyboard, handles and lower RF bay. Option 201 has two ports, not four; their signal paths are independently documented in the option block diagram.','https://keysight-h.assetsadobe.com/is/image/content/dam/keysight/en/img/migrated/scene7/products/wn/PROD-2815126-01.png?wid=950'],
 ['ports','Port and fixture detail','Three short access loops per populated port, 1.85 mm test-port connectors and two seated test leads. Compare the jumper photograph on p. 110 and the 201 diagram on p. 118. DUT box and lead routing are original schematic accessories, not Keysight metrology standards.',spec+'#page=110'],
 ['rear','Back and side hardware','Shield, CPU bay, reference/trigger connectors, AC inlet and side ventilation. The rear is based on the family tour with the CPU 9 insert; option-dependent sockets and undocumented small details are not metrologically located.',rear]
];
const specs=[
 ['Generation','N5247B, option 201, synth rev. 7; CPU 9 rear layout','Two ports, 6 access loops; chosen documented options rather than the product photograph’s four-port fascia.',spec+'#page=9'],
 ['Cabinet without handles / feet','425.6 W × 266.1 H × 582.3 D mm','Geometry: chassis, table 109, p. 100.',spec+'#page=100'],
 ['With handles and feet','458.7 W × 280.0 H × 649.6 D mm','Without rack flanges; depth includes front/rear hardware. Geometry, table 109.',spec+'#page=100'],
 ['Frequency','10 MHz – 67 GHz','Selected two-port 201 tutorial range; no low-frequency extension, operation beyond 67 GHz or specified accuracy inferred.','https://helpfiles.keysight.com/csg/NA520xA/Support/Configurations.htm'],
 ['Interfaces','1.85 mm, 50 Ω; P1 and P2','Physical connector family; equal real 50 Ω power-wave reference. Only the two test ports take part in the calculation.',spec+'#page=9'],
 ['Calibration','Transmission-response THRU, idealized','Divide S21 and S12 by their own reference traces on identical grids. Related Keysight method; not a 12-term correction, SOLT or certified calibration.',cal],
 ['Accessory context','85058V verification kit, 1.85 mm, 10 MHz – 67 GHz','Manufacturer reference for real RF verification devices. Virtual THRU, delay, attenuator and resistor are mathematical examples; no certified kit-characterization values replayed.',kit]
];
const fmt=(n:number)=>Number(n.toPrecision(8)).toString();
---
<Layout pageTitle="Keysight PNA-X N5247B · passive two-port bench" wide={true}><article class="equipment vna"><nav class="eq-nav"><a href="/simulations/equipment/09-08/">← 09-08 equipment record</a><a href="#refs">Reference sheet</a><a href="#proof">Verification</a><a href="#files">Model & files</a></nav>
<header><p class="eq-meta">09-08 · RF METROLOGY · PASSIVE TWO-PORTS</p><h1>PNA-X network analyzer</h1><p class="eq-lede">Can a cable with no loss still change a measurement? Sweep a matched delay line, then remove the test leads’ transmission phase with a THRU reference. Compare forward and reverse transmission with reflection.</p></header>
<div class="vnbench"><section class="vp"><h2>Analyzer</h2><div id="vn-view"><img src={A+'front.png'} width="720" height="420" alt="Original rendering of the two-port N5247B"/></div><p id="vn-model" role="status">Loading the instrument…</p><div class="buttons">{[['full','Reset view'],['face','Front panel'],['dut','Fixture'],['back','Rear connections']].map(([v,t])=><button data-vna-view={v}>{t}</button>)}<button id="vn-vr" hidden>Enter VR</button></div><p class="note">Drag to orbit; pinch or scroll to zoom. Cal, Single, power, preset and the fixture can also be selected directly in the 3D instrument.</p></section>
<section class="vp"><h2>Test setup</h2><div class="buttons"><button id="vn-power">Power: on</button><button id="vn-connect">Disconnect fixture</button><button id="vn-example">Preset example</button></div><form onsubmit="return false">
<label>Device under test<select id="vn-fixture"><option value="line">Matched delay line</option><option value="thru">Ideal THRU standard</option><option value="pad">Matched attenuator</option><option value="series">Series resistor</option><option value="import">Imported two-port</option></select></label><label>Sample ID<input id="vn-sampleId" maxlength="64" value="LINE-01"/></label>
{[['startMHz','Start (MHz)',100],['stopMHz','Stop (MHz)',500],['points','Frequency points',201],['delayNs','DUT delay (ns)',1],['padDb','DUT attenuation (dB)',6],['seriesOhm','Series resistor (Ω)',100],['leftNs','Port 1 lead delay (ns)',.5],['rightNs','Port 2 lead delay (ns)',.5]].map(([k,t,v])=><label>{t}<input type="number" id={'vn-'+k} value={v} step={k==='points'?'1':'any'}/></label>)}
<label>Correction<select id="vn-correction"><option value="raw">Raw · instrument ports</option><option value="response">THRU · transmission only</option></select></label></form><div class="buttons"><button id="vn-cal">Capture THRU</button><button class="run" id="vn-run">Single sweep →</button></div><p id="vn-status" role="status" aria-live="polite">Ready with a matched line.</p><details><summary>Load passive Touchstone data</summary><p>Two-port .s2p, 50 Ω, up to 1,601 strictly increasing frequencies. Select an overlapping sweep band. Only passive S data, RI / MA / DB, with an explicit option line. No renormalization, noise data, or extrapolation.</p><input type="file" accept=".s2p,.txt" id="vn-upload"/><button id="vn-fixture-file">Load reference-line.s2p</button></details></section></div>
<section class="vp"><h2>Receiver display</h2><div class="controls"><label>Trace<select id="vn-term">{['S21','S11','S12','S22'].map(v=><option>{v}</option>)}</select></label><label>Format<select id="vn-format"><option value="db">Log magnitude (dB)</option><option value="phase">Wrapped phase (°)</option></select></label><label>Marker at point<input id="vn-marker" type="range" min="0" max="200" value="100"/></label></div>
<canvas id="vn-graph" width="1000" height="325" aria-label="Frequency response. Use the marker slider for numerical magnitude, phase, and delay."></canvas><p id="vn-result" aria-live="polite">Single sweep records a new trace.</p><div class="buttons"><button id="vn-s2p" disabled>Export port-plane .s2p</button><button id="vn-json" disabled>Export revision JSON</button></div><p class="note">Recommended: run the example. At 300 MHz the line and both test leads give 2 ns group delay. Install THRU, capture it, reinstall the line and sweep again: transmission now gives 1 ns. The reflection planes do not move.</p></section>
<section id="refs"><h2>Illustrated reference sheet</h2><p>Keysight N5247B option 201, two-port 67 GHz PNA-X, with an original passive two-port bench fixture. Analyzers can ship with different test sets, CPUs and jumper layouts. The linked photographs are source material, not republished here; illustrations are original Blender renders.</p><div class="cards">{refs.map(([f,t,cap,src])=><figure><img src={A+f+'.png'} width="720" height="420" loading="lazy" alt={'Reconstruction: '+t}/><figcaption><b>{t}.</b> {cap} <a href={src}>Original reference</a>.</figcaption></figure>)}</div>
<p class="note"><a href={front}>Annotated controls & lower connectors</a> · <a href={service+'#page=455'}>Service drawings: outer cabinet and side covers, Fig. 7-1</a> · <a href={service+'#page=457'}>front assembly Fig. 7-2</a> · <a href={spec+'#page=118'}>option 201 two-port signal path</a>. Front/right, rear and jumper views were compared qualitatively. No exact-option photograph, calibrated camera, manufacturer CAD or measured internal geometry is claimed.</p>
<div class="scroll"><table><thead><tr><th>Feature</th><th>Value or configuration</th><th>Scope</th></tr></thead><tbody>{specs.map(([k,v,t,src])=><tr><td>{k}</td><td>{v}</td><td>{t} <a href={src}>Source</a></td></tr>)}</tbody></table></div></section>
<section><h2>What the sweep measures</h2><p><b>Input.</b> A linear, passive two-port in an equal 50 Ω system, swept at 3–1,601 linearly spaced frequencies from 10 MHz to 67 GHz. An incident normalized wave at port j produces the complex outgoing wave ratio Sij at i when the other port is matched. Magnitude is dimensionless; displayed dB = 20 log₁₀ |S|. Exact zero is −∞; phase and delay at a null are undefined.</p>
<p><b>Networks.</b> Through and matched line have zero reflection and S21 = S12 = exp(−j2πfτ). A matched A-dB pad transmits 10<sup>−A/20</sup>; a series resistor gives S11 = S22 = R/(100 Ω + R), S21 = S12 = 100 Ω/(100 Ω + R). The custom DUT controls vary the virtual fixture, not the analyzer hardware. Imported data use complex-plane linear interpolation, restricted to the recorded band; sparse phase data can understate magnitude. We reject samples with singular value above unity (small roundoff tolerance).</p>
<p><b>Leads & calibration.</b> The two matched, lossless test leads multiply transmissions by exp[−j2πf(τ₁+τ₂)] and each port’s reflection by its own round-trip phase. THRU normalization divides the transmission terms by a measured-in-simulation zero-length through response. It does not remove reflection tracking, mismatch or directivity; S11/S22 stay at their original planes. The trace identifies both planes. Changing the grid, cable delays or power invalidates calibration. On real hardware, errors, finite directivity, connector repeatability, IF bandwidth and noise matter; these are not simulated.</p>
<p><b>Outputs.</b> A standard-frequency <a href={touch}>Touchstone 1.x</a> S2P (Hz, RI, R 50; S11, S21, S12, S22), at a single coherent pair of instrument-port planes. After THRU correction, normalized S21/S12 and raw S11/S22 are intentionally <em>not</em> mixed into an S2P network. Revision JSON carries the displayed terms and common-plane raw data with source, sample ID, revision, port IDs, settings, planes and complex pairs. The marker’s central-difference group delay is −Δarg(S)/(2πΔf), valid only when adjacent phase increments are less than 180°. A BTS-tagged S2P retains its incoming sample ID and revision when reloaded. Third-party files have no assumed revision history: the filename supplies an initial ID. Import the included reference line to try a reproducible round trip; no separate downstream station is required or claimed. An imported dataset is replay, not a new experimental measurement. No radiated field, telemetry range, living tissue, implantation or device safety conclusion can be derived from this bench.</p></section>
<section id="proof"><h2>Verification</h2><p>Analytic bench targets declared before implementation; tolerances check floating-point software, not instrument accuracy or kit uncertainty. No independent instrument measurements are available.</p>
<div class="scroll"><table><thead><tr><th>Independent case</th><th>Expected</th><th>Computed</th><th>Unit</th><th>Tolerance</th><th>Verdict</th></tr></thead><tbody>{vr.rows.map(r=><tr><td>{r.label}</td><td>{fmt(r.expected)}</td><td>{fmt(r.actual)}</td><td>{r.unit}</td><td>{r.tolerance}</td><td>{r.pass?'PASS':'FAIL'}</td></tr>)}{geo.rows.map(r=><tr><td>GLB · {r.label}</td><td>{r.expectedMm}</td><td>{fmt(r.actualMm)}</td><td>mm</td><td>{r.toleranceMm}</td><td>{r.pass?'PASS':'FAIL'}</td></tr>)}</tbody></table></div></section>
<section id="files"><h2>Model & reproducibility</h2><div class="links">{[['n5247b.glb','Inspect GLB'],['build-model.py','Editable Blender generator'],['solver.mjs','Circuit solver'],['station.mjs','Shared station actions'],['xr.json','VR interaction map'],['targets.json','Original targets'],['verification.json','Calculation results'],['geometry.json','Mesh metrology'],['network-schema.json','Revision schema'],['reference-line.s2p','Example S2P']].map(([p,t])=><a href={A+p} download>{t} ↓</a>)}</div><p class="note">{geo.asset.nodes} named scene nodes; {geo.asset.triangles.toLocaleString()} triangles; {(geo.asset.bytes/1e6).toFixed(2)} MB. Metres, Y up, +Z front. Physical travel of the example module is illustrative. The viewer supports WebXR headset detection and controller rays, with a DOM-free state adapter for future lab integration. A physical Quest session has not been measured or verified.</p></section>
</article></Layout><script is:inline>window.vnModules=Promise.all([import("/equipment/09-08/station.mjs"),import("/equipment/09-08/solver.mjs")]);</script><script>import '../../../../lib/equipment/09-08/client.mjs';</script>
<style is:global>
.vna .vnbench{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:1rem;margin:1rem 0}.vna .vp{border:1px solid var(--border);padding:1rem;min-width:0}.vna section{margin:1.8rem 0}.vna .vnbench section{margin:0}.vna h2{margin:.2rem 0 .6rem}.vna .buttons,.vna .links,.vna .controls{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem;margin:.65rem 0}.vna button,.vna input,.vna select{font:inherit;box-sizing:border-box;background:var(--panel);color:var(--text);border:1px solid var(--border);border-radius:2px;padding:.45rem .6rem;max-width:100%;min-width:0}.vna button{cursor:pointer;min-height:40px}.vna button:disabled{opacity:.5}.vna .run{background:#e3bf7e;color:#211b12;font-weight:bold}.vna form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem}.vna label{display:grid;gap:.2rem}.vna #vn-view{height:clamp(270px,38vw,445px);position:relative;background:#26343d;overflow:hidden}.vna #vn-view img,.vna #vn-view canvas{width:100%;height:100%;object-fit:contain;display:block}.vna #vn-view canvas{position:absolute;inset:0;touch-action:none}.vna #vn-graph{width:100%;height:auto;display:block}.vna .note,.vna figcaption,.vna #vn-model{font-size:.88rem}.vna .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.vna figure{margin:0}.vna figure img{width:100%;height:auto}.vna .scroll{overflow:auto}.vna table{width:100%;border-collapse:collapse}.vna td,.vna th{text-align:left;vertical-align:top;border-bottom:1px solid var(--border);padding:.44rem}.vna .links a{border:1px solid var(--border);padding:.35rem .55rem}.vna [data-error=true]{border-left:3px solid #bd5c34;padding-left:.6rem}.vna a{overflow-wrap:anywhere}@media(max-width:760px){.vna .vnbench,.vna .cards{grid-template-columns:1fr}.vna .vp{padding:.65rem}.vna input,.vna select{width:100%}.vna .scroll{max-width:100%}.vna .controls{align-items:flex-end}}
</style>
