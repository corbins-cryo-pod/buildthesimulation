@media(max-width:800px){#psu09 .p-grid{grid-template-columns:1fr}#p-model{height:330px}}@media(max-width:550px){#psu09 .p-refs{grid-template-columns:1fr}#p-model{height:270px}#psu09 section{padding:.65rem}#psu09 button{min-height:42px}}
