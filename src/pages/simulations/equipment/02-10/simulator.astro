em 0}.delta-table{overflow:auto}.delta table{width:100%;border-collapse:collapse;font-size:.85rem}.delta th,.delta td{padding:.45rem;border-bottom:1px solid var(--border);text-align:left}.delta details{margin-top:.65rem}.delta [hidden]{display:none!important}@media(max-width:850px){.delta-grid{grid-template-columns:minmax(0,1fr)}.delta-maps,.delta-refs{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.delta-panel{padding:.6rem}.delta-view{height:330px}.delta-maps,.delta-refs{grid-template-columns:minmax(0,1fr)}.delta-fields{grid-template-columns:repeat(2,minmax(0,1fr))}}
