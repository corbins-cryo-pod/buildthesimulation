const papers = [
  {id:'s1',year:'2012',authors:'Kato et al.',title:'Photosensitive-polyimide based method for fabricating various neural electrode architectures',url:'https://www.frontiersin.org/journals/neuroengineering/articles/10.3389/fneng.2012.00011/full',takeaway:'Shows how photosensitive polyimide and patterned metal / insulation support different electrode architectures. This motivates separate contact, interconnect and substrate geometry.'},
  {id:'s2',year:'2013',authors:'Sankar et al.',title:'A Highly Compliant Serpentine Shaped Polyimide Interconnect for Front-End Strain Relief in Chronic Neural Implants',url:'https://www.frontiersin.org/journals/neurology/articles/10.3389/fneur.2013.00124/full',takeaway:'Tests complete serpentine polyimide cables, not just a decorative bend in a metal trace. Compliance gains are specific to the tested dimensions and stack; the paper calls for in vivo validation.'},
  {id:'s3',year:'2024',authors:'Geramifard et al.',title:'Flexible and Extensible Ribbon-Cable Interconnects for Implantable Electrical Neural Interfaces',url:'https://pubmed.ncbi.nlm.nih.gov/39476818/',takeaway:'Photolithographic a-SiC / polyimide cables with Ti / Au metallization compare linear, serpentine and open-lattice structures. Cable architecture, bending and tensile extension require different evaluations.'},
  {id:'s4',year:'2020',authors:'Fan et al.',title:'Sputtered porous Pt for wafer-scale manufacture of low-impedance flexible microelectrodes',url:'https://pmc.ncbi.nlm.nih.gov/articles/PMC7880536/',takeaway:'Studies patterned contact shapes, including rings, alongside porous platinum. Surface texture and material change the electrochemical interface; outline alone cannot predict impedance.'},
  {id:'s5',year:'2014',authors:'Wang et al.',title:'Evaluation of High-Perimeter Electrode Designs for Deep Brain Stimulation',url:'https://pmc.ncbi.nlm.nih.gov/articles/PMC4198383/',takeaway:'Compares high-perimeter contact geometries using electrochemical measurements and stimulation modeling. Perimeter is a useful design variable, but it does not by itself establish stimulation performance.'},
  {id:'s6',year:'2026',authors:'Fan et al.',title:'High-channel-count neural recording and stimulation platform with 5376 simultaneous recording channels',url:'https://www.nature.com/articles/s44385-026-00103-8',takeaway:'Reports four metal routing layers with 1,344 channels per layer, minimum 2 µm metal linewidth and 2.5 µm spacing. This anchors the optional dense-process rule example, not a universal fabrication limit.'},
  {id:'s7',year:'2021',authors:'Della Valle et al.',title:'Impedance scaling for gold and platinum microelectrodes',url:'https://pmc.ncbi.nlm.nih.gov/articles/PMC8819721/',takeaway:'Demonstrates material-dependent scaling as microelectrode size changes. The designer reports geometric area and assumed trace resistance, rather than inferring electrode impedance from diameter.'},
