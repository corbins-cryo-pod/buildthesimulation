---
import Layout from '../../../layouts/Layout.astro';
---

<Layout pageTitle="Finger Pathway Atlas" compactHeader wide subtitle="" description="Explore a right index finger's sensory and motor pathways in 3D, from sensory endings through peripheral nerves, spinal cord, brainstem and cortex. Compare 50 source-attributed reference plates.">
  <section class="atlas-heading" aria-labelledby="atlas-title">
    <div><p class="edition">Anatomical edition · V3</p><h1 id="atlas-title">Finger Pathway Atlas</h1></div>
    <nav aria-label="Atlas pages">
      <a href="/simulations/finger-pathway-atlas/references/">Reference images · 50 plates</a>
      <button id="atlas-fullscreen" type="button">Full screen</button>
      <a href="/simulations/finger-pathway-atlas/viewer/">Open viewer</a>
    </nav>
  </section>
  <div class="viewer-shell" id="atlas-shell">
    <iframe id="atlas-frame" src="/simulations/finger-pathway-atlas/viewer/" title="Finger Pathway Atlas: interactive 3D anatomy" allow="fullscreen" allowfullscreen></iframe>
  </div>
  <section class="atlas-guide" aria-label="Quick start and scope">
    <div><h2>Follow one pathway</h2><p>Start with <strong>Follow touch</strong> or <strong>Follow motor</strong>. Choose a view to inspect the fingertip, nerve, ganglion, spinal circuit, medullary crossings, thalamus or cortex. Drag to orbit, scroll to zoom, and Shift-drag to pan.</p></div>
    <div><h2>Inspect and compare</h2><p>Open the Inspector to select cells and structures. Toggle tissue layers, sampling and detail; export GLB geometry, original human SWC traces or the evidence manifest. <a href="/simulations/finger-pathway-atlas/references/">Compare the model with published tissue images.</a></p></div>
    <p class="scope">An anatomical exploration: source anatomy and human neuron traces combined with constructed pathways and local tissue specimens. V3 has no electrical or biomechanics solver. Each reference plate identifies species, tissue, magnification limits and differences from the model.</p>
    <p class="download"><button id="atlas-offline" type="button">Download the original offline atlas (22 MB)</button> · Current desktop browsers with WebGL 2 are recommended.</p>
    <p id="offline-status" role="status"></p>
    <p id="fullscreen-status" role="status"></p>
  </section>
</Layout>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('#atlas-frame');
  const requested = new URLSearchParams(location.search).get('view');
  const views = ['overview','hand','arm','cervical','brain','tip','nerve','drg','spinal','medulla','thalamus','cortex','cell','nmj','proprio'];
  if (frame && requested && views.includes(requested)) frame.src += `#view=${requested}`;
  document.querySelector('#atlas-fullscreen')?.addEventListener('click', async () => {
    const shell = document.querySelector<HTMLElement>('#atlas-shell');
    const status = document.querySelector('#fullscreen-status');
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else if (shell?.requestFullscreen) await shell.requestFullscreen();
      else throw new Error('unavailable');
    } catch { if (status) status.textContent = 'Use Open viewer for a full-window view in this browser.'; }
  });
  const offline = document.querySelector<HTMLButtonElement>('#atlas-offline')!;
  offline.addEventListener('click', async () => {
    const status = document.querySelector('#offline-status')!;
    offline.disabled = true; status.textContent = 'Preparing the offline atlas…';
    try {
      const parts = await Promise.all([1,2,3].map(async part => {
        const response = await fetch(`/assets/finger-pathway-atlas/v3/Finger_Pathway_Atlas_v3.html.part-${part}.bin`);
        if (!response.ok) throw new Error('Download failed');
        return response.arrayBuffer();
      }));
      const url = URL.createObjectURL(new Blob(parts, {type:'text/html;charset=utf-8'}));
      const link = document.createElement('a');
      link.href = url; link.download = 'Finger_Pathway_Atlas_v3.html';
      document.body.appendChild(link); link.click(); link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
      status.textContent = 'Offline atlas downloaded. Open the HTML file in your browser.';
    } catch { status.textContent = 'The download could not finish. Try again.'; }
    finally { offline.disabled = false; }
  });
</script>

<style>
  .atlas-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:20px 0 14px}
  .edition{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin:0 0 7px}
  h1{font-size:clamp(30px,4vw,46px);font-weight:400;margin:0}
  .atlas-heading nav{display:flex;align-items:center;flex-wrap:wrap;gap:14px;font-size:13px}
  button{font:inherit;color:var(--text);border:1px solid var(--border);background:var(--panel);border-radius:8px;padding:8px 12px;cursor:pointer}
  .viewer-shell{height:clamp(680px,82vh,1050px);background:#050b11;border:1px solid var(--borderStrong);border-radius:10px;overflow:hidden}
  iframe{display:block;width:100%;height:100%;border:0}
  .viewer-shell:fullscreen{height:100vh;width:100vw;border:0;border-radius:0}
  .atlas-guide{display:grid;grid-template-columns:1fr 1fr;gap:8px 30px;margin:22px 0}
  h2{font-size:24px;font-weight:400;margin:0 0 8px}p{font-size:14px;line-height:1.65;margin:0 0 10px}
  .scope,.download,#fullscreen-status,#offline-status{grid-column:1/-1;color:var(--muted);font-size:12px}.scope{border-top:1px solid var(--border);padding-top:16px;margin-top:8px}
  @media(max-width:760px){.atlas-heading{align-items:start;flex-direction:column}.atlas-guide{grid-template-columns:1fr}.viewer-shell{height:78svh;min-height:570px}.atlas-heading nav{gap:12px;font-size:12px}}
</style>
