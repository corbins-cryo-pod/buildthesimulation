---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/equipment.css';
const labs = [
  {id:'01',name:'Utah Array',link:'/simulations/utah-array-fabrication/',kind:'Silicon geometry and isolation',desc:'Carry a 10 × 10 workpiece through modeled dicing, glass fill, shaping and inspection. The final routing is symbolic, not an electrical recording.'},
  {id:'02',name:'Neuropixels 1.0',link:'/simulations/neuropixels-foundry/',kind:'Active CMOS · Reference process',desc:'Use modeled lithography, deposition, polishing and etching, then see how a blocked via at a physical site changes synthetic AP and LFP recordings across bank selections.'},
  {id:'03',name:'Masmanidis 64D',link:'/simulations/masmanidis-64d-foundry/',kind:'Passive silicon · Open GDS',desc:'Inspect all 64 metal paths traced from UCLA’s 2017 reticle, follow the SOI-to-PCB flow, then compare open and nominal signal paths through the published pin mapping.'},
  {id:'04',name:'Flex-rigid ECoG',link:'/simulations/flex-rigid-ecog-foundry/',kind:'Flexible surface array · 124 recording sites',desc:'Follow a flexible electrode array from patterning to assembly. Open a single reference line and compare the effect on a 31-channel bank versus the shared-reference case.'},
  {id:'05',name:'Self-closing nerve cuff',link:'/simulations/self-closing-cuff-foundry/',kind:'Soft peripheral interface · Benchtop model',desc:'Build the modeled flexible stack, close it around an inert mandrel and compare free curvature, mechanical fit and channel continuity.'},
  {id:"06",name:"Stentrode research prototype",link:"/simulations/stentrode-foundry/",kind:"Endovascular scaffold · Inert fixture",desc:"Inspect a reconstructed eight-site scaffold and distinguish continuity and geometric seating on an inert test fixture. The trial product is a separate configuration."},
  {id:"07",name:"TIME-4H",link:"/simulations/time-4h-foundry/",kind:"Folded thin film · Ground topology",desc:"Walk a modeled flexible circuit through patterning and fold, then check two independent return nets and channel continuity on a benchtop fixture."},
  {id:"08",name:"Foundry tool fit",link:"/simulations/foundry/tool-fit/",kind:"Equipment compatibility · Conditional gates",desc:"Check specific size, resolution and process limits before assigning a register instrument. Candidate equipment does not establish process qualification."},
  {id:"09",name:"Neuropixels family bench",link:"/simulations/neuropixels-family/",kind:"Active CMOS · Capacity and routing",desc:"Compare documented shank, site and channel limits across variants and see how an ideal fault affects a synthetic signal. The tests do not reconstruct ASIC design."},
  {id:"10",name:"PtNRGrid",link:"/simulations/ptnrgrid-foundry/",kind:"Large-panel thin film · Pt–Ag dealloying",desc:"Compare array configurations, follow registered metal layers, and see which reconstructions need full-panel support, overlay evidence or outside processing."},
  {id:"11",name:"Four-mask mesh electronics",link:"/simulations/mesh-electronics-foundry/",kind:"SU-8 and Au · Flexible routing",desc:"Inspect four separate mask layers and compare reconstructed conductor paths against connector placement and continuity checks on an inert bench."},
  {id:"12",name:"Rolled microchannel scaffold",link:"/simulations/rolled-microchannels-foundry/",kind:"Passive microfluidics · Geometry and continuity",desc:"Compare the 84-lumen geometry with the separately instrumented 59-lumen configuration. Test blockage and wire continuity as independent observations."},
  {id:"13",name:"Photovoltaic retinal pixel",link:"/simulations/retinal-photovoltaic-foundry/",kind:"Published silicon predecessor · Device boundary",desc:"Follow the published silicon pixel process and test ideal photoelectric isolation. Compare PRIMA’s reported architecture without assuming its unpublished manufacturing process."},
  {id:"14",name:"Process handoff bench",link:"/simulations/foundry/process-handoff/",kind:"Manufacturing handoffs · Compatibility",desc:"Inspect why a candidate tool output does not automatically meet the next station’s conditions. Check documented mismatches separately from unknowns."},
  {id:"15",name:"NeuroGrid and OECT",link:"/simulations/neurogrid-oect-foundry/",kind:"Passive electrode vs active transistor",desc:"Separate the passive electrode stack from an organic-transistor route. Compare ideal impedance and transfer checks without mixing fixture conventions."},
  {id:"16",name:"Utah and Slant geometry",link:"/simulations/utah-slant-compare/",kind:"Bulk silicon · Cut geometry",desc:"Compare a flat array with a measured slant envelope and modeled length gradients. Inspect ideal dicing, isolation and continuity as separate checks."},
  {id:"17",name:"Transparent graphene stacks",link:"/simulations/graphene-stack-compare/",kind:"Transfer and direct-growth references",desc:"Compare distinct published transparent graphene routes and trace how layer identity changes the optical and electrical checks. Neither route is an INBRAIN replica."},
];
---
<Layout pageTitle="Device foundry" subtitle="" description="Explore interactive virtual fabrication workflows for silicon probes, flexible ECoG arrays and a self-closing peripheral cuff.">
  <article class="equipment eq-sheet foundry">
    <nav class="eq-nav" aria-label="Simulation resources"><a href="/simulations/foundry/atlas/">Manufacturing workflow atlas</a><a href="/simulations/equipment/">Equipment register</a><a href="/simulations/">All simulations</a></nav>
    <p class="eq-lede">Follow one virtual workpiece through fabrication, assembly and inspection. Choose Play in a lab or bench to watch its steps in order, or explore the process controls manually.</p>
    <section class="atlas-entry" aria-label="Manufacturing workflow atlas">
      <div><p class="eq-meta">Catalog coverage · Process routes · Tool compatibility</p><h2>Manufacturing workflow atlas</h2><p>Find a catalog device, compare fabrication configurations, and see which steps have a register match, need an outside facility, or are not publicly known. Play a selected workflow to step through it visually.</p></div>
      <a href="/simulations/foundry/atlas/">Open the Atlas →</a>
    </section>
    <ul class="lab-grid" aria-label="Foundry workspaces">{labs.map(l=><li><p class="eq-meta">{l.id} · {l.kind}</p><h2>{l.name}</h2><p>{l.desc}</p><a href={l.link} aria-label={'Open ' + l.name + ' lab'}>Open lab →</a></li>)}</ul>
    <p class="limits"><strong>Scope.</strong> These are teaching simulations. Each lab distinguishes published geometry and process information from modeled parameters, synthetic data, and fictional inspection thresholds. They are not operating instructions or calibrated manufacturing replicas.</p>
  </article>
</Layout>
<style>
  .atlas-entry { border:1px solid var(--border); padding:1.2rem; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem; }
  .atlas-entry h2 { margin:.1rem 0; } .atlas-entry p { max-width:65ch; margin:.25rem 0; }
  .lab-grid { list-style:none; margin:1.4rem 0 1.6rem; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .lab-grid li { border:1px solid var(--border); padding:1.1rem; background:var(--panel); display:flex; flex-direction:column; min-width:0; }
  .lab-grid h2 { margin:.1rem 0 .4rem; font-size:1.38rem; }
  .lab-grid a { margin-top:auto; text-underline-offset:.2rem; }
  .limits { max-width:75ch; padding-inline-start:1rem; border-inline-start:3px solid var(--border); }
  @media(max-width:820px){.lab-grid{grid-template-columns:1fr}}
</style>
