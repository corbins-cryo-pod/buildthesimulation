---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/equipment.css';
const labs = [
  {id:'01',name:'Utah Array',link:'/simulations/utah-array-fabrication/',kind:'Silicon geometry and isolation',desc:'Carry a 10 × 10 workpiece through modeled dicing, glass fill, shaping and inspection. The final routing is symbolic, not an electrical recording.'},
  {id:'02',name:'Neuropixels 1.0',link:'/simulations/neuropixels-foundry/',kind:'Active CMOS · Reference process',desc:'Use modeled lithography, deposition, polishing and etching, then see how a blocked via at a physical site changes synthetic AP and LFP recordings across bank selections.'},
  {id:'03',name:'Masmanidis 64D',link:'/simulations/masmanidis-64d-foundry/',kind:'Passive silicon · Open GDS',desc:'Inspect all 64 metal paths traced from UCLA’s 2017 reticle, follow the SOI-to-PCB flow, then compare open and nominal signal paths through the published pin mapping.'},
];
---
<Layout pageTitle="Device foundry" subtitle="" description="Explore interactive virtual fabrication workflows for the Utah Array, Neuropixels 1.0, and the Masmanidis 64D open-mask probe.">
  <article class="equipment eq-sheet foundry">
    <nav class="eq-nav" aria-label="Simulation resources"><a href="/simulations/equipment/">Equipment register</a><a href="/simulations/">All simulations</a></nav>
    <p class="eq-lede">Follow one virtual workpiece through fabrication, assembly and inspection. Change a process input, then see whether the geometry or electrical check changes downstream.</p>
    <ul class="lab-grid" aria-label="Foundry workspaces">{labs.map(l=><li><p class="eq-meta">{l.id} · {l.kind}</p><h2>{l.name}</h2><p>{l.desc}</p><a href={l.link} aria-label={'Open ' + l.name + ' lab'}>Open lab →</a></li>)}</ul>
    <p class="limits"><strong>Scope.</strong> These are teaching simulations. Each lab distinguishes published geometry and process information from modeled parameters, synthetic data, and fictional inspection thresholds. They are not operating instructions or calibrated manufacturing replicas.</p>
  </article>
</Layout>
<style>
  .lab-grid { list-style:none; margin:1.4rem 0 1.6rem; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .lab-grid li { border:1px solid var(--border); padding:1.1rem; background:var(--panel); display:flex; flex-direction:column; min-width:0; }
  .lab-grid h2 { margin:.1rem 0 .4rem; font-size:1.38rem; }
  .lab-grid a { margin-top:auto; text-underline-offset:.2rem; }
  .limits { max-width:75ch; padding-inline-start:1rem; border-inline-start:3px solid var(--border); }
  @media(max-width:820px){.lab-grid{grid-template-columns:1fr}}
</style>
