---
import Layout from '../../layouts/Layout.astro';
import { simulationGroups as groups } from '../../data/simulations.js';
---
<Layout pageTitle="Simulations" subtitle="" description="Explore neural-interface laboratories, cell electrophysiology, tissue mechanics and anatomical models.">
  <p class="manual-intro">Explore neural interfaces from membrane currents to complete anatomical pathways. The laboratories below are grouped by scale and purpose, with the principal interface and cortex tools first.</p>
  <div class="manual-index">
    {groups.map((group, index) => <section class="manual-group" aria-labelledby={`simulation-group-${index}`}>
      <header class="manual-group-heading"><span class="manual-group-number">{String(index + 1).padStart(2, '0')}</span><h2 id={`simulation-group-${index}`}>{group.title}</h2></header>
      <ol class="manual-entries">{group.entries.map((entry, item) => <li class="manual-entry">
        <span class="manual-entry-number" aria-hidden="true">{index + 1}.{item + 1}</span>
        <div><h3><a href={entry.href}>{entry.title}</a></h3><p>{entry.desc}</p></div>
      </li>)}</ol>
    </section>)}
  </div>
</Layout>
<style>
.manual-intro{max-width:84ch;font-size:19px;margin:20px 0 30px;line-height:1.4!important}
.manual-index{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 44px;position:relative;align-items:start}
.manual-index::before{content:'';position:absolute;top:0;bottom:0;left:50%;border-left:1px solid var(--border);opacity:.55}
.manual-group{min-width:0}
.manual-group-heading{display:flex;gap:12px;align-items:baseline;border-bottom:1px solid var(--border);padding-bottom:9px;margin-bottom:18px}
.manual-group-heading h2,.manual-group-number{font-family:'Twentieth Century',Arial,sans-serif!important;font-size:18px;font-weight:700;font-style:normal;text-transform:uppercase;letter-spacing:.065em!important;line-height:1.2!important;margin:0}
.manual-group-number{font-size:15px;color:var(--muted)}
.manual-entries{list-style:none;margin:0;padding:0;display:grid;gap:20px}
.manual-entry{display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px;margin:0;min-width:0}
.manual-entry-number{font-size:15px;color:var(--muted);padding-top:3px;font-variant-numeric:tabular-nums}
.manual-entry h3{font-family:var(--font-body)!important;font-size:21px;font-weight:700;font-style:normal;line-height:1.2!important;margin:0 0 6px;letter-spacing:-.015em!important}
.manual-entry a{color:inherit;text-decoration:none}.manual-entry a:hover{text-decoration:underline;text-underline-offset:4px}
.manual-entry p{font-size:17px;margin:0;line-height:1.4!important;opacity:.84;hyphens:auto}
@media(max-width:760px){.manual-index{grid-template-columns:1fr;gap:30px}.manual-index::before{display:none}.manual-intro{font-size:17px}.manual-group-heading h2{font-size:17px}}
</style>
