---
import Layout from '../../../layouts/Layout.astro';
import SimHero from '../../../components/SimHero.jsx';
import CorticalStimulationLab from '../../../components/CorticalStimulationLab.jsx';
import '../../../styles/cortical-stimulation.css';
---
<Layout pageTitle="Cortical Stimulation Laboratory" description="A finite-contact volume conductor and active multicompartment neuron simulation. Customize electrodes, materials, pulse waveforms and cortical anatomy; inspect fields, spikes and recruitment." wide={true} compactHeader={true}>
  <SimHero kicker="Neural interface laboratories / Cortical stimulation" title="Cortical Stimulation Laboratory" intro="Explore how electrode geometry, current steering and neural anatomy shape electrical recruitment." links={[{ href: '/simulations/cortical-stimulation/guide/', label: 'Methods & validation' }]} />
  <CorticalStimulationLab client:load />
  <noscript><p>This simulation needs JavaScript to solve the fields and membrane equations. The <a href="/simulations/cortical-stimulation/guide/">model guide and scientific sources</a> are available without it.</p></noscript>
</Layout>
