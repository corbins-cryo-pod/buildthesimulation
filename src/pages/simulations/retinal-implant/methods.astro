---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/retinal-implant.css';
import {Content} from '../../../../docs/retinal-implant/SCIENCE.md';
---
<Layout pageTitle="Retinal Implant: Models & Verification" description="Published percept equations, finite-contact field calculations, independent reference tests, sampling studies and scientific limits." wide={true} compactHeader={true}>
<article class="ri-lab ri-methods"><header class="ri-heading"><div><p class="ri-kicker">Retinal Implant Laboratory / retinal-1.0.0</p><h1>Models &amp;<br/>verification.</h1><p class="ri-intro">Equations, assumptions and independent numerical evidence.</p></div><div class="ri-heading-links"><a href="/simulations/retinal-implant/">Open the laboratory ↗</a><a href="https://github.com/corbins-cryo-pod/buildthesimulation/tree/main/docs/retinal-implant">Scientific documentation ↗</a></div></header><nav aria-label="Methods sections"><a href="#scientific-scope">Scope</a><a href="#published-percept-models">Percepts</a><a href="#electrical-field">Electrical field</a><a href="#delivery">Delivery</a><a href="#measurements">Measurements</a><a href="#verification">Verification</a></nav><div class="ri-method-body"><Content/></div><footer><a href="/simulations/retinal-implant/">← Return to the laboratory</a></footer></article>
</Layout>
<style>
.ri-methods{max-width:1080px;padding-bottom:48px}.ri-methods nav{display:flex;flex-wrap:wrap;gap:12px 24px;padding:20px 0;border-bottom:1px solid var(--ri-rule);font-family:var(--ri-tech);font-size:12px}.ri-method-body :global(h2){font-size:34px!important;padding-top:38px!important;margin:24px 0!important;border-top:1px solid var(--ri-rule);scroll-margin-top:25px}.ri-method-body :global(h3){font-size:23px!important;margin:28px 0 14px!important}.ri-method-body :global(p),.ri-method-body :global(li){font-size:16px!important;line-height:1.6!important;letter-spacing:0!important}.ri-method-body :global(p){max-width:92ch}.ri-method-body :global(pre){padding:20px;background:var(--ri-panel);border:1px solid var(--ri-rule);overflow:auto;font-size:13px;line-height:1.8!important}.ri-method-body :global(code){letter-spacing:0!important;line-height:1.8!important}.ri-method-body :global(table){width:100%;border-collapse:collapse;display:block;overflow-x:auto;margin:24px 0}.ri-method-body :global(th),.ri-method-body :global(td){border:1px solid var(--ri-rule);padding:14px 16px;text-align:left;vertical-align:top;font-size:14px!important;line-height:1.55!important;letter-spacing:0!important}.ri-method-body :global(th){font-family:var(--ri-tech)!important;background:var(--ri-panel);font-size:12px!important}.ri-methods footer{border-top:1px solid var(--ri-rule);padding-top:25px;margin-top:40px}@media(max-width:700px){.ri-method-body :global(h2){font-size:29px!important}.ri-method-body :global(pre){font-size:11px!important}}
</style>
