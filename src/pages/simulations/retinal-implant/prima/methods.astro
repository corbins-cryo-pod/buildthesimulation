---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/retinal-implant.css';
import { Content } from '../../../../../docs/prima/SCIENCE.md';
---
<Layout pageTitle="PRIMA: Models and Verification" description="Published PRIMA evidence, ProViSim reference reproduction, reduced photovoltaic circuit and half-space field equations, validation and model limits." wide={true} compactHeader={true}>
  <article class="ri-lab prima-methods">
    <header class="ri-heading"><div><p class="ri-kicker">Retinal Implant Laboratory / PRIMA / prima-1.0.0</p><h1>Models &amp;<br/>verification.</h1><p class="ri-intro">The calculations, evidence and assumptions behind each view.</p></div><div class="ri-heading-links"><a href="/simulations/retinal-implant/?technology=photovoltaic">Open PRIMA in the Retina Laboratory ↗</a><a href="/devices/177-science-prima-subretinal-photovoltaic-implant/">Published device reference ↗</a><a href="https://github.com/corbins-cryo-pod/buildthesimulation/tree/main/docs/prima">Source and numerical reports ↗</a></div></header>
    <nav aria-label="PRIMA methods sections"><a href="#scientific-scope">Scope</a><a href="#optical-input-and-geometry">Optics &amp; geometry</a><a href="#photovoltaic-circuit-and-electrical-field">Device physics</a><a href="#percept-approximation">Perception</a><a href="#verification">Verification</a><a href="#references">References</a></nav>
    <div class="prima-method-body"><Content /></div>
    <footer><a href="/simulations/retinal-implant/?technology=photovoltaic">← Return to PRIMA</a><a href="/simulations/retinal-implant/methods/">Unified methods →</a></footer>
  </article>
</Layout>
<style>
.prima-method-body :global(h1){display:none}
.prima-methods{max-width:1080px;padding-bottom:48px}.prima-methods nav{display:flex;flex-wrap:wrap;gap:12px 24px;padding:20px 0;border-bottom:1px solid var(--ri-rule);font-family:var(--ri-tech);font-size:12px}.prima-method-body :global(h2){font-size:32px!important;padding-top:30px!important;margin:24px 0!important;border-top:1px solid var(--ri-rule);scroll-margin-top:25px}.prima-method-body :global(h3){font-size:23px!important;margin:28px 0 14px!important}.prima-method-body :global(p),.prima-method-body :global(li){font-size:16px!important;line-height:1.55!important;letter-spacing:0!important}.prima-method-body :global(p){max-width:92ch}.prima-method-body :global(pre){padding:20px;background:var(--ri-panel);border:1px solid var(--ri-rule);overflow:auto;font-size:13px;line-height:1.8!important}.prima-method-body :global(code){letter-spacing:0!important;line-height:1.8!important}.prima-method-body :global(table){width:100%;border-collapse:collapse;display:block;overflow-x:auto;margin:24px 0}.prima-method-body :global(th),.prima-method-body :global(td){border:1px solid var(--ri-rule);padding:12px 16px;text-align:left;vertical-align:top;font-size:14px!important;line-height:1.5!important;letter-spacing:0!important}.prima-method-body :global(th){font-family:var(--ri-tech)!important;background:var(--ri-panel);font-size:12px!important}.prima-methods footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;border-top:1px solid var(--ri-rule);padding-top:25px;margin-top:40px}@media(max-width:700px){.prima-method-body :global(h2){font-size:27px!important}.prima-method-body :global(pre){font-size:11px!important}}
</style>

