import Layout from '../../../layouts/Layout.astro';
import { MODEL_VERSION, PHYSICAL_BASELINES, DEFAULT_CONFIG, PRESETS } from '../../../lib/cell-growth/engine.js';
import verification from '../../../data/cell-growth-validation.json';
import mechanicsVerification from '../../../data/cell-growth-mechanics-validation.json';
const number = (value, digits=3) => Number(value).toFixed(digits);
const baseline = PHYSICAL_BASELINES;
const organoidSegmentBudget = PRESETS.find(preset=>preset.id==='organoid')?.config.maxSegments ?? DEFAULT_CONFIG.maxSegments;
const biohybridSegmentBudget = PRESETS.find(preset=>preset.id==='biohybrid')?.config.maxSegments ?? DEFAULT_CONFIG.maxSegments;

const references = [
  {id:'motility',author:'Vargas et al. · 2020',title:'Modeling of Mechanosensing Mechanisms Reveals Distinct Cell Migration Modes to Emerge From Combinations of Substrate Stiffness and Adhesion Receptor–Ligand Affinity',url:'https://www.frontiersin.org/journals/bioengineering-and-biotechnology/articles/10.3389/fbioe.2020.00459/full',doi:'10.3389/fbioe.2020.00459',scope:'Triangulated cortex mechanics, balanced internal protrusion and adhesion turnover motivate this architecture. The lab uses its own reduced equations and exploratory coefficients, not a reproduction of this paper.'},
  {id:'traction-measurements',author:'Koch et al. · 2012',title:'Strength in the periphery: growth cone biomechanics and substrate rigidity response in peripheral and central nervous system neurons',url:'https://pubmed.ncbi.nlm.nih.gov/22325267/',doi:'10.1016/j.bpj.2011.12.025',scope:'Reported hippocampal and DRG forces and actin speeds depend on preparation and substrate. They provide order-of-magnitude context, not a fit for the generic cells in this laboratory.'},
  {id:'clutch', author:'Pulido Cifuentes et al. · 2024', title:'A modified motor-clutch model reveals that neuronal growth cones respond faster to soft substrates', url:'https://pmc.ncbi.nlm.nih.gov/articles/PMC11064671/', doi:'10.1091/mbc.E23-09-0364', scope:'An experimentally constrained Aplysia motor-clutch model supports coupling between adhesion, traction and retrograde flow. Its parameter fit and effective substrate stiffness are specific to that preparation.'},
  {id:'membrane', author:'Craig et al. · 2012', title:'Membrane tension, myosin force, and actin turnover maintain actin treadmill in the nerve growth cone', url:'https://pubmed.ncbi.nlm.nih.gov/22500750/', doi:'10.1016/j.bpj.2012.03.003', scope:'Aplysia measurements and modeling link membrane tension, myosin contraction and actin turnover. This motivates coupled mechanics, not a universal membrane-tension constant.'},
  {id:'polarity', author:'Witte, Neukirchen & Bradke · 2008', title:'Microtubule stabilization specifies initial neuronal polarization', url:'https://pmc.ncbi.nlm.nih.gov/articles/PMC2234250/', doi:'10.1083/jcb.200707042', scope:'Cultured rodent hippocampal neurons support a role for local microtubule stabilization in axon specification. A developmental state rule is a reduction of these mechanisms.'},
  {id:'dendrites', author:'Ferreira Castro et al. · 2020', title:'Achieving functional neuronal dendrite structure through sequential stochastic growth and retraction', url:'https://elifesciences.org/articles/60920', doi:'10.7554/eLife.60920', scope:'Time-lapse imaging and modeling of a Drosophila sensory neuron support growth and retraction as distinct contributors to arbor formation. This does not supply a human cortical branching-rate fit.'},
  {id:'self-avoidance', author:'Lefebvre et al. · 2012', title:'Protocadherins mediate dendritic self-avoidance in the mammalian nervous system', url:'https://www.nature.com/articles/nature11305', doi:'10.1038/nature11305', scope:'Mouse retinal starburst amacrine and cerebellar Purkinje cells provide evidence for molecular self/non-self recognition. Self-avoidance and avoidance of other neurons are different rules.'},
  {id:'three-d', author:'Santos et al. · 2020', title:'Axon growth of CNS neurons in three dimensions is amoeboid and independent of adhesions', url:'https://pubmed.ncbi.nlm.nih.gov/32698008/', doi:'10.1016/j.celrep.2020.107907', scope:'CNS axons extended in adhesion-inert 3D matrices. This establishes that mechanisms inferred from adhesive 2D plates cannot simply be assumed to apply to every 3D environment.'},
  {id:'collision', author:'Franze et al. · 2009', title:'Neurite branch retraction is caused by a threshold-dependent mechanical impact', url:'https://pubmed.ncbi.nlm.nih.gov/19804718/', doi:'10.1016/j.bpj.2009.07.033', scope:'Mechanical loading can evoke calcium entry, growth-cone collapse and retraction. Contact responses depend on the assay; the lab does not apply its measured stress threshold universally.'},
  {id:'branching', author:'Dent & Kalil · 2001', title:'Axon branching requires interactions between dynamic microtubules and actin filaments', url:'https://pubmed.ncbi.nlm.nih.gov/11739584/', doi:'10.1523/JNEUROSCI.21-24-09757.2001', scope:'Cortical-neuron imaging and perturbation distinguish cytoskeletal requirements for branching from those for elongation. A branch-rate control is not interchangeable with an extension-speed control.'},
  {id:'human', author:'Ohara et al. · 2015', title:'Early-stage development of human induced pluripotent stem cell-derived neurons', url:'https://pubmed.ncbi.nlm.nih.gov/26346430/', doi:'10.1002/jnr.23666', scope:'Early human iPSC-derived neuronal polarization resembled the compared rat culture stages, while axons grew more slowly. Species, preparation and developmental clocks must remain explicit.'},
  {id:'connections', author:'Barker et al. · 2008', title:'Developmental control of synaptic receptivity', url:'https://pmc.ncbi.nlm.nih.gov/articles/PMC2566963/', doi:'10.1523/JNEUROSCI.1744-08.2008', scope:'Developing retinal ganglion cells acquire synaptic receptivity through maturation and cell interactions. Dendrite growth and geometric contact alone do not establish functional synaptic transmission.'},
];

const evidence = [
  ['Mechanism supported by experiments','Actin–adhesion coupling; microtubule-dependent polarity; membrane tension; recognition-dependent contact responses.','The experiments motivate a mechanism; their cell type and conditions still matter.'],
  ['Mathematical model assumption','Effective force laws, reduced state variables, growth and branching rules, geometry and boundary conditions.','An implemented relation that can be inspected and tested, not a measurement.'],
  ['Exploratory parameter','The default mechanical coefficients, source strength, developmental clock and contact delay.','Chosen to produce an inspectable experiment; not fitted to a particular human cell line.'],
  ['Numerical verification','Geometry, reproducibility, state consistency and refinement checks.','Evidence that the implementation solves its specified model within tested conditions.'],
  ['Future empirical calibration','Agreement with held-out time-lapse, force, morphology and contact-response data.','Required before claiming quantitative prediction of a culture or implant.'],
];

const contexts = [
  ['In vitro plate','A surface-constrained population with explicit substrate interactions and finite obstacles.','Study polarity, dendritic exploration, axon alignment and obstacle encounters.','No medium chemistry, dish-wide diffusion, coating-specific binding kinetics or culture protocol is inferred.'],
  ['Organoid volume','Cells and neurites occupy a three-dimensional bounded volume.','Study crowding, three-dimensional contact and the sensitivity of growth to the modeled microenvironment.','This is not a full organoid: no cortical layers, ventricular zones, vascularization, cell-fate patterning or tissue folding emerge from this release.'],
  ['Nerve regeneration','A bounded guidance environment for growing processes.','Compare trajectories, obstruction, alignment, branching and reaching the far side of a gap.','Crossing a simulated gap does not establish target reinnervation, muscle recovery, scar remodeling or a clinical regeneration rate.'],
  ['Biohybrid interface','Living processes grow around a defined scaffold/interface geometry.','Inspect contact, directionality and geometric integration.','A neurite beside a device is not an electrode seal, recording channel, functional living electrode or chronic integration result.'],
];
