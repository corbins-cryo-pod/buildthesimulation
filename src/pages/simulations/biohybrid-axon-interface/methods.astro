const format=n=>n==null?'—':typeof n==='boolean'?String(n):typeof n==='number'?(n!==0&&Math.abs(n)<.0001?n.toExponential(6):n.toLocaleString('en-US',{maximumFractionDigits:8})):typeof n==='object'?JSON.stringify(n):String(n);
const parameterGroups=[
 {title:'Stage 1 physical and numerical controls',rows:STAGE1_PARAMETER_REGISTER},
 {title:'Fixed architecture and comparator assumptions',rows:STAGE1_ENUM_REGISTER.map(p=>({...p,units:'declared condition'}))},
