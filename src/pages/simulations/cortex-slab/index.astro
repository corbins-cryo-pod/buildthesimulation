---
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/sim-lab.css";
---

<Layout
  pageTitle="Cortical recording lab"
  subtitle="Compare electrode positions and explore how geometry and noise shape synthetic recordings."
  description="Interactive 3D cortex slab sandbox with a single movable electrode, spike raster, and trace output."
>
  <div class="lab-app">
  <div class="lab-toolbar"><div class="lab-presets"><span class="lab-kicker">EXPERIMENT</span><button data-cortex-preset="single">Single contact</button><button data-cortex-preset="depth">Depth probe</button><button data-cortex-preset="grid">2 × 2 array</button></div><div><button id="cortexReset">Restart recording</button><button id="cortexExport">Export raw CSV</button></div></div>
  <p id="webglError" role="alert" hidden>3D rendering could not start. Enable WebGL or try another browser.</p>
  <section class="simShell">
    <aside class="panel" aria-label="Controls">
      <div class="panelSection">
        <div class="panelTitle">Run</div>
        <label class="lab">
          <span style="display:flex;align-items:center;gap:10px;">
            <input id="paused" type="checkbox" />
            Pause
          </span>
        </label>

        <label class="lab">
          Speed
          <div class="rangeRow">
            <input id="speed" type="range" min="0.25" max="2" step="0.05" value="1" />
            <div class="rangeMeta">
              <span class="muted">0.25× to 2×</span>
              <span id="speedLabel" class="muted">1.00×</span>
            </div>
          </div>
        </label>
      </div>

      <div class="panelSection">
        <div class="panelTitle">Electrodes · up to 6</div>
        <p id="elecMeta" class="muted" style="margin:0 0 10px;">1 electrode · selected E1</p>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;">
          <button id="elecAdd" type="button">Add point</button>
          <button id="elecRemove" type="button">Remove point</button>
          <button id="elecPrev" type="button">Prev</button>
          <button id="elecNext" type="button">Next</button>
        </div>

        <label class="lab">
          X
          <input id="elecX" type="number" min="-1000" max="1000" step="10" value="0" />
          <input id="elecXRange" type="range" min="-1000" max="1000" step="10" value="0" />
        </label>

        <label class="lab">
          Y
          <input id="elecY" type="number" min="-1000" max="1000" step="10" value="0" />
          <input id="elecYRange" type="range" min="-1000" max="1000" step="10" value="0" />
        </label>

        <label class="lab">
          Z / depth
          <input id="elecZ" type="number" min="50" max="1450" step="10" value="900" />
          <input id="elecZRange" type="range" min="50" max="1450" step="10" value="900" />
        </label>
      </div>

      <div class="panelSection">
        <div class="panelTitle">3D view</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
          <button id="viewReset" type="button">Reset view</button>
          <button id="viewTop" type="button">Top view</button>
          <button id="viewSide" type="button" style="grid-column:1 / -1;">Side view</button>
        </div>
        <p class="muted" style="margin-top:10px;margin-bottom:0;">Left-drag rotate, right-drag pan, wheel zoom. Click slab to move selected point (hold Shift to also set depth).</p>
      </div>

      <div class="panelSection">
        <div class="panelTitle">Signal</div>
        <label class="lab">Noise drive <output id="noiseLabel">1.2 µV</output><input id="noiseUv" type="range" min="0" max="6" step="0.1" value="1.2" /></label>

        <div class="panelTitle" style="margin-top:12px;">Trace controls</div>
        <label class="lab">
          <span style="display:flex;align-items:center;gap:10px;">
            <input id="spikeBandOn" type="checkbox" />
            Spike-band filter (display)
          </span>
        </label>

        <label class="lab">
          Trace reference line (µV)
          <input id="thrUv" type="number" min="-120" max="-2" step="1" value="-9" />
        </label>

        <label class="lab">
          Gain scale
          <div class="rangeRow">
            <input id="traceGain" type="range" min="0.5" max="8" step="0.1" value="2" />
            <div class="rangeMeta">
              <span class="muted">0.5× to 8×</span>
              <span id="traceGainLabel" class="muted">2.00×</span>
            </div>
          </div>
        </label>

        <div class="panelTitle" style="margin-top:12px;">Network dynamics</div>
        <label class="lab">
          Burstiness
          <div class="rangeRow">
            <input id="burstSeedProb" type="range" min="0" max="0.35" step="0.01" value="0.08" />
            <div class="rangeMeta">
              <span class="muted">0 to 0.35</span>
              <span id="burstSeedProbLabel" class="muted">0.040</span>
            </div>
          </div>
        </label>

        <label class="lab">
          Recruitment radius (µm)
          <div class="rangeRow">
            <input id="recruitRadiusUm" type="range" min="80" max="360" step="10" value="180" />
            <div class="rangeMeta">
              <span class="muted">80 to 360</span>
              <span id="recruitRadiusUmLabel" class="muted">180 µm</span>
            </div>
          </div>
        </label>

        <label class="lab">
          Global modulation strength
          <div class="rangeRow">
            <input id="modStrength" type="range" min="0" max="3" step="0.05" value="1.3" />
            <div class="rangeMeta">
              <span class="muted">0 to 3</span>
              <span id="modStrengthLabel" class="muted">1.30</span>
            </div>
          </div>
        </label>
      </div>
    </aside>

    <div>
      <div class="lab-metrics"><div><span>Simulated time</span><strong id="cortexTime">0.0 s</strong></div><div><span>Selected trace RMS · 2 s</span><strong id="cortexRms">0 µV</strong></div><div><span>Selected units seen · 2 s</span><strong id="cortexUnits">0</strong></div></div>
    <main class="stage" aria-label="Simulation canvas">
      <div class="stageBar">
        <div class="stageTitle">Cortex slab</div>
        <div class="stageHint">1,600 synthetic neurons · 8 kHz sampling</div>
      </div>

      <div class="stageBody">
        <canvas id="cortex3d" class="c3d"></canvas>

        <div class="miniRow">
          <section class="mini">
            <div class="miniBar">
              <div class="miniTitle">Spike raster</div>
              <div class="miniHint">source events ≥ 6 µV expected peak · selected contact</div>
            </div>
            <canvas id="raster" width="980" height="150"></canvas>
          </section>
        </div>

        <div class="miniRow">
          <section class="mini">
            <div class="miniBar">
              <div class="miniTitle">Electrode traces</div>
              <div class="miniHint">one panel per electrode · 2 s window</div>
            </div>
            <canvas id="traces" width="980" height="220"></canvas>
          </section>
        </div>
      </div>
    </main>
    </div>
  </section>
  <details class="lab-method"><summary>How to read the recordings</summary><p>Teal flashes mark synthetic neuron events. Each electrode sums distance-weighted spike waveforms plus correlated noise. The raster shows source events whose expected isolated peak reaches 6 µV at the selected contact; it is not a spike sorter or a threshold detector on the noisy trace. The dashed trace reference line is a visual guide only.</p><p>Presets restart the same seeded neural population. Moving, adding, or removing contacts clears recordings to avoid mixing geometries. Pause to inspect a two-second window; export saves the unfiltered synthetic samples for all contacts. The display filter and gain do not change the exported data.</p><p>This illustrative model is not calibrated to real tissue. It omits membrane biophysics, electrode impedance, layered conductivity, and a physical reference electrode. Values labeled µV are synthetic signal units. <a href="/simulations/cortex-slab/guide/">Recording guide →</a></p></details>
  </div>

  <script type="module" src="/scripts/cortex-v2/main.js"></script>
</Layout>

<style>
  .simShell { margin-top: 14px; display: grid; grid-template-columns: 320px 1fr; gap: 12px; align-items: start; }
  .panel { padding: 16px; border-radius: 16px; border: 1px solid var(--border); background: var(--panel); }
  .panelSection + .panelSection { margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--border); }
  .panelTitle { font-weight: 400; margin-bottom: 10px; }
  .lab { display: block; font-size: 0.95em; line-height: 1.4; margin: 0 0 12px; }
  .lab input[type="number"] { width: 100%; margin: 4px 0 6px; padding: 6px 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--panelStrong); color: var(--text); }
  .rangeRow { margin-top: 6px; }
  .rangeMeta { margin-top: 6px; display: flex; justify-content: space-between; gap: 10px; font-size: 0.88em; }
  .muted { opacity: 0.72; }
  .stage { border-radius: 16px; border: 1px solid var(--border); background: var(--panel); overflow: hidden; }
  .stageBar { display: flex; justify-content: space-between; align-items: baseline; padding: 12px 14px; border-bottom: 1px solid var(--border); }
  .stageTitle { font-weight: 400; }
  .stageHint { opacity: 0.68; font-size: 0.95em; }
  .stageBody { padding: 12px; }
  .c3d { width: 100%; height: 460px; display: block; border-radius: 12px; border: 1px solid var(--border); background: rgba(255,255,255,0.04); }
  .miniRow { margin-top: 12px; }
  .mini { border-radius: 12px; border: 1px solid var(--border); overflow: hidden; background: rgba(255,255,255,0.03); }
  .miniBar { display: flex; justify-content: space-between; align-items: baseline; padding: 10px 12px; border-bottom: 1px solid var(--border); }
  .miniTitle { font-weight: 400; }
  .miniHint { opacity: 0.65; font-size: 0.92em; }
  canvas { width: 100%; display: block; }
  .card { padding: 22px 22px; border-radius: 16px; border: 1px solid var(--border); background: var(--panel); }
  @media (max-width: 980px) { .simShell { grid-template-columns: 1fr; } .c3d { height: 420px; } }
</style>

<style>
.lab-app .panel,.lab-app .stage{background:var(--panel);border-color:var(--border)}.lab-app .panel{padding:14px}.lab-app .panelTitle{font:400 26px/1.2 var(--font-heading)}.lab-app .lab{font:16px/1.5 var(--font-body)}.lab-app .lab input[type=number]{background:var(--panelStrong);color:var(--text)}.lab-app .muted{color:var(--muted);opacity:1;font-size:12px}.lab-app .stageHint,.lab-app .miniHint{font-size:12px}.lab-app .simShell{grid-template-columns:255px minmax(0,1fr)}.lab-app .simShell>div{min-width:0}.lab-app .c3d{height:430px}.lab-app .panel button{font-size:13px}.lab-app .stageTitle,.lab-app .miniTitle{font:400 26px/1.2 var(--font-heading)}@media(max-width:980px){.lab-app .simShell{grid-template-columns:1fr}.lab-app .simShell>div{grid-row:1}.lab-app .panel{display:grid;grid-template-columns:1fr 1fr;gap:15px}.lab-app .panelSection+.panelSection{margin:0;padding:0;border:0}}@media(max-width:550px){.lab-app .panel{grid-template-columns:1fr}.lab-app .c3d{height:320px}.lab-app .stageBar,.lab-app .miniBar{flex-wrap:wrap;gap:5px}}
</style>
