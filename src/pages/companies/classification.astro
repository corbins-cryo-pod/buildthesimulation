---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { classifyOrganization, compareOrganizations, stageLabels, regulatoryLabels } from '../../lib/organization-classification.js';
import { cleanCompanyTitle } from '../../lib/company-briefs.js';
import ProgramClassification from '../../components/ProgramClassification.jsx';
const companies = (await getCollection('companies')).filter(entry => !entry.data.draft).sort(compareOrganizations);
const classified = companies.map(entry => ({entry, classification: classifyOrganization(entry)}));
const stages = [0, 1, 2, 3, 4];
---
<Layout pageTitle="The Atlas code" description="Company or lab, development stage and regulatory status in three characters. Read the classification and sources for every organization in the BCI Atlas." compactHeader>
  <article class="classification-guide">
    <a class="guide-back" href="/companies/">← BCI Atlas</a>
    <header><p class="guide-eyebrow">Company / Lab · Stage · Status</p><h1>Three characters.<br />A clearer landscape.</h1><p>A compact classification of a named device or research program. Read the organization, its demonstrated stage and its regulatory status at a glance.</p></header>
    <div class="guide-example"><span class="org-code" data-status="R">L2R</span><p><i>L</i> Lab · <i>2</i> Animal studies · <i>R</i> Research</p><span class="org-code" data-status="K">C4K</span><p><i>C</i> Company · <i>4</i> Clinical product · <i>K</i> Cleared</p></div>
    <section aria-labelledby="stage-key"><h2 id="stage-key">Stage 0–4</h2><div class="guide-stages">{stages.map(stage => <a href={`/companies/?stage=${stage}`}><span>{stage}</span><h3>{stageLabels[stage]}</h3><p>{['A described concept; no working demonstration established.', 'A working bench, in-vitro or ex-vivo demonstration.', 'An in-vivo animal study of the specified interface.', 'A human study, including acute or investigational use.', 'A clinical product with documented marketing authorization.'][stage]}</p></a>)}</div></section>
    <section aria-labelledby="status-key"><h2 id="status-key">R / A / K</h2><dl class="guide-statuses"><div><dt>R <i>Research</i></dt><dd>A research or investigational program. Commercial animal-research tools can remain R.</dd></div><div><dt>A <i>Regulatory approved</i></dt><dd>Documented clinical marketing authorization, regardless of country. Details identify the regulator and pathway, including FDA PMA, HDE or De Novo, biologics approval, European CE marking or Chinese NMPA approval.</dd></div><div><dt>K <i>Cleared</i></dt><dd>A documented clearance, such as FDA 510(k). This remains distinct from approval.</dd></div></dl><p class="guide-note">“A” is this site's compact umbrella for marketing authorization. The exact legal pathway stays visible in the source details. FDA humanitarian approval, De Novo authorization and CE marking are not described as FDA PMA approval.</p></section>
    <section class="guide-reading"><h2>Reading the landscape</h2><p>The directory is alphabetical by name. Choose “Most advanced first” to order by the highest documented stage among an organization's current cataloged programs, or “Earliest research first” to explore emerging interfaces, or filter by stage, technology and status. Stage and status filters must match the same program; the displayed badge follows that match.</p><p>A question mark means the evidence has not been classified, rather than Stage 0. Funding and headcount do not change a badge. Research-tool sales, patents, trial permission and Breakthrough designation do not make a Stage 4 product.</p><p>Human studies include brief intraoperative tests, healthy-volunteer experiments and chronic implant trials; they are not equivalent evidence. Open the program details for that distinction. Authorized use is specific to a device, model and indication. A component's authorization does not authorize an entire BCI system.</p><p>Historical products are labeled. An active research program takes priority over a discontinued product; authorization history does not establish present availability.</p></section>
    <section aria-labelledby="catalog-codes"><div class="guide-index-heading"><h2 id="catalog-codes">Every organization, classified</h2><p>{classified.length} organizations · {classified.reduce((count, row) => count + row.classification.programs.length, 0)} named program records</p></div><div class="guide-table-wrap"><table><thead><tr><th scope="col">Organization</th><th scope="col">Named program</th><th scope="col">Code &amp; evidence</th></tr></thead><tbody>{classified.map(({entry, classification}) => <tr><th scope="row"><a href={`/companies/${entry.slug}/`}>{cleanCompanyTitle(entry.data.title)}</a><small>{entry.data.kind}{entry.data.location ? ` · ${entry.data.location}` : ''}</small></th><td>{classification.primary.name}{classification.primary.historical && <small>Historical / discontinued</small>}</td><td><ProgramClassification classification={classification} /></td></tr>)}</tbody></table></div></section>
    <footer><p>Classifications are grounded in the linked catalog evidence and authorization sources. They describe development stage, not technical superiority, clinical benefit, safety ranking or neuron-level precision.</p><a href="/companies/">Explore the Atlas →</a></footer>
  </article>
</Layout>
<style>
  .classification-guide { padding: 28px 0; --brief-accent: var(--text); --brief-rule: var(--border); }
  .guide-back, .guide-eyebrow { font-size: 17px; font-style: italic; }
  .classification-guide header { border-block: 1px solid var(--border); margin: 20px 0; padding: 25px 0; }
  .classification-guide h1 { font: 400 clamp(55px, 8vw, 100px)/.95 var(--font-heading); margin: 12px 0 20px; }
  .classification-guide header > p:last-child { font-size: 22px; line-height: 1.4; max-width: 65ch; font-style: italic; }
  .classification-guide h2 { font: 400 40px/1.05 var(--font-heading); margin: 0 0 20px; }
  .classification-guide section { padding: 26px 0; border-bottom: 1px solid var(--border); }
  .guide-example { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .guide-example p { margin: 0 25px 0 0; font-size: 18px; }
  .guide-stages { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; }
  .guide-stages a { color: inherit; text-decoration: none; padding: 15px 0; border-top: 1px solid var(--border); }
  .guide-stages a:hover h3 { text-decoration: underline; }
  .guide-stages span { font: italic 400 46px/1 var(--font-heading); }
  .guide-stages h3 { font: 400 28px/1.05 var(--font-heading); margin: 10px 0; }
  .guide-stages p { font-size: 16px; line-height: 1.4; margin: 0; }
  .guide-statuses { margin: 0; }
  .guide-statuses > div { display: grid; grid-template-columns: 235px 1fr; gap: 22px; padding: 16px 0; border-top: 1px solid var(--border); }
  .guide-statuses dt { font-size: 22px; }.guide-statuses dd { margin: 0; font-size: 18px; line-height: 1.45; }
  .guide-note, .classification-guide footer p { font-size: 16px; line-height: 1.45; color: var(--muted); }
  .guide-reading p { max-width: 90ch; font-size: 19px; line-height: 1.5; }
  .guide-index-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .guide-index-heading p { font-style: italic; color: var(--muted); }
  .guide-table-wrap { overflow-x: auto; }
  .guide-table-wrap table { width: 100%; border-collapse: collapse; }
  .guide-table-wrap th, .guide-table-wrap td { padding: 18px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); font-weight: 400; }
  .guide-table-wrap th:first-child { width: 28%; padding-left: 0; }.guide-table-wrap td:nth-child(2) { width: 29%; }
  .guide-table-wrap th > a { font: 400 29px/1.05 var(--font-heading); text-decoration: none; }
  .guide-table-wrap th > a:hover { text-decoration: underline; }
  .guide-table-wrap small { display: block; font-size: 14px; line-height: 1.35; font-style: italic; color: var(--muted); margin-top: 8px; }
  .guide-table-wrap :global(.org-classification) { margin: 0; padding-top: 0; border: 0; }
  .classification-guide footer { padding-top: 20px; }
  .classification-guide footer > a { font-size: 20px; font-style: italic; }
  @media(max-width: 760px) { .guide-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }.guide-statuses > div { grid-template-columns: 1fr; gap: 8px; }.guide-table-wrap table { min-width: 650px; }.guide-example p { flex: 1 1 70%; margin-right: 0; } }
</style>
