---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import CompanyBrief from "../../components/CompanyBrief.astro";
import { cleanCompanyTitle, getCompanyBrief, linkedDeviceSlugs } from "../../lib/company-briefs.js";

export async function getStaticPaths() {
  const posts = await getCollection("companies");
  return posts.filter((entry) => !entry.data.draft).map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const apps = (await getCollection("applications"))
  .filter((app) => !app.data.draft && app.data.orgs.includes(entry.slug))
  .sort((a, b) => a.data.order - b.data.order);
const allDevices = (await getCollection("designs")).filter((device) => !device.data.draft);
const deviceSlugs = [...new Set([...linkedDeviceSlugs(entry.body), ...apps.flatMap((app) => app.data.devices)])];
const devices = deviceSlugs.map((slug) => allDevices.find((device) => device.slug === slug)).filter(Boolean);
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const brief = getCompanyBrief(entry, remarkPluginFrontmatter.briefFormatting, headings, devices);
const title = cleanCompanyTitle(entry.data.title);
---

<Layout pageTitle={`${title} · ${entry.data.kind === "Lab" ? "Lab" : "Company"} brief`} description={entry.data.description} compactHeader wide>
  <div id="top-of-brief">
    <CompanyBrief entry={entry} brief={brief} headings={headings} apps={apps} devices={devices}><Content /></CompanyBrief>
  </div>
</Layout>
