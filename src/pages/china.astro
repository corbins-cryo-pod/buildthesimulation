---
import Layout from "../layouts/Layout.astro";
import { Content } from "../pages-content/china-overview.md";
---

<Layout pageTitle="BCI Atlas" subtitle="Invasive brain-computer interfaces in China: regulation, trials and companies, from Chinese primary sources." description="Regulatory timeline, ChiCTR trial table and company map for invasive brain-computer interface work in China, built from NMPA, NHSA, ChiCTR and company filings.">
  <article class="post">
    <header class="postHead">
      <div class="kicker">Overview — China</div>
      <h2 class="title">China invasive BCI overview</h2>
      <div class="meta verified">Last reviewed against Chinese primary sources: Oct 9, 2026</div>
    </header>
    <section class="content"><Content /></section>
  </article>
</Layout>

<style>
  .atlas-return { margin: 0 0 16px; font-size: 18px; font-style: italic; }
  .post {
    padding: 26px 26px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--panel);
    max-width: 860px;
  }

  :global(main.wrap) {
    display: flex;
    flex-direction: column;
  }

  :global(main.wrap) .post {
    align-self: center;
    width: 100%;
  }

  .kicker {
    opacity: 0.7;
    font-size: var(--text-kicker);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .title {
    margin: 6px 0 0;
    font-size: var(--title-post);
    letter-spacing: -0.005em;
    line-height: 1.15;
  }

  .siteLink {
    margin: 12px 0 0;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .siteBtn {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panelStrong);
    color: inherit;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .siteBtn:hover {
    border-color: var(--borderStrong);
    background: var(--panelHover);
    transform: translateY(-1px);
  }

  .siteLoc {
    opacity: 0.70;
    font-size: 13px;
  }

  .meta {
    margin-top: 8px;
    opacity: 0.72;
    font-size: var(--text-meta);
  }

  .content :global(p) {
    line-height: 1.55;
    margin: 0.95em 0;
  }

  .content :global(p:first-of-type) {
    font-size: 1.08em;
    line-height: 1.55;
  }

  .content :global(h2) {
    margin: 1.2em 0 0.2em;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: var(--title-section);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .content :global(h3) {
    margin: 1.0em 0 0.2em;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.12;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0.6em 0 0.9em;
    padding-left: 1.2em;
  }

  .content :global(li) {
    margin: 0.25em 0;
    line-height: 1.55;
  }

  .content :global(a) {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .appList {
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--panelStrong);
  }

  .appList h3 {
    margin: 0 0 6px;
    font-family: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.12;
  }

  .appList h3:not(:first-child) { margin-top: 12px; }
  .appList ul { margin: 0; padding-left: 1.1em; }
  .appList li { margin: 0.25em 0; }
  .appList a { color: inherit; }
</style>
<style is:global>
  .post .content table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin: 1rem 0; display: block; overflow-x: auto; }
  .post .content th, .post .content td { border: 1px solid rgba(128,128,128,0.35); padding: 0.4rem 0.55rem; vertical-align: top; text-align: left; }
  .post .content td a[href*="chictr"] { white-space: nowrap; }
</style>
