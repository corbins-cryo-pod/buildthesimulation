---
import Layout from '../../layouts/Layout.astro';
import RecordingLibrary from '../../components/recordings/RecordingLibrary.jsx';
import { recordingDatasets, existingRecordingIntegrations } from '../../data/recordings.js';
---
<Layout pageTitle="Recording Library" subtitle="Measured neural-interface data" description="Explore real Neuropixels, Utah-array, ECoG, peripheral nerve, RPNI and retinal recordings with documented sources and signal types.">
  <section class="recording-intro"><div class="recording-eyebrow">Data / Instruments / Observations</div><h2>From the electrode<br/><em>to the recording.</em></h2><p>Inspect measured signals and published study results from the interfaces in this atlas. Choose a dataset, explore its channels and time scales, and follow every excerpt back to its source.</p><p class="recording-principle">Each viewer identifies the recorded hardware, species, signal type and processing. Related laboratory experiments are marked explicitly. These observations remain fixed when simulation settings change.</p></section>
  <RecordingLibrary entries={recordingDatasets} client:load />
  <details class="recording-sources-index"><summary>All dataset sources &amp; licenses</summary><ul>{recordingDatasets.map(entry=><li><a href={entry.sourceUrl}>{entry.title}</a> · <a href={entry.licenseUrl}>{entry.license}</a></li>)}</ul></details>
  <section class="recording-existing" aria-labelledby="existing-recordings-title"><header><span>Existing integrations</span><h2 id="existing-recordings-title">Spikes, features &amp; decoding</h2></header><div>{existingRecordingIntegrations.map(entry=><article><p>{entry.signal}</p><h3><a href={entry.href}>{entry.title} →</a></h3><p>{entry.description}</p></article>)}</div></section>
</Layout>
<style>
.recording-sources-index{border-top:1px solid var(--border);padding-top:14px;font-size:16px;line-height:1.6}.recording-sources-index summary{cursor:pointer}.recording-sources-index a{color:inherit}.recording-intro{max-width:860px;margin:24px 0 32px}.recording-eyebrow,.recording-existing header>span{font-family:var(--font-label,Arial,sans-serif);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.recording-intro h2{font-family:var(--font-body)!important;font-size:clamp(34px,5vw,56px);font-weight:400;line-height:1.05!important;letter-spacing:-.035em!important;margin:14px 0 20px}.recording-intro p{font-size:19px;line-height:1.4;max-width:72ch}.recording-intro .recording-principle{font-size:15px;color:var(--muted);border-left:1px solid var(--border);padding-left:14px}.recording-existing{border-top:1px solid var(--border);padding-top:24px;margin:36px 0}.recording-existing h2{font-family:var(--font-body)!important;font-size:30px;font-weight:400;margin:8px 0 20px}.recording-existing>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.recording-existing article{border-top:1px solid var(--border);padding-top:10px}.recording-existing article p:first-child{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-family:var(--font-label,Arial,sans-serif)}.recording-existing h3{font-size:21px;font-family:var(--font-body)!important;margin:8px 0}.recording-existing article p{font-size:16px;line-height:1.45}.recording-existing a{color:inherit;text-decoration:none}.recording-existing a:hover{text-decoration:underline}@media(max-width:650px){.recording-existing>div{grid-template-columns:1fr}}
</style>
