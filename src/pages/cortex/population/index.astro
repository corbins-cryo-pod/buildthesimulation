    <a href="/cortex/">← Single-cell Cortex Laboratory</a> · <a href="/cortex/interface/">Neural Interface Laboratory</a>
  </nav>
  <CortexLaboratory populationEnabled={true} client:load />
  <noscript><p>Enable JavaScript to configure and calculate populations. <a href="/cortex/methods/">Read the equations, assumptions and scientific sources.</a></p></noscript>
</Layout>
