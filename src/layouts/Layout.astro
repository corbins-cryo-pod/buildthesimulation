---
import "../styles/site.css";
import NerveHero from "../components/NerveHero.astro";
import { getCollection } from "astro:content";
import { compareDeviceEntries } from "../lib/device-order.js";

const {
  pageTitle,
  subtitle,
  description =
    "A catalog of brain-computer interface companies, their work, and their technologies, with device briefs and interactive simulations.",
  withHero = false,
  wide = false,
} = Astro.props;

const siteTitle = "Build the Simulation";
const fullTitle = pageTitle ? `${pageTitle} | ${siteTitle}` : siteTitle;

const pathname = Astro.url?.pathname ?? "/";

// Display title can be different from <title>
const displayTitle = siteTitle;
const isDirectoryIndexPath = /^\/(companies|devices|designs|applications|simulations)\/?$/.test(pathname);
const bodyClasses = [
  pathname === "/" ? "home" : undefined,
  isDirectoryIndexPath ? "dir-index" : undefined,
].filter(Boolean);
const bodyClass = bodyClasses.length ? bodyClasses.join(" ") : undefined;

// Build dropdown menus (a mini table of contents) for quick navigation.
const companies = (await getCollection("companies"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const ar = a.data.sizeRank ?? Number.POSITIVE_INFINITY;
    const br = b.data.sizeRank ?? Number.POSITIVE_INFINITY;
    if (ar !== br) return ar - br;
    return stripPrefix(a.data.title).localeCompare(stripPrefix(b.data.title));
  });

const designs = (await getCollection("designs"))
  .filter((p) => !p.data.draft)
  .sort(compareDeviceEntries);

const applications = (await getCollection("applications"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

function stripPrefix(title) {
  return title.replace(/^\d+\s*[-—]\s*/, "");
}

function stripAtlasLabel(title) {
  return stripPrefix(title).replace(/\s*\((company|lab) brief\)$/i, "");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <script>
      // Theme: default to system preference, allow manual override via localStorage.
      (() => {
        try {
          const saved = localStorage.getItem("bts_theme");
          const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = saved === "light" || saved === "dark" ? saved : prefersDark ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
  </head>

  <body class={bodyClass}>
    {withHero ? <NerveHero /> : null}

    <main class:list={["wrap", { "wrap-wide": wide }]}>
      <header class="hero">
        <div class="brand">
          <div class="titleblock">
            {pageTitle ? <h1 class="pageTitle">{pageTitle}</h1> : <h1 class={pathname === "/" ? "homeTitle" : undefined}>{displayTitle}</h1>}
            {pathname === "/" || subtitle === "" ? null : <p class="sub">
              {subtitle ??
                "Brain-computer interface companies, their work, and their technologies."}
            </p>}
          </div>
        </div>

        <nav class="nav" aria-label="Primary">
          <a class={`pill ${pathname === "/" ? "active" : ""}`} href="/">Home</a>

          <div class={`navDrop ${pathname.startsWith("/sim") || pathname.startsWith("/simulations") ? "active" : ""}`}>
            <a class="pill" href="/simulations/">Simulations</a>
            <div class="menu">
              <a class="menuItem" href="/simulations/cortical-stimulation/">Cortical stimulation lab</a>
              <a class="menuItem" href="/simulations/cortex-slab/">Cortical recording lab</a>
              <a class="menuItem" href="/sim/">Nerve cross-section sandbox</a>
            </div>
          </div>

          <div class={`navDrop ${pathname.startsWith("/designs") || (pathname.startsWith("/devices") && !pathname.startsWith("/devices/designer")) ? "active" : ""}`}>
            <a class="pill" href="/devices/">Devices</a>
            <div class="menu">
              <a class="menuItem" href="/devices/models/">3D model finder</a>
              <div class="menuSep"></div>
              {designs.map((p) => (
                <a class="menuItem" href={`/devices/${p.slug}/`}>
                  {stripPrefix(p.data.title)}
                </a>
              ))}
            </div>
          </div>

          <a class={`pill ${pathname.startsWith("/devices/designer") ? "active" : ""}`} href="/devices/designer/">Designer</a>

          <div class={`navDrop ${pathname.startsWith("/companies") ? "active" : ""}`}>
            <a class="pill" href="/companies/">BCI Atlas</a>
            <div class="menu">
              {companies.map((p) => (
                <a class="menuItem" href={`/companies/?org=${p.slug}`}>
                  {stripAtlasLabel(p.data.title)}
                </a>
              ))}
            </div>
          </div>

          <a class={`pill ${pathname.startsWith("/china") ? "active" : ""}`} href="/china/">China</a>

          <div class={`navDrop ${pathname.startsWith("/applications") ? "active" : ""}`}>
            <a class="pill" href="/applications/">Applications</a>
            <div class="menu">
              {applications.map((p) => (
                <a class="menuItem" href={`/applications/${p.slug}/`}>
                  {stripPrefix(p.data.title)}
                </a>
              ))}
            </div>
          </div>

          <button id="themeToggle" class="pill" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            Theme
          </button>
        </nav>

        <script>
          // Wire up theme toggle + hoverable nav dropdowns after markup exists.
          (() => {
            try {
              // Theme toggle
              const btn = document.getElementById("themeToggle");
              if (btn) {
                const setLabel = (theme) => {
                  btn.textContent = theme === "dark" ? "Light" : "Dark";
                  btn.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
                };

                const getTheme = () => document.documentElement.dataset.theme || "light";
                setLabel(getTheme());

                btn.addEventListener("click", () => {
                  const next = getTheme() === "dark" ? "light" : "dark";
                  document.documentElement.dataset.theme = next;
                  localStorage.setItem("bts_theme", next);
                  setLabel(next);
                });
              }

              const drops = Array.from(document.querySelectorAll(".navDrop"));
              const closeAll = (except = null) => {
                for (const d of drops) {
                  if (d !== except) d.removeAttribute("data-open");
                }
              };

              for (const d of drops) {
                let closeTimer = null;
                const open = () => {
                  clearTimeout(closeTimer);
                  closeAll(d);
                  d.setAttribute("data-open", "");
                };
                const closeSoon = () => {
                  clearTimeout(closeTimer);
                  closeTimer = setTimeout(() => d.removeAttribute("data-open"), 140);
                };

                // Hover offers shortcuts; clicking the pill always follows its link.
                d.addEventListener("pointerenter", (event) => {
                  if (event.pointerType === "mouse") open();
                });
                d.addEventListener("pointerleave", (event) => {
                  if (event.pointerType === "mouse" && !d.contains(document.activeElement)) closeSoon();
                });

                // Keyboard users can tab through the shortcuts without intercepting taps.
                d.addEventListener("focusin", (event) => {
                  if (event.target.matches(":focus-visible")) open();
                });
                d.addEventListener("focusout", (event) => {
                  if (!d.contains(event.relatedTarget)) closeSoon();
                });
                d.addEventListener("keydown", (event) => {
                  if (event.key === "Escape") {
                    clearTimeout(closeTimer);
                    d.querySelector(".pill").focus();
                    closeAll();
                  }
                });
              }
            } catch {}
          })();
        </script>
      </header>

      <slot />

      <footer class="foot">
        <span>© {new Date().getFullYear()} buildthesimulation.com</span>
      </footer>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: "Newston";
    src: url("/fonts/newston/Newston-Regular.ttf") format("truetype"),
         url("/fonts/newston/Newston-Regular.otf") format("opentype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Bodoni MT";
    src: url("/fonts/bodoni/BodoniMT-Regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Bodoni MT";
    src: url("/fonts/bodoni/BodoniMT-Italic.ttf") format("truetype");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: "Bodoni MT Compressed";
    src: url("/fonts/bodoni/BodoniMT-Compressed.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :global(:root) {
    /* Light theme (default) */
    --bg: #f6f1e6; /* paper */
    --text: rgba(10, 10, 12, 0.86);
    --muted: rgba(10, 10, 12, 0.72);

    --panel: rgba(255, 255, 255, 0.22);
    --panelStrong: rgba(255, 255, 255, 0.65);
    --panelHover: rgba(255, 255, 255, 0.50);

    --border: rgba(10, 10, 12, 0.14);
    --borderStrong: rgba(10, 10, 12, 0.28);

    --shadow: rgba(0, 0, 0, 0.14);
    --menuBg: rgba(255, 255, 255, 0.92);

    --grainOpacity: 0.045;
    --grainBlend: multiply;

    --compressed-size: 46px;
    --title-hero: clamp(46px, 5.2vw, 88px);
    --title-page: clamp(56px, 6vw, 96px);
    --title-post: clamp(32px, 4.2vw, 46px);
    --font-body: "Bodoni MT", "Times New Roman", serif;
    --font-heading: "Bodoni MT Compressed", "Bodoni MT", "Times New Roman", serif;
    --title-section: 32px;
    --title-card: 32px;
    --text-meta: 16px;
    --text-kicker: 14px;
  }

  :global(html[data-theme="dark"]) {
    /* Dark theme */
    --bg: #0f1114;
    --text: rgba(245, 242, 236, 0.88);
    --muted: rgba(245, 242, 236, 0.68);

    --panel: rgba(255, 255, 255, 0.06);
    --panelStrong: rgba(255, 255, 255, 0.10);
    --panelHover: rgba(255, 255, 255, 0.12);

    --border: rgba(245, 242, 236, 0.14);
    --borderStrong: rgba(245, 242, 236, 0.26);

    --shadow: rgba(0, 0, 0, 0.45);
    --menuBg: rgba(18, 20, 24, 0.96);

    --grainOpacity: 0.035;
    --grainBlend: overlay;
  }

  :global(body) {
    margin: 0;
    font-family: var(--font-body);
    font-size: 22px;
    line-height: 1.34;
    color: var(--text);
    background: var(--bg);
  }

  :global(strong),
  :global(b) {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  :global(h1),
  :global(h2),
  :global(h3),
  :global(h4),
  :global(h5),
  :global(h6) {
    font-family: var(--font-heading);
    font-weight: 400;
  }

  :global(h2) {
    font-size: clamp(2.05rem, 3.7vw, 2.65rem);
  }

  :global(h3) {
    font-size: clamp(1.75rem, 3vw, 2.2rem);
  }

  :global(body.dir-index h2),
  :global(body.dir-index h3) {
    font-size: 32px;
    line-height: 1.02;
  }

  :global(p),
  :global(li) {
    line-height: 1.38;
  }

  /* subtle paper grain */
  :global(body::before) {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: var(--grainOpacity);
    mix-blend-mode: var(--grainBlend);
    background-image:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.35) 0px, rgba(0, 0, 0, 0.35) 1px, transparent 1px, transparent 3px),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.25) 0px, rgba(0, 0, 0, 0.25) 1px, transparent 1px, transparent 4px);
    filter: blur(0.2px);
    z-index: 0;
  }

  /* keep UI above the 3D canvas */
  .wrap {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 60px 24px 44px;
  }

  .wrap-wide { max-width: 1600px; }

  /* home width reset to global .wrap */

  .hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    gap: 14px;
    align-items: center;
  }


  h1 {
    margin: 0;
    font-size: 66px;
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.02;
  }

  .homeTitle {
    font-family: var(--font-heading);
    font-size: clamp(74px, 9vw, 120px);
    line-height: 0.92;
    letter-spacing: 0.008em;
    white-space: nowrap;
    width: 100%;
  }

  .pageTitle {
    font-size: var(--title-page);
    font-weight: 400;
    line-height: 0.94;
  }

  .sub {
    margin: 10px 0 0;
    font-size: 20px;
    opacity: 0.78;
    max-width: 78ch;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .pill {
    display: inline-flex;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    background: var(--panel);
    transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
    user-select: none;
  }

  .pill:hover {
    border-color: var(--borderStrong);
    transform: translateY(-1px);
    background: var(--panelHover);
  }

  .pill.active {
    border-color: var(--borderStrong);
    background: var(--panelStrong);
    font-style: italic;
  }

  /* Nav dropdowns (mini table-of-contents) */
  .navDrop {
    position: relative;
    margin: 0;
  }

  .navDrop.active > .pill {
    font-style: italic;
    border-color: var(--borderStrong);
    background: var(--panelStrong);
  }

  .navDrop:not([data-open]) .menu {
    display: none;
  }

  .menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: min(320px, calc(100vw - 64px));
    max-width: min(520px, calc(100vw - 64px));
    max-height: min(60vh, 520px);
    overflow: auto;
    padding: 10px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--menuBg);
    box-shadow: 0 12px 30px var(--shadow);
    z-index: 10;
  }

  .menuItem {
    display: block;
    padding: 8px 10px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    line-height: 1.25;
  }

  .menuItem:hover {
    background: var(--panelHover);
  }

  .menuSep {
    height: 1px;
    margin: 8px 4px;
    background: var(--border);
  }

  /* Expandable definition pills (use <details class="def"> in Markdown) */
  :global(details.def) {
    margin: 12px 0;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--panelStrong);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  :global(details.def summary) {
    cursor: pointer;
    list-style: none;
    padding: 10px 12px;
    font-weight: 400;
    font-style: italic;
  }

  :global(details.def summary::-webkit-details-marker) {
    display: none;
  }

  :global(details.def .defBody) {
    padding: 0 12px 12px;
    opacity: 0.9;
    line-height: 1.65;
  }

  .foot {
    margin-top: 28px;
    padding-top: 16px;
    opacity: 0.62;
    font-size: 14px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 680px) {
    .nav { position: relative; }
    .navDrop { position: static; }
    .menu { left: 0; right: 0; min-width: 0; max-width: none; width: 100%; }
    :global(body) { font-size: 20px; }
    h1 { font-size: 46px; }
    .pageTitle { font-size: 54px; }
    .homeTitle {
      white-space: normal;
      font-size: clamp(52px, 14vw, 74px);
      line-height: 0.95;
    }
  }
</style>
