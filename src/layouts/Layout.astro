---
import "../styles/site.css";
import "../styles/title-typography.css";
import "../styles/discovery.css";
import SiteSearch from "../components/SiteSearch.jsx";
import NerveHero from "../components/NerveHero.astro";

const {
  pageTitle,
  subtitle,
  description =
    "A catalog of brain-computer interface companies, their work, and their technologies, with device briefs and interactive simulations.",
  withHero = false,
  wide = false,
  compactHeader = false,
} = Astro.props;

const siteTitle = "Build the Simulation";
const fullTitle = pageTitle ? `${pageTitle} | ${siteTitle}` : siteTitle;

const pathname = Astro.url?.pathname ?? "/";

// Display title can be different from <title>
const displayTitle = siteTitle.toUpperCase();
const isDirectoryIndexPath = /^\/(companies|devices|designs|applications|simulations)\/?$/.test(pathname);
const bodyClasses = [
  pathname === "/" ? "home" : undefined,
  isDirectoryIndexPath ? "dir-index" : undefined,
].filter(Boolean);
const bodyClass = bodyClasses.length ? bodyClasses.join(" ") : undefined;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <link rel="stylesheet" href="/styles/theme.css?v=2" />
    <script is:inline src="/scripts/theme.js"></script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
  </head>

  <body class={bodyClass}>
    {withHero ? <NerveHero /> : null}

    <main class:list={["wrap", { "wrap-wide": wide }]}>
      <header class:list={["hero", { "hero-compact": compactHeader }]}>
        <div class="brand">
          <div class="titleblock">
            {compactHeader ? <a class="compact-brand" href="/">{siteTitle}</a> : pageTitle ? <h1 class="pageTitle">{pageTitle}</h1> : <h1 class={pathname === "/" ? "homeTitle" : undefined}>{displayTitle}</h1>}
            {compactHeader || pathname === "/" || subtitle === "" || ["/devices", "/designs", "/applications", "/companies"].some(prefix => pathname === prefix || pathname.startsWith(prefix + "/")) ? null : <p class="sub">
              {subtitle ??
                "Brain-computer interface companies, their work, and their technologies."}
            </p>}
          </div>
        </div>

        <nav class="nav" aria-label="Primary">
          <a class={`pill ${pathname === "/" ? "active" : ""}`} href="/">Home</a>
          <a class={`pill ${pathname.startsWith("/sim") || pathname.startsWith("/cortex/") || pathname.startsWith("/cells/") ? "active" : ""}`} href="/simulations/">Simulations</a>
          <a class={`pill ${pathname.startsWith("/devices/") ? "active" : ""}`} href="/devices/">Devices</a>
          <a class={`pill ${pathname.startsWith("/companies/") ? "active" : ""}`} href="/companies/">Companies &amp; Labs</a>
          <a class={`pill ${pathname.startsWith("/applications/") ? "active" : ""}`} href="/applications/">Applications</a>
          <button class="pill discovery-trigger" type="button" data-discovery-trigger aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">Search</button>
          <button id="themeToggle" data-theme-toggle class="pill" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">Theme</button>
        </nav>
      </header>

      <SiteSearch client:load />
      <slot />

      <footer class="foot">
        <span>© {new Date().getFullYear()} buildthesimulation.com</span>
      </footer>
    </main>
  </body>
</html>

<style>
  /* Preview typography: all DOM text. Canvas/3D rendering code is unchanged. */
  :global(body), :global(body *) {
    line-height: 1.25 !important;
    letter-spacing: -0.025em !important;
  }

  @font-face {
    font-family: "Newston";
    src: url("/fonts/newston/Newston-Regular.ttf") format("truetype"),
         url("/fonts/newston/Newston-Regular.otf") format("opentype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "TeX Gyre Schola";
    src: url("/fonts/tex-gyre-schola/texgyreschola-regular.otf") format("opentype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "TeX Gyre Schola";
    src: url("/fonts/tex-gyre-schola/texgyreschola-italic.otf") format("opentype");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: "TeX Gyre Schola";
    src: url("/fonts/tex-gyre-schola/texgyreschola-bold.otf") format("opentype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "TeX Gyre Schola";
    src: url("/fonts/tex-gyre-schola/texgyreschola-bolditalic.otf") format("opentype");
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: "Twentieth Century";
    src: url("/fonts/twentieth-century/Twentieth-Century-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Bodoni MT Compressed";
    src: url("/fonts/bodoni/BodoniMT-Compressed.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :global(:root) {
    --compressed-size: 46px;
    --title-hero: clamp(46px, 5.2vw, 88px);
    --title-page: clamp(56px, 6vw, 96px);
    --title-post: clamp(32px, 4.2vw, 46px);
    --font-body: "TeX Gyre Schola", "Times New Roman", serif;
    --font-heading: "Twentieth Century", "Bodoni MT Compressed", Arial, sans-serif;
    --title-section: 32px;
    --title-card: 32px;
    --text-meta: 16px;
    --text-kicker: 14px;
  }

  :global(body) {
    margin: 0;
    font-family: var(--font-body);
    font-size: 22px;
    line-height: 1.34;
    color: var(--text);
    background: var(--outer);
  }

  :global(strong),
  :global(b) {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  :global(h1),
  :global(h2),
  :global(h3),
  :global(h4),
  :global(h5),
  :global(h6) {
    font-family: var(--font-heading);
    font-weight: 400;
  }

  :global(h2) {
    font-size: clamp(2.05rem, 3.7vw, 2.65rem);
  }

  :global(h3) {
    font-size: clamp(1.75rem, 3vw, 2.2rem);
  }

  :global(body.dir-index h2),
  :global(body.dir-index h3) {
    font-size: 32px;
    line-height: 1.02;
  }

  :global(p),
  :global(li) {
    line-height: 1.38;
  }

  /* subtle paper grain */
  :global(body::before) {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: var(--grainOpacity);
    mix-blend-mode: var(--grainBlend);
    background-image:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.35) 0px, rgba(0, 0, 0, 0.35) 1px, transparent 1px, transparent 3px),
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.25) 0px, rgba(0, 0, 0, 0.25) 1px, transparent 1px, transparent 4px);
    filter: blur(0.2px);
    z-index: 0;
  }

  /* keep UI above the 3D canvas */
  .wrap {
    background: var(--paper);
    min-height: 100vh;
    border-inline: 1px solid var(--accent);
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 60px 24px 44px;
  }

  .wrap-wide { max-width: 1600px; }

  /* home width reset to global .wrap */

  .hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .hero-compact { gap: 20px; margin-bottom: 0; padding-bottom: 26px; }
  .compact-brand { font: 400 clamp(30px, 4vw, 42px)/1 var(--font-heading); text-decoration: none; }


  h1 {
    margin: 0;
    font-size: 66px;
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.02;
  }

  .homeTitle {
    font-family: var(--font-heading);
    font-size: clamp(74px, 9vw, 120px);
    line-height: 0.92;
    letter-spacing: 0.008em;
    white-space: nowrap;
    width: 100%;
  }

  .pageTitle {
    font-size: var(--title-page);
    font-weight: 400;
    line-height: 0.94;
  }

  .sub {
    margin: 10px 0 0;
    font-size: 20px;
    opacity: 0.78;
    max-width: 78ch;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .pill {
    display: inline-flex;
    padding: 10px 14px;
    border-radius: 0;
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    background: var(--panel);
    transition: transform 120ms ease, border-color 120ms ease, background 120ms ease;
    user-select: none;
  }

  .pill:hover {
    border-color: var(--borderStrong);
    transform: translateY(-1px);
    background: var(--panelHover);
  }

  .nav-key { margin-left: 7px; opacity: .55; font-size: 14px; }
  .pill.active {
    border-color: var(--accent);
    box-shadow: inset 0 -2px var(--accent);
    background: var(--panelStrong);
    font-style: italic;
  }

  /* Nav dropdowns (mini table-of-contents) */
  .navDrop {
    position: relative;
    margin: 0;
  }

  .navDrop.active > .pill {
    font-style: italic;
    border-color: var(--borderStrong);
    background: var(--panelStrong);
  }

  .navDrop:not([data-open]) .menu {
    display: none;
  }

  .menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: min(320px, calc(100vw - 64px));
    max-width: min(520px, calc(100vw - 64px));
    max-height: min(60vh, 520px);
    overflow: auto;
    padding: 10px;
    border-radius:0;
    border: 1px solid var(--border);
    background: var(--menuBg);
    box-shadow: 0 12px 30px var(--shadow);
    z-index: 10;
  }

  .menuItem {
    display: block;
    padding: 8px 10px;
    border-radius:0;
    text-decoration: none;
    color: inherit;
    line-height: 1.25;
  }

  .menuItem:hover {
    background: var(--panelHover);
  }

  .menuSep {
    height: 1px;
    margin: 8px 4px;
    background: var(--border);
  }

  /* Expandable definition pills (use <details class="def"> in Markdown) */
  :global(details.def) {
    margin: 12px 0;
    border-radius:0;
    border: 1px solid var(--border);
    background: var(--panelStrong);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  :global(details.def summary) {
    cursor: pointer;
    list-style: none;
    padding: 10px 12px;
    font-weight: 400;
    font-style: italic;
  }

  :global(details.def summary::-webkit-details-marker) {
    display: none;
  }

  :global(details.def .defBody) {
    padding: 0 12px 12px;
    opacity: 0.9;
    line-height: 1.65;
  }

  .foot {
    margin-top: 28px;
    padding-top: 16px;
    opacity: 0.62;
    font-size: 14px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 680px) {
    .nav { position: relative; }
    .navDrop { position: static; }
    .menu { left: 0; right: 0; min-width: 0; max-width: none; width: 100%; }
    :global(body) { font-size: 20px; }
    h1 { font-size: 46px; }
    .pageTitle { font-size: 54px; }
    .homeTitle {
      white-space: normal;
      font-size: clamp(52px, 14vw, 74px);
      line-height: 0.95;
    }
  }
</style>
